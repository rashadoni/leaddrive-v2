# Copy to /etc/leaddrive/wal-archive.env, replace every placeholder, then set:
#   chown root:root /etc/leaddrive/wal-archive.env
#   chmod 0600 /etc/leaddrive/wal-archive.env
# Keep values shell-safe: this file is read by both systemd and bash.
#
# This file holds the repository passphrase. Without it the archive is a pile
# of unreadable blocks, so the file must be inside the encrypted secrets
# snapshot BEFORE the first archive_command runs; snapshot-secrets.sh already
# lists it.

WAL_STANZA=leaddrive
WAL_PG_VERSION=16
WAL_PG_DATA=/var/lib/postgresql/16/main
WAL_PG_CONF_DIR=/etc/postgresql/16/main
WAL_PG_PORT=5432
WAL_PG_USER=postgres

# Repository bucket. It must be its OWN bucket, not the Object Lock bucket the
# logical dumps go to: pgBackRest expires its own backups and WAL, so a
# delete-denied key or a compliance retention lock would make the repository
# grow until the disk or the bill stops it. The dump chain keeps its immutable
# bucket untouched; this one is the low-RPO copy, not the ransomware-proof one.
WAL_REPO_BUCKET=REPLACE_WITH_DEDICATED_WAL_BUCKET
WAL_REPO_ENDPOINT=REPLACE_WITH_S3_ENDPOINT_HOSTNAME
WAL_REPO_REGION=REPLACE_WITH_REGION
WAL_REPO_PATH=/pgbackrest
WAL_REPO_KEY=REPLACE
WAL_REPO_KEY_SECRET=REPLACE
# openssl rand -hex 32
WAL_REPO_CIPHER_PASS=REPLACE_WITH_64_HEX_CHARACTERS

# Recovery window. Full backup weekly, differential daily. Retention counts
# full backups, and PITR reaches back only as far as the oldest retained full
# backup, so this number is the recovery window: 3 fulls is ~21 days.
WAL_RETENTION_FULL=3
WAL_RETENTION_DIFF=14

# How often leaddrive-wal-backup.timer takes a full backup instead of a
# differential. It runs daily and compares the newest full backup against this
# interval, so a day the server was down only delays the full, never skips it.
# Longer means a cheaper repository and a longer WAL replay on restore.
WAL_FULL_INTERVAL_DAYS=7

# The release artifact lives in this same bucket under its own prefix, so a
# full restore needs no GitHub. pgBackRest is scoped to WAL_REPO_PATH and never
# looks here; the prefix must not equal it, or pruning artifacts would delete
# WAL. Keep is a count of artifacts, newest first.
WAL_ARTIFACT_PREFIX=artifacts
WAL_ARTIFACT_KEEP=5
# How long after a release the watch waits before complaining that the bucket
# has no artifact for it: the deploy copies the tarball a few minutes after the
# swap, and warning in that window would be noise.
WAL_ARTIFACT_GRACE_SECONDS=1800

# Asynchronous archiving: archive_command returns once the segment is in the
# spool and a background process ships it, so a slow upload never blocks
# commits. The queue is bounded because a repository outage would otherwise
# fill the data disk and stop PostgreSQL.
#
# WAL_ARCHIVE_QUEUE_MAX is a deliberate trade: when the spool exceeds it,
# pgBackRest DROPS segments and reports success, which keeps the database up
# and breaks PITR continuity until the next full backup. The checker alarms on
# it; see docs/BACKUP_RUNBOOK.md, "WAL archive".
WAL_SPOOL_PATH=/var/spool/pgbackrest
WAL_ARCHIVE_QUEUE_MAX=16GiB
WAL_ARCHIVE_TIMEOUT=60s
WAL_PROCESS_MAX=2

# Checker thresholds. Lag is measured from the last successfully archived
# segment, not from the last write, so an idle database does not alarm.
WAL_CHECK_LAG_WARN_SECONDS=900
WAL_CHECK_LAG_CRIT_SECONDS=3600
WAL_CHECK_BACKLOG_WARN=64
WAL_CHECK_STATE_FILE=/var/lib/leaddrive-wal-archive/check-state.json
WAL_CHECK_LOCK_FILE=/var/lib/leaddrive-recovery-runner-locks/wal-check.lock

# Telegram target for the checker, same bot as the Kafka and line watches.
# Left empty the checker still exits non-zero; it just stays silent.
WAL_ALERT_COMMAND=/usr/local/bin/notify-telegram
