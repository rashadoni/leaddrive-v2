# Copy to /etc/leaddrive/backup.env, replace every placeholder, then set:
#   chown root:leaddrive-backup /etc/leaddrive/backup.env
#   chmod 0640 /etc/leaddrive/backup.env
# Keep values shell-safe: this file is read by both systemd and bash.

# Source database: dedicated LOGIN BYPASSRLS role with SELECT-only grants.
PGHOST=private-postgres-hostname
PGPORT=25060
PGDATABASE=leaddrive_v2
PGUSER=leaddrive_backup
PGPASSFILE=/etc/leaddrive/backup.pgpass
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/leaddrive/managed-postgres-ca.crt
PGCONNECT_TIMEOUT=10
BACKUP_EXPECTED_DB_ROLE=leaddrive_backup

# Scratch PostgreSQL: separate host/port, disposable databases only.  Its
# PostgreSQL major, extension versions and collation must match production;
# see the compatibility preflight in docs/BACKUP_RUNBOOK.md.
VERIFY_PGHOST=private-restore-verifier-hostname
VERIFY_PGPORT=5432
VERIFY_PGUSER=leaddrive_restore_verifier
VERIFY_PGPASSFILE=/etc/leaddrive/restore-verifier.pgpass
VERIFY_PGMAINTENANCE_DB=postgres
VERIFY_PGSSLMODE=verify-full
VERIFY_PGSSLROOTCERT=/etc/leaddrive/restore-postgres-ca.crt
VERIFY_PGCONNECT_TIMEOUT=10
VERIFY_ALLOW_SOURCE_CLUSTER=0

# Plaintext staging is restricted to systemd-owned tmpfs under /run and is
# always removed, including on failure. Persistent state contains tier markers
# and stable lock inodes only; it never contains a dump or a secrets snapshot.
BACKUP_WORK_ROOT=/run/leaddrive-postgres-backup
BACKUP_STATE_ROOT=/var/lib/leaddrive-postgres-backup
BACKUP_LOCK_FILE=/var/lib/leaddrive-recovery-runner-locks/postgres-backup.lock
BACKUP_MIN_DUMP_BYTES=1048576
BACKUP_MIN_WORK_AVAILABLE_BYTES=1073741824
BACKUP_WORK_CAPACITY_RATIO_PERCENT=250

# Secrets use a separate root-only tmpfs authority. Never share this runtime
# directory with the unprivileged database or log-shipping services.
APP_ENV_FILE=/etc/leaddrive/app.env
SECRETS_WORK_ROOT=/run/leaddrive-secrets-snapshot
SECRETS_LOCK_FILE=/var/lib/leaddrive-recovery-runner-locks/secrets-snapshot.lock
SECRETS_S3_PREFIX=secrets

# Log slices are plaintext only in tmpfs. The persistent state records
# device/inode/offset/content checkpoints for files, exact per-unit journald
# cursors, and the first immutable v4 evidence-object watermark. It advances
# only after the exact Object Lock version is verified.
LOG_SHIP_SOURCE_DIRS="/var/lib/leaddrive-v2-logs /var/log/nginx /var/log/postgresql"
LOG_SHIP_SOURCE_FILES=/var/log/leaddrive-resilience-cron.log
LOG_SHIP_WORK_ROOT=/run/leaddrive-log-ship
LOG_SHIP_STATE_FILE=/var/lib/leaddrive-log-ship/log-ship-offsets
LOG_SHIP_LOCK_FILE=/var/lib/leaddrive-recovery-runner-locks/log-ship.lock
# A full recovery catalog retains every referenced exact object for at least
# the monthly recovery horizon.  Do not lower this: the first genesis object
# is itself part of the recovery chain.
LOG_SHIP_RETENTION_DAYS=400
LOG_SHIP_S3_PREFIX=logs
LOG_SHIP_JOURNAL_UNITS="leaddrive-postgres-backup.service leaddrive-secrets-snapshot.service leaddrive-runtime-files-snapshot.service leaddrive-log-ship.service"

# Tenant documents/media are authoritative files outside PostgreSQL. Inventory
# metadata is staged only in tmpfs; the temporary persistent payload is already
# age-encrypted and is deleted after its exact Object Storage version is locked.
RUNTIME_FILES_SOURCE_ROOT=/var/lib/leaddrive-v2
RUNTIME_FILES_STATE_ROOT=/var/lib/leaddrive-runtime-files-snapshot
RUNTIME_FILES_WORK_ROOT=/run/leaddrive-runtime-files-snapshot
RUNTIME_FILES_LOCK_FILE=/var/lib/leaddrive-recovery-runner-locks/runtime-files-snapshot.lock
RUNTIME_FILES_S3_PREFIX=runtime-files
RUNTIME_FILES_CAPACITY_RATIO_PERCENT=110
RUNTIME_FILES_MIN_FREE_BYTES=1073741824

# Public age recipient only.  The private decryption identity must remain
# offline and be available to the independent restore-drill operator.
BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient

# Hetzner Object Storage.  This must be a cross-project writer key allowlisted
# by the bucket policy for the minimum upload/head/retention actions.  A key in
# the bucket's own project has implicit full access and is not least-privilege.
# The writer must not have DeleteObject or BypassGovernanceRetention.
BACKUP_S3_ENDPOINT=https://hel1.your-objectstorage.com
BACKUP_S3_REGION=hel1
BACKUP_S3_BUCKET=leaddrive-prod-backups
BACKUP_S3_PREFIX=postgres
AWS_ACCESS_KEY_ID=replace_with_backup_writer_key
AWS_SECRET_ACCESS_KEY=replace_with_backup_writer_secret

# One object per run: first successful run in each UTC month=monthly, then first
# successful run in each ISO week=weekly, otherwise daily.  Small safety margins
# preserve at least 14/8/12 generations even if a scheduled run is delayed.
# Bucket default must already be COMPLIANCE/14 days; the script extends the
# selected object's retention and verifies it after upload.
BACKUP_RETENTION_DAILY_DAYS=16
BACKUP_RETENTION_WEEKLY_DAYS=63
BACKUP_RETENTION_MONTHLY_DAYS=400
SECRETS_RETENTION_DAYS=400

# External dead-man monitor.  It must alert when no success ping arrives for
# 26 hours.  The script sends <URL>/fail on a failed run.
BACKUP_REQUIRE_HEALTHCHECK=1
BACKUP_HEALTHCHECK_URL=https://replace-with-monitor.example/unique-secret-path

# Independent weekly dead-man monitor. Alert after eight days without success;
# the script sends <URL>/fail on any failed snapshot.
SECRETS_HEALTHCHECK_URL=https://replace-with-monitor.example/another-unique-secret-path

# Nightly runtime-file monitor. Alert after 26 hours without success. Large
# tenants should move upload bytes to object-storage primary before this full
# snapshot approaches the eight-hour service timeout.
RUNTIME_FILES_HEALTHCHECK_URL=https://replace-with-monitor.example/runtime-files-secret-path

# Hourly log-shipping monitor. Account for the 5-minute randomized delay and
# 30-minute service timeout; alert after 100 minutes without a success ping.
LOG_SHIP_HEALTHCHECK_URL=https://replace-with-monitor.example/log-shipping-secret-path
