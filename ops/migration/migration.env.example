# Install as /etc/leaddrive/migration.env, owned by root with mode 0600.
# This file must never be sourced by the Next.js/PM2 application process.
# Use the primary PostgreSQL endpoint directly, not a PgBouncer transaction
# pool or a read-replica endpoint.
MIGRATION_DATABASE_URL='postgresql://leaddrive_migrator:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/leaddrive_v2?connect_timeout=10'
MIGRATION_EXPECTED_DB_ROLE=leaddrive_migrator
