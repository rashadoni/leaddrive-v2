{
  "name": "leaddrive-event-outbox-__ENV__",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "topic.prefix": "ld.__ENV__.cdc-source",
    "database.hostname": "__PGHOST__",
    "database.port": "5432",
    "database.dbname": "__PGDATABASE__",
    "database.user": "leaddrive_event_cdc",
    "database.password": "__SECRET_FROM_PROVIDER__",
    "database.sslmode": "verify-full",
    "database.sslrootcert": "__PG_SSL_ROOT_CERT_PATH__",
    "plugin.name": "pgoutput",
    "slot.name": "leaddrive_event_outbox___ENV__",
    "slot.drop.on.stop": "false",
    "publication.name": "leaddrive_event_outbox",
    "publication.autocreate.mode": "disabled",
    "schema.include.list": "public",
    "table.include.list": "public.event_outbox",
    "column.include.list": "public.event_outbox.id,public.event_outbox.organizationId,public.event_outbox.eventId,public.event_outbox.eventType,public.event_outbox.topic,public.event_outbox.partitionKey,public.event_outbox.envelope,public.event_outbox.payloadHash,public.event_outbox.createdAt",
    "include.schema.changes": "false",
    "skipped.operations": "u,d,t",
    "snapshot.mode": "initial",
    "snapshot.isolation.mode": "repeatable_read",
    "snapshot.fetch.size": "10000",
    "snapshot.max.threads": "1",
    "snapshot.select.statement.overrides": "public.event_outbox",
    "snapshot.select.statement.overrides.public.event_outbox": "SELECT o.\"id\", o.\"organizationId\", o.\"eventId\", o.\"eventType\", o.\"topic\", o.\"partitionKey\", o.\"envelope\", o.\"payloadHash\", o.\"createdAt\" FROM public.\"event_outbox\" AS o ORDER BY o.\"partitionKey\", ((o.\"envelope\" ->> 'aggregateversion')::bigint), o.\"id\"",
    "decimal.handling.mode": "string",
    "binary.handling.mode": "base64",
    "time.precision.mode": "adaptive_time_microseconds",
    "provide.transaction.metadata": "false",
    "event.processing.failure.handling.mode": "fail",
    "errors.tolerance": "none",
    "topic.creation.enable": "false",
    "max.queue.size": "8192",
    "max.batch.size": "2048",
    "poll.interval.ms": "500",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.op.invalid.behavior": "fatal",
    "transforms.outbox.table.field.event.id": "eventId",
    "transforms.outbox.table.field.event.key": "partitionKey",
    "transforms.outbox.table.field.event.payload": "envelope",
    "transforms.outbox.table.field.event.timestamp": "createdAt",
    "transforms.outbox.table.field.event.type": "eventType",
    "transforms.outbox.route.by.field": "topic",
    "transforms.outbox.route.topic.regex": "leaddrive\\.domain\\.([a-z][a-z0-9-]*)\\.v1",
    "transforms.outbox.route.topic.replacement": "ld.__ENV__.$1.events.v1",
    "transforms.outbox.table.fields.additional.placement": "eventType:header:eventtype,organizationId:header:organizationid,payloadHash:header:payloadhash",
    "transforms.outbox.table.field.additional.missing": "error",
    "transforms.outbox.table.expand.json.payload": "true",
    "transforms.outbox.table.json.payload.null.behavior": "optional_bytes",
    "transforms.outbox.route.tombstone.on.empty.payload": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false"
  }
}
