[Unit]
Description=Snapshot LeadDrive environment secrets weekly

[Timer]
# Weekly, not nightly. These values change rarely, and every copy is another
# place the domain token exists. The retention (400 days) is what makes a
# rotated key recoverable, not the frequency.
OnCalendar=Sun *-*-* 03:30:00 UTC
RandomizedDelaySec=15m
Persistent=true
AccuracySec=5m
Unit=leaddrive-secrets-snapshot.service

[Install]
WantedBy=timers.target
