[Unit]
Description=LeadDrive verified encrypted PostgreSQL backup
Documentation=file:/opt/leaddrive-v2/docs/BACKUP_RUNBOOK.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=leaddrive-backup
Group=leaddrive-backup
EnvironmentFile=/etc/leaddrive/backup.env
ExecStart=/usr/local/lib/leaddrive-v2/ops/current/backup/postgres-backup.sh
UMask=0077
StateDirectory=leaddrive-postgres-backup
StateDirectoryMode=0750
RuntimeDirectory=leaddrive-postgres-backup
RuntimeDirectoryMode=0750
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemorySwapMax=0

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=-/etc/leaddrive
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
