[Unit]
Description=LeadDrive WAL archive watch: is the recovery point still minutes old
Documentation=file:/opt/leaddrive-v2/docs/BACKUP_RUNBOOK.md
# The script reports a warning as exit 10 and a critical state as exit 20, and
# the watch on the workstation forwards its wording. OnFailure is for the watch
# CRASHING, which must not look like a healthy archive — which is exactly what
# happened while this unit accepted 1 and 2 as verdicts.
OnFailure=leaddrive-wal-check-failed.service
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
# Runs as root: it reads the root-only env file and switches to the database
# superuser for pgbackrest, so NoNewPrivileges would break su.
ExecStart=/usr/local/lib/leaddrive-v2/ops/current/backup/wal-archive-check.sh
# 10 is a warning and 20 is a critical verdict; anything else — 1, 2, 127 — is
# the script itself breaking, and systemd must report THAT as a failure so
# OnFailure fires. The old "0 1 2" called a dead script healthy.
SuccessExitStatus=0 10 20
TimeoutStartSec=5min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

PrivateTmp=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectSystem=strict
ReadOnlyPaths=-/etc/leaddrive -/etc/pgbackrest
# pgBackRest writes its own log during check, and that line is the only
# record of a segment that failed to push.
ReadWritePaths=-/var/lib/leaddrive-wal-archive -/var/lib/leaddrive-recovery-runner-locks -/var/log/pgbackrest
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
