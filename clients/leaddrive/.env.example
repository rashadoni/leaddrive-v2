# LeadDrive Inc. — Production environment: /etc/leaddrive/app.env
# Install root:root, mode 0600. The checkout .env is only a compatibility link;
# do not create or edit a second secret file under /opt/leaddrive-v2.

# Database
DATABASE_URL="postgresql://leaddrive:PASSWORD@localhost:5432/leaddrive"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_-base64_32"
NEXTAUTH_URL="https://app.leaddrivecrm.org"

# Domain URLs
NEXT_PUBLIC_APP_URL="https://app.leaddrivecrm.org"
NEXT_PUBLIC_MARKETING_URL="https://leaddrivecrm.org"
COOKIE_DOMAIN=".leaddrivecrm.org"
NEXT_PUBLIC_CONTACT_EMAIL="info@leaddrivecrm.org"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# AI
ANTHROPIC_API_KEY=""

# WhatsApp
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry
SENTRY_DSN=""

# Telegram notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_FINANCE_CHAT_ID=""

# Social Monitoring search-index collector
# Configure once to let newly added external page/profile/hashtag/keyword sources
# use the same approved read-only search provider without per-source code changes.
SOCIAL_SEARCH_INDEX_ENABLED="0"
SOCIAL_SEARCH_INDEX_ENDPOINT=""
SOCIAL_SEARCH_INDEX_ALLOWED_HOSTS=""
SOCIAL_SEARCH_INDEX_LIMIT="10"

# Social Monitoring provider collectors and provider reply actions
# Read endpoints and reply endpoints are intentionally allowlisted separately.
SOCIAL_PROVIDER_ALLOWED_HOSTS=""
SOCIAL_REPLY_PROVIDER_ALLOWED_HOSTS=""
