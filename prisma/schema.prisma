  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  /**
   * Board (Division) that automated work born in this pipeline files itself on
   * — call promises, unanswered callbacks. Null means "use the organization's
   * board", which is the setting most tenants will ever need; this exists so a
   * tenant running two different sales motions does not have to merge them
   * onto one wall.
   */
  taskBoardId    String?

  stages PipelineStage[]
  deals  Deal[]
  leads  Lead[]

  // A12 Revenue Intelligence
  stageTransitions PipelineStageTransition[]
  velocityMetrics  DealVelocityMetric[]

