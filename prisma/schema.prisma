// Org-wide, configurable task types (Bordio-style "Task types"). Replaces the
// hardcoded bug/feature/story/epic/task enum: Task.type stays a String, validated
// dynamically against an active TaskType.name (same canonical-string + config-table
// shape as Task.status + BoardColumn). Bare `organizationId` scalar mirrors
// CustomField/PipelineStage; the DB FK + cascade is added in the migration.
model TaskType {
  id             String   @id @default(cuid())
  organizationId String
  name           String // machine value written to Task.type (unique per org)
  displayName    String // human label shown in UI
  color          String   @default("#6B7280") // hex accent (#RRGGBB) — color dot
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("task_types")
}

// Org-wide configurable Event types (Bordio "Event types") — the channel/source
// axis on tasks (914 LINE, SOCIAL MEDIA, …), used for filtering "what the task
// relates to". Same shape as TaskType; Task.eventType validates against
// event_types.name. Bare organizationId scalar; DB FK + cascade in the migration.
model EventType {
  id             String   @id @default(cuid())
  organizationId String
  name           String // machine value written to Task.eventType (unique per org)
  displayName    String
  color          String   @default("#6B7280")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("event_types")
}

