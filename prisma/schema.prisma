model Lead {
  id                     String           @id @default(cuid())
  organizationId         String
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactName            String
  companyName            String?
  email                  String?
  phone                  String? // primary — used for SMS / voice calls
  phoneWhatsApp          String? // dedicated WhatsApp number (may equal `phone`)
  telegramHandle         String? // Telegram @username or chat id
  source                 String?
  sourceDetail           String? // event/campaign/referral name for source attribution
  sourceProfileUrl       String? // customer profile/page on the originating social channel
  interest               String? // customer's stated need or primary product interest
  brand                  String? // product brand the lead is associated with (TT §3.3)
  category               String? // lead category: vip, regular, partner, prospect (TT §3.3)
  status                 String           @default("new") // new, contacted, qualified, converted, lost
  priority               String           @default("medium")
  score                  Int              @default(0)
  scoreDetails           Json             @default("{}")
  assignedTo             String?
  // A browser call holds this lead only while its lease is alive. The opaque
  // token prevents a stale tab from releasing a newer salesperson's claim.
  browserCallClaimToken     String?
  browserCallClaimedByUserId String?
  browserCallClaimedAt      DateTime?
  browserCallClaimExpiresAt DateTime?
  estimatedValue         Float?
  notes                  String?
  customerStage          String? // current salesperson-confirmed lead qualification; never set by Inbox AI and not a per-call outcome
  salesCallOutcomes      String[]         @default([]) // current multi-select lead qualification signals; customerStage remains the primary compatibility value
  customerStageReason    String? // salesperson's qualification note, synced back to Inbox
  customerStageUpdatedAt DateTime?
  customerStageUpdatedBy String?
  pipelineId             String?
  pipeline               Pipeline?        @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  convertedAt            DateTime?
  lastScoredAt           DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  formSubmissions        FormSubmission[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, phone])
  @@index([organizationId, phoneWhatsApp])
  @@index([organizationId, customerStage])
  @@index([organizationId, pipelineId])
  @@map("leads")
}

model Task {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  status             String             @default("pending") // Kanban statuses (target): backlog | todo | in_progress | testing | review | done. Legacy values pending/completed/cancelled still accepted. NOTE (as of this turn): POST still defaults to legacy "pending" and the Zod enum accepts only the 4 legacy values — migrating the route to Kanban statuses + a data migration (pending→todo, completed→done) is a later turn. Don't trust this column to hold a Kanban status yet.
  priority           String             @default("medium")
  dueDate            DateTime?
  assignedTo         String?
  assignee           User?              @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  relatedType        String? // deal, contact, company, lead, ticket
  relatedId          String?
  // Optional link to a Project. Distinct from ProjectTask (which is a separate
  // sub-table for tasks inside a project's own task list) — this is a CRM-side
  // relation that lets a regular Task contribute to a Project's rollup
  // (Project.completionPercentage). See `src/lib/project-rollup.ts`.
  projectId          String?
  project            Project?           @relation("ProjectLinkedTasks", fields: [projectId], references: [id], onDelete: SetNull)
  // Recurrence — Roadmap #22. When a task with `recurrenceRule` enters
  // status="completed", the PATCH handler spawns the next instance with
  // the same payload but a new dueDate derived from the rule.
  //
  // Rule format is the small DSL parsed by `src/lib/recurrence/parse.ts`:
  //   "daily" | "weekly" | "monthly" | "yearly" | "every:N:day|week|month"
  //
  // `recurrenceCount` is the remaining future spawns from this point —
  // decrements by 1 on each spawn; spawn stops when it hits 0
  // (null = unlimited).
  // `recurrenceEndAt` is the upper-bound date INCLUSIVE; a next-due that
  // lands exactly on endAt still spawns. The first dueDate past endAt
  // stops the chain.
  // `recurrenceParentId` chains every instance back to the first task in
  // the series so the UI can show "instance 4 of an open series" and an
  // operator can stop the chain by clearing the rule on the parent.
  recurrenceRule     String?
  recurrenceEndAt    DateTime?
  recurrenceCount    Int?
  recurrenceParentId String?
  recurrenceParent   Task?              @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren Task[]             @relation("TaskRecurrence")
  customFields       Json?              @default("{}") // values for user-defined CustomField definitions (entityType="task")
  // ── Jira-style Kanban board (Division + BoardPermission spec) ──
  // taskKey: human key "PREFIX-N" (prefix from Division.key). Unique per org;
  // NULL allowed so pre-existing tasks need no backfill. The generator computes
  // MAX *including soft-deleted rows* so a reused number can never collide with
  // the unique index. See src/lib/tasks/task-key.ts.
  taskKey            String?
  // type: bug | feature | story | epic | task (house style: String + Zod-validated)
  type               String             @default("task")
  // eventType: configurable channel/source axis (Bordio "Event types": 914 LINE,
  // SOCIAL MEDIA, …). Nullable; validated against the org's event_types.name.
  eventType          String?
  // category: quarterly/period bucket shown as a board badge (screenshot "Q1") —
  // Q1 | Q2 | Q3 | Q4 | yearly | normal. Nullable; Zod-validated at the route.
  category           String?
  estimatedHours     Decimal?           @db.Decimal(10, 2) // 0..1000
  estimatedPrice     Decimal?           @db.Decimal(18, 4) // 0..100,000,000 (house Decimal precision)
  // divisionId: board this task belongs to. Nullable — the "project OR division
  // required" rule is enforced at the API layer (not the DB) so existing
  // project-only / orphan tasks keep validating.
  divisionId         String?
  // boardColumnKey: which BoardColumn lane this task sits in on its board
  // (display ordering + custom columns). NULL = unassigned / non-board task — the
  // board folds such tasks by `status` (identical to pre-custom-columns behavior).
  // Deliberately a loose String, NOT an FK: it references BoardColumn.key by value
  // and a column may be removed (Phase 2) without cascade-touching tasks. `status`
  // stays canonical/load-bearing; every board move co-writes status = the target
  // column's mapsToStatus. See src/app/(dashboard)/boards/[divisionId]/page.tsx.
  boardColumnKey     String?
  // Stable manual order inside a Kanban lane. Values are intentionally spaced
  // by the client so inserting between two cards normally updates only the
  // dragged task; createdAt remains the deterministic tie-breaker.
  boardPosition      Float              @default(0)
  // Soft delete (spec DELETE = soft). Board/list reads filter deletedAt:null via
  // the prisma client extension; the taskKey generator deliberately bypasses it.
  deletedAt          DateTime?
  completedAt        DateTime?
  createdBy          String?
  creator            User?              @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  checklist          TaskChecklist[]
  comments           TaskComment[]
  attachments        TaskAttachment[]
  division           Division?          @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  activities         TaskActivity[]
  // Co-assignees (Bordio-plus): the PRIMARY assignee stays `assignedTo` (all
  // per-user reporting keys off it); collaborators additionally see the task
  // in "My tasks" and on their boards. Managed via collaboratorIds on the
  // tasks POST/PATCH routes (replace-set semantics).
  collaborators      TaskCollaborator[]

  // Architect P1 — concurrent-completion race protection. Two PATCHes
  // hitting `complete` on the same recurring task simultaneously would
  // otherwise each spawn a duplicate child (same parentId, same
  // computed dueDate). The unique constraint at DB level guarantees
  // only one survives; the spawn helper catches the Prisma P2002 and
  // silently no-ops. Postgres treats NULL as distinct so the original
  // parent task (parentId=null) is never constrained.
  @@unique([recurrenceParentId, dueDate])
  // taskKey unique per org. Postgres treats NULL as distinct, so the many
  // pre-existing NULL-key rows don't collide; only generated keys are constrained.
  @@unique([organizationId, taskKey])
  @@index([organizationId])
  @@index([organizationId, assignedTo])
  @@index([organizationId, divisionId])
  @@index([organizationId, divisionId, boardColumnKey, boardPosition])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([projectId])
  @@index([recurrenceParentId])
  @@map("tasks")
}

// Co-assignee join table (see Task.collaborators). organizationId is denorm'd
// for direct org-scoped lookups ("my collaborations") without a task join.
model TaskCollaborator {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  userId         String
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([organizationId, userId])
  @@map("task_collaborators")
}

model TaskChecklist {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title          String
  completed      Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([taskId])
  @@map("task_checklists")
}

model TaskComment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation("TaskComments", fields: [userId], references: [id], onDelete: SetNull)
  content        String
  isSystem       Boolean      @default(false) // system-generated activity log entries
  createdAt      DateTime     @default(now())

  @@index([taskId])
  @@map("task_comments")
}

// ═══════════════════════════════════════════════════
// JIRA-STYLE KANBAN BOARD (Division + per-user BoardPermission)
// ═══════════════════════════════════════════════════

// A board / team / department. The spec's "division". One board per Division;
// Task.divisionId points here. `key` is the taskKey prefix (PROJ → PROJ-123).
model Division {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key              String // short uppercase prefix for taskKey ("PROJ"). Unique per org.
  name             String
  description      String?
  color            String? // board accent (hex) — UI only
  // headUserId: division/department head. Per spec rule #3, the head (or an
  // admin/manager role) is the only one allowed to move a task to "done".
  headUserId       String?
  head             User?        @relation("DivisionHead", fields: [headUserId], references: [id], onDelete: SetNull)
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  // slaTargetDays: per-board SLA cycle-time target in CALENDAR days (Board Reports
  // Tier-3 #14). NULL = board hasn't set one → the SLA report falls back to the
  // global default (DEFAULT_SLA_TARGET_DAYS = 5). Reports only; never gates writes.
  slaTargetDays    Int?
  // --- Department → Section hierarchy (nested boards) ---
  // isDepartment: this board is a CONTAINER (a "департамент") that groups child
  // section boards. A department holds NO tasks of its own (enforced at the route
  // layer) — it only aggregates its sections' tasks + reports. The flag is needed
  // because an empty, just-created department looks identical to a standalone board
  // (no parent, no children yet); without it we couldn't tell "container" from
  // "ordinary board" until a child is added.
  isDepartment     Boolean      @default(false)
  // parentDivisionId: a section's parent department. NULL = top-level (a department,
  // or a standalone board with no department). Depth is capped at 2 levels at the
  // route layer: only departments may be parents, and a department may not have a
  // parent. onDelete: SetNull fires only on a HARD row delete (e.g. org cascade) →
  // sections detach instead of being deleted. The app DELETE is a SOFT archive
  // (isActive=false), which does NOT fire the FK, so that route detaches child
  // sections explicitly (see divisions/[id] DELETE). A divisions_parent_coherence
  // trigger (raw SQL in the migration) rejects a parent in a different org — same
  // defense-in-depth pattern as board_permissions/board_columns.
  parentDivisionId String?
  parent           Division?    @relation("DivisionTree", fields: [parentDivisionId], references: [id], onDelete: SetNull)
  children         Division[]   @relation("DivisionTree")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tasks            Task[]
  boardPermissions BoardPermission[]
  boardColumns     BoardColumn[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, parentDivisionId])
  @@map("divisions")
}

// Per-user-per-division board access. This is the spec's explicit access layer;
// it sits ALONGSIDE the role matrix (permissions.ts) and row-level sharing-rules.
// Resolution order (see src/lib/tasks/board-permission.ts):
//   admin/superadmin            → bypass (always allowed)
//   explicit row, canView=false → explicit DENY (beats own-division)
//   own division                → default view/comment
//   per-action move flags gate each status transition (incl. canMoveToTesting).
// DB-level tenant hardening (Codex P0): a `board_permissions_coherence_trigger`
// (raw SQL in the migration) rejects any row whose user's org OR division's org
// ≠ organizationId — defense-in-depth beyond the app-layer checks, justified
// because this is a PERMISSION table. Prisma does not manage triggers, so it
// lives in the migration only and is invisible to `migrate diff` (no drift).
model BoardPermission {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  divisionId          String
  division            Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  canView             Boolean      @default(false)
  canEdit             Boolean      @default(false)
  canMoveToTodo       Boolean      @default(false)
  canMoveToInProgress Boolean      @default(false)
  canMoveToTesting    Boolean      @default(false)
  canMoveToReview     Boolean      @default(false)
  canMoveBack         Boolean      @default(false)
  canCreateTask       Boolean      @default(false)
  canComment          Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([userId, divisionId])
  @@index([organizationId])
  @@index([divisionId])
  @@map("board_permissions")
}

// Per-board Kanban columns (custom-columns feature). One row per visible lane on
// a board, ordered by `sortOrder`. SEEDED from Division.columns at migration time
// so the board renders identically; Phase 2 adds arbitrary add/rename/reorder/
// recolor via a CRUD route.
//
// Separation of concerns:
//   * Task.status  — canonical, load-bearing state. KPIs, recurrence spawn,
//                     project rollup all read it. The 6 stages: backlog, todo,
//                     in_progress, testing, review, done.
//   * mapsToStatus — the canonical stage a task takes when moved INTO this column.
//                     Many columns MAY map to one status (e.g. "Dev" + "QA" both
//                     → in_progress) — that's the whole point of custom columns.
//   * key          — stable, IMMUTABLE per-board id stored on Task.boardColumnKey
//                     (referenced by value, not an FK). A rename changes `label`,
//                     never `key`. For SEEDED columns key == mapsToStatus == one
//                     of the 6 canonical stages, so the board reads identically.
//   * color        — optional accent hex; NULL = brand-reactive default resolved
//                     in the UI by mapsToStatus (keeps the in-progress lane on the
//                     live brand color instead of freezing a hex in the DB).
//
// Multi-tenant: organizationId is carried (prisma client extension scopes by it)
// and a board_columns_coherence_trigger (raw SQL) rejects any row whose division
// belongs to a different org — same defense-in-depth pattern as board_permissions.
model BoardColumn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  key            String
  label          String
  sortOrder      Int          @default(0)
  mapsToStatus   String
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([divisionId, key])
  @@index([organizationId])
  @@index([divisionId, sortOrder])
  @@map("board_columns")
}

// Task audit log (spec calls it "Activity"). Named TaskActivity to avoid
// colliding with the existing CRM Activity model (calls/emails/meetings).
// One row per status/assignee/title change, create, delete, etc.
model TaskActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String // status_changed | assignee_changed | title_changed | created | deleted | ...
  oldValue       String?
  newValue       String?
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now())

  @@index([taskId])
  @@index([organizationId])
  @@map("task_activities")
}

// Roadmap #20 — user-defined saved views (a.k.a. "favorite filters") on
// list pages. A view captures the filter / sort / column-visibility state
// the user wants to revisit; clicking a view's chip on the list page
// applies it. One view per (org, user, entityType) can be marked
// isDefault — applied automatically when the user lands on that page.
//
// Personal by default (scoped to userId). isShared opens the view to the
// whole org — useful for ops-pre-built views like "VIP leads to nurture"
// or "Overdue tasks". When isShared=true, the view ignores userId for
// visibility but still records who created it for attribution.
model SavedView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String // owner (creator); see isShared for org visibility
  user           User         @relation("SavedViewOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Which entity's list page this view applies to. Free-form string so
  // new entities (e.g. "projects") don't require a schema migration.
  entityType     String
  name           String
  // Filter / sort / column state. Shape is owned by the consumer entity
  // (no schema validation here) — the list page interprets the JSON
  // according to its own filter model.
  filters        Json         @default("{}")
  isDefault      Boolean      @default(false)
  isShared       Boolean      @default(false)
  sortOrder      Int          @default(0) // for chip ordering on the list page
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, entityType])
  @@index([organizationId, entityType, isShared])
  @@map("saved_views")
}

// Roadmap #21 — user-defined task templates. Captures the pre-fill state
// of the "new task" form so common patterns ("weekly status report",
// "client onboarding call") can be instantiated with one click instead
// of typing the same fields each time.
//
// Personal by default (scoped to userId). `isShared=true` makes the
// template visible to the whole org — useful for team-wide playbooks.
// Only the owner or an admin may edit/delete (enforced in [id] route).
//
// Variable substitution at instantiation time on the client:
//   {{date}}   → today's date in user locale
//   {{user}}   → current user's name
//   {{month}}  → current month name in user locale
//   {{week}}   → ISO week number
// Unknown vars are left untouched so they're visible in the created task.
model TaskTemplate {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String // owner (creator)
  user              User         @relation("TaskTemplateOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Template metadata — what this template IS for
  name              String // "Weekly status report"
  description       String? // free-text — shows in the picker dropdown
  // Pre-filled task fields. Empty/null means "use the form's own default
  // when the user instantiates" rather than locking the field.
  taskTitle         String // supports {{date}} {{user}} {{month}} {{week}}
  taskDescription   String?
  priority          String       @default("medium")
  // Days from creation. Null = leave dueDate empty on the new task.
  dueDateOffsetDays Int?
  assignedTo        String? // userId; null = leave assignee field empty
  relatedType       String? // "deal"|"contact"|"company"|"lead"|"ticket"
  customFields      Json         @default("{}") // {fieldName: value}
  // Checklist items to copy onto the new task. Shape: [{title, sortOrder}]
  // (no `completed` — fresh task starts all unchecked).
  checklist         Json         @default("[]")
  isShared          Boolean      @default(false)
  // Bumped each time the template is instantiated; lets the UI sort by
  // popularity later.
  usageCount        Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, isShared])
  @@map("task_templates")
}

model Contract {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractNumber String
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String
  type           String       @default("service_agreement")
  /**
   * Status enum — application-enforced by state-machine helper in
   * `src/lib/contract-lifecycle/state-machine.ts`. Slice-1 keeps
   * the column free-form; slice-2 adds a CHECK constraint after a
   * one-time backfill normalises legacy rows. Allowed values:
   * draft | pending_approval | approved | active | renewing
   * | renewed | expired | terminated | rejected | cancelled
   */
  status         String       @default("draft")
  startDate      DateTime?
  endDate        DateTime?
  valueAmount    Decimal?     @db.Decimal(18, 4)
  currency       String       @default("AZN")
  notes          String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // M5 slice 1 additions: template attachment + approval-chain pointer + renewal-flow pointer.
  templateId              String?
  template                ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /**
   * Frozen template version at instantiation — survives template edits.
   */
  templateVersion         Int?
  /**
   * Substituted clause body — slice-2 PDF rendering reads this.
   */
  renderedBody            String?
  /**
   * Rich HTML body authored in the contract editor (Slice 1). The editable
   * SOURCE OF TRUTH; `renderedBody` is its derived plain-text mirror via
   * `serializeContractBody()`. Nullable: legacy contracts have only
   * `renderedBody` and are seeded into `bodyHtml` lazily on first editor open
   * (non-destructively — see docs/superpowers/specs §5.1). NEVER hashed —
   * `contentHash` stays over `renderedBody` so existing sign/verify is untouched.
   */
  bodyHtml                String?
  /**
   * Pointer into the approval chain — `currentApprovalStage` = ContractApprovalStage.order awaiting decision.
   */
  currentApprovalStage    Int?
  /**
   * If this contract was instantiated as a renewal of another, the source.
   */
  renewalSourceContractId String?
  renewalSource           Contract?         @relation("ContractRenewals", fields: [renewalSourceContractId], references: [id], onDelete: SetNull)
  renewedAs               Contract[]        @relation("ContractRenewals")

  // M6 slice 1 additions: signed-state tracking. Set when an
  // EsignEnvelope transitions to `completed` (slice-2 wires the
  // automation). Multiple envelopes per contract are allowed
  // (amendments / re-sign cycles); only the most recent completed
  // envelope's countersign timestamp matters for Contract.signedAt.
  signedAt DateTime?
  signedBy String?

  /// S6 CPQ slice-3 piece-4: provenance pointer for contracts that
  /// were auto-spawned when a Quote transitioned to `accepted`. The
  /// `@unique` constraint guarantees one-to-one — a given Quote can
  /// spawn at most one Contract, even under racing PATCH calls (the
  /// second insert violates the unique and rolls back the whole
  /// transaction). NULL on contracts created manually (the legacy
  /// path); audit can `WHERE spawnedFromQuoteId IS NOT NULL` to find
  /// the auto-population history.
  spawnedFromQuoteId String? @unique(map: "contracts_spawned_from_quote_uniq")

  files                  ContractFile[]
  invoices               Invoice[]
  approvalStages         ContractApprovalStage[]
  escalationEvents       ContractApprovalEscalationEvent[]
  renewalAlerts          ContractRenewalAlert[]            @relation("ContractRenewalAlertsForContract")
  supersedes             ContractRenewalAlert[]            @relation("ContractRenewalAlertsSupersededBy")
  esignEnvelopes         EsignEnvelope[]
  performanceObligations PerformanceObligation[]
  // CLM Slice 1a: immutable version history (ContractVersion.contractId FK).
  contractVersions       ContractVersion[]
  // CLM Slice 3d: intake submission that spawned this contract (optional).
  intakeSubmission       ContractIntakeSubmission?         @relation("IntakeSubmissionContract")
  // CLM Slice 4b-1: org-scoped tags (implicit m2m — join table _ContractToContractTag).
  tags                   ContractTag[]
  // CLM Slice 4c: deviation flags from clause governance detection.
  deviationFlags         ContractDeviationFlag[]
  // CLM Slice 5a: general milestones / obligations (deliverables + owners + reminders).
  milestones             ContractMilestone[]
  // CLM Slice 6a: AI clause + obligation extraction results.
  aiExtractions          ContractAiExtraction[]
  // CLM Slice 6b: AI risk-scoring results vs clause-library playbook.
  riskScores             ContractRiskScore[]
  // CLM Slice 6c: pgvector embedding for semantic search.
  embedding              ContractEmbedding?
  // CLM Slice 6d: AI semantic redlines between two ContractVersions.
  redlines               ContractRedline[]

  @@index([organizationId])
  @@index([templateId])
  @@index([renewalSourceContractId])
  @@index([signedAt])
  @@map("contracts")
}

model ContractFile {
  id             String   @id @default(cuid())
  organizationId String
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fileName       String
  originalName   String
  fileSize       Int
  mimeType       String
  uploadedBy     String?
  createdAt      DateTime @default(now())

  // F-41 cross-tenant guard hot path
  // (`src/app/api/v1/uploads/[...path]/route.ts:196`).
  // Lookup is `where: { fileName, organizationId }` — composite index
  // makes it index-only instead of an org-filtered scan + LIKE.
  // Also doubles as a uniqueness guarantee: the upload route generates
  // 32-char hex names but collisions stay theoretical until enforced.
  @@unique([organizationId, fileName])
  @@index([contractId])
  @@map("contract_files")
}

// Task file attachments — mirrors ContractFile exactly (same upload/serve
// security model). Stored on disk as /uploads/tasks/<32-hex>.<ext>; the F-41
// gate resolves ownership by (fileName, organizationId), so the composite
// unique below is both the hot-path index and the collision guarantee.
model TaskAttachment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName       String
  originalName   String
  fileSize       Int
  mimeType       String
  uploadedBy     String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, fileName])
  @@index([taskId])
  @@map("task_attachments")
}

