// LeadDrive CRM v2.0 — Prisma Schema
// Multi-tenant: ALL models (except Organization) have organizationId

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════
// ORGANIZATION & AUTH
// ═══════════════════════════════════════════════════

