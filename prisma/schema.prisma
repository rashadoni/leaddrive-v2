model Event {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  type            String    @default("conference") // conference, webinar, workshop, meetup, exhibition, other
  status          String    @default("planned") // planned, registration_open, in_progress, completed, cancelled
  startDate       DateTime
  endDate         DateTime?
  location        String?
  isOnline        Boolean   @default(false)
  meetingUrl      String?
  budget          Float     @default(0)
  actualCost      Float     @default(0)
  expectedRevenue Float     @default(0)
  actualRevenue   Float     @default(0)
  maxParticipants Int?
  registeredCount Int       @default(0)
  attendedCount   Int       @default(0)
  responsibleId   String?
  tags            String[]  @default([])
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // C9 Marketing Attribution — optional link so event participation becomes
  // a campaign touchpoint (channel "event"). NULL = event not tied to a
  // marketing campaign → no touchpoint derived.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  participants EventParticipant[]

  @@index([organizationId])
  @@index([organizationId, campaignId])
  @@map("events")
}

model EventParticipant {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contactId    String?
  companyId    String?
  name         String
  email        String?
  phone        String?
  role         String    @default("attendee") // attendee, speaker, sponsor, organizer, vip
  status       String    @default("registered") // registered, confirmed, attended, cancelled, no_show
  source       String    @default("invited") // invited, self_registered, imported
  invitedAt    DateTime?
  inviteStatus String    @default("not_sent") // not_sent, sent, opened, declined
  registeredAt DateTime  @default(now())
  notes        String?

  // C9 #14 — one participant per (event, email): kills duplicate-registration
  // rows that each spawned an attribution touchpoint and inflated campaign
  // credit. email is nullable, so Postgres (NULLS DISTINCT) still allows many
  // email-less invited/imported participants per event.
  @@unique([eventId, email])
  @@index([eventId])
  @@map("event_participants")
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  category       String   @default("service") // service, product, addon, consulting
  sku            String? // S6 CPQ — part number / SKU; null for service-only catalog entries
  productType    String   @default("other") // hardware | license | subscription | service | other
  price          Float    @default(0)
  currency       String   @default("AZN")
  isActive       Boolean  @default(true)
  features       String[] @default([])
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // D7 back-relation — InventoryItem.productId has an ON DELETE RESTRICT
  // FK at the SQL level (see migration 20260517210000_inventory). Keeps
  // the Prisma client navigation in sync with the underlying FK.
  inventoryItems         InventoryItem[]
  // M4 back-relation — PerformanceObligation.productId is optional;
  // ON DELETE SET NULL preserves the PO row if the product is removed.
  performanceObligations PerformanceObligation[]

  // S6 CPQ back-relation — QuoteLineItem.productId is optional with
  // ON DELETE SET NULL. Snapshot of productName at line-item write
  // time preserves quote integrity if the product gets renamed.
  quoteLineItems QuoteLineItem[]

  @@index([organizationId])
  @@map("products")
}

// ═══════════════════════════════════════════════════
// INVOICES & BILLING
// ═══════════════════════════════════════════════════

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contractId     String?
  contract       Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  offerId        String?

  title  String
  status String @default("draft") // draft, sent, viewed, partially_paid, paid, overdue, cancelled, refunded

  // Financial — all money amounts are Decimal(18,4) to prevent IEEE-754 drift
  // on repeated read-write cycles (billing totals, statements, LTV rollups).
  // taxRate is intentionally Float (it's a percentage rate, not a money amount).
  subtotal       Decimal @default(0) @db.Decimal(18, 4)
  discountType   String  @default("percentage") // percentage, fixed
  discountValue  Decimal @default(0) @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  taxRate        Float   @default(0)
  taxAmount      Decimal @default(0) @db.Decimal(18, 4)
  totalAmount    Decimal @default(0) @db.Decimal(18, 4)
  paidAmount     Decimal @default(0) @db.Decimal(18, 4)
  balanceDue     Decimal @default(0) @db.Decimal(18, 4)
  currency       String  @default("AZN")

  // Tax details
  voen       String?
  sellerVoen String?
  includeVat Boolean @default(false)

  // Dates
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  sentAt    DateTime?
  viewedAt  DateTime?
  paidAt    DateTime?

  // Payment terms
  paymentTerms     String @default("net30")
  paymentTermsDays Int?

  // Recipient
  recipientEmail String?
  recipientName  String?
  billingAddress String?

  // Notes
  notes              String?
  termsAndConditions String?
  footerNote         String?

  // Document details
  signerName       String?
  signerTitle      String?
  contractNumber   String?
  contractDate     String?
  documentLanguage String  @default("az")

  // Recurring
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])

  // Communication chain
  chainJourneyId String? // dedicated Journey for this invoice's reminder chain

  // Custom columns definition
  customColumns Json? // [{ "key": "unit", "label": "Ölçü vahidi" }, ...]

  // Meta
  viewToken String?  @unique
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments InvoicePayment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, companyId])
  @@index([dealId])
  @@index([contractId])
  @@map("invoices")
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String?
  name         String
  description  String?
  quantity     Float   @default(1)
  unitPrice    Decimal @default(0) @db.Decimal(18, 4)
  discount     Float   @default(0)
  taxRate      Float?
  total        Decimal @default(0) @db.Decimal(18, 4)
  sortOrder    Int     @default(0)
  customFields Json? // { "columnName": "value", ... }

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(18, 4)
  currency       String       @default("AZN")
  paymentMethod  String       @default("bank_transfer")
  paymentDate    DateTime     @default(now())
  reference      String?
  notes          String?
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([invoiceId])
  @@index([organizationId])
  @@map("invoice_payments")
}

model RecurringInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  titleTemplate  String? // e.g. "IT Xidmətləri — {month} {year}"
  companyId      String?
  contactId      String?
  dealId         String?
  contractId     String?

  frequency      String    @default("monthly")
  intervalCount  Int       @default(1)
  startDate      DateTime
  endDate        DateTime?
  nextRunDate    DateTime?
  lastRunDate    DateTime?
  totalGenerated Int       @default(0)
  maxOccurrences Int?

  currency           String  @default("AZN")
  taxRate            Float   @default(0)
  includeVat         Boolean @default(false)
  voen               String?
  paymentTerms       String  @default("net30")
  notes              String?
  termsAndConditions String?
  recipientEmail     String?

  autoSend   Boolean @default(false)
  dayOfMonth Int? // e.g. 25 = generate on 25th

  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
