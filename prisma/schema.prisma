  latitude          Float
  longitude         Float
  status            String
  accuracyMeters    Float?
  sourceSystem      String
  sourceReference   String?
  sourceObservedAt  DateTime
  decisionReason    String?
  verifiedByUserId  String
  verifiedAt        DateTime     @default(now())
