model EducationStudent {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Soft references to CRM Contact + User. Intentionally NO FK at the
   * schema level — slice-1 avoids cross-module coupling; slice-2 may
   * promote these to typed Prisma relations once the recruit→student
   * conversion flow is wired. App-layer reads these as opaque ids
   * until then.
   */
  contactId         String?
  userId            String?
  /**
   * Institutional student ID — UNIQUE per tenant.
   */
  externalStudentId String
  fullName          String
  email             String
  phone             String?
  birthDate         DateTime?
  /**
   * Lifecycle (DB CHECK):
   * prospect | applicant | admitted | enrolled
   * | graduated | withdrawn | inactive
   */
  status            String       @default("prospect")
  programSlug       String?
  cohortYear        Int?
  admittedAt        DateTime?
  enrolledAt        DateTime?
  graduatedAt       DateTime?
  metadata          Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  enrollments EducationEnrollment[]

  @@unique([organizationId, externalStudentId])
  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, programSlug])
  @@index([organizationId, cohortYear])
  @@map("education_students")
}

model EducationEnrollment {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentId      String
  student        EducationStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       String
  course         EducationCourse       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  termId         String
  term           EducationAcademicTerm @relation(fields: [termId], references: [id], onDelete: Restrict)
  /**
   * Lifecycle (DB CHECK):
   * pending | enrolled | dropped | completed | failed | audit
   */
  status         String                @default("pending")
  /**
   * Grade points 0.00-4.00; NULL until graded.
   */
  gradePoints    Decimal?              @db.Decimal(3, 2)
  /**
