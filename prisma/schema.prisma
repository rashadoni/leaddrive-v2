  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type              MtmImportType
  status            MtmImportStatus @default(UPLOADED)
  templateVersion   String
  originalFileName  String
  fileChecksum      String
  fileSize          Int
  storageKey        String?
  errorFileKey      String?
  detectedSheet     String?
  headerMap         Json?
  previewData       Json?
  validatedSnapshot Json?
  validationSummary Json?
