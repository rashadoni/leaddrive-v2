  eventIds       String[]     @default([])
  completedAt    DateTime     @default(now())
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, commandType, idempotencyKey], map: "event_command_receipts_org_command_key")
  @@index([organizationId, createdAt], map: "event_command_receipts_org_created_idx")
