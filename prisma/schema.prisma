  name             String
  status           WorkforceAttendanceQrStationStatus @default(ACTIVE)
  rotationSeconds  Int                                @default(60)
  createdByUserId  String
  createdByUser    User                               @relation("WorkforceAttendanceQrStationCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  disabledByUserId String?
  disabledByUser   User?                              @relation("WorkforceAttendanceQrStationDisabledBy", fields: [organizationId, disabledByUserId], references: [organizationId, id], onDelete: Restrict)
  disabledAt       DateTime?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  verifications WorkforceAttendanceVerification[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdByUserId])
  @@index([organizationId, disabledByUserId])
  @@map("workforce_attendance_qr_stations")
}

// A device enrollment stores only an approved public key. Device labels are
// operator-facing metadata, not an authentication factor; biometric templates
// and biometric results are never stored in LeadDrive.
model WorkforceAttendanceDeviceEnrollment {
  id                   String                                    @id @default(cuid())
  organizationId       String
  organization         Organization                              @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "workforce_attendance_devices_organization_fkey")
  agentId              String
  agent                MtmAgent                                  @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade, map: "workforce_attendance_devices_agent_fkey")
  deviceLabel          String
  publicKeySpki        String                                    @db.Text
  publicKeyFingerprint String                                    @db.VarChar(64)
  status               WorkforceAttendanceDeviceEnrollmentStatus @default(PENDING)
  keyVerifiedAt        DateTime?
  approvedByUserId     String?
  approvedByUser       User?                                     @relation("WorkforceAttendanceDeviceEnrollmentApprovedBy", fields: [organizationId, approvedByUserId], references: [organizationId, id], onDelete: Restrict, map: "workforce_attendance_devices_approved_by_fkey")
  approvedAt           DateTime?
  revokedByUserId      String?
  revokedByUser        User?                                     @relation("WorkforceAttendanceDeviceEnrollmentRevokedBy", fields: [organizationId, revokedByUserId], references: [organizationId, id], onDelete: Restrict, map: "workforce_attendance_devices_revoked_by_fkey")
  revokedAt            DateTime?
  replacesEnrollmentId String?
  replacesEnrollment   WorkforceAttendanceDeviceEnrollment?      @relation("WorkforceAttendanceDeviceReplacement", fields: [organizationId, replacesEnrollmentId], references: [organizationId, id], onDelete: Restrict, map: "workforce_attendance_devices_replaces_fkey")
  replacements         WorkforceAttendanceDeviceEnrollment[]     @relation("WorkforceAttendanceDeviceReplacement")
  createdAt            DateTime                                  @default(now())
  updatedAt            DateTime                                  @updatedAt

  challenges    WorkforceAttendanceDeviceEnrollmentChallenge[]
  verifications WorkforceAttendanceVerification[]

  @@unique([organizationId, id], map: "workforce_attendance_devices_organization_id_key")
  @@unique([organizationId, publicKeyFingerprint], map: "workforce_attendance_devices_public_key_key")
  @@index([organizationId, agentId, status, createdAt])
  @@index([organizationId, approvedByUserId])
  @@index([organizationId, revokedByUserId])
  @@index([organizationId, replacesEnrollmentId])
  @@map("workforce_attendance_device_enrollments")
}

// The raw proof-of-possession challenge is returned once to the mobile client.
// Only its tenant-bound fingerprint is persisted, with a monotonic consumedAt
// marker, so a replay cannot be accepted after enrollment.
model WorkforceAttendanceDeviceEnrollmentChallenge {
  id                   String                              @id @default(cuid())
  organizationId       String
  organization         Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "workforce_attendance_device_challenges_organization_fkey")
  enrollmentId         String
  enrollment           WorkforceAttendanceDeviceEnrollment @relation(fields: [organizationId, enrollmentId], references: [organizationId, id], onDelete: Cascade, map: "workforce_attendance_device_challenges_enrollment_fkey")
  challengeFingerprint String                              @db.VarChar(64)
  expiresAt            DateTime
  consumedAt           DateTime?
  createdAt            DateTime                            @default(now())

  @@unique([organizationId, id], map: "workforce_attendance_device_challenges_organization_id_key")
  @@unique([organizationId, challengeFingerprint], map: "workforce_attendance_device_challenges_challenge_key")
  @@index([organizationId, enrollmentId, expiresAt])
  @@map("workforce_attendance_device_enrollment_challenges")
}

// Append-only proof ledger for a canonical workday event. QR nonce and device
// signature fingerprints provide replay resistance without retaining raw QR,
// private keys, biometric data, or biometric templates.
model WorkforceAttendanceVerification {
  id                   String                                @id @default(cuid())
  organizationId       String
  organization         Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "workforce_attendance_verifications_organization_fkey")
  agentId              String
  agent                MtmAgent                              @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, map: "workforce_attendance_verifications_agent_fkey")
  workdayEventId       String
  workdayEvent         MtmAgentWorkdayEvent                  @relation(fields: [organizationId, workdayEventId], references: [organizationId, id], onDelete: Restrict, map: "workforce_attendance_verifications_event_fkey")
  policyId             String
  policy               WorkforcePolicy                       @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict, map: "workforce_attendance_verifications_policy_fkey")
  policyVersion        Int
  policyDefinitionHash String                                @db.VarChar(64)
  method               WorkforceAttendanceVerificationMethod
  stationId            String?
  station              WorkforceAttendanceQrStation?         @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Restrict, map: "workforce_attendance_verifications_station_fkey")
  deviceEnrollmentId   String?
  deviceEnrollment     WorkforceAttendanceDeviceEnrollment?  @relation(fields: [organizationId, deviceEnrollmentId], references: [organizationId, id], onDelete: Restrict, map: "workforce_attendance_verifications_device_fkey")
  nonceFingerprint     String?                               @db.VarChar(64)
  proofFingerprint     String?                               @db.VarChar(64)
  verifiedAt           DateTime                              @default(now())
  createdAt            DateTime                              @default(now())

  @@unique([organizationId, id], map: "workforce_attendance_verifications_organization_id_key")
  @@unique([organizationId, workdayEventId, method], map: "workforce_attendance_verifications_event_method_key")
  @@unique([organizationId, nonceFingerprint], map: "workforce_attendance_verifications_nonce_key")
  @@index([organizationId, agentId, verifiedAt])
  @@index([organizationId, policyId, policyVersion])
  @@index([organizationId, stationId, verifiedAt])
  @@index([organizationId, deviceEnrollmentId, verifiedAt])
  @@map("workforce_attendance_verifications")
}

/// A tenant-scoped emergency/drain fence for mobile Workforce mutations.
/// Device rows live in MtmMobileSyncCohort under the dedicated
/// `workforce-write` stream; this record decides whether that cohort is merely
/// prepared or is required for every mobile Workforce write. No tenant receives
/// a row during migration, so existing mobile behavior remains unchanged.
model WorkforceMobileWriteFence {
  organizationId   String                        @id
  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mode             WorkforceMobileWriteFenceMode @default(LEGACY_ALLOWED)
  updatedByUserId  String
  updatedByUser    User                          @relation("WorkforceMobileWriteFenceUpdatedBy", fields: [organizationId, updatedByUserId], references: [organizationId, id], onDelete: Restrict)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([organizationId, mode, updatedAt])
  @@map("workforce_mobile_write_fences")
}

// MTM Photo — visit photos with review
model MtmPhoto {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId           String
  agent             MtmAgent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  visitId           String?
  visit             MtmVisit?      @relation(fields: [visitId], references: [id], onDelete: SetNull)
  clientPhotoId     String?
  /// SHA-256 of the original uploaded bytes. This is intentionally distinct
  /// from the public URL because HEIC may be converted before storage; durable
  /// clientPhotoId replay must compare the exact local-file payload.
  checksumSha256    String?
  url               String
  thumbnailUrl      String?
  category          String? // shelf, display, promo, receipt
  status            MtmPhotoStatus @default(PENDING)
  hasWatermark      Boolean        @default(false)
  latitude          Float?
  longitude         Float?
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNote        String?
  // M1-2 watermark + EXIF audit columns. exifData stores parsed EXIF for
  // forensic review. gpsMatchedAt is non-null only when EXIF GPS was
  // within tolerance of the form-supplied claim. tamperingDetected fires
  // when EXIF Software/Make/agent diverges from auth context — those rows
  // also get an MtmAuditLog entry with action PHOTO_TAMPER_DETECTED
  // (see src/lib/mtm-audit.ts).
  exifData          Json?
  watermarkedAt     DateTime?
  gpsMatchedAt      DateTime?
  tamperingDetected Boolean        @default(false)
  likes             Int            @default(0)
  dislikes          Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  /// Exact-cohort object-storage metadata. The legacy URL remains the stable
  /// authorization handle, so old clients do not need a schema migration.
  mediaObject MtmMediaObject? @relation("MtmPhotoObject")
  promiseEvidenceFor MtmCommitment[]            @relation("MtmCommitmentPromiseEvidence")
  factEvidenceFor    MtmCommitmentFulfillment[] @relation("MtmCommitmentFactEvidence")
  pharmacyPromotionEvidence MtmPharmacyPromotionEvidence[] @relation("MtmPharmacyEvidencePhoto")

  @@unique([organizationId, agentId, clientPhotoId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([agentId])
  @@index([visitId])
  @@index([tamperingDetected])
  // M4-2: analytics date-range queries — WHERE organizationId + createdAt range
  @@index([organizationId, createdAt])
  // F-41 cross-tenant guard hot path
  // (`src/app/api/v1/uploads/[...path]/route.ts:179`).
  // Lookup is `where: { url, organizationId }` — composite index makes
  // it index-only instead of an org-filtered scan + LIKE. NOT unique:
  // `url` can theoretically repeat across re-uploads of the same shot
  // (timestamp+nonce collision is astronomical but allowed by schema).
  @@index([organizationId, url])
  @@map("mtm_photos")
}

/// Durable ownership/lifecycle record for encrypted Field media in
/// S3-compatible storage. The object key is random and contains no tenant,
/// agent, filename, GPS or document title. A PENDING row is created before the
/// external PUT, which leaves a bounded, tenant-scoped recovery trail if a
/// process dies between object storage and the business transaction.
model MtmMediaObject {
  id                String       @id @default(cuid())
  organizationId    String
  /// Unlike ordinary tenant rows, media metadata blocks a hard tenant delete
  /// until the export/retention/legal-hold procedure has handled its bytes.
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploaderAgentId   String
  uploaderAgent     MtmAgent     @relation("MtmMediaObjectUploader", fields: [organizationId, uploaderAgentId], references: [organizationId, id], onDelete: Restrict)
  /// Stable mobile idempotency key. It exists before the external PUT, so a
  /// retry can recover an interrupted upload without creating a second object.
  clientMediaId     String
  requestHash       String
  kind              String
  state             String       @default("PENDING")
  provider          String
  bucketName        String
  objectKey         String
  checksumSha256    String
  sizeBytes         Int
  mimeType          String
  encryptionKeyId   String
  retentionUntil    DateTime
  legalHold         Boolean      @default(false)
  photoId           String?      @unique
  photo             MtmPhoto?    @relation("MtmPhotoObject", fields: [organizationId, photoId], references: [organizationId, id], onDelete: Restrict)
  documentId        String?      @unique
  document          MtmDocument? @relation("MtmDocumentObject", fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  attempts          Int          @default(0)
  lastAttemptAt     DateTime?
  lastErrorCode     String?
  committedAt       DateTime?
  quarantinedAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([bucketName, objectKey])
  @@unique([organizationId, uploaderAgentId, clientMediaId])
  // Prisma needs these exact composite keys on the defining side of the
  // tenant-scoped one-to-one relations below. The existing globally unique
  // photoId/documentId keys remain the stronger business invariant.
  @@unique([organizationId, photoId])
  @@unique([organizationId, documentId])
  @@index([organizationId, state, createdAt])
  @@index([state, retentionUntil])
  @@map("mtm_media_objects")
}

// MTM Alert — system alerts for anomalies
model MtmAlert {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type           MtmAlertType
  category       MtmAlertCategory @default(WARNING)
  title          String
  description    String?
  isResolved     Boolean          @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([agentId])
  @@index([createdAt])
  @@map("mtm_alerts")
}

// MTM Agent Location — GPS tracking data
model MtmAgentLocation {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId          String
  agent            MtmAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workdayId        String?
  workday          MtmAgentWorkday? @relation(fields: [workdayId], references: [id], onDelete: SetNull)
  clientLocationId String?
  /// Immutable digest for the v2 GPS batch idempotency contract. Legacy rows
  /// may remain NULL and are never treated as an exact batch replay.
  payloadSha256    String?
  latitude         Float
  longitude        Float
  accuracy         Float?
  speed            Float?
  heading          Float?
  altitude         Float?
  battery          Float?
  isMoving         Boolean          @default(false)
  recordedAt       DateTime         @default(now())

  @@unique([organizationId, agentId, clientLocationId])
  @@index([organizationId])
  @@index([agentId])
  @@index([recordedAt])
  @@index([workdayId, recordedAt])
  // M4-2: live-map "latest location per agent" — WHERE agentId ORDER BY recordedAt DESC LIMIT 1
  @@index([agentId, recordedAt])
  // M4-2: supervisor live-map date-range — WHERE organizationId + agentId + recordedAt range
  @@index([organizationId, agentId, recordedAt])
  @@map("mtm_agent_locations")
}

/// Narrow latest-location projection for live maps. It is intentionally
/// separate from the high-volume raw GPS table: writes only advance it when
/// the incoming recordedAt is not older than the current point, and retention
/// removes stale projection rows with the same 30-day policy as raw GPS.
model MtmAgentLatestLocation {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId          String       @unique
  agent            MtmAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sourceLocationId String?
  payloadSha256    String?
  latitude         Float
  longitude        Float
  accuracy         Float?
  speed            Float?
  heading          Float?
  altitude         Float?
  battery          Float?
  isMoving         Boolean      @default(false)
  recordedAt       DateTime
  receivedAt       DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, agentId])
  @@index([organizationId, recordedAt])
  @@map("mtm_agent_latest_locations")
}

// MTM Setting — organization-level MTM settings
model MtmSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("mtm_settings")
}

// MTM Notification — notifications for agents/managers
model MtmNotification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Null for legacy/direct notifications. A non-null source gives the
  /// post-commit outbox a database-enforced exactly-once materialization key.
  outboxId       String?
  outbox         MtmRouteNotificationOutbox? @relation("MtmRouteNotificationOutboxDelivery", fields: [organizationId, outboxId], references: [organizationId, id], onDelete: Cascade)
  title          String
  body           String?
  type           String       @default("info") // info, warning, alert, task
  isRead         Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, outboxId], map: "mtm_notifications_org_outbox_key")
  @@index([organizationId])
  @@index([agentId])
  @@index([createdAt])
  @@map("mtm_notifications")
}

/// Tenant-scoped transactional outbox for route and customer-review events.
/// dedupeKey is immutable and unique per organization; consumers may retry
/// safely because MtmNotification is keyed back to this source row.
model MtmRouteNotificationOutbox {
  id             String                           @id @default(cuid())
  organizationId String
  organization   Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent                         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dedupeKey      String
  title          String
  body           String?
  type           String                           @default("info")
  metadata       Json?
  status         MtmRouteNotificationOutboxStatus @default(PENDING)
  attempts       Int                              @default(0)
  availableAt    DateTime                         @default(now())
  leaseToken     String?
  leaseUntil     DateTime?
  lastError      String?
  deliveredAt    DateTime?
  suppressedAt   DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  notification MtmNotification? @relation("MtmRouteNotificationOutboxDelivery")

  @@unique([organizationId, id], map: "mtm_route_notification_outbox_org_id_key")
  @@unique([organizationId, dedupeKey], map: "mtm_route_notification_outbox_org_dedupe_key")
  @@index([status, availableAt, leaseUntil], map: "mtm_route_notification_outbox_dispatch_idx")
  @@index([organizationId, status, createdAt], map: "mtm_route_notification_outbox_org_status_created_idx")
  @@index([agentId, createdAt], map: "mtm_route_notification_outbox_agent_created_idx")
  @@map("mtm_route_notification_outbox")
}

// MTM Audit Log — MTM-specific audit trail
model MtmAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          MtmAgent?    @relation(fields: [agentId], references: [id], onDelete: SetNull) // F-18: enable join for agent name in reports/activity
  action         String
  entity         String
  entityId       String?
  // F-29: discrete kind for indexed filtering. e.g. "force_checkin", "auto_link",
  // "login_failed", "settings_change". Lets queries like "show all force overrides
  // last month" use an index instead of JSON path scan on `newData`.
  metadataKind   String?
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([agentId])
  @@index([createdAt])
  @@index([organizationId, metadataKind])
  @@map("mtm_audit_logs")
}

// ─────────────────────────────────────────────────────
// MTM Offline Sync — idempotency log
// ─────────────────────────────────────────────────────

/// One record per client-generated operationId — prevents duplicate writes on retry.
model MtmSyncOperation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  /// Client-provided UUID; forms the idempotency key.
  operationId    String
  entity         String // "visits" | "tasks" | ...
  opType         String // "create" | "update" | "delete"
  /// 'ok' | 'conflict' | 'error'
  status         String
  /// C1 workday operations pin the canonical request digest as well as the
  /// response, so a changed payload cannot replay an earlier result.
  requestHash    String?      @db.VarChar(64)
  /// Full server result stored for replay on duplicate push.
  result         Json?
  processedAt    DateTime     @default(now())

  @@unique([organizationId, operationId])
  @@index([organizationId, agentId])
  @@map("mtm_sync_operations")
}

// ─────────────────────────────────────────────────────
// MTM Route Field mobile commands — durable idempotency receipts
// ─────────────────────────────────────────────────────

/// Immutable terminal receipts for the additive Route Field v1 command
/// endpoint.  This deliberately does not reuse `MtmSyncOperation`: the
/// command contract binds a canonical payload hash and an opaque device id,
/// while legacy sync operations remain protocol-v1 compatibility state.
model MtmMobileRouteCommandReceipt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The freshly authenticated mobile principal that first completed it.
  agentId        String
  /// Opaque installation identifier supplied by the Route Field APK.
  deviceId       String
  /// Client-persisted operation ID. It is unique within a tenant so an
  /// accidental cross-device reuse fails closed instead of leaking a replay.
  operationId    String
  command        String
  /// Route identity is retained only to reject mismatched replays; CREATE has
  /// no target route before it succeeds.
  targetRouteId  String?
  /// SHA-256 of the canonical command envelope, never of a raw request body.
  requestHash    String
  /// APPLIED | CONFLICT. Infrastructure errors are never written here.
  outcome        String
  responseStatus Int
  /// Minimal terminal response only; do not retain route points or raw input.
  result         Json
  createdAt      DateTime     @default(now())
  completedAt    DateTime     @default(now())
  expiresAt      DateTime

  @@unique([organizationId, operationId], map: "mtm_mobile_route_command_receipts_organizationId_op_key")
  @@index([organizationId, expiresAt, id], map: "mtm_mobile_route_command_receipts_tenant_expiry_idx")
  @@index([organizationId, agentId, deviceId, createdAt], map: "mtm_mobile_route_command_receipts_lookup_idx")
  @@map("mtm_mobile_route_command_receipts")
}

// ─────────────────────────────────────────────────────
// MTM Mobile Sync v2 — per-stream revisions and snapshots
// ─────────────────────────────────────────────────────

/// One monotonic sequence per tenant and stream. `revision` advances for every
/// change and `retentionFloorRevision` lets an expired client receive a
/// controlled resnapshot instead of silently missing a tombstone. Actor scope
/// has its own per-agent revision below, so a revoked assignment cannot force
/// unrelated Field devices to rebuild their route cache.
model MtmMobileSyncStream {
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stream                  String
  revision                BigInt       @default(0)
  retentionFloorRevision  BigInt       @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  changes   MtmMobileSyncChange[]
  snapshots MtmMobileSyncSnapshot[]
  agentScopes MtmMobileSyncAgentScope[]
  snapshotLeases MtmMobileSyncSnapshotLease[]

  @@id([organizationId, stream])
  @@index([organizationId, updatedAt])
  @@map("mtm_mobile_sync_streams")
}

/// Per-agent scope fence for a stream. Snapshot and delta cursors bind this
/// value, and membership-changing triggers advance it in the same business
/// transaction. It is deliberately not device-specific: revoking a route must
/// invalidate every registered device for that Field principal.
model MtmMobileSyncAgentScope {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stream         String
  streamState    MtmMobileSyncStream @relation(fields: [organizationId, stream], references: [organizationId, stream], onDelete: Cascade)
  agentId        String
  scopeRevision  BigInt       @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, stream, agentId])
  @@index([organizationId, stream, agentId, updatedAt])
  @@map("mtm_mobile_sync_agent_scopes")
}

/// Append-only route/stream change journal. The record deliberately contains
/// identity and tombstone metadata, not a full business payload: a later
/// projection can supersede this revision safely because the cursor remains
/// monotonic and a subsequent revision is replayed idempotently.
model MtmMobileSyncChange {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stream            String
  streamState       MtmMobileSyncStream @relation(fields: [organizationId, stream], references: [organizationId, stream], onDelete: Cascade)
  revision          BigInt
  changeType        String
  entityType        String
  entityId          String
  /// Every journal record is addressed to exactly one actor. This avoids a
  /// noisy tenant forcing unrelated Field devices to scan/drop global UPSERTs,
  /// and prevents IDs or removal reasons crossing an authorization boundary.
  audienceAgentId   String
  tombstoneReason   String?
  createdAt         DateTime            @default(now())
  expiresAt         DateTime

  @@unique([organizationId, stream, revision])
  @@index([organizationId, stream, audienceAgentId, revision])
  @@index([expiresAt])
  @@map("mtm_mobile_sync_changes")
}

/// A materialised, short-lived initial snapshot. It freezes the exact row set
/// at `boundaryRevision`, so concurrent writes cannot shift offset pages or
/// mutate a page that is still being downloaded.
model MtmMobileSyncSnapshot {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stream           String
  streamState      MtmMobileSyncStream @relation(fields: [organizationId, stream], references: [organizationId, stream], onDelete: Cascade)
  agentId          String
  deviceId         String
  boundaryRevision BigInt
  scopeRevision    BigInt
  /// Tenant-local horizon key prevents an old day-window snapshot from being
  /// reused as a new initial sync after the policy window rolls forward.
  horizonKey       String
  expiresAt        DateTime
  createdAt        DateTime            @default(now())

  items MtmMobileSyncSnapshotItem[]

  @@unique([organizationId, id])
  @@index([organizationId, stream, agentId, deviceId, horizonKey, expiresAt])
  @@index([expiresAt])
  @@map("mtm_mobile_sync_snapshots")
}

/// A short durable lease prevents duplicate snapshot builders for an exact
/// tenant/actor/device/horizon. It is acquired before the repeatable-read
/// materialisation transaction because RLS setup itself is a SQL statement and
/// must not establish a stale MVCC snapshot while waiting for a lock.
model MtmMobileSyncSnapshotLease {
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stream         String
  streamState    MtmMobileSyncStream   @relation(fields: [organizationId, stream], references: [organizationId, stream], onDelete: Cascade)
  agentId        String
  deviceId       String
  horizonKey     String
  leaseToken     String
  expiresAt      DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@id([organizationId, stream, agentId, deviceId, horizonKey])
  @@index([expiresAt])
  @@map("mtm_mobile_sync_snapshot_leases")
}

/// Immutable JSON projection for one initial-sync row. Snapshot repair may
/// delete this cache only after expiry; it never touches the mutation outbox.
model MtmMobileSyncSnapshotItem {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotId     String
  snapshot       MtmMobileSyncSnapshot @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)
  ordinal        Int
  entityType     String
  entityId       String
  payload        Json
  createdAt      DateTime              @default(now())

  @@unique([snapshotId, ordinal])
  @@unique([snapshotId, entityId])
  @@index([organizationId, snapshotId, ordinal])
  @@map("mtm_mobile_sync_snapshot_items")
}

/// Explicit server-side cohort fence. A new APK cannot opt itself into v2 by
/// merely sending a header: its authenticated agent and registered device must
/// be enabled for the named stream here.
model MtmMobileSyncCohort {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stream         String
  agentId        String
  deviceId       String
  enabled        Boolean      @default(false)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, stream, agentId, deviceId])
  @@index([organizationId, stream, enabled, expiresAt])
  @@map("mtm_mobile_sync_cohorts")
}

/// Global, opaque round-robin position for bounded v2 cache retention. This
/// state deliberately has no tenant foreign key: it is visible only to the
/// RLS-bypass maintenance path, never to a tenant request.
model MtmMobileSyncRetentionCursor {
  jobName            String   @id
  lastOrganizationId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("mtm_mobile_sync_retention_cursors")
}

// ═══════════════════════════════════════════════════
// SWM-09 — PHARMACY PROMOTION EXECUTION & POINTS
// ═══════════════════════════════════════════════════

/// Tenant-owned promotion type dictionary. Localized labels are stored at the
/// definition boundary so the registry and mobile execution use the same codes.
model MtmPharmacyPromotionType {
  id             String                        @id @default(cuid())
  organizationId String
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameRu         String
  nameAz         String
  nameEn         String
  description    String?
  status         MtmPharmacyDefinitionStatus   @default(DRAFT)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  promotionVersions MtmPharmacyPromotionVersion[]
  events            MtmPharmacyPromotionEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("mtm_pharmacy_promotion_types")
}

/// Stable campaign identity. Business definition changes are published as
/// immutable MtmPharmacyPromotionVersion rows.
model MtmPharmacyPromotion {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String
  createdByUserId String
  createdByUser   User         @relation("MtmPharmacyPromotionCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  versions MtmPharmacyPromotionVersion[]
  events   MtmPharmacyPromotionEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, archivedAt, createdAt])
  @@map("mtm_pharmacy_promotions")
}

/// Immutable once published. Formula, approval policy, eligibility, source,
/// localized copy, and period are pinned together for reproducible points.
model MtmPharmacyPromotionVersion {
  id                    String                              @id @default(cuid())
  organizationId        String
  organization          Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promotionId           String
  promotion             MtmPharmacyPromotion                @relation(fields: [organizationId, promotionId], references: [organizationId, id], onDelete: Restrict)
  revision              Int
  typeId                String
  type                  MtmPharmacyPromotionType            @relation(fields: [organizationId, typeId], references: [organizationId, id], onDelete: Restrict)
  nameRu                String
  nameAz                String
  nameEn                String
  descriptionRu         String?
  descriptionAz         String?
  descriptionEn         String?
  startsOn              DateTime                            @db.Date
  endsOn                DateTime                            @db.Date
  timezone              String                              @db.VarChar(100)
  formulaId             String
  formula               MtmPharmacyPointsFormula            @relation("MtmPharmacyVersionFormula", fields: [organizationId, formulaId], references: [organizationId, id], onDelete: Restrict)
  approvalPolicyId      String
  approvalPolicy        MtmPharmacyApprovalPolicy           @relation("MtmPharmacyVersionApprovalPolicy", fields: [organizationId, approvalPolicyId], references: [organizationId, id], onDelete: Restrict)
  eligibilityDefinition Json                                @default("{}")
  eligibilityDefinitionHash String                          @db.VarChar(64)
  definitionHash        String                              @db.VarChar(64)
  approvalReference     String?
  eligibilityApprovalReference String?
  eligibilityApprovedByUserId String?
  eligibilityApprovedByUser User?                           @relation("MtmPharmacyEligibilityApprovedBy", fields: [organizationId, eligibilityApprovedByUserId], references: [organizationId, id], onDelete: Restrict)
  eligibilityApprovedAt DateTime?
  sourceSystem          String
  sourceReference       String?
  sourceObservedAt      DateTime
  sourceReceivedAt      DateTime                            @default(now())
  status                MtmPharmacyPromotionVersionStatus   @default(DRAFT)
  createdByUserId       String
  createdByUser         User                                @relation("MtmPharmacyVersionCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  publishedByUserId     String?
  publishedByUser       User?                               @relation("MtmPharmacyVersionPublishedBy", fields: [organizationId, publishedByUserId], references: [organizationId, id], onDelete: Restrict)
  publishedAt           DateTime?
  retiredAt             DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt

  targets MtmPharmacyPromotionTarget[]
  events  MtmPharmacyPromotionEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, promotionId, revision])
  @@index([organizationId, status, startsOn, endsOn])
  @@index([organizationId, typeId, status])
  @@index([organizationId, formulaId])
  @@index([organizationId, approvalPolicyId])
  @@map("mtm_pharmacy_promotion_versions")
}

/// Server-executed points formula. ACTIVE rows require an explicit signature;
/// callers submit facts, never final points.
model MtmPharmacyPointsFormula {
  id               String                        @id @default(cuid())
  organizationId   String
  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  version          Int
  nameRu           String
  nameAz           String
  nameEn           String
  schemaVersion    Int                           @default(1)
  definition       Json
  definitionHash   String                        @db.VarChar(64)
  approvalReference String?
  sourceSystem     String
  sourceReference  String?
  sourceObservedAt DateTime
  sourceReceivedAt DateTime                      @default(now())
  status           MtmPharmacyDefinitionStatus   @default(DRAFT)
  createdByUserId  String
  createdByUser    User                          @relation("MtmPharmacyFormulaCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  signedByUserId   String?
  signedByUser     User?                         @relation("MtmPharmacyFormulaSignedBy", fields: [organizationId, signedByUserId], references: [organizationId, id], onDelete: Restrict)
  signedAt         DateTime?
  activatedAt      DateTime?
  retiredAt        DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  promotionVersions MtmPharmacyPromotionVersion[]  @relation("MtmPharmacyVersionFormula")
  executions        MtmPharmacyPromotionExecution[] @relation("MtmPharmacyExecutionFormula")
  reviews           MtmPharmacyPromotionReview[]    @relation("MtmPharmacyReviewFormula")
  ledgerEntries     MtmPharmacyPointsLedgerEntry[]  @relation("MtmPharmacyLedgerFormula")
  events            MtmPharmacyPromotionEvent[]     @relation("MtmPharmacyEventFormula")

  @@unique([organizationId, id])
  @@unique([organizationId, code, version])
  @@index([organizationId, status, code])
  @@map("mtm_pharmacy_points_formulas")
}

/// Signed, versioned L1/L2 policy. Scope is evaluated by the server against
/// current ownership; the pinned policy snapshot remains auditable.
model MtmPharmacyApprovalPolicy {
  id                String                        @id @default(cuid())
  organizationId    String
  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  version           Int
  name              String
  l1Roles           Json                          @default("[]")
  l2Roles           Json                          @default("[]")
  l1Scope           Json                          @default("{}")
  l2Scope           Json                          @default("{}")
  definition        Json                          @default("{}")
  allowSelfApproval Boolean                       @default(false)
  requireDistinctReviewers Boolean                @default(true)
  requireRejectReason Boolean                     @default(true)
  requireReturnReason Boolean                     @default(true)
  definitionHash    String                        @db.VarChar(64)
  approvalReference String?
  sourceSystem      String
  sourceReference   String?
  sourceObservedAt  DateTime
  sourceReceivedAt  DateTime                      @default(now())
  status            MtmPharmacyDefinitionStatus   @default(DRAFT)
  createdByUserId   String
  createdByUser     User                          @relation("MtmPharmacyPolicyCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  signedByUserId    String?
  signedByUser      User?                         @relation("MtmPharmacyPolicySignedBy", fields: [organizationId, signedByUserId], references: [organizationId, id], onDelete: Restrict)
  signedAt          DateTime?
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  promotionVersions MtmPharmacyPromotionVersion[]  @relation("MtmPharmacyVersionApprovalPolicy")
  executions        MtmPharmacyPromotionExecution[] @relation("MtmPharmacyExecutionApprovalPolicy")
  reviews           MtmPharmacyPromotionReview[]    @relation("MtmPharmacyReviewApprovalPolicy")
  events            MtmPharmacyPromotionEvent[]     @relation("MtmPharmacyEventApprovalPolicy")

  @@unique([organizationId, id])
  @@unique([organizationId, code, version])
  @@index([organizationId, status, code])
  @@map("mtm_pharmacy_approval_policies")
}

/// Planned pharmacy/agent assignment. Ownership and display snapshots are
/// retained when teams or managers later change.
model MtmPharmacyPromotionTarget {
  id                       String                          @id @default(cuid())
  organizationId           String
  organization             Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promotionVersionId       String
  promotionVersion         MtmPharmacyPromotionVersion     @relation(fields: [organizationId, promotionVersionId], references: [organizationId, id], onDelete: Restrict)
  customerId               String
  customer                 MtmCustomer                     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  contactId                String?
  contact                  MtmContact?                     @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  assignedAgentId          String
  assignedAgent            MtmAgent                        @relation("MtmPharmacyTargetAgent", fields: [organizationId, assignedAgentId], references: [organizationId, id], onDelete: Restrict)
  assignedTeamId           String?
  assignedTeam             MtmTeam?                        @relation("MtmPharmacyTargetTeam", fields: [organizationId, assignedTeamId], references: [organizationId, id], onDelete: Restrict)
  managingManagerId        String?
  managingManager          MtmAgent?                       @relation("MtmPharmacyTargetManager", fields: [organizationId, managingManagerId], references: [organizationId, id], onDelete: Restrict)
  planQuantity             Decimal                         @default(0) @db.Decimal(18, 4)
  unit                     String
  status                   MtmPharmacyTargetStatus         @default(PLANNED)
  eligibilityStatus        MtmPharmacyEligibilityStatus    @default(PENDING)
  eligibilitySnapshot      Json                            @default("{}")
  eligibilityOverrideReason String?
  customerCodeSnapshot     String?
  customerNameSnapshot     String
  customerAddressSnapshot  String?
  customerRegistrationSnapshot String?
  agentNameSnapshot        String
  teamNameSnapshot         String?
  managerNameSnapshot      String?
  sourceSystem             String
  sourceReference          String?
  sourceObservedAt         DateTime
  sourceReceivedAt         DateTime                        @default(now())
  connectedAt              DateTime?
  closedAt                 DateTime?
  cancelledAt              DateTime?
  createdByUserId          String
  createdByUser            User                            @relation("MtmPharmacyTargetCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  executions   MtmPharmacyPromotionExecution[]
  events       MtmPharmacyPromotionEvent[]
  ledgerEntries MtmPharmacyPointsLedgerEntry[]
  rewardClaims MtmPharmacyRewardClaim[]

  @@unique([organizationId, id])
  @@unique([organizationId, promotionVersionId, customerId, assignedAgentId])
  @@index([organizationId, assignedAgentId, status, createdAt])
  @@index([organizationId, assignedTeamId, status, createdAt])
  @@index([organizationId, managingManagerId, status, createdAt])
  @@index([organizationId, customerId, status])
  @@index([organizationId, promotionVersionId, status])
  @@index([organizationId, connectedAt])
  @@index([organizationId, closedAt])
  @@map("mtm_pharmacy_promotion_targets")
}

/// Submitted fact and deterministic calculation snapshot. Returned work is
/// corrected by a successor row rather than mutating the reviewed fact.
model MtmPharmacyPromotionExecution {
  id                       String                         @id @default(cuid())
  organizationId           String
  organization             Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetId                 String
  target                   MtmPharmacyPromotionTarget     @relation(fields: [organizationId, targetId], references: [organizationId, id], onDelete: Restrict)
  visitId                  String?
  visit                    MtmVisit?                      @relation(fields: [organizationId, visitId], references: [organizationId, id], onDelete: Restrict)
  agentId                  String
  agent                    MtmAgent                       @relation("MtmPharmacyExecutionAgent", fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict)
  submittedByAgentId       String?
