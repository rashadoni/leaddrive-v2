model PlanTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  features    String[] @default([])
  addons      String[] @default([])
  maxUsers    Int      @default(3)
  maxContacts Int      @default(500)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("plan_templates")
}

model PlanRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedPlan  String
  contactName    String
  contactEmail   String
  contactPhone   String?
  message        String?
  status         String       @default("pending") // pending, approved, rejected
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("plan_requests")
}

model User {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email             String
  name              String
  passwordHash      String
  role              String       @default("viewer") // admin, manager, sales, support, viewer
  /// Voice control of the CRM. Set by an admin through /api/v1/users/[id],
  /// never by the user themselves: a self-service flag would let any member
  /// grant themselves a surface that reads the whole organisation aloud.
  /// Org-level entitlement (the `ai` module) and the role gate still apply on
  /// top — this only says WHICH of the eligible people were switched on.
  voiceEnabled      Boolean      @default(false)
  avatar            String?
  phone             String?
  department        String?
  totpSecret        String?
  totpEnabled       Boolean      @default(false)
  smsAuthEnabled    Boolean      @default(false) // SMS 2FA flag — when true, login requires SMS code after password
  verifiedPhone     String? // E.164 phone number verified via sms-otp flow
  require2fa        Boolean      @default(false)
  backupCodes       Json         @default("[]")
  calendarToken     String?      @unique
  twoFactorNonce    String? // Server-side nonce for secure 2FA session update
  passwordChangedAt DateTime? // Track password changes for session invalidation
  resetToken        String?
  resetTokenExp     DateTime?
  lastLogin         DateTime?
  loginCount        Int          @default(0)
  isActive          Boolean      @default(true)

  /// Надгробие. Пользователя нельзя удалить физически: на него ссылаются
  /// журналы соответствия, снимки прогнозов и переходы этапов сделок —
  /// таблицы под триггером «только добавление», которые невозможно обновить.
  /// Раньше это давало тупик: `prisma.user.delete()` пытался проставить NULL
  /// в `forecast_snapshots.capturedBy` (onDelete: SetNull), триггер отвергал
  /// UPDATE, и админ видел «Internal server error» без объяснений.
  ///
  /// Вместо удаления строка остаётся, `id` живёт, а персональные данные
  /// затираются. Журналы продолжают указывать на конкретного субъекта —
  /// в них ценно именно «кто», ради этого они и ведутся, — а требование на
  /// стирание персональных данных выполняется затиранием ФИО и контактов.
  /// Это псевдонимизация, а не необратимая анонимность: `id` сохраняется.
  ///
  /// Отличается от `isActive: false`: деактивированного можно вернуть,
  /// обезличенного — нет, восстанавливать уже нечего.
  anonymizedAt      DateTime?
  skills            String[]     @default([])
  maxTickets        Int          @default(20)
  isAvailable       Boolean      @default(true)
  preferredLanguage String? // "ru" | "en" | "az" — null = use org default
  timezone          String? // IANA timezone name (e.g. "Europe/Warsaw") — null = fall back to org default or server UTC. P5 Phase 1.
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  budgetDeptOwnership  BudgetDepartmentOwner[]
  mtmAgents            MtmAgent[]
