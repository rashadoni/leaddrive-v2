// --- Task 1: Field-Level Permissions + Sharing Rules ---

model FieldPermission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String // "admin", "manager", "sales", "support", "viewer", or custom role ID
  entityType     String // "company", "contact", "deal", "lead", "ticket"
  fieldName      String // "phone", "email", "revenue", etc.
  access         String // "visible" | "editable" | "hidden"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, roleId, entityType, fieldName])
  @@index([organizationId, roleId, entityType])
  @@map("field_permissions")
}

model SharingRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // "deal", "lead", "company", "contact"
  name           String
  description    String?
  ruleType       String // "owner" | "role" | "team" | "all"
  sourceRole     String? // Role whose records are shared
  targetRole     String? // Role who gets access
  accessLevel    String // "read" | "readwrite"
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType])
  @@map("sharing_rules")
}

// --- Task 3: Multi-Agent Orchestration ---

model AgentHandoff {
  id             String    @id @default(cuid())
  organizationId String
  sessionId      String // AI session ID
  fromAgentId    String // AiAgentConfig ID
  toAgentId      String // AiAgentConfig ID
  reason         String
  context        Json // Conversation summary for target agent
  status         String    @default("pending") // pending, accepted, completed
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, sessionId])
  @@map("agent_handoffs")
}

// H1: Agent framework — per-task stateful execution of an AI agent.
// Each AgentSession threads through one user goal; AgentStep records
// the planning-loop trace (observation → thought → action → result).
// Distinct from AiChatSession (per-conversation chat-bot session) and
// AiAgentConfig (static agent definition).
model AgentSession {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * FK to AiAgentConfig.id — which agent definition powers this session.
   */
  agentConfigId  String
  agentConfig    AiAgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Restrict)
  /**
   * Display name of the agent at session creation (denormalised for trace stability).
   */
  agentName      String
  /**
   * Free-form description of what the user asked the agent to do.
   */
  goal           String
  /**
   * "planning" → "executing" → "waiting_input" → "completed" | "failed" | "cancelled"
   */
  status         String        @default("planning")
  /**
   * Optional contact/deal/ticket the session is bound to (for audit + UI).
   */
  contextType    String? // "deal" | "lead" | "contact" | "ticket" | "task" | null
  contextId      String?
  /**
   * Final outcome message — set when status = completed | failed | cancelled.
   */
  result         String?
  /**
   * Number of planning iterations elapsed. Caps at agent's maxSteps.
   */
  stepCount      Int           @default(0)
  /**
   * Hard cap on iterations — prevents runaway loops.
   */
  maxSteps       Int           @default(20)
  /**
   * Optional cost ceiling in USD; engine aborts if exceeded.
   */
  budgetUsd      Float?
  /**
   * Cumulative spend so far (sum of `costUsd` across this session's steps).
   */
  costSoFarUsd   Float         @default(0)
  /**
   * User who initiated the session.
   */
  initiatedBy    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  steps AgentStep[]

  @@index([organizationId, status])
  @@index([agentConfigId])
  @@map("agent_sessions")
}

// One iteration of an AgentSession's planning loop. The Atlas-reasoning-
// engine analogue (slice 2 wires actual Claude calls; slice 1 ships the
// trace schema + transitions only).
model AgentStep {
  id           String       @id @default(cuid())
  sessionId    String
  session      AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /**
   * Monotonic 0-indexed step within session.
   */
  stepIndex    Int
  /**
   * "observe" gathers context; "think" plans next action; "act" calls a tool; "respond" returns to user.
   */
  kind         String
  /**
   * What the agent saw / decided / did — free-form for slice 1.
   */
  observation  String?
  thought      String?
  action       String?
  /**
   * Tool name if `kind = "act"`.
   */
  toolName     String?
  /**
   * Tool input + result as JSON for replay/audit.
   */
  toolInput    Json?
  toolOutput   Json?
  /**
   * "ok" | "error" | "deferred" — step-level outcome.
   */
  outcome      String       @default("ok")
  errorMessage String?
  /**
   * LLM cost for this step in USD.
   */
  costUsd      Float?
  /**
   * LLM latency in ms.
   */
  latencyMs    Int?
  createdAt    DateTime     @default(now())

  @@unique([sessionId, stepIndex])
  @@index([sessionId])
  @@map("agent_steps")
}

// H3: Einstein Prediction Builder — no-code AutoML on org records.
// Per-tenant trained models bound to one object type (deal/lead/ticket)
// predicting a binary outcome (won/lost, qualified/disqualified, etc.).
// Slice 1 ships an in-process logistic-regression baseline; slice 2 swaps
// the trainer for a Python sidecar without touching the schema.
model PredictionModel {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Display name shown in the prediction-builder UI.
   */
  name              String
  /**
   * Optional human description.
   */
  description       String?
  /**
   * Object the model predicts on: "deal" | "lead" | "ticket". Slice 1 wires "deal".
   */
  objectType        String
  /**
   * Field whose values are bucketed into binary outcome (e.g. "stage" → won/lost).
   */
  targetField       String
  /**
   * Set of `targetField` values that count as the positive class.
   */
  positiveValues    String[]
  /**
   * Feature spec — array of input field configs.
   * `[{ field: "amount", kind: "numeric" }, { field: "source", kind: "categorical", oneHotValues: ["web","referral"] }]`
   */
  inputFields       Json
  /**
   * "draft" → "training" → "trained" → "failed" lifecycle.
   */
  status            String       @default("draft")
  /**
   * When the current training run started. Set when status flips to
   * "training", cleared when it leaves. Enables a stale-lock sweeper
   * (cron in slice 2) to recover models stuck in "training" after a
   * route crash or timeout: any row with `status='training'` AND
   * `trainingStartedAt < now() - N min` is eligible for reset.
   */
  trainingStartedAt DateTime?
  /**
   * Trained artifact:
   * { algorithm: "logreg-v1", featureNames: string[], weights: number[],
   * bias: number, sampleCount: number, positiveCount: number,
   * accuracy: number, trainedAt: string }
   * Null until the first successful train run.
   */
  artifact          Json?
  /**
   * Denormalised last-known accuracy (0..1) for cheap listing without
   * parsing artifact. Slice 1: this is *training-set* accuracy and is
   * overfitting-prone — slice 2 introduces a holdout/test split and
   * surfaces a separate `testAccuracy`. UI must label this honestly.
   */
  accuracy          Float?
  /**
   * When the artifact was last produced.
   */
  trainedAt         DateTime?
  /**
   * User who created the definition.
   */
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  runs PredictionRun[]

  @@index([organizationId, objectType])
  @@map("prediction_models")
}

// One scored prediction for one record under one model. Append-only —
// the UI charts score history per record, so we never update in place.
//
// Retention caveat: slice 3 will introduce auto-scoring cron (every
// Deal × every active model nightly). At ~10k deals × 5 models × 365
// days this table reaches 18M rows/year/tenant. Add a retention cap
// (e.g. last-30-days + daily aggregates) or partition before enabling
// the cron.
model PredictionRun {
  id             String          @id @default(cuid())
  modelId        String
  model          PredictionModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Same vocabulary as `PredictionModel.objectType`.
   */
  recordType     String
  /**
   * ID of the scored record (Deal.id / Lead.id / Ticket.id).
   */
  recordId       String
  /**
   * Probability of the positive class in [0, 1].
   */
  score          Float
  /**
   * Confidence band derived from `score`:
   * ≥0.8 very_likely, ≥0.6 likely, ≥0.4 uncertain, ≥0.2 unlikely, else very_unlikely.
   */
  band           String
  predictedAt    DateTime        @default(now())

  @@index([modelId, recordType, recordId])
  @@index([organizationId, recordType, recordId])
  @@map("prediction_runs")
}

// H13: Einstein Semantic Search — cross-record embedding store.
// One row per (org, recordType, recordId) tuple. `embedding` is stored
// as a Float[] array for slice 1 (JS-side cosine similarity on the
// fetched candidate set); slice 2 migrates to pgvector for native
// kNN ops at scale. `contentHash` lets the re-index path skip rows
// whose source text hasn't changed since the last embed.
//
// Note: `KbEmbedding` (used by the legacy KB-search path) stays —
// it's already on pgvector. New record types (Deal/Contact/Company/
// Ticket) write here. Slice 2 unifies the two stores.
model RecordEmbedding {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * "deal" | "contact" | "company" | "ticket" | "kb_article" — checked at write time.
   */
  recordType       String
  /**
   * ID of the source record (Deal.id / Contact.id / ...).
   */
  recordId         String
  /**
   * Concatenated searchable text that was embedded (stored for re-index audit + change detection).
   */
  content          String
  /**
   * SHA-256 hex of `content` — re-index path skips rows whose hash is unchanged.
   */
  contentHash      String
  /**
   * Slice 1: Float[] for JS cosine; slice 2: pgvector.
   */
  embedding        Float[]
  /**
   * Embedding model identifier (e.g. "voyage-3-lite" or slice-1 deterministic fallback).
   */
  embeddingModel   String
  /**
   * Schema version of the embedding — bumped if dim/normalisation changes.
   */
  embeddingVersion Int          @default(1)
  embeddedAt       DateTime     @default(now())

  @@unique([organizationId, recordType, recordId])
  @@index([organizationId, recordType])
  // Truncation path on /api/v1/search/semantic orders by embeddedAt
  // desc — index prevents sort-on-disk at >5k rows per tenant.
  @@index([organizationId, embeddedAt])
  @@map("record_embeddings")
}

// N6: Rollup Summary fields — Salesforce-style aggregations on a parent
// entity from its children (count of Deals per Company, sum of invoice
// values per Deal, etc.). Slice 1 ships the definition + manual recompute
// engine; slice 2 wires child-mutation triggers via Prisma middleware so
// values update incrementally.
//
// `RollupField` holds the spec (one row per defined rollup).
// `RollupValue` holds the per-parent computed result (one row per
// (rollupField, parentId) tuple — upserted on each recompute).
model RollupField {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Technical name — unique per (org, parentEntity). E.g. "open_deal_count".
   */
  name           String
  /**
   * Human-readable label for the UI.
   */
  label          String
  /**
   * EntityKey of the parent (the entity whose record gets the rollup
   * value). Must match the schema-builder ENTITY_REGISTRY.
   */
  parentEntity   String
  /**
   * EntityKey of the child entity to aggregate.
   */
  childEntity    String
  /**
   * "count" | "sum" | "avg" | "min" | "max".
   */
  aggregate      String
  /**
   * Numeric field on the child to aggregate. Required for sum/avg/min/max;
   * ignored for count.
   */
  aggregateField String?
  /**
   * FK field name on the child that points to the parent record
   * (e.g. "companyId" on Deal when parentEntity = "company").
   */
  parentKey      String
  /**
   * Optional JSON filter spec. Slice 1: array of {field, op, value}
   * predicates AND-joined. Slice 2 widens to nested expressions.
   * Null = no filter (all children counted).
   */
  filterJson     Json?
  isActive       Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  values RollupValue[]

  @@unique([organizationId, parentEntity, name])
  @@index([organizationId, parentEntity])
  @@map("rollup_fields")
}

// One computed rollup value per (definition, parent record) tuple.
// Slice 1 writes a numeric scalar; slice 2 may extend to date / string
// aggregates (e.g. "earliest start date"). `null` numericValue means
// the rollup was computed but no children matched (distinguishes from
// "never computed" — that row would be missing entirely).
model RollupValue {
  id             String       @id @default(cuid())
  rollupFieldId  String
  rollupField    RollupField  @relation(fields: [rollupFieldId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * ID of the parent record this rollup is computed for.
   */
  parentId       String
  /**
   * Numeric aggregate result; null when no children matched.
   */
  numericValue   Float?
  /**
   * Number of child rows that contributed (audit + drift detection).
   */
  childCount     Int          @default(0)
  computedAt     DateTime     @default(now())

  @@unique([rollupFieldId, parentId])
  @@index([organizationId, rollupFieldId])
  @@map("rollup_values")
}

// N3: Apex-equivalent per-tenant code modules. Salesforce Apex analogue
// — tenant writes JS in a UI editor, system compiles + runs in an
// isolated sandbox with a curated `crm.*` API surface and hard CPU/
// memory/time limits.
//
// Slice 1 ships manual-trigger execution via Node's `vm` module
// (frozen globals + timeout-bounded `runInContext`). Slice 2 swaps the
// executor for `isolated-vm` (true V8-isolate boundary) + adds
// record-event / cron triggers + a npm-import allowlist.
model CodeModule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Unique slug per tenant — used in trigger config + API paths.
   */
  name           String
  description    String?
  /**
   * Source code as text. Slice 1: single-file JS exporting `handler`.
   */
  source         String
  /**
   * SHA-256 hex of source — cache key for compiled vm.Script.
   */
  sourceHash     String
  /**
   * "manual" → invoked via POST /[id]/execute (slice 1)
   * "record_created" / "record_updated" → slice 2 trigger system
   * "cron" → slice 2 scheduled execution
   */
  triggerType    String       @default("manual")
  /**
   * Shape depends on triggerType:
   * manual          → {}
   * record_created  → { entity: "deal" | "contact" | ... }
   * record_updated  → { entity: "...", fields?: string[] }
   * cron            → { expression: "0 9 * * MON" }
   */
  triggerConfig  Json         @default("{}")
  isActive       Boolean      @default(true)
  /**
   * Per-execution wall-clock cap. Hard-capped at 30s by the engine.
   */
  timeoutMs      Int          @default(3000)
  /**
   * Truncate console output beyond this many lines.
   */
  maxLogLines    Int          @default(500)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  executions CodeExecution[]

  @@unique([organizationId, name])
  @@index([organizationId, triggerType])
  @@map("code_modules")
}

// Append-only execution log. Slice 1: written by the manual-execute
// route. Slice 2 trigger system writes here too. UI surfaces this as
// the "Module Runs" history panel.
model CodeExecution {
  id             String       @id @default(cuid())
  moduleId       String
  module         CodeModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * "ok" | "error" | "timeout" | "rejected" — outcome of the run.
   */
  outcome        String
  /**
   * Captured console output (truncated at `module.maxLogLines`).
   */
  output         String
  /**
   * Error message + stack frame trace if outcome != ok.
   */
  errorMessage   String?
  /**
   * JSON-stringified return value from the module's handler.
   */
  result         String?
  /**
   * Wall-clock duration in ms.
   */
  durationMs     Int
  startedAt      DateTime
  finishedAt     DateTime

  @@index([moduleId, startedAt])
  @@index([organizationId, startedAt])
  @@map("code_executions")
}

// N17: Named Credentials — Salesforce-style credential vault. Per-org
// secrets (API keys, OAuth bearers, basic-auth creds) stored
// encrypted at rest via AES-256-GCM; the plaintext only ever exists
// in memory for the duration of an outbound request.
//
// Slice 1 ships the schema + crypto wrapper + manual outbound HTTP
// (callExternalService). Slice 2 wires OpenAPI-spec auto-generation
// + the N3 sandbox `crm.http.<credName>.get(path)` surface + an
// oauth token-refresh path.
model NamedCredential {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Unique slug per tenant — referenced by Flow Builder + Apex modules.
   */
  name              String
  description       String?
  /**
   * Outbound base URL. Must be https for slice 1.
   */
  baseUrl           String
  /**
   * Auth scheme:
   * bearer         → Authorization: Bearer <secret>
   * basic          → Authorization: Basic base64(secret) — caller stores "user:pass"
   * api_key_header → custom header (config.headerName) carrying <secret> verbatim
   * none           → no auth header (still useful for baseUrl indirection)
   */
  authType          String       @default("bearer")
  /**
   * Per-authType config. Shape:
   * bearer / basic → {}
   * api_key_header → { headerName: string }
   * none           → {}
   */
  authConfig        Json         @default("{}")
  /**
   * AES-256-GCM ciphertext of the secret payload. Stored as base64
   * for portability across pg client drivers. Null for `authType: none`.
   */
  secretCiphertext  String?
  /**
   * 12-byte IV per encryption (base64). Mandatory when ciphertext set.
   */
  secretIv          String?
  /**
   * GCM auth tag (base64, 16 bytes). Mandatory when ciphertext set.
   */
  secretTag         String?
  /**
   * Algorithm marker for crypto-migration safety.
   */
  secretAlg         String?
  /**
   * "ok" | "failed" | "untested" — last result of POST /[id]/test.
   */
  testStatus        String       @default("untested")
  testStatusMessage String?
  testedAt          DateTime?
  isActive          Boolean      @default(true)
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("named_credentials")
}

// N14: Platform Events — Salesforce-style event-driven architecture.
// Tenant defines named event types with a typed field schema;
// publishers post payloads validated against that schema; subscribers
// receive them via the pub/sub bus.
//
// Slice 1 ships in-memory bus + durable event log (definitions +
// payloads persisted). Slice 2 adds Redis Streams for cross-process
// fan-out, the Prisma CDC middleware (auto-publish on record events),
// and a WebSocket subscriber endpoint.
model PlatformEventDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Unique slug per tenant. Drives the topic name + Apex/Flow reference.
   */
  name           String
  description    String?
  /**
   * Typed field schema as JSON:
   * [{ name: "amount", type: "number", required: true },
   * { name: "currency", type: "string", required: true, maxLength: 8 },
   * { name: "metadata", type: "json", required: false }]
   */
  fields         Json
  isActive       Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events PlatformEventLog[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("platform_event_definitions")
}

// Append-only event log. Every publish writes one row regardless of
// the in-memory bus state — durable replay + slice-2 CDC consumer
// can resume from `id` ordering. The actual stream delivery is the
// in-memory bus's job; this is the on-disk truth.
model PlatformEventLog {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * FK to the definition that vouched for this payload's shape.
   */
  definitionId   String
  definition     PlatformEventDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  /**
   * Denormalised event name for index-only scans.
   */
  eventName      String
  /**
   * Validated payload — shape matches the definition's `fields`.
   */
  payload        Json
  /**
   * Origin tag for audit + slice-2 routing:
   * manual         → user/API publish (slice 1 default)
   * cdc            → record-event trigger (slice 2)
   * apex           → emitted from a code module (slice 2)
   * workflow       → emitted from a flow step (slice 2)
   */
  origin         String                  @default("manual")
  /**
   * User or API key that initiated the publish, if known.
   */
  publishedBy    String?
  publishedAt    DateTime                @default(now())

  @@index([organizationId, publishedAt])
  @@index([organizationId, eventName, publishedAt])
  @@index([definitionId, publishedAt])
  @@map("platform_event_logs")
}

// L1/L2: App marketplace — Salesforce AppExchange analogue. Apps live
// globally (shared across all orgs) and are *installed* per-tenant
// via `AppInstallation`. The manifest declares the side-effects the
// install plan applies (custom fields, webhook subscriptions, event
// subscriptions, settings keys).
//
// Slice 1 ships schema + manifest parser + a static first-party
// catalog seed. Slice 2 wires the actual side-effect execution
// (creating CustomField rows, registering Webhook subscriptions,
// linking PlatformEvent definitions) and ships the marketplace UI.
model App {
  id           String   @id @default(cuid())
  /**
   * Slug — unique globally.
   */
  slug         String   @unique
  /**
   * Display name.
   */
  name         String
  /**
   * SemVer-style version of the manifest.
   */
  version      String
  /**
   * Short description for the catalog tile.
   */
  summary      String?
  /**
   * Vendor name (first-party = "LeadDrive Inc").
   */
  vendor       String
  /**
   * Manifest JSON — typed shape parsed by `parseManifest`:
   * { capabilities: { customFields[], webhookSubscriptions[],
   * eventSubscriptions[], settingsKeys[] },
   * requirements: { namedCredentialNames?, modules? } }
   */
  manifest     Json
  /**
   * Curated by us vs published by a third-party vendor.
   */
  isFirstParty Boolean  @default(false)
  /**
   * Surface in the public catalog (vs private/beta).
   */
  isPublic     Boolean  @default(true)
  /**
   * Free-form catalog tag — "Sales", "Service", "Integrations", etc.
   */
  category     String?
  /**
   * Icon / logo URL displayed in the catalog UI.
   */
  iconUrl      String?
  /**
   * Documentation URL — slice 2 surfaces in the tile.
   */
  docsUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  installations AppInstallation[]

  @@index([category, isPublic])
  @@map("apps")
}

// Per-org install record. One row per (org, app) pair — an org cannot
// install the same app twice (use the config to vary behaviour). The
// `config` JSON carries the install-time parameter answers declared
// by the manifest's settingsKeys.
model AppInstallation {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appId            String
  app              App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  /**
   * Version installed — pins so a catalog-level version bump doesn't
   * silently mutate an installed tenant's behaviour.
   */
  installedVersion String
  /**
   * Tenant-provided settings values, keyed by manifest.settingsKeys.
   */
  config           Json         @default("{}")
  /**
   * "active" | "disabled" — soft-disable without uninstalling.
   */
  status           String       @default("active")
  installedBy      String
  installedAt      DateTime     @default(now())
  /**
   * Audit: last-modified time of `config` or `status`.
   */
  updatedAt        DateTime     @updatedAt
  /**
   * Set on uninstall — slice 2 keeps the row for audit + cleanup
   * reconciliation; this slice just deletes outright.
   */
  uninstalledAt    DateTime?

  @@unique([organizationId, appId])
  @@index([organizationId])
  @@index([appId])
  @@map("app_installations")
}

// R4: Consumer Goods Cloud — TPM (Trade Promotion Management) +
// Retail Execution layered on top of MTM. Adds:
//   - TradePromotion: a planned promotion campaign with budget + KPIs
//   - PromotionTactic: a specific tactic within a promotion (discount /
//     display / sample / coupon) with expected uplift
//   - TradeSpend: actual spend logged against a tactic at a customer
//     site — feeds ROI calculation
//   - RetailExecutionAudit: per-visit planogram-compliance / on-shelf-
//     availability / share-of-shelf scoring (extends MtmVisit)
//
// Slice 1 ships the schema + pure helpers (uplift / planogram scorer
// / ROI roll-up) + CRUD routes. Slice 2 wires KPI rollup crons +
// dashboards.
model TradePromotion {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Human name. Unique per tenant.
   */
  name                String
  description         String?
  /**
   * "planned" | "active" | "completed" | "cancelled".
   */
  status              String       @default("planned")
  /**
   * Period the promotion runs.
   */
  startsAt            DateTime
  endsAt              DateTime
  /**
   * SKU/product list the promotion covers.
   */
  productSkus         String[]
  /**
   * Channel / customer segment — "modern_trade", "horeca", etc.
   */
  channelType         String?
  /**
   * Total budget for the campaign.
   */
  budgetAmount        Float        @default(0)
  budgetCurrency      String       @default("USD")
  /**
   * Optional KPI target — expected total sales uplift in same currency.
   */
  upliftTargetAmount  Float?
  /**
   * Optional baseline sales for ROI math — caller supplies pre-promo period sum.
   */
  baselineSalesAmount Float?
  createdBy           String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tactics PromotionTactic[]
  spends  TradeSpend[]
  audits  RetailExecutionAudit[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, startsAt, endsAt])
  @@map("trade_promotions")
}

// One tactic within a TradePromotion. Multiple tactics per promotion
// — e.g. a "Summer drink push" could have a 10% discount + endcap
// display + sample distribution. ROI roll-up sums spends by tactic.
model PromotionTactic {
  id                    String         @id @default(cuid())
  promotionId           String
  promotion             TradePromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  /**
   * "discount" | "display" | "sample" | "coupon" | "bundle".
   */
  kind                  String
  /**
   * Configuration JSON — shape varies by `kind`.
   */
  parameters            Json           @default("{}")
  /**
   * Caller-supplied expected uplift coefficient (e.g. 0.15 = 15%).
   */
  expectedUpliftPct     Float?
  /**
   * Allocated portion of the parent promotion's budget.
   */
  allocatedBudgetAmount Float          @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  spends TradeSpend[]

  @@index([promotionId])
  @@map("promotion_tactics")
}

// Actual spend logged against a tactic at a customer site. Slice 1:
// caller posts (tactic, customer, amount, currency, recordedAt). ROI
// roll-up is a pure function over these rows + the promotion's
// baseline.
model TradeSpend {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promotionId           String
  promotion             TradePromotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  tacticId              String
  tactic                PromotionTactic @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  /**
   * Optional — which MTM customer / retailer the spend is logged for.
   */
  customerId            String?
  amount                Float
  currency              String          @default("USD")
  /**
   * Optional — actual sales attributed during this spend window.
   */
  attributedSalesAmount Float?
  notes                 String?
  recordedBy            String?
  recordedAt            DateTime        @default(now())

  @@index([organizationId, promotionId])
  @@index([tacticId])
  @@index([recordedAt])
  @@map("trade_spends")
}

// Retail-execution audit attached to an MTM visit. Captures the
// planogram-compliance / OSA / share-of-shelf measurements an agent
// records at the store. The score is computed by `planogram-scorer`
// — caller persists the breakdown JSON for audit + drill-down.
model RetailExecutionAudit {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Optional FK — links the audit to a specific TradePromotion.
   */
  promotionId    String?
  promotion      TradePromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /**
   * FK to the MtmVisit this audit was recorded during.
   */
  visitId        String
  /**
   * Expected planogram for the store, e.g.
   * { facingsByProduct: { "sku_a": 4, "sku_b": 2 }, requiredProducts: [...] }
   */
  planogramSpec  Json
  /**
   * Agent-recorded observations:
   * { facingsByProduct, productsPresent: string[], priceTagsCorrect: number,
   * priceTagsTotal: number, photos: string[] }
   */
  observations   Json
  /**
   * Score breakdown the scorer produced:
   * { osaScore, shareOfShelfScore, planogramComplianceScore, priceTagAccuracy,
   * totalScore (0..100), penalties: [...] }
   */
  scoreBreakdown Json
  /**
   * Denormalised totalScore for cheap listing + KPI rollup.
   */
  totalScore     Float
  auditedBy      String?
  auditedAt      DateTime        @default(now())

  @@index([organizationId, auditedAt])
  @@index([visitId])
  @@index([promotionId])
  @@map("retail_execution_audits")
}

// R9: Nonprofit Cloud (NPSP analogue). Donor management + fundraising
// programs + grants + volunteer tracking.
//
// Slice 1 ships schema + pure helpers (donor giving roll-up, grant
// utilisation, volunteer-hours aggregator) + CRUD routes. Slice 2
// wires the recurring-donation cron + grant-lifecycle workflows +
// impact-reporting dashboards + N14 platform-events integration
// (donor_milestone, grant_awarded, program_funded events).
model Donor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * "individual" | "organization" — gates form fields in slice-2 UI.
   */
  donorType      String       @default("individual")
  /**
   * Display name — full name for individuals, legal name for orgs.
   */
  name           String
  email          String?
  phone          String?
  /**
   * Optional link to existing CRM Contact — bridges to donor stewardship.
   */
  contactId      String?
  /**
   * Anonymous-by-default opt-in — slice-2 reporting hides anonymous donors.
   */
  anonymous      Boolean      @default(false)
  /**
   * Free-form tags for segmentation: ["major_gift", "monthly", ...]
   */
  tags           String[]     @default([])
  notes          String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  donations Donation[]

  // Uniqueness on (organizationId, email) is enforced by the
  // hand-written PARTIAL unique index in the migration SQL
  // (`WHERE "email" IS NOT NULL` — allows multiple no-email donors).
  // Prisma can't model partial indexes in schema language; declaring
  // `@@unique([organizationId, email])` here would cause
  // `prisma migrate dev` to overwrite the partial index with a full
  // one. See prior precedent: ai_shadow_actions_pending_uniq.
  @@index([organizationId, donorType])
  @@index([contactId])
  @@map("donors")
}

// A funded program / initiative. Donations + grants reference one;
// recurring donations are pinned to their original program through
// slice 2.
model Program {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /**
   * "planning" | "active" | "completed" | "paused".
   */
  status         String       @default("active")
  /**
   * Funding goal in the program's currency.
   */
  goalAmount     Float        @default(0)
  goalCurrency   String       @default("USD")
  /**
   * Optional period of operation.
   */
  startsAt       DateTime?
  endsAt         DateTime?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  donations           Donation[]
  grants              Grant[]
  volunteerActivities VolunteerActivity[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("programs")
}

// A single donation. May be linked to a program (most common), to a
// grant (when the donation IS the grant disbursement; rare), or to
// neither (general fund).
model Donation {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donorId             String
  donor               Donor        @relation(fields: [donorId], references: [id], onDelete: Cascade)
  programId           String?
  program             Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  amount              Float
  currency            String       @default("USD")
  /**
   * When the donation cleared (gift date, not the pledge date).
   */
  receivedAt          DateTime     @default(now())
  /**
   * "one_time" | "recurring" — recurring rows are emitted by the slice-2 cron.
   */
  donationType        String       @default("one_time")
  /**
   * Anonymise this individual donation in public reports — overrides Donor.anonymous=false.
   */
  isAnonymous         Boolean      @default(false)
  /**
   * Optional pledge-vs-actual tracking. When pledge fulfilment matters
   * (e.g. capital campaigns), the donor's pledge total goes here and
   * `amount` carries the cleared portion.
   */
  pledgedAmount       Float?
  /**
   * Optional payment channel — "card", "ach", "wire", "check", "cash", "in_kind".
   */
  channel             String?
  /**
   * Tax-deductible portion (≤ amount). Defaults to amount when null.
   */
  taxDeductibleAmount Float?
  notes               String?
  recordedBy          String?
  createdAt           DateTime     @default(now())

  @@index([organizationId, receivedAt])
  @@index([donorId, receivedAt])
  @@index([programId, receivedAt])
  @@map("donations")
}

// Grant — funder-issued award. Tracked separately from Donation
// because grants have a funder + reporting requirements + period of
// performance that individual donations don't.
model Grant {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId       String?
  program         Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  /**
   * Funder / granter name (foundation, agency).
   */
  granterName     String
  /**
   * Internal grant identifier (e.g. "FORD-2026-001").
   */
  grantNumber     String?
  /**
   * Total awarded amount.
   */
  awardedAmount   Float
  /**
   * Amount actually disbursed so far (slice 2 cron tracks per draw-down).
   */
  disbursedAmount Float        @default(0)
  /**
   * Amount the grantee has actually spent (for utilisation %).
   */
  spentAmount     Float        @default(0)
  currency        String       @default("USD")
  awardedAt       DateTime
  /**
   * Period of performance — funds must be spent between these dates.
   */
  periodStart     DateTime?
  periodEnd       DateTime?
  /**
   * "applied" | "awarded" | "active" | "reporting" | "closed" | "declined".
   */
  status          String       @default("awarded")
  notes           String?
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, granterName, grantNumber])
  @@index([organizationId, status])
  @@index([programId])
  @@map("grants")
}

// Volunteer activity log. One row per volunteer-session — slice 2's
// aggregator rolls up hours by person / program / period for
// impact reporting.
model VolunteerActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String?
  program        Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  /**
   * Optional FK to a CRM contact — bridges to volunteer stewardship.
   */
  contactId      String?
  /**
   * Display name for the volunteer (set if no contact link).
   */
  volunteerName  String
  /**
   * Hours logged in this session (float for half-hour granularity).
   */
  hoursLogged    Float
  /**
   * "event" | "office" | "fundraising" | "outreach" | "other".
   */
  activityType   String       @default("other")
  occurredAt     DateTime
  notes          String?
  recordedBy     String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, occurredAt])
  @@index([programId, occurredAt])
  @@index([contactId])
  @@map("volunteer_activities")
}

// D1: B2B Commerce (Phase 6 Block A). Salesforce B2B Commerce
// analogue. Builds on existing Product / PricingProfile / Company:
//
//   BuyerAccount      Per-company B2B context: credit limit, payment
//                     terms, optional price-list pin, status.
//   BuyerOrder        B2B order header (buyerAccountId, status,
//                     currency, total, requestedDeliveryAt).
//   BuyerOrderItem    Line item (productId, qty, unitPrice,
//                     discountPct, totalPrice).
//   RequestForQuote   RFQ workflow before order: customer requests
//                     pricing, sales responds, accepted RFQ →
//                     BuyerOrder via the converter.
//   RequestForQuoteItem  RFQ line item (productId, qty, requestedUnitPrice?).
//
// Slice 1 ships schema + pure helpers (pricing engine, credit
// checker, RFQ→Order converter) + buyer-account CRUD route. Slice 2
// wires order create / list, RFQ submit + convert routes, and the
// bulk-order-import CSV path.
model BuyerAccount {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * FK to the existing CRM Company that owns the B2B relationship.
   */
  companyId        String
  /**
   * Credit limit in the account's currency. 0 = no credit (cash only).
   */
  creditLimit      Float        @default(0)
  currency         String       @default("USD")
  /**
   * Payment terms in days from invoice (e.g. 30 = "net 30").
   */
  paymentTermsDays Int          @default(0)
  /**
   * Optional pin to a specific PricingProfile id — overrides product list price.
   */
  priceListId      String?
  /**
   * "active" | "suspended" | "closed" — gates new orders.
   */
  status           String       @default("active")
  /**
   * Free-form internal notes (credit-officer comments).
   */
  notes            String?
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  orders BuyerOrder[]
  rfqs   RequestForQuote[]

  @@unique([organizationId, companyId])
  @@index([organizationId, status])
  @@map("buyer_accounts")
}

// B2B order header. Pricing is captured per-line at create time
// (snapshotted from PricingProfile + product list price + buyer
// discount) so a future price change doesn't retroactively mutate
// historical orders.
model BuyerOrder {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyerAccountId      String
  buyerAccount        BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)
  /**
   * Human-friendly identifier — slice 2 generates via a sequence.
   */
  orderNumber         String
  /**
   * "draft" → "submitted" → "approved" → "shipped" → "delivered" → "closed"
   * or → "cancelled" / "rejected" terminal states.
   */
  status              String       @default("draft")
  currency            String       @default("USD")
  /**
   * Sum of line totalPrice — denormalised for cheap listing + credit math.
   */
  totalAmount         Float        @default(0)
  requestedDeliveryAt DateTime?
  notes               String?
  createdBy           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  items     BuyerOrderItem[]
  shipments OrderShipment[]
  returns   OrderReturn[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([buyerAccountId, createdAt])
  @@map("buyer_orders")
}

// Per-product line on a BuyerOrder. Pricing snapshot — unitPrice
// + discountPct + totalPrice are captured at order create time
// (the pricing engine produces them) and never updated by changes
// to Product.price or PricingProfile.
model BuyerOrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       BuyerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  /**
   * Display name snapshot — survives Product.name renames.
   */
  productName String
  quantity    Int
  /**
   * Unit price after profile match, before per-line discount.
   */
  unitPrice   Float
  /**
   * Discount applied to this line as a percentage 0..100.
   */
  discountPct Float      @default(0)
  /**
   * unitPrice * quantity * (1 - discountPct/100).
   */
  totalPrice  Float

  returnItems OrderReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("buyer_order_items")
}

// RFQ — Request For Quote. Customer (or sales rep on behalf of) asks
// for pricing on a product list; sales responds with confirmed prices;
// accepted RFQ converts to a BuyerOrder via the RFQ→Order converter.
model RequestForQuote {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyerAccountId   String
  buyerAccount     BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)
  rfqNumber        String
  /**
   * "draft" → "submitted" → "quoted" → "accepted" / "rejected" / "expired".
   */
  status           String       @default("draft")
  /**
   * Quote validity — after this, status auto-expires (slice 2 cron).
   */
  validUntil       DateTime?
  /**
   * Filled when status flips to "accepted" + RFQ→Order converter runs.
   */
  convertedOrderId String?
  /**
   * Internal sales notes.
   */
  notes            String?
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  items RequestForQuoteItem[]

  @@unique([organizationId, rfqNumber])
  @@index([organizationId, status])
  @@index([buyerAccountId, createdAt])
  @@map("request_for_quotes")
}

// Per-product line on an RFQ. `requestedUnitPrice` is the buyer's
// asking price; `quotedUnitPrice` is sales's response. Both null
// until populated through the workflow.
model RequestForQuoteItem {
  id                 String          @id @default(cuid())
  rfqId              String
  rfq                RequestForQuote @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId          String
  productName        String
  quantity           Int
  /**
   * Buyer's asking price; optional — buyer may leave blank to request a quote.
   */
  requestedUnitPrice Float?
  /**
   * Sales-confirmed price — null until status moves to "quoted".
   */
  quotedUnitPrice    Float?

  @@index([rfqId])
  @@map("request_for_quote_items")
}

// D2: B2C Commerce (Phase 6 Block A). Salesforce B2C Commerce
// analogue — public-facing storefront + session-bound cart + checkout
// state machine. Builds on existing Product catalog and slice-1
// D1 BuyerOrder primitives (slice-2 wires Cart → BuyerOrder via the
// "submit checkout" path).
//
// Slice 1 ships schema + pure helpers + admin-side storefront/cart
// routes. Slice 2 adds public unauthenticated endpoints (guest cart
// via sessionToken cookies), payment-provider integration (Stripe in
// the first cut), and the Cart → BuyerOrder conversion path.
model Storefront {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * URL slug — public path/subdomain identifier. Unique per tenant.
   */
  slug            String
  name            String
  description     String?
  /**
   * Primary currency for catalog display + cart totals.
   */
  primaryCurrency String       @default("USD")
  /**
   * Locale code for storefront UI (e.g. "en-US", "ru", "az").
   */
  primaryLocale   String       @default("en-US")
  /**
   * Theme config JSON — colors / logo URL / hero copy. Slice-2 UI consumes.
   */
  theme           Json         @default("{}")
  isActive        Boolean      @default(true)
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  carts Cart[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("storefronts")
}

// Session-bound cart. Slice 1 supports the registered-user path
// (contactId set, sessionToken optional). Slice 2 wires the guest
// path (sessionToken always set, contactId null until registration).
//
// Cart items snapshot Product.price + name at add time so a future
// catalog price change doesn't retroactively mutate the cart.
model Cart {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storefrontId   String
  storefront     Storefront   @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  /**
   * Session token for guest carts — cookie-pinned. Optional because
   * registered users address by contactId; guests by sessionToken.
   */
  sessionToken   String?
  /**
   * Set when a registered user owns the cart (Contact FK is loose; route validates).
   */
  contactId      String?
  /**
   * "open" → "abandoned" / "checked_out" / "merged" (into another cart).
   */
  status         String       @default("open")
  currency       String       @default("USD")
  /**
   * Denormalised subtotal of items — recomputed by the pure helper on every mutation.
   */
  subtotal       Float        @default(0)
  /**
   * Last-activity timestamp — slice-2 cron marks open→abandoned after N days.
   */
  lastActivityAt DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([organizationId, status])
  @@index([sessionToken])
  @@index([contactId])
  @@map("carts")
}

// Per-product cart line. Snapshot pricing at add time matching the
// D1 BuyerOrderItem pattern — line totals are not retro-mutated when
// Product.price moves later.
model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  /**
   * unitPrice * quantity, rounded to 2 dp.
   */
  lineTotal   Float
  addedAt     DateTime @default(now())

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// Checkout session bridges Cart → BuyerOrder. State machine: shipping
// → payment → review → completed; failed / expired terminal.
// Slice 2 wires the actual order conversion + payment-provider hooks;
// slice 1 ships the state-machine primitives + an audit row.
model CheckoutSession {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cartId           String
  cart             Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  /**
   * "shipping" → "payment" → "review" → "completed"
   * ↓             ↓           ↓
   * "failed" / "expired" terminal at any stage.
   */
  status           String       @default("shipping")
  /**
   * Shipping address + method snapshot:
   * { fullName, line1, line2?, city, region, postalCode, country,
   * methodId?, methodLabel? }
   */
  shipping         Json?
  /**
   * Billing address snapshot (often same as shipping). Stored
   * separately because some buyers / regions split them.
   */
  billing          Json?
  /**
   * Payment-provider reference (Stripe paymentIntent id, etc.).
   * Null until status moves to "payment" + provider is confirmed.
   */
  paymentRef       String?
  /**
   * When the session expires if not completed (slice-2 cron flips).
   */
  expiresAt        DateTime?
  /**
   * When status flipped to "completed" — converted to BuyerOrder.
   */
  completedAt      DateTime?
  /**
   * FK to the converted BuyerOrder, if any.
   */
  convertedOrderId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([cartId])
  @@map("checkout_sessions")
}

// D3: OMS — Fulfillment + Returns (Phase 6 Block A slice 1).
// Post-submission lifecycle layered on top of BuyerOrder (D1). Shared
// between B2B (direct BuyerOrder.create) and B2C (Cart → Checkout →
// BuyerOrder). Slice 1 ships schema + pure helpers (state machines,
// quantity-cap validator, BuyerOrder → Invoice projection). Slice 2
// wires shipping-provider integrations, RMA admin UI, and refund hooks.
//
// `lineItems` JSON snapshots which items + quantities this shipment
// covers — supports partial / multi-parcel fulfillment without a
// per-shipment-line join table (slice 2 may promote to relational if
// reporting needs it).
model OrderShipment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String
  order          BuyerOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /**
   * Carrier slug ("ups" / "fedex" / "dhl" / "local-courier"). Free-text — slice 2 may enum.
   */
  carrier        String
  trackingNumber String?
  /**
   * "pending" → "in_transit" → "delivered"
   * ↓
   * "exception" (recoverable — back to in_transit or forward to delivered)
   * "pending" → "cancelled" (terminal, no progression)
   * State + timestamp invariant enforced by DB CHECK (see migration):
   * pending/cancelled → both timestamps NULL
   * in_transit/exception → shippedAt NOT NULL, deliveredAt NULL
   * delivered → both NOT NULL with shippedAt ≤ deliveredAt
   */
  status         String       @default("pending")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  /**
   * Last-known location / exception message — free text.
   */
  lastStatusNote String?
  /**
   * Snapshot of which line items + quantities this shipment covers (partial-ship).
   */
  lineItems      Json         @default("[]")
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([orderId, createdAt])
  @@index([trackingNumber])
  @@map("order_shipments")
}

// Return / RMA workflow. State machine matches Salesforce OMS canonical
// flow: requested → approved → received → refunded → closed; reject /
// cancel terminal branches at the appropriate stages. The state
// machine also allows received → closed (no-refund close, e.g.
// store-credit / RMA-of-record), so a `closed` return MAY or MAY NOT
// have money returned. Reporting + reversal flows MUST disambiguate
// on `refundedAt IS NULL`, NOT on `status === 'closed'`.
//
// `refundedAmount` is the actual refunded value (may differ from line
// snapshot to support restocking fees / partial credit). Three refund
// columns (amount / ref / at) are atomically set together — enforced
// by DB CHECK (refund_coherence) so a partial-refund half-state row
// cannot exist.
model OrderReturn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String
  order          BuyerOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rmaNumber      String
  /**
   * "requested" → "approved" → "received" → "refunded" → "closed"
   * ↓             ↓
   * "rejected"  "cancelled"  (terminal)
   */
  status         String       @default("requested")
  reason         String?
  /**
   * In order currency. Non-negative; null until refund issued.
   */
  refundedAmount Float?
  /**
   * Payment-provider refund reference (Stripe refund id, etc.).
   */
  refundRef      String?
  approvedAt     DateTime?
  receivedAt     DateTime?
  refundedAt     DateTime?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items OrderReturnItem[]

  @@unique([organizationId, rmaNumber])
  @@index([organizationId, status])
  @@index([orderId, createdAt])
  @@map("order_returns")
}

// Per-line return entry. `quantity` is enforced > 0 in DB; the
// helper (validateReturnQuantities) caps the cumulative sum across
// sibling returns at the original BuyerOrderItem.quantity — a single
// SQL CHECK can't span rows. Per-(return, orderItem) uniqueness is
// indexed to forbid listing the same line twice in one return.
model OrderReturnItem {
  id           String         @id @default(cuid())
  returnId     String
  return       OrderReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    BuyerOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /**
   * Snapshot of productId from the order line — kept for reporting independence.
   */
  productId    String
  productName  String
  quantity     Int
  reason       String?
  /**
   * Allocated refund for this line — non-negative; slice 2 calculator.
   */
  refundAmount Float?

  @@unique([returnId, orderItemId])
  @@index([returnId])
  @@index([orderItemId])
  @@map("order_return_items")
}

// D4: Subscription Management (Phase 6 Block A).
// Customer-facing subscription lifecycle on top of (NOT replacing)
// RecurringInvoice. RecurringInvoice = tenant's invoice-generation
// engine (template + nextRunDate + dayOfMonth). Subscription =
// customer's purchased plan with status lifecycle (trial → active
// → past_due → cancelled, plus paused branch, plan changes with
// proration, dunning retries). Slice 2 wires the Subscription →
// RecurringInvoice bridge so a transition to active also primes
// the invoice cadence.
//
// Slice 1 ships schema + pure helpers (state machine, proration,
// dunning scheduler, billing-period calculator). No API routes yet.
// Slice 3 wires the dunning cron + Stripe webhook handlers.
model SubscriptionPlan {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  /**
   * Price per billing cycle in `currency`. Non-negative (CHECK).
   * Stored as NUMERIC(18,4) — Float replaced to eliminate MRR/proration drift.
   */
  unitAmount           Decimal      @db.Decimal(18, 4)
  currency             String       @default("USD")
  /**
   * "day" | "week" | "month" | "year" (CHECK-enforced enum).
   */
  billingInterval      String       @default("month")
  /**
   * count=1 + interval=month → monthly. count=3 + month → quarterly.
   */
  billingIntervalCount Int          @default(1)
  /**
   * Trial length on Subscription create. 0 = no trial.
   */
  trialDays            Int          @default(0)
  isActive             Boolean      @default(true)
  createdBy            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  subscriptions Subscription[]

  @@index([organizationId, isActive])
  @@map("subscription_plans")
}

// Customer subscription instance. Stripe-style cancelAtPeriodEnd
// separates immediate-cancel (status flips now) from scheduled-cancel
// (status stays active until currentPeriodEnd, then auto-transitions).
//
// Price + interval are SNAPSHOTTED at create / plan_changed time —
// a SubscriptionPlan.unitAmount update does NOT retroactively mutate
// active subscriptions. Mirrors the immutable-line-item pattern used
// in D1 BuyerOrderItem.
//
// Coherence invariants (DB CHECK + SM helper enforce together):
//   - status='cancelled' iff cancelledAt is set
//   - status='paused' implies pausedAt set + resumedAt NULL
//   - subject = companyId OR contactId (cannot be both NULL)
//   - currentPeriodStart ≤ currentPeriodEnd
model Subscription {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  /**
   * Subject — company-level subscription.
   */
  companyId            String?
  /**
   * Subject — contact-level subscription. At least one of company/contact required (CHECK).
   */
  contactId            String?
  /**
   * "trial" → "active" → "past_due" → "cancelled"
   * ↓           ↓
   * "paused"     "active" (recovery)
   * "cancelled" — TERMINAL. Reactivation = create a new Subscription (link
   * via metadata if needed). All transitions go through the SM helper.
   * `paused` semantics: service halt — billing stops (nextBillingAt set to
   * null) but calendar continues. Period boundaries do NOT extend; if the
   * period ends mid-pause, no auto-charge fires. Slice-3 cron treats paused
   * rows as "skip" not "extend". Matches Stripe's subscription-pause model.
   */
  status               String           @default("trial")
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  /**
   * When the next recurring charge fires (slice-3 cron). Null when paused / cancelled.
   */
  nextBillingAt        DateTime?
  cancelledAt          DateTime?
  /**
   * Stripe-style: cancel scheduled at currentPeriodEnd rather than immediate.
   */
  cancelAtPeriodEnd    Boolean          @default(false)
  pausedAt             DateTime?
  resumedAt            DateTime?
  /**
   * Snapshot price — D3-style immutable, survives plan price changes.
   * Stored as NUMERIC(18,4) — Float replaced to eliminate proration drift.
   */
  currency             String           @default("USD")
  unitAmount           Decimal          @db.Decimal(18, 4)
  /**
   * Snapshot interval — must mirror plan at create / plan_changed.
   */
  billingInterval      String
  billingIntervalCount Int              @default(1)
  metadata             Json             @default("{}")
  createdBy            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  events          SubscriptionEvent[]
  dunningAttempts DunningAttempt[]

  @@index([organizationId, status])
  @@index([organizationId, nextBillingAt])
  // Slice-3 cron scans by (org, currentPeriodEnd) for cancelAtPeriodEnd
  // reaper + trial-end auto-conversion. Ships now to avoid follow-up migration.
  @@index([organizationId, currentPeriodEnd])
  @@index([companyId])
  @@index([contactId])
  @@index([planId])
  @@map("subscriptions")
}

// Append-only audit log. Every status change + plan change emits a
// row with before/after snapshots. Slice 2 admin UI consumes for the
// "Activity" tab; slice 3 reporting (MRR / churn / cohort) reads
// heavily — so the (subscriptionId, occurredAt) index is hot.
model SubscriptionEvent {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /**
   * created / trial_ended / activated / paused / resumed / plan_changed
   * / dunning_started / dunning_succeeded / dunning_failed / cancelled
   * / cancel_scheduled / cancel_revoked
   * (CHECK-enforced via `subscription_events_type_check`). `cancelled` is
   * the terminal event — no `reactivated`, because the SM has no cancelled→*
   * edge. Win-back flows create a new Subscription row.
   * `cancel_scheduled`: emitted when cancelAtPeriodEnd flipped true.
   * `cancel_revoked`: emitted when cancelAtPeriodEnd flipped back false.
   */
  eventType       String
  previousStatus  String?
  newStatus       String?
  previousPlanId  String?
  newPlanId       String?
  /**
   * Per plan_changed: positive = customer owes net charge; negative = credit.
   */
  prorationAmount Decimal?     @db.Decimal(18, 4)
  metadata        Json         @default("{}")
  occurredAt      DateTime     @default(now())

  @@index([subscriptionId, occurredAt])
  @@index([organizationId, eventType])
  @@map("subscription_events")
}

// One row per dunning retry against a past_due subscription. Helper
// (dunning-scheduler) computes scheduledAt + isFinalAttempt; slice-3
// cron picks up scheduledAt ≤ now() rows where attemptedAt IS NULL.
//
// Outcome coherence (DB CHECK):
//   pending   — attemptedAt NULL, succeededAt NULL, failureReason NULL
//   succeeded — attemptedAt set, succeededAt set, failureReason NULL
//   failed    — attemptedAt set, succeededAt NULL, failureReason set
model DunningAttempt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /**
   * 1-indexed; UNIQUE (subscriptionId, attemptNumber).
   */
  attemptNumber  Int
  scheduledAt    DateTime
  attemptedAt    DateTime?
  succeededAt    DateTime?
  failureReason  String?
  /**
   * Payment-provider reference (Stripe paymentIntent id).
   */
  paymentRef     String?
  /**
   * Computed by the scheduler — last allowed attempt before auto-cancel.
   */
  isFinalAttempt Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, attemptNumber])
  @@index([organizationId, scheduledAt])
  @@index([subscriptionId, scheduledAt])
  @@map("dunning_attempts")
}

// D5: Payment integrations (Phase 6 Block A).
// Pluggable provider pattern mirroring src/lib/sms/providers/. Each
// provider (stripe/paypal/yookassa/robokassa) implements the same
// `PaymentProvider` interface from src/lib/payments/types.ts; the
// registry picks one per PaymentIntent based on its `providerId` FK.
//
// Slice 1 ships schema + provider abstraction + state machine +
// stubbed provider implementations (signature-only, no real SDK calls).
// Slice 2 wires actual Stripe API calls + webhook handler endpoint.
// Slice 3 wires the customer-facing checkout UI + saved-payment-method
// flow.
model PaymentProvider {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * "stripe" | "paypal" | "yookassa" | "robokassa" (CHECK-enforced).
   */
  type           String
  name           String
  /**
   * Credentials JSON — shape varies per provider. Slice 1 stores
   * plaintext for testability; slice 2 wraps via the NamedCredentials
   * vault (Phase 5 N17). Webhook secret has its own column so the
   * verifier doesn't need to load + decrypt the full credentials blob
   * on every webhook (hot path).
   */
  credentials    Json         @default("{}")
  isActive       Boolean      @default(true)
  /**
   * True = sandbox/test API endpoint; false = live.
   */
  isTestMode     Boolean      @default(false)
  /**
   * Provider-supplied webhook signing secret (e.g. Stripe `whsec_...`).
   */
  webhookSecret  String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  intents       PaymentIntent[]
  webhookEvents PaymentWebhookEvent[]

  @@unique([organizationId, type, isTestMode])
  @@index([organizationId, isActive])
  @@map("payment_providers")
}

// Payment-attempt lifecycle. `externalRef` is the provider's
// PaymentIntent id (e.g. Stripe `pi_...`); UNIQUE per (org, provider)
// so webhook handlers can dedupe retries cheaply.
//
// Coherence invariants (DB CHECK):
//   - status × timestamp tuple matches (succeededAt for succeeded /
//     refunded / partially_refunded; failedAt for failed; cancelledAt
//     for cancelled; none for pending / processing / requires_action).
//   - failureCode + failureMessage exist iff status = failed.
//   - amount >= 0.
model PaymentIntent {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId     String
  provider       PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  /**
   * Provider's PaymentIntent id — null until the create call returns.
   */
  externalRef    String?
  /**
   * Charge amount in the stated currency. Stored as Decimal(18,4) to
   * avoid IEEE-754 drift (0.1 + 0.2 ≠ 0.3 in Float). Migrated from
   * Float in 20260524210000_d5_d8_float_to_decimal.
   */
  amount         Decimal         @db.Decimal(18, 4)
  currency       String          @default("USD")
  /**
   * pending → processing → succeeded / failed / cancelled
   * ↓
   * refunded / partially_refunded
   * "requires_action" is a Stripe-style 3DS / SCA branch reachable
   * from processing. Slice 1 SM allows all forward edges; slice 2
   * webhook handler maps provider events to transitions.
   */
  status         String          @default("pending")
  description    String?
  customerEmail  String?
  /**
   * Optional linkage — contact owning this payment context.
   */
  contactId      String?
  /**
   * Optional linkage — D4 Subscription this charge belongs to.
   */
  subscriptionId String?
  /**
   * Optional linkage — Invoice being paid (D-2026 existing model).
   */
  invoiceId      String?
  /**
   * Payment method type snapshot — "card" / "bank" / "wallet" / etc.
   */
  paymentMethod  String?
  metadata       Json            @default("{}")
  failureCode    String?
  failureMessage String?
  succeededAt    DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  refunds PaymentRefund[]

  @@index([organizationId, status])
  @@index([organizationId, providerId])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([contactId])
  @@map("payment_intents")
}

// One refund per PaymentRefund row; a PaymentIntent may have N refunds
// (partial refund cascade). Slice-3 reconciler maintains the parent
// intent's `refunded` / `partially_refunded` status based on
// sum(refund.amount where status=succeeded) vs intent.amount.
model PaymentRefund {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  /**
   * Provider's refund id (e.g. Stripe `re_...`).
   */
  externalRef     String?
  /**
   * Refund amount. Decimal(18,4) — must not exceed parent intent amount.
   * Migrated from Float in 20260524210000_d5_d8_float_to_decimal.
   */
  amount          Decimal       @db.Decimal(18, 4)
  currency        String
  status          String        @default("pending")
  reason          String?
  failureCode     String?
  failureMessage  String?
  succeededAt     DateTime?
  failedAt        DateTime?
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([paymentIntentId])
  @@index([organizationId, status])
  @@map("payment_refunds")
}

// Incoming webhook log. Idempotency-by-design via UNIQUE
// (providerId, externalId): the second arrival of the same event id
// is a no-op. Slice-2 webhook handler:
//   1. Verifies signature against PaymentProvider.webhookSecret
//   2. Tries to INSERT a row with externalId from the payload
//   3. P2002 unique violation = already-processed → 200 OK
//   4. Otherwise processes the event + sets processedAt + status
model PaymentWebhookEvent {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId      String
  provider        PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /**
   * Provider's event id (Stripe `evt_...`, etc.).
   */
  externalId      String
  eventType       String
  payload         Json
  signatureValid  Boolean         @default(false)
  /**
   * received → processing → processed
   * ↓             ↓
   * failed       (terminal)
   * "ignored" is for events we explicitly don't handle yet (e.g. test
   * pings during slice 2 — log + skip without flagging as failed).
   */
  status          String          @default("received")
  processedAt     DateTime?
  processingError String?
  receivedAt      DateTime        @default(now())

  // Scope: (orgId, providerId, externalId) — providerId is FK-org-
  // scoped so adding orgId is defense-in-depth, not duplication. See
  // migration comment for the rationale.
  @@unique([organizationId, providerId, externalId])
  @@index([organizationId, receivedAt])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

// D7: Inventory Management (Phase 6 Block A).
// Salesforce Inventory Cloud analogue. Tracks per-warehouse stock,
// append-only movement audit, and per-item low-stock alerts.
//
// Slice 1 ships schema + pure helpers (movement-validator, available-
// quantity calculator, reservation engine, low-stock detector) +
// admin warehouse/inventory-item CRUD routes. Slice 2 wires the
// StockMovement POST routes + reservation hooks for D1/D2 carts +
// the low-stock alert cron. Slice 3 wires multi-warehouse transfers
// and Slack/email notification dispatch.
model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Human-readable warehouse code — uppercase alnum + hyphens, 2-32 chars (DB CHECK). Unique per tenant.
   */
  code           String
  name           String
  address        String?
  isActive       Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventoryItems InventoryItem[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("warehouses")
}

// Per-(warehouse, product) stock row. Stock math is split into
// `quantityOnHand` (physical count) and `quantityReserved` (allocated
// to open carts / orders). "Available" = onHand - reserved, computed
// by the slice-1 helper.
//
// Invariants (DB CHECK + helper):
//   • quantityOnHand >= 0
//   • quantityReserved >= 0
//   • quantityReserved <= quantityOnHand  ← "promise what you have"
//   • lowStockThreshold IS NULL OR >= 0
//
// Product FK uses RESTRICT — deleting a Product with extant inventory
// is blocked at the DB level; operator must zero out + delete the
// inventory item first.
model InventoryItem {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId         String
  // ON DELETE RESTRICT at the SQL level (see migration). Architect P1
  // closure: previously declared as plain String without @relation —
  // SQL FK was orphaned from the Prisma navigation. Now in sync.
  product           Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  /**
   * Physical stock in this warehouse.
   */
  quantityOnHand    Int          @default(0)
  /**
   * Allocated to open carts/orders — not yet shipped.
   */
  quantityReserved  Int          @default(0)
  /**
   * Per-item override; NULL = use tenant default at alert-cron level.
   */
  lowStockThreshold Int?
  /**
   * Optional human-readable SKU snapshot for cross-system reference.
   */
  sku               String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  movements      StockMovement[]
  lowStockAlerts LowStockAlert[]

  @@unique([warehouseId, productId])
  @@index([organizationId, warehouseId])
  @@index([productId])
  @@map("inventory_items")
}

// Append-only audit trail. Every change to InventoryItem.quantityOnHand
// or quantityReserved emits one row. `quantityDelta` is SIGNED:
//   receipt / release / transfer_in / adjustment_in → positive
//   shipment / reservation / loss / transfer_out / adjustment_out → negative
// `column` records which inventory column moved (onHand vs reserved).
//
// DB CHECK guarantees:
//   • type IN allowed enum
//   • column IN ('onHand', 'reserved')
//   • quantityDelta ≠ 0
//   • sign matches type (sign_check)
model StockMovement {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  /**
   * Business-reason enum — see migration CHECK.
   */
  type            String
  /**
   * Signed delta. Positive for inbound, negative for outbound. Never zero.
   */
  quantityDelta   Int
  /**
   * "onHand" | "reserved" — which inventory column moved.
   */
  column          String
  reason          String?
  /**
   * App-level reference: Cart.id / BuyerOrder.id / etc. — opaque, type-specific.
   */
  referenceId     String?
  createdBy       String?
  createdAt       DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([referenceId])
  @@map("stock_movements")
}

// Per-item alert state. One open alert per InventoryItem at a time
// (partial UNIQUE on resolvedAt IS NULL). Cron flow:
//   1. Poll inventory_items where availableQty <= threshold
//   2. INSERT alert if no open alert exists (P2002 dedupes concurrent fires)
//   3. Dispatch notification (Slack/email — slice 3)
//   4. Operator acknowledges (sets acknowledgedAt + acknowledgedBy)
//   5. Receipt event resolves the alert (sets resolvedAt; cron may
//      auto-resolve when availableQty climbs back above threshold)
model LowStockAlert {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItemId    String
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  /**
   * Snapshot of threshold at fire time — history is immutable to later threshold changes.
   */
  thresholdAtTrigger Int
  /**
   * Snapshot of (onHand - reserved) at fire time.
   */
  availableAtTrigger Int
  triggeredAt        DateTime      @default(now())
  acknowledgedAt     DateTime?
  /**
   * Operator who acknowledged. Set TOGETHER with acknowledgedAt (DB ack-coherence CHECK).
   */
  acknowledgedBy     String?
  resolvedAt         DateTime?

  @@index([organizationId, triggeredAt])
  @@index([inventoryItemId, triggeredAt])
  @@map("low_stock_alerts")
}

// D8: Promo Codes / Loyalty Management (Phase 6 Block A — final D-track item).
// Salesforce Loyalty Management analogue. Slice 1 ships the four core
// primitives:
//   • PromoCode + PromoCodeRedemption — discount-code engine with
//     usage / per-customer caps + validity window + min-order +
//     currency-correct semantics (percentage vs fixed).
//   • LoyaltyAccount + LoyaltyTransaction — per-(org, contact) points
//     wallet + append-only earn/redeem/expire audit. `lifetimePoints`
//     is monotonic (drives tier upgrades); `points` is the redeemable
//     balance.
// Slice 2 wires API routes + LoyaltyTier config + EarnRule config.
// Slice 3 wires cron for tier-recompute + points-expiry + checkout
// integration that auto-redeems and emits PromoCodeRedemption rows.
model PromoCode {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Human-readable code (e.g. "SUMMER25"). Unique per tenant — two tenants can both have "SUMMER25".
   */
  code             String
  description      String?
  /**
   * 'percentage' | 'fixed' (DB CHECK enum).
   */
  discountType     String
  /**
   * For percentage: 0..100. For fixed: amount in `currency`.
   * Decimal(18,4) — migrated from Float in 20260525210000_d8_promo_float_to_decimal.
   */
  discountValue    Decimal      @db.Decimal(18, 4)
  /**
   * Required for fixed-amount; NULL for percentage (currency-agnostic). DB CHECK enforces coherence.
   */
  currency         String?
  /**
   * Inclusive lower bound on order subtotal for code eligibility.
   * Decimal(18,4) — migrated from Float in 20260525210000_d8_promo_float_to_decimal.
   */
  minOrderAmount   Decimal?     @db.Decimal(18, 4)
  /**
   * Total redemption cap across all customers. NULL = unlimited.
   */
  usageLimit       Int?
  /**
   * Per-customer redemption cap. NULL = unlimited (within global cap).
   */
  perCustomerLimit Int?
  validFrom        DateTime?
  validUntil       DateTime?
  isActive         Boolean      @default(true)
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  redemptions PromoCodeRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([validFrom, validUntil])
  @@map("promo_codes")
}

// Audit row per redemption. The validator helper consumes
// (promoCodeId, contactId) counts via the redemption-code-contact
// index to enforce per-customer limits without scanning the full
// redemption history.
model PromoCodeRedemption {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promoCodeId     String
  promoCode       PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  /**
   * Anonymous redemption (guest checkout) allowed — both contactId + referenceId may be NULL.
   */
  contactId       String?
  /**
   * App-level reference (invoiceId / orderId / cartId).
   */
  referenceId     String?
  /**
   * Discriminator for `referenceId`. D8 slice-2 soft #7 — without this,
   * slice-3 reporting can't join the opaque `referenceId` to the right
   * table. NULL allowed for legacy rows + truly anonymous redemptions
   * where no upstream entity exists. DB CHECK enforces taxonomy:
   * 'invoice' | 'order' | 'cart' | NULL.
   * When `referenceId` is set, callers SHOULD pass `referenceType`. The
   * route enforces this at the Zod boundary (reject `referenceId` without
   * `referenceType` after migration 20260529000000); DB stays permissive
   * for backfill safety.
   */
  referenceType   String?
  /**
   * Snapshot of actual discount applied — audit-immutable.
   * Decimal(18,4) — migrated from Float in 20260525210000_d8_promo_float_to_decimal.
   */
  discountApplied Decimal      @db.Decimal(18, 4)
  currency        String
  redeemedAt      DateTime     @default(now())

  @@index([promoCodeId, redeemedAt])
  @@index([promoCodeId, contactId])
  @@index([organizationId, redeemedAt])
  @@index([referenceId])
  // Slice-3 reporting index: group redemptions by entity type over time.
  // Partial — skip rows where the discriminator wasn't set (legacy +
  // anonymous), which is the path the report doesn't care about.
  @@index([organizationId, referenceType, redeemedAt], map: "promo_code_redemptions_org_refType_redeemedAt_idx")
  @@map("promo_code_redemptions")
}

// Per-(org, contact) points wallet. The `lifetimePoints` accumulator
// is MONOTONIC — only earn paths increment it; redeem / expire /
// adjustment_debit DO NOT decrement. This is the tier-eligibility
// signal that survives a customer drawing their balance to zero.
//
// Invariants (DB CHECK):
//   • points >= 0 AND lifetimePoints >= 0
//   • lifetimePoints >= points (can't redeem more than earned)
//   • tier-coherence: tier and tierUpgradedAt set together or both NULL
model LoyaltyAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  /**
   * Current redeemable balance.
   */
  points         Int          @default(0)
  /**
   * Monotonic — total points ever earned. Drives tier upgrades.
   */
  lifetimePoints Int          @default(0)
  /**
   * Tier slug ("bronze" / "silver" / "gold" / ...). Resolved against slice-2 LoyaltyTier config.
   */
  tier           String?
  /**
   * When the current tier was reached.
   */
  tierUpgradedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions LoyaltyTransaction[]

  @@unique([organizationId, contactId])
  @@index([organizationId, tier])
  @@map("loyalty_accounts")
}

// Append-only points-movement audit. `delta` is SIGNED — sign matches
// type (DB CHECK enforces). `lifetimeDelta` is ONLY non-zero on `earn`
// rows; coherence CHECK forbids `redeem` / `expire` / `adjustment_*`
// from touching lifetime.
model LoyaltyTransaction {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount      @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  /**
   * earn / redeem / expire / adjustment_credit / adjustment_debit.
   */
  type             String
  /**
   * Signed delta — sign matches type:
   * earn / adjustment_credit → positive
   * redeem / expire / adjustment_debit → negative
   * Never zero.
   */
  delta            Int
  /**
   * Lifetime-accumulator increment. Non-negative; only `earn` rows
   * populate (> 0); all other types MUST pass 0. DB CHECK enforces.
   */
  lifetimeDelta    Int                 @default(0)
  reason           String?
  /**
   * App-level reference (invoiceId / orderId / dealId / `birthday:<id>:<year>`).
   * Auto-earn idempotency anchor: a PARTIAL UNIQUE index
   * `loyalty_txn_org_type_ref_uniq (organizationId, type, referenceId)
   * WHERE referenceId IS NOT NULL` (migration 20260620100000) stops a
   * double-firing event from double-awarding. Not expressible in the Prisma
   * schema (partial WHERE) → lives in raw migration SQL, like the
   * payment_intents externalRef pattern. Always written by applyAutoEarn.
   */
  referenceId      String?
  createdBy        String?
  createdAt        DateTime            @default(now())
  /**
   * Optional expiry timestamp — set at earn time when the tenant has
   * `loyaltyPointsExpiryDays` configured in `Organization.settings`.
   * Non-earn rows must leave this null (application-enforced).
   * When expiresAt < now() AND expiredAt IS NULL, the daily cron
   * emits an `expire` LoyaltyTransaction and stamps expiredAt.
   * Migration: 20260525220000_d8_loyalty_expiry_cron
   */
  expiresAt        DateTime?
  /**
   * Stamped by the loyalty-expiry cron after it emits the corresponding
   * `expire` transaction for this earn row. Prevents double-expiry on
   * repeated cron runs. Set in the same $transaction as the expire row.
   * Migration: 20260525220000_d8_loyalty_expiry_cron
   */
  expiredAt        DateTime?
  /// Reverse side of LoyaltyRedemption.transaction (a 'redeem' txn ↔ its fulfilment record).
  redemptions      LoyaltyRedemption[]

  @@index([loyaltyAccountId, createdAt])
  @@index([organizationId, type])
  @@index([referenceId])
  @@map("loyalty_transactions")
}

// ═══════════════════════════════════════════════════════════════════════════
// D8 Loyalty — slice-2-full Phase A config tables.
// LoyaltyTier: per-tenant tier ladder; LoyaltyEarnRule: rules that
// translate purchases/signups/referrals into points. Both unlock the
// rest of slice-2-full (storefront integration + tier cron worker).
// ═══════════════════════════════════════════════════════════════════════════

model LoyaltyTier {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Tier slug — referenced by LoyaltyAccount.tier. UNIQUE per org.
  /// CHECK enforces `[a-z][a-z0-9_]*` shape, max 32 chars.
  code              String
  name              String
  description       String?
  /// Lifetime-points threshold (lower bound, inclusive). CHECK: >= 0.
  /// Cron orders by this column ASC and picks highest threshold crossed.
  minLifetimePoints Int
  /// Storefront earn-rate multiplier (1.0 base, 1.5 = 50% bonus).
  /// CHECK: > 0. Rounding rule (Math.floor — conservative) lives in
  /// the earn-pipeline code; documented in slice-2-full design notes.
  /// Decimal(6,4) — allows 0.0001..9.9999 without IEEE-754 drift.
  /// Migrated from Float in 20260524210000_d5_d8_float_to_decimal.
  multiplier        Decimal      @default(1.0) @db.Decimal(6, 4)
  /// Free-form per-tier perks (priority_support, free_shipping, ...).
  /// Slice-3 portal renders.
  benefits          Json         @default("{}")
  isActive          Boolean      @default(true)
  createdBy         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, code], map: "loyalty_tiers_org_code_uniq")
  @@index([organizationId, minLifetimePoints], map: "loyalty_tiers_org_threshold_idx")
  @@map("loyalty_tiers")
}

model LoyaltyEarnRule {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  /// Trigger taxonomy (DB CHECK):
  /// purchase | signup | referral | birthday | review | survey | custom
  trigger             String
  /// Points per currency-unit. NULL = use pointsFlat only.
  /// CHECK: NULL OR >= 0.
  /// Decimal(18,4) — migrated from Float in 20260524210000_d5_d8_float_to_decimal.
  pointsRate          Decimal?     @db.Decimal(18, 4)
  /// Flat points award (signup bonus, referral, birthday).
  /// CHECK: NULL OR >= 0.
  /// At least one of pointsRate / pointsFlat must be set (DB CHECK).
  pointsFlat          Int?
  /// Minimum order amount (tenant primary currency). CHECK: NULL OR >= 0.
  /// Decimal(18,4) — migrated from Float in 20260524210000_d5_d8_float_to_decimal.
  minOrderAmount      Decimal?     @db.Decimal(18, 4)
  /// Optional category filter (slice-3 may use).
  productCategory     String?
  /// Tie-breaker priority. Higher wins; equal → createdAt ASC.
  priority            Int          @default(0)
  /// Whether tier-multiplier stacks on top of this rule (default true).
  /// Set false for "guaranteed flat" rules (signup bonus).
  applyTierMultiplier Boolean      @default(true)
  isActive            Boolean      @default(true)
  validFrom           DateTime?
  validUntil          DateTime?
  metadata            Json         @default("{}")
  createdBy           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId, trigger, isActive], map: "loyalty_earn_rules_org_trigger_active_idx")
  @@index([organizationId, priority], map: "loyalty_earn_rules_org_priority_idx")
  @@map("loyalty_earn_rules")
}

// D8 Loyalty — redeem rewards catalog. The tenant defines rewards (like earn
// rules); a member spends `pointsCost` from their redeemable balance via the
// existing redeemPoints CAS to claim one. Phase 1 = model + admin CRUD.
model LoyaltyReward {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// Points required to redeem. DB CHECK: > 0.
  pointsCost     Int
  /// Optional cap on TOTAL redemptions across all members. NULL = unlimited.
  stockLimit     Int?
  isActive       Boolean             @default(true)
  metadata       Json                @default("{}")
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  redemptions    LoyaltyRedemption[]

  @@index([organizationId, isActive], map: "loyalty_rewards_org_active_idx")
  @@map("loyalty_rewards")
}

// A member's claim of a LoyaltyReward — the points were already debited via a
// 'redeem' LoyaltyTransaction (linked by transactionId); this row is the
// fulfilment record the tenant works off.
model LoyaltyRedemption {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId       String
  loyaltyRewardId String
  reward          LoyaltyReward       @relation(fields: [loyaltyRewardId], references: [id], onDelete: Cascade)
  /// Points spent — snapshot of the reward's pointsCost at redemption time.
  pointsSpent     Int
  /// fulfilled | pending | cancelled (DB CHECK). Default fulfilled.
  status          String              @default("fulfilled")
  /// The loyalty 'redeem' transaction that debited the points.
  transactionId   String?
  /// FK → the debit txn (SetNull so deleting/expiring a txn doesn't orphan-cascade the fulfilment record).
  transaction     LoyaltyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@index([organizationId, contactId], map: "loyalty_redemptions_org_contact_idx")
  @@index([organizationId, loyaltyRewardId], map: "loyalty_redemptions_org_reward_idx")
  @@map("loyalty_redemptions")
}

// G1: Unified Customer Profile (Phase 6 Block B slice 1).
// Salesforce Data Cloud Customer 360 analogue. Aggregates identity
// across Contact / Lead / MtmCustomer / PortalUser / WebChatSession
// into ONE profile per (org, identity-keys triplet).
//
// Slice 1 ships schema + pure helpers (identity-key normalization,
// merger, aggregator). Slice 2 wires the nightly refresh cron + the
// 360-view route + real-time merge hooks. Slice 3 wires G2 (Identity
// Resolution — fuzzy matching) and G5 (Activation — push segments
// to ad platforms).
//
// Aggregate metrics (totalSpent, lifetimeOrderCount, lastSeenAt) are
// MATERIALIZED columns refreshed by cron, not relations. A 360-view
// query is one row read, not a 5-table join.
model UnifiedProfile {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Lowercased + trimmed email; primary lookup key. Partial UNIQUE per (org, emailNormalized).
   */
  emailNormalized    String?
  /**
   * E.164 phone format; primary lookup key. Partial UNIQUE per (org, phoneNormalized).
   */
  phoneNormalized    String?
  /**
   * Lowercased + whitespace-collapsed name; SECONDARY signal only (no UNIQUE).
   */
  nameNormalized     String?
  /**
   * Display values — preserved as-supplied, used by 360-view UI.
   */
  displayEmail       String?
  displayPhone       String?
  displayName        String?
  /**
   * Loose FK; route validates same-tenant. On Contact delete, slice-2 nullifies + re-merges.
   */
  primaryContactId   String?
  primaryCompanyId   String?
  /**
   * Sum of paid invoices in `primaryCurrency`. RECOMPUTED from scratch on every
   * refresh by the CDP materializer (profile-builder Phase B) — NOT incrementally
   * accumulated — so there is no cross-run IEEE-754 drift. Source
   * `Invoice.totalAmount` is Decimal(18,4) (migrated `20260524210000`); the builder
   * reads it via decimalToNumber() and round2()s the per-run sum. Float is adequate
   * for this materialized aggregate (used for sort + KPI rollups); the read route
   * recomputes LTV/churn from the Decimal invoice rows directly.
   * (Reconciled 2026-06-01: an earlier "SLICE-2 P0 BLOCKER Float→Decimal" note here
   * was stale — the source column migrated to Decimal and the full-recompute model
   * removes the accumulation concern. See memory/deferred_findings.md.)
   */
  totalSpent         Float        @default(0)
  /**
   * Count of invoices in 'paid' status.
   */
  lifetimeOrderCount Int          @default(0)
  /**
   * Most recent interaction timestamp across all sources.
   */
  lastSeenAt         DateTime?
  /**
   * First-seen timestamp — monotonic (never moves backward).
   */
  firstSeenAt        DateTime?
  /**
   * Channel tags Postgres array. Slice-2 G4 segmentation queries
   * `WHERE 'web_chat_session' = ANY("channelsActive")` directly — a
   * comma-separated TEXT would force LIKE-substring matching with
   * false-positive risk (e.g. "web_chat" matches "web_chat_session").
   */
  channelsActive     String[]     @default([])
  primaryCurrency    String?
  metadata           Json         @default("{}")
  /**
   * Slice-2 cron sets this on refresh. Stale-detection in UI.
   */
  lastRefreshedAt    DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sources                  ProfileSource[]
  // G2 back-relations — named because a single UnifiedProfile can
  // be EITHER primary or secondary in different candidate rows; the
  // named relation lets the Prisma client navigate both sides.
  primaryMergeCandidates   ProfileMergeCandidate[]      @relation("ProfileMergeCandidatePrimary")
  secondaryMergeCandidates ProfileMergeCandidate[]      @relation("ProfileMergeCandidateSecondary")
  // G3 back-relation — materialized insight values per (profile, def).
  insights                 ProfileInsight[]
  // G4 back-relation — segment memberships.
  segmentMemberships       DataCloudSegmentMembership[]

  @@index([organizationId, lastSeenAt])
  @@index([primaryContactId])
  @@index([primaryCompanyId])
  @@map("unified_profiles")
}

// Maps a source record (Contact / Lead / MtmCustomer / PortalUser /
// WebChatSession) → UnifiedProfile. Per-source uniqueness via
// UNIQUE(orgId, sourceType, sourceId) prevents a Contact from being
// merged into two different profiles. Slice-2 merge engine
// upserts rows here.
//
// `confidence` is 1.0 in slice 1 (exact match by email/phone). Slice 3
// G2 fuzzy-matching may emit < 1.0 for soft matches; consumers filter
// on confidence threshold for activation decisions.
model ProfileSource {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unifiedProfileId  String
  unifiedProfile    UnifiedProfile @relation(fields: [unifiedProfileId], references: [id], onDelete: Cascade)
  /**
   * 'contact' | 'lead' | 'mtm_customer' | 'portal_user' | 'web_chat_session' (DB CHECK enum).
   */
  sourceType        String
  /**
   * App-level id of the source record.
   */
  sourceId          String
  /**
   * 0..1 match-confidence. Slice-1 always 1.0; slice-3 G2 fuzzy may be lower.
   */
  confidence        Float          @default(1.0)
  lastContributedAt DateTime       @default(now())
  mergedAt          DateTime       @default(now())

  @@unique([organizationId, sourceType, sourceId])
  @@index([unifiedProfileId])
  @@index([organizationId, sourceType])
  @@map("profile_sources")
}

// G2: Identity Resolution (Phase 6 Block B slice 1).
// Salesforce Identity Resolution analogue. Fuzzy-match candidate
// queue + per-pair score breakdown. Builds on G1 UnifiedProfile.
//
// `primaryProfileId` is the lexicographically-smaller of the two
// candidates (matcher rule) — gives the partial UNIQUE
// `(org, primary, secondary) WHERE status='pending'` a deterministic
// pair-ordering so two matchers running concurrently on the same
// pair race-resolve to a single P2002 instead of duplicate queue rows.
model ProfileMergeCandidate {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Lexicographically-smaller profile.id — canonical "winner" on approve.
   */
  primaryProfileId   String
  primaryProfile     UnifiedProfile @relation("ProfileMergeCandidatePrimary", fields: [primaryProfileId], references: [id], onDelete: Cascade)
  /**
   * Lexicographically-larger profile.id — "loser" merged INTO primary on approve.
   */
  secondaryProfileId String
  secondaryProfile   UnifiedProfile @relation("ProfileMergeCandidateSecondary", fields: [secondaryProfileId], references: [id], onDelete: Cascade)
  /**
   * Composite fuzzy-match score 0..1 — DB CHECK enforces range.
   */
  score              Float
  /**
   * Per-key score breakdown JSON:
   * { email, phone, name (each 0..1), emailWeight, phoneWeight, nameWeight }
   * Slice-2 admin UI renders this so the operator sees WHY the matcher
   * flagged a pair (e.g. "email=0.95 from Levenshtein=1, phone=0.0 absent").
   */
  matchBreakdown     Json           @default("{}")
  reason             String?
  /**
   * pending → auto_merged | manually_merged | rejected
   * pending is the queue state; the other three are terminal.
   * Review-coherence CHECK enforces reviewedAt + reviewedBy set together
   * on terminal transition.
   */
  status             String         @default("pending")
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewNote         String?
  createdBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, score])
  @@index([primaryProfileId])
  @@index([secondaryProfileId])
  @@map("profile_merge_candidates")
}

// G3: Calculated Insights (Phase 6 Block B slice 1).
// Salesforce Calculated Insights analogue. Materialized computed
// metrics on top of G1 UnifiedProfile (LTV, churn risk, engagement
// score, days-since-last-purchase) + custom-formula path (slice 2
// reuses N4 formula-field engine).
//
// Slice 1 ships schema + 4 pure calculators (LTV / churn risk /
// engagement score / days-since-last-purchase).
// Slice 2 wires refresh cron + API + custom formula evaluator.
model CalculatedInsightDef {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Human-readable identifier — UNIQUE per tenant. e.g. "ltv", "churn_risk".
   */
  key             String
  name            String
  description     String?
  /**
   * 'pre_built' | 'custom' (DB CHECK enum). Pre-built points at a known calculator.
   */
  kind            String
  /**
   * Reserved for custom formulas — slice-2 N4-engine evaluator consumes. NULL for pre_built.
   */
  formula         String?
  /**
   * Cron-style schedule honored by slice-2 refresh cron. Default = nightly 02:00.
   */
  refreshSchedule String       @default("0 2 * * *")
  /**
   * Per-def tuning bag. Slice-1 calculators use hardcoded constants
   * (EXPECTED_LIFETIME_MONTHS, CHURN_INFLECTION_MULTIPLIER, etc.);
   * slice-2 will read overrides from here. Ships now to avoid
   * migration churn when subscription-aware churn variant + B2B/B2C
   * LTV horizon overrides land.
   */
  params          Json         @default("{}")
  /**
   * Materialized-value semantic for admin-UI rendering:
   * 'currency' / 'percentage' / 'score' / 'days' / 'count'
   * (DB CHECK enum).
   */
  valueType       String
  isActive        Boolean      @default(true)
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  profileInsights ProfileInsight[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
  @@map("calculated_insight_defs")
}

// Materialized value of an insight for a specific UnifiedProfile.
// One row per (profileId, insightDefId) — refresh cron UPSERTs.
// `previousValue` snapshots the prior value before each refresh so
// slice-3 trend analysis can compute deltas without a history table.
//
// `confidence` is 0..1 — calculators emit lower scores when input
// data is sparse (e.g. churn risk on a profile with 0 orders has
// near-zero confidence). Slice-2 segmentation may filter on min
// confidence to avoid noisy targeting.
model ProfileInsight {
  id               String               @id @default(cuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unifiedProfileId String
  unifiedProfile   UnifiedProfile       @relation(fields: [unifiedProfileId], references: [id], onDelete: Cascade)
  insightDefId     String
  insightDef       CalculatedInsightDef @relation(fields: [insightDefId], references: [id], onDelete: Cascade)
  /**
   * Numeric value — range depends on valueType.
   * ⚠️ SLICE-2 P0 BLOCKER — Float→Decimal: LTV-class insights write a
   * sum-of-paid-invoices value here; slice-3 cohort aggregation sums
   * ACROSS profiles, compounding IEEE-754 drift. Migrate to Decimal
   * alongside D5 Payments + G1 UnifiedProfile.totalSpent (see
   * memory/project_payments_slice2_p0.md — same migration set).
   */
  value            Float
  /**
   * Previous value snapshot — null on first compute.
   */
  previousValue    Float?
  /**
   * 0..1 confidence (DB CHECK). Sparse-input calculators emit < 1.
   */
  confidence       Float                @default(1.0)
  /**
   * Input snapshot for explainability — slice-2 admin UI renders.
   */
  computeMetadata  Json                 @default("{}")
  computedAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([unifiedProfileId, insightDefId])
  @@index([organizationId, insightDefId])
  @@index([organizationId, computedAt])
  @@index([insightDefId, value])
  @@map("profile_insights")
}

// G4: Data Cloud Segmentation (Phase 6 Block B slice 1).
// Salesforce Segment Builder analogue. Query-tree over G1
// UnifiedProfile + G3 ProfileInsight + materialized membership
// for G5 activation.
//
// Distinct from the existing `Segment` model (which targets Contacts
// for marketing campaigns) because Data Cloud segments aggregate
// identity ACROSS all sources via UnifiedProfile and can filter on
// calculated insights (LTV / churn / engagement).
//
// Slice 1 ships schema + 2 pure helpers (query-validator + in-memory
// query-evaluator). Slice 2 wires the query-translator (JSON → Prisma
// where) + refresh cron + builder UI. Slice 3 wires G5 activation.
model DataCloudSegment {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * URL-safe slug — UNIQUE per tenant. Matches D2 storefront pattern.
   */
  slug             String
  name             String
  description      String?
  /**
   * JSON query tree. Shape:
   * { op: 'and' | 'or' | 'not', children: [Condition | Subtree] }
   * Condition = { field: {source, path}, op, value }
   * See `src/lib/data-cloud-segmentation/types.ts` for canonical
   * TypeScript types + the validator's allowed-ops-per-field rules.
   */
  query            Json
  refreshSchedule  String       @default("0 3 * * *")
  /**
   * Last successful refresh — slice-2 cron writes.
   */
  lastRefreshedAt  DateTime?
  /**
   * Member count snapshot for cheap list views — refreshed atomically with the membership pass.
   */
  memberCount      Int          @default(0)
  isActive         Boolean      @default(true)
  /**
   * Slice-3 G5 activation hints — FB audience id / Google list id / etc.
   */
  activationConfig Json         @default("{}")
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  memberships DataCloudSegmentMembership[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([organizationId, lastRefreshedAt])
  @@map("data_cloud_segments")
}

// Materialized (segment, profile) membership rows. Refresh cron
// UPSERTs as it re-evaluates; profiles that drop out are DELETED
// (no soft-delete — audit history is slice-2 if reporting needs it).
//
// `addedAt` snapshots when the profile FIRST joined this segment;
// `lastConfirmedAt` advances on every refresh while the profile
// remains a member. Slice-3 G5 reads `lastConfirmedAt` to detect
// recent adds (worth re-targeting in ads) vs. stale stalwarts.
model DataCloudSegmentMembership {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segmentId        String
  segment          DataCloudSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  unifiedProfileId String
  unifiedProfile   UnifiedProfile   @relation(fields: [unifiedProfileId], references: [id], onDelete: Cascade)
  /**
   * When the profile first joined this segment — never moves backward.
   */
  addedAt          DateTime         @default(now())
  /**
   * Updated on every refresh pass where the profile still matches.
   */
  lastConfirmedAt  DateTime         @default(now())
  /**
   * Per-membership metadata snapshot for G5 activation payloads.
   */
  metadata         Json             @default("{}")

  @@unique([segmentId, unifiedProfileId])
  @@index([organizationId, segmentId])
  @@index([unifiedProfileId])
  @@index([segmentId, addedAt])
  @@map("data_cloud_segment_memberships")
}

// M5: Contract Lifecycle Management (Phase 6 Block C slice 1).
// Salesforce CLM analogue. Three models extend the existing Contract:
//   • ContractTemplate — reusable clause+variable boilerplate
//   • ContractApprovalStage — ordered approval chain per contract
//   • ContractRenewalAlert — scheduled pre-expiry reminders
//
// Slice 1 ships schema + 4 pure helpers (state-machine + clause-
// substituter + approval-router + renewal-alert-scheduler). Slice 2
// wires approval/renewal cron + admin UI. Slice 3 connects E-Sign
// (M6) for signedAt/signedBy and Revenue Recognition (M4) for
// performance-obligation creation on activation.
model ContractTemplate {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * URL-safe slug, UNIQUE per tenant. Same pattern as D2 storefront / G4 segments.
   */
  slug                  String
  name                  String
  description           String?
  /**
   * Bumped on every edit. Existing rendered contracts pin to a snapshot via Contract.templateVersion.
   */
  version               Int          @default(1)
  /**
   * JSONB array: `[{ id, title, body, conditional?: { var, equals } }, ...]`
   * Order matters — clause-substituter emits in this order. `body` may
   * contain `{{variable}}` substitution markers consumed by
   * `src/lib/contract-lifecycle/clause-substituter.ts`.
   */
  clauses               Json
  /**
   * JSONB array: `[{ name, type: 'string'|'number'|'date'|'boolean', required, default? }, ...]`
   * Validator + substituter consult this to enforce required-var presence
   * and basic type-coercion at instantiation.
   */
  variables             Json         @default("[]")
  /**
   * Default Contract.type for instances.
   */
  defaultContractType   String       @default("service_agreement")
  /**
   * Default duration in months — substituter uses to compute endDate from startDate.
   */
  defaultDurationMonths Int?
  isActive              Boolean      @default(true)
  createdBy             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  contracts     Contract[]
  approvalRules ContractApprovalRule[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("contract_templates")
}

// Ordered approval chain per contract. Slice-1 ships the schema +
// pure approval-router helper that computes next state given a
// decision. Slice-2 wires API endpoints + UI.
//
// `order` is 1-based; advancement is sequential (stage N+1 becomes
// actionable when stage N is approved). A single reject shorts the
// chain — later stages move to `skipped`.
model ContractApprovalStage {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId             String
  contract               Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /**
   * 1-based ordinal. UNIQUE per contract.
   */
  order                  Int
  /**
   * Display label: "Sales Manager", "Finance Director", "Legal".
   */
  label                  String
  /**
   * Specific user gate. NULL = role-only. assigneeUserId XOR assigneeRole
   * is recommended but not enforced — application layer decides.
   */
  assigneeUserId         String?
  /**
   * Role gate: "manager", "director", "owner" — helper resolves caller eligibility.
   */
  assigneeRole           String?
  /**
   * Audit trail: when delegation resolved the assignee, this records the
   * original intended user (before the delegate substitution). NULL when
   * no delegation occurred or when assigneeRole/no-user-gate is used.
   */
  originalAssigneeUserId String?
  /**
   * pending | approved | rejected | skipped | superseded
   */
  status                 String       @default("pending")
  decidedBy              String?
  /**
   * Immutable once set (DB trigger enforces). Terminal-state advance requires this.
   */
  decidedAt              DateTime?
  comments               String?
  /**
   * SLA for this stage in hours. NULL = no SLA enforced.
   * Set at submit time; stored so each stage can carry its own deadline.
   */
  slaHours               Int?
  /**
   * Wall-clock deadline = activation time + slaHours*3600s.
   * Set on stage 1 at submit time; set on subsequent stages when they
   * become the active pending stage (inside the approve tx).
   * NULL when slaHours is not configured for this stage.
   */
  dueAt                  DateTime?
  /**
   * Number of times this stage has been escalated (capped at MAX_ESCALATIONS=3).
   */
  escalationLevel        Int          @default(0)
  /**
   * Timestamp of the most recent escalation. Used to enforce ESCALATION_INTERVAL_HOURS.
   */
  lastEscalatedAt        DateTime?
  /**
   * Parallel resolution mode for the LEVEL (all stages at the same `order`).
   * All stages in a level MUST carry the same parallelMode + quorumThreshold —
   * the route enforces this at write time; the router reads them from level[0].
   * all    — every stage must approve (default; single-stage all == sequential).
   * any    — first approve passes the level; all must reject to reject.
   * quorum — passes when approvedCount >= quorumThreshold.
   */
  parallelMode           String       @default("all")
  /**
   * Required when parallelMode = "quorum". Minimum approvals (K) to pass the level.
   * NULL when parallelMode != "quorum".
   */
  quorumThreshold        Int?

  escalationEvents ContractApprovalEscalationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Non-unique: multiple stages may share the same order (parallel level).
  /// Replaces the former @@unique([contractId, order]) dropped in Slice 3e-1.
  @@index([contractId, order])
  @@index([organizationId, status])
  @@index([assigneeUserId])
  @@index([organizationId, dueAt, status])
  @@map("contract_approval_stages")
}

/// Audit record written by the escalation cron each time it escalates a stage.
model ContractApprovalEscalationEvent {
  id              String                @id @default(cuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId      String
  contract        Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stageId         String
  stage           ContractApprovalStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  /// 1-based ordinal of the stage at the time of escalation (denormalized for listing).
  order           Int
  /// e.g. "escalated" — extensible for future event types.
  eventType       String                @default("escalated")
  /// JSON array of user IDs who were notified (admins + assignee).
  notifiedUserIds Json
  /// Escalation level at the time of this event (1-based: 1st escalation = level 1).
  level           Int
  createdAt       DateTime              @default(now())

  @@index([organizationId, contractId])
  @@map("contract_approval_escalation_events")
}

// Scheduled pre-expiry alerts. Slice-1 ships the scheduler helper
// that computes the alert calendar (90/60/30/14/7-day windows
// relative to Contract.endDate). Slice-2 cron fans these out to
// Slack/email/in-app delivery channels.
//
// `dueAt` is wall-clock fire time. `daysBeforeExpiry` is the
// offset that produced it (denormalised for listing UIs).
//
// Lifecycle:
//   pending → sent  (delivery channel acked)
//          → dismissed (user closed)
//          → superseded (contract renewed/terminated before fire;
//             `supersededByContractId` may point to the renewal)
model ContractRenewalAlert {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId             String
  contract               Contract     @relation("ContractRenewalAlertsForContract", fields: [contractId], references: [id], onDelete: Cascade)
  /**
   * Wall-clock fire time — slice-2 cron polls by `dueAt <= now() AND status = 'pending'`.
   */
  dueAt                  DateTime
  /**
   * 90 / 60 / 30 / 14 / 7 — enforced by DB CHECK.
   */
  daysBeforeExpiry       Int
  /**
   * pending | sent | dismissed | superseded
   */
  status                 String       @default("pending")
  /**
   * Set on transition to 'sent'.
   */
  deliveredVia           String?
  deliveredAt            DateTime?
  /**
   * Optional pointer to the renewal-flow contract that triggered supersession.
   */
  supersededByContractId String?
  supersededBy           Contract?    @relation("ContractRenewalAlertsSupersededBy", fields: [supersededByContractId], references: [id], onDelete: SetNull)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([contractId, daysBeforeExpiry])
  @@index([organizationId, dueAt])
  @@map("contract_renewal_alerts")
}

// M6: E-Signature (Phase 6 Block C slice 1).
// Salesforce E-Sign / DocuSign analogue. Three models:
//   • EsignEnvelope — per-contract signing session
//   • EsignSigner — per-party row (ordered chain, slice-1 sequential)
//   • EsignAuditEvent — append-only audit trail (DB trigger blocks UPDATE)
//
// Slice 1 ships schema + 5 pure helpers (state-machine + HMAC token
// issuer/verifier + signature-payload validator + audit-event
// constructor). Slice 2 wires public /sign/[token] portal route +
// envelope auto-progression. Slice 3 may add DocuSign provider as an
// alternative to the built-in signer flow.
model EsignEnvelope {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId         String
  contract           Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  subject            String
  message            String?
  /**
   * Status enum (DB CHECK enforced):
   * created | sent | in_progress | completed | declined | voided | expired
   * State-machine helper enforces transitions at application layer.
   */
  status             String               @default("created")
  /**
   * Set on transition to "sent"; immutable thereafter (DB trigger).
   */
  sentAt             DateTime?
  /**
   * Set on transition to "completed"; immutable thereafter (DB trigger).
   */
  completedAt        DateTime?
  voidedAt           DateTime?
  voidedBy           String?
  voidReason         String?
  /**
   * Slice-2 cron flips status to 'expired' when expiresAt < now.
   */
  expiresAt          DateTime?
  /**
   * Slice 4a integrity: the ContractVersion this envelope was bound to at SEND
   * time. The sign flow reads body from this immutable version, not the live
   * Contract.renderedBody (which may have been mutated by /amend).
   * Nullable for backward-compat; sign route falls back to Contract.renderedBody
   * when null (legacy envelopes predating this column).
   */
  contractVersionId  String?
  boundVersion       ContractVersion?     @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  /**
   * SHA-256 hex of the content that was bound at send time. Cross-check in the
   * sign completion path: if this no longer matches the bound version's
   * contentHash (shouldn't happen — versions are immutable) fail safe.
   */
  boundContentHash   String?
  /**
   * Slice 7d provider seam: which e-sign provider handled this envelope.
   * "native" = the built-in HMAC-token flow (default, unchanged).
   * "docusign" = DocuSign API (requires an active EsignProviderConfig).
   * Adding new providers here is additive — existing rows remain "native".
   */
  provider           String               @default("native")
  /**
   * Slice 7d: DocuSign envelope GUID (or equivalent external ID for other
   * providers). NULL for native envelopes; set by the provider on send.
   */
  externalEnvelopeId String?
  /**
   * Slice 7d: FK to the EsignProviderConfig used when this envelope was
   * sent. NULL for native envelopes.
   */
  providerConfigId   String?
  providerConfig     EsignProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)

  metadata  Json     @default("{}")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signers     EsignSigner[]
  auditEvents EsignAuditEvent[]

  @@index([organizationId, status])
  @@index([contractId])
  @@index([organizationId, expiresAt])
  @@index([contractVersionId])
  @@index([providerConfigId])
  @@map("esign_envelopes")
}

// One row per party (signer / cc / copy). `order` is 1-based;
// sequential signing only in slice 1 (parallel routing deferred).
model EsignSigner {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  envelopeId       String
  envelope         EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  order            Int
  fullName         String
  email            String
  /**
   * signer | cc | copy — DB CHECK enforced.
   */
  role             String        @default("signer")
  /**
   * pending | sent | viewed | signed | declined | expired — DB CHECK.
   */
  status           String        @default("pending")
  /**
   * Server-side HMAC hash of the canonical signing token. Plaintext
   * token is emailed to the signer; verifier re-computes HMAC and
   * constant-time-compares with this column.
   * Slice 1 helper produces both halves; slice 2 will rotate this
   * value on each viewedAt update to enforce single-use semantics if
   * we choose stricter posture.
   */
  tokenHash        String?
  viewedAt         DateTime?
  signedAt         DateTime?
  declinedAt       DateTime?
  declineReason    String?
  /**
   * drawn | typed | uploaded — DB CHECK enforced.
   */
  signatureMethod  String?
  /**
   * Captured signature payload — method-specific shape:
   * drawn:    `{ svgPath: string, widthPx: number, heightPx: number }`
   * typed:    `{ typedName: string, font: string }`
   * uploaded: `{ fileRefId: string }`
   * Validator helper checks shape at submission time.
   */
  signaturePayload Json?
  signedIpAddress  String?
  signedUserAgent  String?
  /**
   * Reminder tracking — set by the esign-reminders cron (Slice 2d-2).
   * Each run that sends a reminder increments remindersSent and updates
   * lastRemindedAt. The cron re-issues a fresh HMAC token on each reminder
   * (old link dies, new link works — single-use semantics).
   */
  lastRemindedAt   DateTime?
  remindersSent    Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  auditEvents EsignAuditEvent[]

  @@unique([envelopeId, order])
  @@index([organizationId, envelopeId])
  @@index([email])
  @@map("esign_signers")
}

// Append-only audit trail. DB trigger blocks any UPDATE on this
// table; INSERT-only by design. Used for non-repudiation, dispute
// resolution, and slice-2 admin timeline UI.
model EsignAuditEvent {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  envelopeId     String
  envelope       EsignEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  /**
   * Nullable — envelope-scoped events (create/void/expire) have no signer.
   */
  signerId       String?
  signer         EsignSigner?  @relation(fields: [signerId], references: [id], onDelete: Cascade)
  /**
   * Event kinds (DB CHECK enforces the set):
   * envelope_created | envelope_sent | envelope_voided | envelope_expired
   * | envelope_completed
   * signer_invited | signer_viewed | signer_signed | signer_declined
   * | signer_expired
   * token_issued | token_verified_ok | token_verified_failed
   */
  eventType      String
  /**
   * user | signer | system — DB CHECK enforced.
   */
  actorType      String
  /**
   * userId for actorType='user', signerId for 'signer', null for 'system'.
   */
  actorId        String?
  ipAddress      String?
  userAgent      String?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([envelopeId, createdAt])
  @@index([organizationId, envelopeId])
  @@index([signerId])
  @@map("esign_audit_events")
}

// M4: Revenue Recognition (Phase 6 Block C slice 1, closes Block C).
// Salesforce Revenue Cloud — ASC 606 / IFRS 15 compliance.
//
// 5-step ASC 606 model: identify contract (already in Contract) →
// identify POs (PerformanceObligation) → determine price (Contract
// .valueAmount) → allocate (allocation-engine helper) → recognize
// (schedule-generator + recognition-calculator helpers).
//
// Slice 1 ships schema + 5 pure helpers; slice 2 wires monthly
// recognition cron + posting workflow + admin builder UI; slice 3
// wires multi-currency FX + variable-consideration (caps, refunds).
//
// All money columns are Decimal-native — no Float→DECIMAL P0 follow-up
// for this module.
model PerformanceObligation {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId             String
  contract               Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /**
   * Optional product reference; slice-2 admin UI defaults from product list.
   */
  productId              String?
  product                Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  /**
   * 1-based ordinal within contract; UNIQUE per contract.
   */
  displayOrder           Int
  description            String
  /**
   * Standalone selling price (SSP) — allocation-engine reads this for
   * multi-PO contracts. NULL allowed when contract has a single PO
   * (allocatedAmount == Contract.valueAmount directly).
   */
  standaloneSellingPrice Decimal?     @db.Decimal(18, 4)
  /**
   * Allocated transaction price — what this PO owns of the contract
   * total. Allocation-engine helper computes this; slice-2 admin may
   * override with manual entry + reason logged in metadata.
   */
  allocatedAmount        Decimal      @db.Decimal(18, 4)
  /**
   * Currency mirrors Contract.currency at PO-creation time.
   */
  currency               String
  /**
   * Recognition method (DB CHECK enforces):
   * point_in_time           — single schedule line, due at periodEnd
   * over_time_straight_line — N equal monthly slices
   * milestone               — caller-defined milestones (slice-2 UI)
   * usage_based             — slice-2 consumes usage events
   */
  recognitionMethod      String
  /**
   * Service-period start — recognition window opens.
   */
  periodStart            DateTime
  /**
   * Service-period end — recognition fully amortised.
   */
  periodEnd              DateTime
  /**
   * Status (DB CHECK enforces):
   * draft | scheduled | in_progress | completed | cancelled
   */
  status                 String       @default("draft")
  metadata               Json         @default("{}")
  createdBy              String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  schedules RevenueRecognitionSchedule[]

  @@unique([contractId, displayOrder])
  @@index([organizationId, status])
  @@index([contractId])
  @@index([productId])
  @@map("performance_obligations")
}

// Schedule lines = "the plan". Generated at PO creation; recognized
// by slice-2 monthly cron. Each line is one accounting-period target.
model RevenueRecognitionSchedule {
  id                      String                @id @default(cuid())
  organizationId          String
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performanceObligationId String
  performanceObligation   PerformanceObligation @relation(fields: [performanceObligationId], references: [id], onDelete: Cascade)
  /**
   * 1-based ordinal within the PO's schedule. UNIQUE per PO.
   */
  lineNumber              Int
  /**
   * Accounting period (typically month start/end).
   */
  periodStart             DateTime
  periodEnd               DateTime
  /**
   * Decimal-native — Float→DECIMAL P0 is irrelevant here.
   */
  scheduledAmount         Decimal               @db.Decimal(18, 4)
  currency                String
  /**
   * Status (DB CHECK enforces):
   * scheduled | recognized | partially_recognized | cancelled
   */
  status                  String                @default("scheduled")
  /**
   * Set on transition to 'recognized'; immutable thereafter (DB trigger).
   */
  recognizedAt            DateTime?
  /**
   * Slice-2 milestone label / usage period label / etc.
   */
  label                   String?
  metadata                Json                  @default("{}")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  entries RevenueRecognitionEntry[]

  @@unique([performanceObligationId, lineNumber])
  @@index([organizationId, status])
  @@index([performanceObligationId])
  @@index([organizationId, periodStart])
  @@map("revenue_recognition_schedules")
}

// Entries = "the actuals". Append-only audit of recognition events.
// DB trigger blocks UPDATE — corrections via new reversing entries
// (slice-2 helper enforces "negative entry must reference an existing
// positive entry via metadata.reversesEntryId").
model RevenueRecognitionEntry {
  id               String                     @id @default(cuid())
  organizationId   String
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleId       String
  schedule         RevenueRecognitionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /**
   * Signed: positive for normal, negative for reversals (slice 2).
   */
  recognizedAmount Decimal                    @db.Decimal(18, 4)
  currency         String
  postedAt         DateTime
  postedBy         String?
  /**
   * Slice-2 GL integration — external journal entry id.
   */
  journalRef       String?
  /**
   * Reason / note — slice-2 helper requires this for negative entries.
   */
  note             String?
  metadata         Json                       @default("{}")
  createdAt        DateTime                   @default(now())

  @@index([scheduleId, postedAt])
  @@index([organizationId, postedAt])
  @@map("revenue_recognition_entries")
}

// N2: Lightning App Builder (Phase 6 Block D slice 1).
// Salesforce Lightning App Builder analogue — drag-drop page layouts
// per Object (Deal, Contact, Lead, ...) with per-user / per-role /
// per-profile assignment overrides.
//
// Slice 1 ships schema + 5 pure helpers (state-machine + widget-
// validator + assignment-resolver + layout-serializer + types).
// Slice 2 wires the drag-drop admin UI + object-render layer; slice
// 3 wires OmniStudio FlexCards (N16) as an alternative widget engine.
model LightningPage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * URL-safe slug, UNIQUE per (tenant, objectType).
   */
  slug           String
  name           String
  description    String?
  /**
   * Target object: "deal", "contact", "lead", custom-object slug.
   */
  objectType     String
  /**
   * Status (DB CHECK enforces):
   * draft | published | archived
   */
  status         String       @default("draft")
  /**
   * Bumped on every publish; slice-2 audit trail consumes.
   */
  version        Int          @default(1)
  /**
   * Set on transition to 'published'; immutable thereafter (DB trigger).
   */
  publishedAt    DateTime?
  publishedBy    String?
  /**
   * Set on transition to 'archived'; immutable thereafter (DB trigger).
   */
  archivedAt     DateTime?
  archivedBy     String?
  metadata       Json         @default("{}")
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  regions     LightningPageRegion[]
  assignments LightningPageAssignment[]

  @@unique([organizationId, objectType, slug])
  @@index([organizationId, objectType, status])
  @@index([organizationId, status])
  @@map("lightning_pages")
}

// Top-level layout region within a page. Standard Salesforce-style
// regions: header / main / sidebar / footer. 1-based displayOrder
// UNIQUE per page.
model LightningPageRegion {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pageId         String
  page           LightningPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /**
   * header | main | sidebar | footer — DB CHECK.
   */
  regionType     String
  displayOrder   Int
  /**
   * Bootstrap-style 1-12 column width; NULL = auto.
   */
  widthCols      Int?
  label          String?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  widgets LightningPageWidget[]

  @@unique([pageId, displayOrder])
  @@index([organizationId, pageId])
  @@map("lightning_page_regions")
}

// Widget instance within a region. `widgetType` selects renderer;
// `config` carries per-instance settings validated by the
// widget-validator helper.
model LightningPageWidget {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regionId       String
  region         LightningPageRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  /**
   * Widget kind (DB CHECK pins slice-1 set):
   * record_details | related_list | chart | quick_actions
   * | activity_timeline | html | embed_external
   * Adding a new type requires:
   * 1. Extend this DB CHECK in a follow-up migration.
   * 2. Extend WIDGET_TYPES in src/lib/app-builder/types.ts.
   * 3. Extend widget-validator's per-type switch.
   * 4. Drift-guard test pins WIDGET_TYPES length.
   */
  widgetType     String
  displayOrder   Int
  config         Json                @default("{}")
  label          String?
  isVisible      Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([regionId, displayOrder])
  @@index([organizationId, regionId])
  @@map("lightning_page_widgets")
}

// Resolution mapping for which page applies. Precedence (highest →
// lowest): user > profile > role > default. Slice-1 application
// layer (assignment-resolver helper) enforces "one active assignment
// per scope" — DB doesn't have a partial UNIQUE because Prisma can't
// express it; slice-2 may revisit.
model LightningPageAssignment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pageId         String
  page           LightningPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /**
   * Mirrored from page.objectType — denormalised for cheap lookup.
   */
  objectType     String
  /**
   * default | role | profile | user — DB CHECK + coherence with scopeId.
   */
  scopeType      String
  /**
   * Scope value. NULL when scopeType='default'.
   * Role → enum value; profile → ContractApprovalStage-style placeholder
   * (slice-2 wires N13 Profile model); user → User.id.
   */
  scopeId        String?
  isActive       Boolean       @default(true)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, objectType, scopeType, scopeId])
  @@index([organizationId, objectType])
  @@index([pageId])
  @@map("lightning_page_assignments")
}

// N16: OmniStudio (FlexCards + OmniScript) — Phase 6 Block D slice 2,
// closes Block D.
//
// Salesforce OmniStudio analogue: declarative UI engine for Industry
// Clouds. Two core declarative artifacts:
//   • FlexCard — record-view config with conditional sections
//   • OmniScript — declarative workflow (input → API → conditional → action)
//
// Slice 1 ships schema + 5 pure helpers; slice 2 wires the runtime
// (OmniScript stepper, FlexCard renderer hooked into page requests)
// + admin builder UI. Distinct from N2 Lightning App Builder because
// OmniStudio targets vertical-industry config reuse, not per-tenant
// page layout.
model OmniStudioFlexCard {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * URL-safe slug, UNIQUE per (org, objectType).
   */
  slug           String
  name           String
  description    String?
  /**
   * Target object type — same shape as N2 lightning_pages.
   */
  objectType     String
  version        Int          @default(1)
  /**
   * FlexCard config — JSONB. See `src/lib/omnistudio/types.ts` for the
   * canonical TypeScript shape and `flex-card-validator.ts` for the
   * enforced invariants (section ids unique, conditional vars
   * resolvable, field count bounds, etc.).
   */
  config         Json
  /**
   * draft | published | archived — DB CHECK.
   */
  status         String       @default("draft")
  publishedAt    DateTime?
  publishedBy    String?
  archivedAt     DateTime?
  archivedBy     String?
  metadata       Json         @default("{}")
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, objectType, slug])
  @@index([organizationId, status])
  @@map("omni_studio_flex_cards")
}

// OmniScript = declarative workflow step graph. `steps` JSONB is a
// DAG validated by omni-script-validator (no cycles, all step refs
// resolve, types align with step.config).
model OmniStudioOmniScript {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String?
  objectType     String
  version        Int          @default(1)
  /**
   * Step graph — JSONB. Shape:
   * { startStepId, steps: [{ id, type, config, nextStepId?,
   * branches?: [{ condition, nextStepId }] }] }
   * Validator enforces DAG-shape + type-specific config presence.
   */
  steps          Json
  status         String       @default("draft")
  publishedAt    DateTime?
  publishedBy    String?
  archivedAt     DateTime?
  archivedBy     String?
  metadata       Json         @default("{}")
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sessions OmniStudioRunSession[]

  @@unique([organizationId, objectType, slug])
  @@index([organizationId, status])
  @@map("omni_studio_omni_scripts")
}

// Execution-tracking row for an in-flight OmniScript run. Slice 1
// ships schema only; slice 2 wires the runtime that advances
// `currentStepId` based on user input / API responses.
model OmniStudioRunSession {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scriptId          String
  script            OmniStudioOmniScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  /**
   * Pin to script.version at session-start — keeps the run reproducible.
   */
  scriptVersion     Int
  /**
   * Optional object reference the script acts on.
   */
  contextObjectType String?
  contextObjectId   String?
  /**
   * User running the script (NULL = system-triggered).
   */
  userId            String?
  /**
   * Status (DB CHECK):
   * in_progress | completed | abandoned | failed
   */
  status            String               @default("in_progress")
  /**
   * ID of the step currently awaiting input / API completion.
   */
  currentStepId     String?
  /**
   * Accumulated variables across the run — slice-2 runtime mutates.
   */
  state             Json                 @default("{}")
  endedAt           DateTime?
  startedAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([organizationId, status])
  @@index([scriptId])
  @@index([userId])
  @@index([contextObjectType, contextObjectId])
  @@map("omni_studio_run_sessions")
}

// R10: Education Cloud (Phase 6 Block E first slice).
// Salesforce Education Data Architecture (EDA) analogue. Student
// lifecycle, course catalog, term-based enrollments, faculty.
//
// Slice 1 ships schema + 5 pure helpers (state-machine, enrollment-
// validator, gpa-calculator, term-resolver, types). Slice 2 wires
// student portal + bulk-import flows. Slice 3 adds grade-book +
// financial-aid + OmniStudio FlexCard reuse for student record view.

model EducationAcademicTerm {
