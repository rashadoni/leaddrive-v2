  code              String
  version           Int
  nameRu            String
  nameAz            String
  nameEn            String
  schemaVersion     Int                     @default(1)
  definition        Json
  definitionHash    String                  @db.VarChar(64)
  approvalReference String?
  sourceSystem      String
  sourceReference   String?
  sourceObservedAt  DateTime
  effectiveFrom     DateTime                @db.Date
  effectiveTo       DateTime?               @db.Date
  status            MtmCoveragePolicyStatus @default(DRAFT)
  createdByUserId   String
  signedByUserId    String?
  signedAt          DateTime?
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  snapshots MtmCoverageSnapshot[]

  @@unique([organizationId, id], map: "mtm_cov_policy_org_id_key")
  @@unique([organizationId, code, version], map: "mtm_cov_policy_org_code_version_key")
  @@index([organizationId, status, effectiveFrom, effectiveTo], map: "mtm_cov_policy_org_status_effective_idx")
  @@map("mtm_coverage_policies")
}

/// Tenant-approved interpretation of the SWM plan/GPS dashboard. The code
/// supports a deliberately narrow formula contract; activation proves that an
/// administrator reviewed the exact hash and its embedded reconciliation
/// vectors before the dashboard may call a result authoritative.
model MtmKpiPolicy {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  version           Int
  nameRu            String
  nameAz            String
  nameEn            String
  schemaVersion     Int                @default(1)
  definition        Json
  definitionHash    String             @db.VarChar(64)
  approvalReference String?
  sourceSystem      String
  sourceReference   String?
  sourceObservedAt  DateTime
  effectiveFrom     DateTime           @db.Date
  effectiveTo       DateTime?          @db.Date
  status            MtmKpiPolicyStatus @default(DRAFT)
  createdByUserId   String
  signedByUserId    String?
  signedAt          DateTime?
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([organizationId, id], map: "mtm_kpi_policy_org_id_key")
  @@unique([organizationId, code, version], map: "mtm_kpi_policy_org_code_version_key")
  @@index([organizationId, status, effectiveFrom, effectiveTo], map: "mtm_kpi_policy_org_status_effective_idx")
  @@map("mtm_kpi_policies")
}

/// Immutable employee/period population envelope. FROZEN rows never follow
/// live ownership or master-data changes; policy, cutoff, population hash and
/// denormalized row evidence explain exactly what the closed period contained.
model MtmCoverageSnapshot {
  id                String                    @id @default(cuid())
  organizationId    String
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId          String
  policy            MtmCoveragePolicy         @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict)
  policyVersion     Int
  agentId           String
  agentName         String
  periodStart       DateTime                  @db.Date
  periodEnd         DateTime                  @db.Date
  timezone          String
  status            MtmCoverageSnapshotStatus @default(BUILDING)
  sourceCutoffAt    DateTime
  sourceFreshnessAt DateTime?
  populationHash    String                    @db.VarChar(64)
  totals            Json?
  completeness      Json?
  failureReason     String?
  createdByUserId   String
  frozenByUserId    String?
  frozenAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  rows MtmCoverageSnapshotRow[]

  @@unique([organizationId, id], map: "mtm_cov_snapshot_org_id_key")
  @@unique([organizationId, agentId, periodStart, periodEnd, policyId], map: "mtm_cov_snapshot_org_agent_period_policy_key")
  @@index([organizationId, agentId, status, periodStart, periodEnd], map: "mtm_cov_snapshot_org_agent_status_period_idx")
  @@index([organizationId, policyId, createdAt], map: "mtm_cov_snapshot_org_policy_created_idx")
  @@map("mtm_coverage_snapshots")
}

/// Subject-level explanation for one frozen coverage population. IDs and
/// labels are snapshots, deliberately not foreign keys to mutable master data.
model MtmCoverageSnapshotRow {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotId       String
  snapshot         MtmCoverageSnapshot    @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Cascade)
  rowHash           String                 @db.VarChar(64)
  subjectType       MtmCoverageSubjectType
  subjectId         String
  subjectName       String
  customerId        String?
  customerName      String?
  ownerAgentId      String
  ownerAgentName    String
  groupKey          String
  groupLabel        String
  groupOrder        Int                    @default(0)
  categoryCode      String?
  categoryLabel     String?
  specialtyCode     String?
  specialtyName     String?
  requiredCoverage  Decimal                @default(0) @db.Decimal(18, 4)
  actualMoi         Decimal                @default(0) @db.Decimal(18, 4)
  target            Decimal                @default(0) @db.Decimal(18, 4)
  actualCoverage    Decimal                @default(0) @db.Decimal(18, 4)
  uncoveredMoi      Decimal                @default(0) @db.Decimal(18, 4)
  explanation       Json
  planningContext   Json
  sourceEvidence    Json
  createdAt         DateTime               @default(now())

  @@unique([snapshotId, rowHash], map: "mtm_cov_row_snapshot_hash_key")
  @@index([organizationId, snapshotId, groupOrder, groupKey], map: "mtm_cov_row_org_snapshot_group_idx")
  @@index([organizationId, snapshotId, subjectType, subjectId], map: "mtm_cov_row_org_snapshot_subject_idx")
  @@index([organizationId, ownerAgentId, subjectType], map: "mtm_cov_row_org_owner_subject_idx")
  @@map("mtm_coverage_snapshot_rows")
}

// A submitted promise is immutable. Later execution is recorded as a
// separate one-to-one fact event so promise-vs-fact history cannot be
// rewritten by an offline retry or a manager edit.
model MtmCommitment {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId            String
  agent              MtmAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  visitId            String?
  visit              MtmVisit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  customerId         String
  customer           MtmCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            MtmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  clientCommitmentId String
  productExternalId  String?
  productName        String
  brandExternalId    String?
  brandName          String?
  promisedQuantity   Decimal      @db.Decimal(14, 2)
  unit               String       @default("unit")
  dueAt              DateTime
  note               String?
  evidencePhotoId    String?
  evidencePhoto      MtmPhoto?    @relation("MtmCommitmentPromiseEvidence", fields: [evidencePhotoId], references: [id], onDelete: SetNull)
  submittedAt        DateTime
  createdAt          DateTime     @default(now())

  fulfillment MtmCommitmentFulfillment?

  @@unique([organizationId, agentId, clientCommitmentId])
  @@index([organizationId, agentId, dueAt])
  @@index([organizationId, customerId, dueAt])
  @@index([organizationId, contactId, dueAt])
  @@index([evidencePhotoId])
  @@map("mtm_commitments")
}

model MtmCommitmentFulfillment {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commitmentId        String               @unique
  commitment          MtmCommitment        @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  agentId             String
  agent               MtmAgent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientFulfillmentId String
  outcome             MtmCommitmentOutcome
  actualQuantity      Decimal              @db.Decimal(14, 2)
  varianceQuantity    Decimal              @db.Decimal(14, 2)
  note                String?
  evidencePhotoId     String?
  evidencePhoto       MtmPhoto?            @relation("MtmCommitmentFactEvidence", fields: [evidencePhotoId], references: [id], onDelete: SetNull)
  fulfilledAt         DateTime
  createdAt           DateTime             @default(now())

  @@unique([organizationId, agentId, clientFulfillmentId])
  @@index([organizationId, agentId, fulfilledAt])
  @@index([organizationId, commitmentId])
  @@index([evidencePhotoId])
  @@map("mtm_commitment_fulfillments")
}

// MTM Route — daily route plan for agent
model MtmRoute {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  date           DateTime       @db.Date
  name           String?
  externalId     String?
  status           MtmRouteStatus @default(PLANNED)
  version          Int            @default(1)
  publishedVersion Int?
  dedupeKey      String?
  publishedAt    DateTime?
  publishedBy    String?
  totalPoints    Int            @default(0)
  visitedPoints  Int            @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  points           MtmRoutePoint[]
  assignments      MtmRouteAssignment[]
  visits           MtmVisit[]
  changeRequests   MtmRouteChangeRequest[]
  customerRequests MtmCustomerCreateRequest[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([agentId])
  @@index([date])
  @@index([organizationId, dedupeKey])
  /// Hourly day-close sweep: WHERE organizationId = ? AND status IN (...) AND date < ?
  @@index([organizationId, status, date])
  @@map("mtm_routes")
}

// MTM Route Point — single stop in a route
model MtmRoutePoint {
  id          String         @id @default(cuid())
  // Denormalised from the parent route so this table can carry the same
  // tenant_isolation policy as every other MTM table (see MtmRouteAssignment).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeId     String
  route       MtmRoute       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  customerId  String
  customer    MtmCustomer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     MtmContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  orderIndex  Int            @default(0)
  status      MtmPointStatus @default(PENDING)
  /// Point-local optimistic-concurrency version. Route aggregate version remains
  /// canonical for publish/reorder compatibility; this is for independent sync.
  version     Int            @default(1)
  plannedTime DateTime?
  visitedAt   DateTime?
  notes       String?
  /// A soft-deleted point remains a sync tombstone with its final revision.
  deletedAt   DateTime?
  updatedAt   DateTime       @updatedAt

  visits         MtmVisit[]
  changeRequests MtmRouteChangeRequest[]

  @@index([organizationId])
  @@index([routeId])
  @@index([organizationId, routeId, orderIndex])
  @@index([organizationId, updatedAt, id])
  @@index([customerId])
  @@index([contactId])
  @@map("mtm_route_points")
}

// MTM Visit — actual visit to a customer
model MtmVisit {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId         String
  agent           MtmAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  customerId      String
  customer        MtmCustomer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         MtmContact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  routeId         String?
  route           MtmRoute?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routePointId    String?
  routePoint      MtmRoutePoint?     @relation(fields: [routePointId], references: [id], onDelete: SetNull)
  status          MtmVisitStatus     @default(CHECKED_IN)
  checkInAt       DateTime           @default(now())
  checkOutAt      DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkOutLat     Float?
  checkOutLng     Float?
  duration        Int? // minutes
  notes           String?
  outcome         MtmVisitOutcome?
  potential       MtmVisitPotential?
  resultNotes     String?
  nextActionDueAt DateTime?
  tasksCompleted  Int                @default(0)
  tasksTotal      Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  photos                 MtmPhoto[]
  tasks                  MtmTask[]
  participants           MtmVisitParticipant[]
  requirementSnapshot    MtmVisitRequirementSnapshot?
  actionResults          MtmVisitActionResult[]
  commitments            MtmCommitment[]
  documents              MtmDocument[]
  fieldPotentialEvidence MtmFieldPotentialEvidence[]
  pharmacyPromotionExecutions MtmPharmacyPromotionExecution[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([agentId])
  @@index([customerId])
  @@index([contactId])
  @@index([routeId])
  @@index([routePointId])
  @@index([checkInAt])
  // M4-2: composite indexes for analytics hot-path queries
  // Agent visit history: WHERE organizationId AND agentId ORDER BY checkInAt DESC
  @@index([organizationId, agentId, checkInAt])
  // Analytics date-range queries: WHERE organizationId AND createdAt BETWEEN
  @@index([organizationId, createdAt])
  @@map("mtm_visits")
}

// Additive multi-agent assignment. MtmRoute.agentId remains the primary owner
// throughout Phase 1 for legacy web/mobile and analytics compatibility.
model MtmRouteAssignment {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeId        String
  route          MtmRoute               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  role           MtmRouteAssignmentRole @default(PARTICIPANT)
  assignedBy     String?
  assignedAt     DateTime               @default(now())
  removedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([routeId, agentId])
  @@index([organizationId, agentId, removedAt])
  @@index([routeId, role])
  @@map("mtm_route_assignments")
}

model MtmVisitParticipant {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitId        String
  visit          MtmVisit               @relation(fields: [visitId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  role           MtmRouteAssignmentRole @default(PARTICIPANT)
  joinedAt       DateTime               @default(now())
  leftAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([visitId, agentId])
  @@index([organizationId, agentId])
  @@index([visitId, role])
  @@map("mtm_visit_participants")
}

model MtmVisitPolicy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           MtmTeam?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name           String
  visitType      String       @default("DEFAULT")
  priority       Int          @default(100)
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  isActive       Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  actions   MtmVisitPolicyAction[]
  snapshots MtmVisitRequirementSnapshot[]

  @@index([organizationId, teamId, visitType, isActive])
  @@index([organizationId, effectiveFrom, effectiveTo])
  @@map("mtm_visit_policies")
}

model MtmVisitPolicyAction {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId       String
  policy         MtmVisitPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  actionKey      MtmVisitActionKey
  mode           MtmRequirementMode @default(OPTIONAL)
  minCount       Int                @default(1)
  conditions     Json?
  allowWaiver    Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([policyId, actionKey])
  @@index([organizationId, actionKey])
  @@map("mtm_visit_policy_actions")
}

model MtmVisitRequirementSnapshot {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitId        String          @unique
  visit          MtmVisit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  sourcePolicyId String?
  sourcePolicy   MtmVisitPolicy? @relation(fields: [sourcePolicyId], references: [id], onDelete: SetNull)
  resolvedAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  requirements MtmVisitRequirement[]

  @@index([organizationId, resolvedAt])
  @@map("mtm_visit_requirement_snapshots")
}

model MtmVisitRequirement {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotId     String
  snapshot       MtmVisitRequirementSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  actionKey      MtmVisitActionKey
  mode           MtmRequirementMode
  minCount       Int                         @default(1)
  conditions     Json?
  allowWaiver    Boolean                     @default(false)
  createdAt      DateTime                    @default(now())

  actionResults MtmVisitActionResult[]

  @@unique([snapshotId, actionKey])
  @@index([organizationId, actionKey])
  @@map("mtm_visit_requirements")
}

model MtmVisitActionResult {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitId            String
  visit              MtmVisit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  requirementId      String?
  requirement        MtmVisitRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  actionKey          MtmVisitActionKey
  status             MtmVisitActionStatus @default(COMPLETED)
  evidence           Json?
  completedByAgentId String?
  completedByAgent   MtmAgent?            @relation(fields: [completedByAgentId], references: [id], onDelete: SetNull)
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([organizationId, visitId, actionKey])
  @@index([requirementId])
  @@index([completedByAgentId])
  @@map("mtm_visit_action_results")
}

model MtmRouteChangeRequest {
  id                 String             @id @default(cuid())
  organizationId     String
