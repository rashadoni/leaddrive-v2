model StageValidationRule {
  id              String        @id @default(cuid())
  organizationId  String
  pipelineStageId String
  stage           PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Cascade)
  fieldName       String // "valueAmount", "contactId", "notes", "expectedClose"
  ruleType        String // "required", "min_value", "file_attached", "task_completed"
  ruleValue       String? // e.g. "1000" for min_value
  errorMessage    String // Human-readable error
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([organizationId])
  @@index([pipelineStageId])
  @@map("stage_validation_rules")
}

// N5: Salesforce-style declarative validation rules driven by the N4
// formula engine. Distinct from `StageValidationRule` (pipeline-specific,
// rule-type enum). When `condition` evaluates truthy at save-time, the
// save fails (or warns) with `errorMessage`. `errorField` optionally
// names which field the UI should highlight.
model FormulaValidationRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Entity slug: "deal" | "lead" | "contact" | "company" | "ticket" | "task" | "invoice" | "offer" | "contract" | "project"
   */
  entityType     String
  name           String
  description    String?
  /**
   * Formula expression — when truthy, validation fails.
   */
  condition      String
  /**
   * Optional field name to highlight on the form when the rule fails.
   */
  errorField     String?
  errorMessage   String
  /**
   * "error" blocks save; "warning" allows save with surface notice.
   */
  severity       String       @default("error")
  isActive       Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, entityType, isActive])
  @@map("formula_validation_rules")
}

