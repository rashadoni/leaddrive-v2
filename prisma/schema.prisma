  organizationId        String
  ticketNumber          String
  subject               String
  description           String?
  priority              String          @default("medium")
  status                String          @default("new")
  category              String          @default("general")
  categoryId            String?
  categoryRef           TicketCategory? @relation("TicketCategoryTickets", fields: [categoryId], references: [id], onDelete: SetNull)
  contactId             String?
  contact               Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId                String? // set by writers when the ticket is tied to a lead (Slice 3 lead timeline)
  companyId             String?
  company               Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo            String?
  createdBy             String?
  slaDueAt              DateTime?
  slaFirstResponseDueAt DateTime?
  slaPolicyName         String?
  firstResponseAt       DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  satisfactionRating    Int?
  satisfactionComment   String?
  source                String? // portal | email | whatsapp | web_chat | facebook | instagram | agent | telegram — used to route survey invites back to the original channel
  sourceMeta            Json? // channel-specific context: whatsapp phone, web_chat sessionId, fb/ig externalId
  requesterName         String?
  requesterEmail        String?
  requesterPhone        String?
  requesterExternalId   String?
  requesterMeta         Json?
  tags                  String[]        @default([])
  escalationLevel       Int             @default(0)
  lastEscalatedAt       DateTime?
  handleTimeSeconds     Int             @default(0)
  reopenCount           Int             @default(0) // # times this ticket went terminal (resolved/closed) → active again; feeds the KPI Arena reopen-rate
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  comments        TicketComment[]
  callLogs        CallLog[]
  complaintMeta   ComplaintMeta?
  closureRequests TicketClosureRequest[]

  // B10 Entitlement Process
  entitlementMilestones EntitlementTicketMilestone[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status])
  @@index([organizationId, assignedTo])
  @@index([organizationId, categoryId])
  @@index([organizationId, source])
  @@index([organizationId, createdAt])
  @@index([organizationId, resolvedAt])
  @@index([organizationId, closedAt])
  @@index([organizationId, slaDueAt])
  @@index([organizationId, leadId])
