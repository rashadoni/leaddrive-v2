// Canned/saved replies for the inbox composer (E3.1, respond.io-style "/" snippets).
// Distinct from TicketMacro (which is action-based): a snippet is pure text inserted
// via a "/shortcut" typeahead, with {{contact.name}} / {{agent.name}} variables
// substituted at insert-time. Org-shared library; `channelTypes` empty = all channels.
model MessageSnippet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shortcut       String // text typed after "/" to insert this snippet (unique per org)
  title          String
  body           String       @db.Text
  channelTypes   String[]     @default([]) // empty = all channels; else e.g. ["whatsapp","telegram"]
  isActive       Boolean      @default(true)
  usageCount     Int          @default(0)
  sortOrder      Int          @default(0)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, shortcut])
  @@index([organizationId])
  @@map("message_snippets")
}

/// Phase 7 (inbox redesign) — inbound auto-reply rules. A rule matches an inbound
/// ChannelMessage (by channel + trigger) and defines a canned text reply. slice-1
/// is the rule store + matcher + management API ONLY; wiring the matcher into the
/// webhook ingest + actually sending the reply is slice-2 (touches shared ingest/
/// send paths). No org FK (orphan-on-delete, same choice as InboxFolder) to keep
/// the change localized; org scoping is enforced in every route via organizationId.
model ChatbotRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  status         String   @default("draft") // draft | active | paused — only "active" rules fire
  channelTypes   String[] @default([]) // empty = all channels; else subset of email/telegram/sms/whatsapp/facebook/instagram
  triggerType    String   @default("contains") // contains | exact | starts_with | always
  triggerValue   String? // contains: comma-separated terms (match ANY); ignored for "always"
  responseText   String // the auto-reply body (plain text; richer responses are a later slice)
  priority       Int      @default(0) // higher = evaluated first; ties broken by createdAt asc
  matchCount     Int      @default(0)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("chatbot_rules")
}

