/// Durable, operator-triggered Social Monitoring batch. The browser creates a
/// job and observes it; cron workers own all source dispatch and reconciliation.
model SocialMonitoringRunJob {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind                 String // PROFILE_FULL | SOURCE_FULL | WEB_NEWS
  sourceScope          String? // null for PROFILE_FULL; OWNED | EXTERNAL for watchlist jobs
  status               String       @default("QUEUED") // QUEUED | RUNNING | WAITING_PROVIDER | CANCEL_REQUESTED | CANCELED | COMPLETED | COMPLETED_WITH_ISSUES | FAILED
  idempotencyKey       String
  requestedBy          String
  fullArchiveConfirmed Boolean      @default(false)
  paidConfirmed        Boolean      @default(false)
  sharedConfirmed      Boolean      @default(false)
  totalItems           Int
  paidItems            Int          @default(0)
  sharedItems          Int          @default(0)
  failureCount         Int          @default(0)
  nextAttemptAt        DateTime?
  leaseToken           String?
  leaseExpiresAt       DateTime?
  cancelRequestedAt    DateTime?
  error                String?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  items SocialMonitoringRunJobItem[]

  @@unique([organizationId, id], map: "social_monitoring_run_jobs_org_id_key")
  @@unique([organizationId, idempotencyKey], map: "social_monitoring_run_jobs_org_idempotency_key")
  @@index([status, nextAttemptAt, leaseExpiresAt, updatedAt, createdAt], map: "social_monitoring_run_jobs_queue_idx")
  @@index([organizationId, createdAt], map: "social_monitoring_run_jobs_org_created_idx")
  @@map("social_monitoring_run_jobs")
}

/// One stable profile/source (or watchlist source) position in a durable batch.
/// A shared physical source intentionally appears more than once when its
/// subject/scenario target differs.
model SocialMonitoringRunJobItem {
  id                        String                 @id @default(cuid())
  organizationId            String
  organization              Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId                     String
  job                       SocialMonitoringRunJob @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)
  position                  Int
  subjectId                 String?
  scenarioId                String?
  profileName               String?
  sourceId                  String
  sourceLabel               String
  sourcePlatform            String
  status                    String                 @default("QUEUED") // QUEUED | RUNNING | WAITING_PROVIDER | SUCCEEDED | PARTIAL | SKIPPED | FAILED | TIMED_OUT
  paid                      Boolean                @default(false)
  providerAccountFundedOnly Boolean                @default(false)
  sharedAcrossMonitorings   Boolean                @default(false)
  maxTotalChargeUsd         Decimal?               @db.Decimal(12, 6)
  onlyCapability            String?
  includeComments           Boolean                @default(false)
  fullArchiveRun            Boolean                @default(false)
  attemptCount              Int                    @default(0)
  nextAttemptAt             DateTime?
  providerDeadlineAt        DateTime?
  terminalObservedAt        DateTime?
  leaseToken                String?
  leaseExpiresAt            DateTime?
  collectorRunId            String?
  providerRunIds            String[]               @default([])
  collectorResult           Json?
  foundCount                Int                    @default(0)
  newCount                  Int                    @default(0)
  duplicateCount            Int                    @default(0)
  acceptedCount             Int                    @default(0)
  reviewCount               Int                    @default(0)
  rejectedCount             Int                    @default(0)
  ignoredCount              Int                    @default(0)
  error                     String?
  startedAt                 DateTime?
  finishedAt                DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@unique([organizationId, id], map: "social_monitoring_run_job_items_org_id_key")
  @@unique([organizationId, jobId, position], map: "social_monitoring_run_job_items_org_job_position_key")
  @@index([organizationId, jobId, status, position], map: "social_monitoring_run_job_items_job_status_idx")
  @@index([status, nextAttemptAt, leaseExpiresAt], map: "social_monitoring_run_job_items_queue_idx")
  @@map("social_monitoring_run_job_items")
}

