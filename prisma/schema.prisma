  @@unique([organizationId, eventId], map: "event_outbox_org_event_key")
  @@index([organizationId, createdAt, id], map: "event_outbox_org_created_idx")
  @@index([createdAt, id], map: "event_outbox_created_idx")
  @@map("event_outbox")
}

model ConsumerInbox {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String
