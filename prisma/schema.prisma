  openedAt       DateTime?
  clickedAt      DateTime?
  /// RFC In-Reply-To of an INBOUND email (E1/E2 sequence threading: lets a
  /// follow-up thread from the recipient's own reply).
  inReplyTo      String?
  /// E4/E5 — set on cadence (sales-sequence) emails: powers the daily-send
  /// limit count and the per-step delivery/reply stats. Null for all other mail.
  sequenceId     String?
  /**
   * H6 Einstein Email Insights — versioned analysis payload
   * (sentiment / intent / urgency / signals / suggested actions).
   * Slice 1: written by the analyze route with a PLACEHOLDER_LLM
   * sentinel; slice 2 wires the Anthropic SDK + IMAP receive hook.
   */
  insights       Json?
  insightsAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, contactId])
  @@index([organizationId, leadId])
  @@index([variantId])
  // Backs the inbound-email idempotency probe (email-inbound dedup): findFirst by
  // (organizationId, messageId) on the hot inbound webhook path — without it that's an
  // org-index scan + messageId filter.
  @@index([organizationId, messageId])
  // M10 slice-3 prereq — content-perf-refresh cron's per-template
  // `groupBy({by: templateId, where: {organizationId}})` was a seq scan
  // without this composite. ~140-byte-per-row index, modest cost.
  @@index([organizationId, templateId])
  // E4 daily-send-limit count: emails of THIS org's sequences sent today.
  @@index([organizationId, sequenceId, createdAt])
  @@map("email_logs")
}

