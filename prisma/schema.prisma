}

model BudgetPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  periodType     String       @default("monthly") // monthly | quarterly | annual
  year           Int
  month          Int?
  quarter        Int?
  status         String       @default("draft") // draft | pending_approval | approved | rejected | closed
  notes          String?
  submittedBy    String?
  submittedAt    DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  amendmentOf    String? // ID of plan this amends (version chain root)
  version        Int          @default(1)
  versionLabel   String? // "v1", "v2 (Q1 revision)"
  snapshotData   Json? // full snapshot for versioning: { lines: [...] }
  isRolling      Boolean      @default(false)
  rollingMonths  Int          @default(12)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines                 BudgetLine[]
  actuals               BudgetActual[]
  sections              BudgetSection[]
  forecastEntries       BudgetForecastEntry[]
  approvalComments      BudgetApprovalComment[]
  accountingImports     AccountingImport[]
  rollingForecastMonths RollingForecastMonth[]

  @@index([organizationId])
  @@map("budget_plans")
}

model BudgetLine {
  id             String            @id @default(cuid())
  organizationId String
  planId         String
  plan           BudgetPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  category       String
  department     String?
  lineType       String            @default("expense") // expense | revenue | cogs
  lineSubtype    String? // service | product | cogs | null
  plannedAmount  Float             @default(0)
  forecastAmount Float?
  unitPrice      Float? // For product lines: price per unit
  unitCost       Float? // For COGS: cost per unit
  quantity       Int? // For product/COGS: number of units
  costModelKey   String? // e.g. "grandTotalG", "deptCosts.IT", "serviceRevenues.total"
  isAutoPlanned  Boolean           @default(true) // true = план из cost model + SalesForecast
  isAutoActual   Boolean           @default(false)
  costTypeId     String?
  costType       BudgetCostType?   @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  vatIncluded    Boolean           @default(false) // true = amount includes VAT
  vatRate        Float? // e.g. 0.18 for 18% — null means no VAT applicable
  amountExVat    Float? // computed: plannedAmount / (1 + vatRate) when vatIncluded=true
  currencyCode   String? // "USD", "EUR", null = base currency
  exchangeRate   Float? // rate at time of entry (e.g. 1.70 for 1 USD = 1.70 AZN)
  originalAmount Float? // amount in original currency
  notes          String?
  sortOrder      Int               @default(0)
  parentId       String?
  parent         BudgetLine?       @relation("LineChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       BudgetLine[]      @relation("LineChildren")

  @@index([organizationId])
  @@index([planId])
  @@index([parentId])
  @@index([costTypeId])
  @@index([departmentId])
  @@map("budget_lines")
}

model BudgetActual {
  id             String            @id @default(cuid())
  organizationId String
  planId         String
  plan           BudgetPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  category       String
  department     String?
  lineType       String            @default("expense")
  actualAmount   Float             @default(0)
  expenseDate    String?
  description    String?
  currencyCode   String? // "USD", "EUR", null = base currency
  exchangeRate   Float? // rate at time of entry
  originalAmount Float? // amount in original currency
  costTypeId     String?
  costType       BudgetCostType?   @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([planId])
  @@index([costTypeId])
  @@index([departmentId])
  @@map("budget_actuals")
}

model BudgetSection {
  id             String     @id @default(cuid())
  organizationId String
  planId         String
  plan           BudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name           String
  sectionType    String     @default("expense") // revenue | expense | gross_profit | ebitda
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([organizationId])
  @@index([planId])
  @@map("budget_sections")
}

model BudgetForecastEntry {
  id             String            @id @default(cuid())
  organizationId String
  planId         String
  plan           BudgetPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  category       String
  lineType       String            @default("expense")
  forecastAmount Float             @default(0)
  costTypeId     String?
  costType       BudgetCostType?   @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([planId, year, month, category, lineType])
  @@index([organizationId])
  @@index([planId])
  @@index([costTypeId])
  @@index([departmentId])
  @@map("budget_forecast_entries")
}

model BudgetDirectionTemplate {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  description    String?
  lineType       String            @default("revenue") // revenue | expense | cogs
  lineSubtype    String? // service | product | cogs
  defaultAmount  Float             @default(0)
  unitPrice      Float?
  unitCost       Float?
  quantity       Int?
  costModelKey   String?
  department     String?
  costTypeId     String?
  costType       BudgetCostType?   @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([costTypeId])
  @@index([departmentId])
  @@map("budget_direction_templates")
}

model SalesForecast {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  budgetDept     BudgetDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year           Int
  month          Int // 1-12
  amount         Float            @default(0) // monthly revenue forecast (excl. VAT, AZN)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, departmentId, year, month])
  @@index([organizationId])
  @@index([organizationId, year])
  @@map("sales_forecasts")
}

model ExpenseForecast {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costTypeId     String
  budgetCostType BudgetCostType    @relation(fields: [costTypeId], references: [id], onDelete: Cascade)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year           Int
  month          Int // 1-12
  amount         Float             @default(0) // monthly expense forecast (AZN)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([organizationId, year])
  @@index([organizationId, costTypeId, departmentId, year, month])
  @@map("expense_forecasts")
}

// ═══════════════════════════════════════════════════
// BUDGET ACCESS CONTROL & APPROVAL
// ═══════════════════════════════════════════════════

model BudgetDepartmentOwner {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  budgetDept     BudgetDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  canEdit        Boolean          @default(true)
  canApprove     Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@unique([organizationId, departmentId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("budget_department_owners")
}

model BudgetApprovalComment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           BudgetPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId         String
  userName       String
  status         String // submitted | review | approved | rejected | comment
  comment        String
  createdAt      DateTime     @default(now())

  @@index([planId, createdAt])
  @@index([organizationId])
  @@map("budget_approval_comments")
}

model SocialConversation {
  id                         String    @id @default(cuid())
  organizationId             String
  /// Trash, not destruction. Messages, the lead this produced and the audit
  /// trail all still point at this row, so a mistaken delete stays reversible.
  deletedAt                  DateTime?
  deletedBy                  String?
  channelConfigId            String?
  platform                   String // whatsapp | telegram | facebook | instagram | vkontakte | email | sms
  externalId                 String // platform-specific thread ID
  contactId                  String?
  contactName                String    @default("")
  contactAvatar              String?
  status                     String    @default("open") // open | resolved | archived
  closedAt                   DateTime? // stamped when the operator closes the thread
  closeOutcome               String? // won | lost | none — operator disposition at close (analytics)
  closeOutcomeReason         String? // optional internal note about the outcome (NOT the farewell)
  customerStage              String? // interested | potential | marketing_contacted | sales_contacted | unable_to_contact | sold | not_sold | no_result
  salesCallOutcomes          String[]  @default([]) // current salesperson-confirmed lead qualification signals mirrored from the linked Lead
  customerStageSource        String? // agent | lead | ai | system | backfill
  customerStageConfidence    Float?
  customerStageReason        String?
  customerStageUpdatedAt     DateTime?
  customerStageUpdatedBy     String?
  aiSuggestedCustomerStage   String?
  aiCustomerStageConfidence  Float?
  aiCustomerStageReason      String?
  aiCustomerStageSuggestedAt DateTime?
  tags                       String[]  @default([]) // respond.io-style inbox labels for filtering/routing
  unreadCount                Int       @default(0)
  lastMessage                String    @default("")
  lastMessageAt              DateTime  @default(now())
  assignedTo                 String?
  snoozedUntil               DateTime? // Phase 2 (Option-D) — null = active; > now() = snoozed until that time
  followUpSentAt             DateTime? // 24h-silence auto-follow-up: stamped (atomic claim) when the nudge was sent; null = not yet. One per conversation.
  aiReplyClaimedAt           DateTime? // AI auto-reply tight-loop guard: atomic per-conversation claim (updateMany WHERE null|<window). Serializes concurrent duplicate inbound so a customer can never get two AI replies for one tap.
  aiReplyClaimToken          String? // Owner token for the active AI-reply lease; release must compare-and-set this token.
  aiReplyClaimedUntil        DateTime? // Lease expiry. Flow ai_reply can hold longer than webhook tight-loop without webhook reclaiming it after 8s.
  aiReplyPendingMessageId    String? // Wake marker: at least one inbound arrived while an AI reply lease was active. ChannelMessage rows remain the durable ordered queue.
  folderId                   String? // Phase 5 — team folder (null = no folder)
  metadata                   Json      @default("{}")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  messages            ChannelMessage[]
  notes               ConversationNote[]
  participants        ConversationParticipant[]
  callLogs            CallLog[]
  customerStageEvents InboxCustomerStageEvent[]
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConfig       ChannelConfig?            @relation(fields: [channelConfigId], references: [id])

  @@unique([organizationId, platform, externalId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, snoozedUntil])
  @@index([organizationId, closeOutcome])
  @@index([organizationId, customerStage])
  @@map("social_conversations")
}

model InboxCustomerStageEvent {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String
  fromStage      String?
  toStage        String
  source         String
  confidence     Float?
  reason         String?
  changedBy      String?
  createdAt      DateTime @default(now())

  conversation SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([conversationId, createdAt])
  @@map("inbox_customer_stage_events")
}

/// Conversation collaborators — internal users added to an inbox conversation so the
/// conversation is surfaced to them ("Со мной" view) and they get notified of new
/// messages. Visibility model B: this does NOT restrict who can see the conversation
/// (the team still sees all); it only surfaces + notifies. The external customer never
/// sees participants. Keyed to the persisted SocialConversation (mirrors ConversationNote).
model ConversationParticipant {
  id                   String   @id @default(cuid())
  organizationId       String
  socialConversationId String
  userId               String // the internal participant (a User in this org)
  addedBy              String? // the user who added them
  createdAt            DateTime @default(now())

  conversation SocialConversation @relation(fields: [socialConversationId], references: [id], onDelete: Cascade)

  @@unique([socialConversationId, userId])
  @@index([organizationId, userId])
  @@map("conversation_participants")
}

/// E1 — Conversation Automation Engine: a visual chat-automation flow (respond.io-style).
/// `graph` holds the @xyflow node/edge JSON the builder produces. DARK until the runner
/// + inbox event wiring (E1.1c) consume it — landing the table alone triggers nothing.
model ConversationFlow {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  status         String       @default("draft") // draft | active | paused
  trigger        String       @default("conversation_opened") // conversation_opened | message_inbound | conversation_idle
  channelTypes   String[]     @default([]) // empty = all channels
  graph          Json         @default("{}") // { nodes: [...], edges: [...] }
  version        Int          @default(1)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  runs ConversationFlowRun[]

  @@index([organizationId])
  @@index([organizationId, status, trigger])
  @@map("conversation_flows")
}

/// E1 — one execution of a ConversationFlow against one conversation. Tracks the current
/// node + accumulated state so the runner can resume across events.
model ConversationFlowRun {
  id             String           @id @default(cuid())
  organizationId String
  flowId         String
  flow           ConversationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversationId String // SocialConversation.id (loose ref — conversations are per-platform)
  status         String           @default("running") // running | completed | failed
  currentNodeId  String?
  state          Json             @default("{}")
  startedAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([flowId])
  @@index([organizationId, conversationId])
  @@map("conversation_flow_runs")
}

/// E1.2 — inbox conversation routing queues. These are separate from TicketQueue:
/// TicketQueue routes support tickets; TeamQueue routes live SocialConversation rows
/// from ConversationFlow `assign_to_queue` nodes.
model TeamQueue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  skillTags      String[]     @default([]) // empty = any available non-viewer user
  strategy       String       @default("least_loaded") // least_loaded | round_robin | skill_match
  lastAssignedTo String?
  isActive       Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("team_queues")
}

/// N2 — per-org / per-channel business hours for inbox automation. `channelType = "all"`
/// is the org-wide fallback; exact channel rows override it. This is a backend foundation:
/// no webhook sends are changed unless a ConversationFlow explicitly uses the gate/template.
model BusinessHours {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelType    String       @default("all") // all | whatsapp | telegram | email | sms | ...
  timezone       String       @default("UTC")
  schedule       Json         @default("{}") // { mon: {enabled, intervals:[{start,end}] }, ... }
  holidays       Json         @default("[]") // [{ date:"YYYY-MM-DD", name?, intervals? }]
  isActive       Boolean      @default(true)
  welcomeMessage String?      @db.Text
  awayMessage    String?      @db.Text
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, channelType])
  @@index([organizationId, isActive])
  @@map("business_hours")
}

/// Phase 3b — internal agent notes on an inbox conversation (private, not sent
/// to the customer). Keyed to the persisted SocialConversation (Option-D).
model ConversationNote {
  id                   String   @id @default(cuid())
  organizationId       String
  socialConversationId String
  authorId             String?
  authorName           String   @default("")
  body                 String
  createdAt            DateTime @default(now())

  conversation SocialConversation @relation(fields: [socialConversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, socialConversationId, createdAt])
  @@map("conversation_notes")
}

/// Phase 5 — team folders for the inbox (e.g. Design, Finance). A conversation
/// references one via SocialConversation.folderId (no FK constraint — deleting a
/// folder just orphans the reference, which the UI treats as "no folder").
model InboxFolder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, sortOrder])
  @@map("inbox_folders")
}

// ═══════════════════════════════════════════════════
// PROJECT MANAGEMENT (ERP Module)
// ═══════════════════════════════════════════════════

model Project {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  code                 String? // e.g. "PRJ-001"
  description          String?
  status               String       @default("planning") // planning, active, on_hold, completed, cancelled
  priority             String       @default("medium") // low, medium, high, critical
  startDate            DateTime?
  endDate              DateTime?
  actualStartDate      DateTime?
  actualEndDate        DateTime?
  budget               Float        @default(0)
  actualCost           Float        @default(0)
  currency             String       @default("AZN")
  completionPercentage Int          @default(0)
  managerId            String?
  manager              User?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  companyId            String?
  company              Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId               String?
  deal                 Deal?        @relation("ProjectDeal", fields: [dealId], references: [id], onDelete: SetNull)
  color                String       @default("#6366f1")
  tags                 String[]     @default([])
  createdBy            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  members     ProjectMember[]
  milestones  ProjectMilestone[]
  tasks       ProjectTask[]
  linkedTasks Task[]             @relation("ProjectLinkedTasks")

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([companyId])
  @@map("projects")
}

model ProjectMember {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  role           String   @default("member") // manager, member, viewer
  hourlyRate     Float?   @default(0)
  hoursLogged    Float    @default(0)
  joinedAt       DateTime @default(now())

  @@unique([projectId, userId])
  @@index([organizationId])
  @@index([projectId])
  @@map("project_members")
}

model ProjectMilestone {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  dueDate        DateTime?
  completedAt    DateTime?
  status         String    @default("pending") // pending, in_progress, completed, overdue
  color          String    @default("#6366f1")
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  tasks ProjectTask[]

  @@index([projectId])
  @@index([organizationId])
  @@map("project_milestones")
}

model ProjectTask {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId    String?
  milestone      ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         ProjectTask?      @relation("SubTasks", fields: [parentId], references: [id], onDelete: SetNull)
  children       ProjectTask[]     @relation("SubTasks")
  title          String
  description    String?
  status         String            @default("todo") // todo, in_progress, review, done, cancelled
  priority       String            @default("medium")
  assignedTo     String?
  assignee       User?             @relation("ProjectTaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  estimatedHours Float?            @default(0)
  actualHours    Float             @default(0)
  completedAt    DateTime?
  sortOrder      Int               @default(0)
  tags           String[]          @default([])
  createdBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([projectId])
  @@index([organizationId])
  @@index([milestoneId])
  @@index([parentId])
  @@index([assignedTo])
  @@map("project_tasks")
}

// ═══════════════════════════════════════════════════
// FINANCE MODULE (A/P, Funds)
// ═══════════════════════════════════════════════════

model Bill {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billNumber     String
  vendorName     String
  vendorId       String?
  vendor         Company?     @relation("VendorBills", fields: [vendorId], references: [id], onDelete: SetNull)
  title          String
  status         String       @default("draft") // draft, pending, partially_paid, paid, overdue, cancelled
  /// Stored as NUMERIC(18,4) — migrated from Float in 20260525280000_bill_money_decimal
  /// to eliminate IEEE-754 drift in vendor payment arithmetic.
  totalAmount    Decimal      @default(0) @db.Decimal(18, 4)
  paidAmount     Decimal      @default(0) @db.Decimal(18, 4)
  balanceDue     Decimal      @default(0) @db.Decimal(18, 4)
  currency       String       @default("AZN")
  issueDate      DateTime     @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  category       String? // "rent", "software", "services", "equipment"
  notes          String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments BillPayment[]

  @@unique([organizationId, billNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, vendorId])
  @@map("bills")
}

model BillPayment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billId         String
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  /// Stored as NUMERIC(18,4) — migrated from Float in 20260525280000_bill_money_decimal.
  amount         Decimal      @db.Decimal(18, 4)
  currency       String       @default("AZN")
  paymentMethod  String       @default("bank_transfer")
  paymentDate    DateTime     @default(now())
  reference      String?
  notes          String?
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([billId])
  @@index([organizationId])
  @@map("bill_payments")
}

model Fund {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // "Tax Reserve", "Payroll Buffer", "Emergency", "Dividends"
  description    String?
  /// Exact monetary storage. Migrated from Float by
  /// 20260901100000_fund_event_source_pilot.
  targetAmount   Decimal?     @db.Decimal(18, 4)
  /// Compatibility projection rebuilt from the canonical Fund event stream.
  currentBalance Decimal      @default(0) @db.Decimal(18, 4)
  currency       String       @default("AZN")
  color          String?
  isActive       Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions FundTransaction[]
  rules        FundRule[]
  balanceProjections FundBalanceProjection[]

  @@unique([organizationId, id], map: "funds_org_id_key")
  @@index([organizationId])
  @@map("funds")
}

model FundTransaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundId         String
  fund           Fund         @relation(fields: [organizationId, fundId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade, map: "fund_transactions_organizationId_fundId_fkey")
  type           String // "deposit" | "withdrawal" | "transfer_in" | "transfer_out" | "auto_allocation"
  /// Exact ledger amount. A DB trigger makes this compatibility ledger
  /// append-only after the event-source pilot migration.
  amount         Decimal      @db.Decimal(18, 4)
  description    String?
  relatedType    String? // "invoice_payment", "manual", "rule"
  relatedId      String?
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([fundId])
  @@map("fund_transactions")
}

model FundBalanceProjection {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fundId            String
  fund              Fund         @relation(fields: [organizationId, fundId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade, map: "fund_balance_projections_fundId_fkey")
  projectionVersion Int
  buildKey          String
  status            String       @default("shadow")
  balance           Decimal      @db.Decimal(18, 4)
  currency          String
  aggregateVersion  BigInt
  lastEventId       String?      @db.Uuid
  evidence          Json         @default("{}")
  createdAt         DateTime     @default(now())
  promotedAt        DateTime?

  @@unique([organizationId, fundId, projectionVersion, buildKey], map: "fund_balance_projections_build_key")
  @@index([organizationId, status, fundId], map: "fund_balance_projections_status_idx")
  @@map("fund_balance_projections")
}

model FundRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundId         String
  fund           Fund         @relation(fields: [fundId], references: [id], onDelete: Cascade)
  name           String
  triggerType    String // "revenue_percentage" | "fixed_monthly" | "invoice_paid"
  percentage     Float? // for revenue_percentage: 0.10 = 10%
  fixedAmount    Float? // for fixed_monthly
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([fundId])
  @@map("fund_rules")
}

// ============================================================
// Bank Accounts
// ============================================================

model BankAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accountName   String
  accountNumber String?
  bankName      String
  bankCode      String?
  swiftCode     String?
  currency      String  @default("AZN")
  isDefault     Boolean @default(false)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("bank_accounts")
}

// ============================================================
// Payment Registry & Payment Orders
// ============================================================

model PaymentRegistryEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  direction String // "incoming" | "outgoing"
  amount    Float
  currency  String @default("AZN")

  counterpartyName String
  counterpartyId   String?

  sourceType String // "bill_payment" | "invoice_payment" | "fund_transaction" | "payment_order"
  sourceId   String

  billId    String?
  invoiceId String?
  fundId    String?

  category    String? // "vendor_payment" | "revenue" | "fund_allocation" | "manual"
  paymentDate DateTime
  description String?

  createdBy String?
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, direction])
  @@index([organizationId, paymentDate])
  @@index([organizationId, sourceType, sourceId])
  @@map("payment_registry_entries")
}

model PaymentOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orderNumber      String
  counterpartyName String
  counterpartyId   String?

  billId        String?
  bankAccountId String?
  amount        Float
  currency      String  @default("AZN")

  purpose       String
  paymentMethod String  @default("bank_transfer")
  bankDetails   String?

  status String @default("draft") // "draft" | "pending_approval" | "approved" | "executed" | "rejected" | "cancelled"

  createdBy       String?
  approvedBy      String?
  approvedAt      DateTime?
  executedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("payment_orders")
}

