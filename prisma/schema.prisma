  periodStart       DateTime      @db.Date
  customerId        String?
  customer          MtmCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agentId           String?
  agent             MtmAgent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  territoryCode     String?
  productCode       String?
  plannedQuantity   Decimal?      @db.Decimal(18, 4)
  plannedAmount     Decimal?      @db.Decimal(18, 4)
  currency          String        @default("AZN")
  sourceImportJobId String?
  sourceImportJob   MtmImportJob? @relation(fields: [sourceImportJobId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, periodStart])
  @@index([organizationId, customerId, periodStart])
  @@index([organizationId, agentId, periodStart])
  @@index([sourceImportJobId])
  @@map("mtm_sales_plan_lines")
}

// MTM Task — task assigned to agent
model MtmTask {
  id                 String                 @id @default(cuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId            String
  agent              MtmAgent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           MtmCustomer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visitId            String?
  visit              MtmVisit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  taskGroupDictionaryId String?
  taskGroupDictionary   MtmContactDictionary? @relation("MtmTaskGroupDictionary", fields: [organizationId, taskGroupDictionaryId], references: [organizationId, id], onDelete: Restrict)
  taskGroupCode         String?
  sourceKey          String?
  title              String
  description        String?
  status             MtmTaskStatus          @default(PENDING)
  priority           MtmTaskPriority        @default(MEDIUM)
  // Planned start belongs to the task schedule. `startedAt` below remains the
  // factual execution timestamp and must never be reused as a planning field.
  scheduledStartAt   DateTime?
  dueDate            DateTime?
  completedAt        DateTime?
  result             String?
  progress           Int?
  returnReason       String?
  version            Int                    @default(1)
  acceptedAt         DateTime?
  startedAt          DateTime?
  recurrenceRule     MtmTaskRecurrenceRule?
  recurrenceInterval Int?
  recurrenceUntil    DateTime?
  // IANA timezone pinned when the recurrence rule is authored. This keeps
  // tenant-local wall time stable across DST and later tenant-setting changes.
  recurrenceTimezone               String?
  // A THIS_AND_FUTURE edit can re-anchor a series without rewriting its
  // completed root. Generated children inherit these resolved pivot moments.
  recurrenceAnchorScheduledStartAt DateTime?
  recurrenceAnchorDueDate          DateTime?
  // Immutable planned identity of this particular occurrence. A THIS-only
  // exception may change the visible schedule without moving the series cursor.
  recurrenceCursorScheduledStartAt DateTime?
  recurrenceCursorDueDate          DateTime?
  recurrenceParentId               String?
  recurrenceParent                 MtmTask?               @relation("MtmTaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren               MtmTask[]              @relation("MtmTaskRecurrence")
  copiedFromId       String?
  copiedFrom         MtmTask?               @relation("MtmTaskCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies             MtmTask[]              @relation("MtmTaskCopies")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  events    MtmTaskEvent[]
  documents MtmDocument[]

  @@index([organizationId])
  @@index([agentId])
  @@index([customerId])
  @@index([visitId])
  @@index([organizationId, taskGroupDictionaryId, taskGroupCode])
  @@index([organizationId, agentId, status, dueDate])
  @@index([recurrenceParentId])
  @@index([copiedFromId])
  @@index([organizationId, sourceKey])
  @@map("mtm_tasks")
}

// Immutable mobile-visible task timeline. The sync operation pins each client
// event, while clientEventId prevents a replay from duplicating the timeline.
model MtmTaskEvent {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String
  task           MtmTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientEventId  String?
  type           MtmTaskEventType
  occurredAt     DateTime
  comment        String?
  evidence       Json?
  fromStatus     MtmTaskStatus?
  toStatus       MtmTaskStatus?
  oldDueDate     DateTime?
  newDueDate     DateTime?
  createdAt      DateTime         @default(now())

  @@unique([organizationId, agentId, clientEventId])
  @@index([organizationId, agentId, occurredAt])
  @@index([taskId, occurredAt])
  @@map("mtm_task_events")
}

// One organization-local field shift per agent and date. Every transition is
// also recorded in MtmAgentWorkdayEvent so offline replay remains auditable.
model MtmAgentWorkday {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId            String
  agent              MtmAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workDate           DateTime         @db.Date
  status             MtmWorkdayStatus @default(STARTED)
  startedAt          DateTime
  pausedAt           DateTime?
  completedAt        DateTime?
  totalPausedSeconds Int              @default(0)
  startLatitude      Float?
  startLongitude     Float?
  endLatitude        Float?
  endLongitude       Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  events             MtmAgentWorkdayEvent[]
  correctionRequests MtmHrmRequest[]
  locations          MtmAgentLocation[]
  workforcePolicySnapshot WorkforcePolicySnapshot?       @relation("WorkforcePolicySnapshotWorkday")
  workforceShiftSnapshot  WorkforceShiftSnapshot?        @relation("WorkforceShiftSnapshotWorkday")
  workforceExceptions     WorkforceAttendanceException[]
  workforceAttendanceReviewCases WorkforceAttendanceReviewCase[]
  workforceTimeCorrections WorkforceTimeCorrection[]

  @@unique([organizationId, agentId, workDate])
  @@unique([organizationId, id])
  @@index([organizationId, workDate])
  @@index([organizationId, agentId, status])
  @@map("mtm_agent_workdays")
}

model MtmAgentWorkdayEvent {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workdayId      String
  workday        MtmAgentWorkday     @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  clientEventId  String?
  type           MtmWorkdayEventType
  /// Client-declared attendance action time. `occurredAt` remains the
  /// compatibility field and is required to equal this value for C1+ writes.
  claimedAt      DateTime?
  /// When the client captured the action's local evidence/context.
  capturedAt     DateTime?
  /// When the client placed the action in its durable outbox. Null only for
  /// legacy v1 adapters that did not expose provenance.
  queuedAt         DateTime?
  /// Set only by the receiving server; never trusted from a client envelope.
  serverReceivedAt DateTime?
  /// Instant at which the canonical state transition was accepted in its
  /// transaction. It remains distinct from client claim/capture time.
  appliedAt        DateTime?
  /// Legacy adapter writes use v1; v2 requires explicit client provenance.
  schemaVersion    Int                 @default(1)
  /// SHA-256 of actor/action/provenance/evidence references. This detects an
  /// altered payload under an already-used clientEventId without storing raw
  /// QR or device proof.
  requestHash      String?             @db.VarChar(64)
  /// C1 review state derived only by the server from claim/receipt evidence.
  attendanceReviewState WorkforceAttendanceClaimReviewState @default(LEGACY_UNKNOWN)
  attendanceReviewReasonCode String?   @db.VarChar(64)
  occurredAt     DateTime
  latitude       Float?
  longitude      Float?
  accuracy       Float?
  note           String?
  createdAt      DateTime            @default(now())

  workforceAttendanceVerifications WorkforceAttendanceVerification[]
  workforceAttendanceReviewCase WorkforceAttendanceReviewCase?

  @@unique([organizationId, agentId, clientEventId])
  @@unique([organizationId, id])
  @@index([organizationId, agentId, occurredAt])
  @@index([organizationId, agentId, serverReceivedAt])
  @@index([organizationId, agentId, attendanceReviewState, serverReceivedAt])
  @@index([workdayId, occurredAt])
  @@map("mtm_agent_workday_events")
}

/// A separate, tenant-scoped review queue for a server-identified attendance
/// claim risk. It references immutable workday provenance; no raw location,
/// token, device signature or biometric material is copied into the case.
model WorkforceAttendanceReviewCase {
  id                String                              @id @default(cuid())
  organizationId    String
  organization      Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId           String
  agent             MtmAgent                            @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict)
  workdayId         String
  workday           MtmAgentWorkday                     @relation(fields: [organizationId, workdayId], references: [organizationId, id], onDelete: Restrict)
  workdayEventId    String
  workdayEvent      MtmAgentWorkdayEvent                @relation(fields: [organizationId, workdayEventId], references: [organizationId, id], onDelete: Restrict)
  status            WorkforceAttendanceReviewCaseStatus @default(PENDING_REVIEW)
  reasonCode        String                              @db.VarChar(64)
  policyVersion     String                              @db.VarChar(64)
  claimAgeSeconds   Int
  claimedAt         DateTime
  serverReceivedAt  DateTime
  createdAt         DateTime                            @default(now())
  updatedAt         DateTime                            @updatedAt

  @@unique([organizationId, workdayEventId])
  @@unique([organizationId, id])
  @@index([organizationId, agentId, status, createdAt])
  @@index([organizationId, workdayId])
  @@map("workforce_attendance_review_cases")
}

// Agent-to-manager conversations and broadcasts. Participants are explicit,
// so every mobile query can remain agent-scoped even inside one tenant.
model MtmMessageThread {
  id               String               @id @default(cuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             MtmMessageThreadType @default(DIRECT)
  subject          String?
  directKey        String?
  createdByAgentId String?
  createdByAgent   MtmAgent?            @relation("MtmMessageThreadCreator", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  lastMessageAt    DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  participants MtmMessageParticipant[]
  messages     MtmMessage[]

  @@unique([organizationId, directKey])
  @@index([organizationId, lastMessageAt])
  @@index([createdByAgentId])
  @@map("mtm_message_threads")
}

model MtmMessageParticipant {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  threadId       String
  thread         MtmMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agentId        String
  agent          MtmAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  role           String           @default("MEMBER")
  joinedAt       DateTime         @default(now())
  lastReadAt     DateTime?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([threadId, agentId])
  @@index([organizationId, agentId, archivedAt])
  @@map("mtm_message_participants")
}

// Private mobile documents are never exposed from public/uploads. The opaque
// storageKey is resolved only by authenticated download routes.
model MtmDocument {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientDocumentId  String?
  title             String?
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  checksumSha256    String?
  uploadedByAgentId String?
  uploadedByAgent   MtmAgent?    @relation("MtmDocumentUploader", fields: [uploadedByAgentId], references: [id], onDelete: SetNull)
  uploadedByUserId  String?
  visitId           String?
  visit             MtmVisit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  taskId            String?
  task              MtmTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          MtmCustomer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  sourceSystem      String?
  sourceReference   String?
  sourceObservedAt  DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  /// Additive object-storage lifecycle metadata. Legacy documents have no
  /// relation and continue to resolve through their existing local key.
  mediaObject MtmMediaObject? @relation("MtmDocumentObject")
  assignments MtmDocumentAssignment[]
  messages    MtmMessage[]
  pharmacyPromotionEvidence MtmPharmacyPromotionEvidence[] @relation("MtmPharmacyEvidenceDocument")

  @@unique([organizationId, clientDocumentId])
  @@unique([organizationId, storageKey])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([uploadedByAgentId])
  @@index([visitId])
  @@index([taskId])
  @@index([organizationId, customerId, deletedAt])
  @@map("mtm_documents")
}

model MtmDocumentAssignment {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId       String
  document         MtmDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agentId          String
  agent            MtmAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignedByUserId String?
  required         Boolean      @default(false)
  assignedAt       DateTime     @default(now())
  expiresAt        DateTime?
  readAt           DateTime?
  downloadedAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([documentId, agentId])
  @@index([organizationId, agentId, assignedAt])
  @@map("mtm_document_assignments")
}

model MtmMessage {
  id                      String           @id @default(cuid())
  organizationId          String
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  threadId                String
  thread                  MtmMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderAgentId           String?
  senderAgent             MtmAgent?        @relation("MtmMessageSender", fields: [senderAgentId], references: [id], onDelete: SetNull)
  senderUserId            String?
  senderName              String
  clientMessageId         String?
  body                    String?
  attachmentDocumentId    String?
  attachmentDocument      MtmDocument?     @relation(fields: [attachmentDocumentId], references: [id], onDelete: SetNull)
  acknowledgementRequired Boolean          @default(false)
  sentAt                  DateTime
  createdAt               DateTime         @default(now())

  receipts MtmMessageReceipt[]

  @@unique([organizationId, senderAgentId, clientMessageId])
  @@index([organizationId, threadId, sentAt])
  @@index([attachmentDocumentId])
  @@map("mtm_messages")
}

model MtmMessageReceipt {
  id              String                @id @default(cuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId       String
  message         MtmMessage            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agentId         String
  agent           MtmAgent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type            MtmMessageReceiptType
  clientReceiptId String?
  occurredAt      DateTime
  createdAt       DateTime              @default(now())

  @@unique([messageId, agentId, type])
  @@unique([organizationId, agentId, clientReceiptId])
  @@index([organizationId, agentId, occurredAt])
  @@map("mtm_message_receipts")
}

model MtmHrmRequest {
  id                  String              @id @default(cuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId             String
  agent               MtmAgent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientRequestId     String
  type                MtmHrmRequestType
  status              MtmHrmRequestStatus @default(PENDING)
  startDate           DateTime            @db.Date
  endDate             DateTime            @db.Date
  correctionWorkdayId String?
  correctionWorkday   MtmAgentWorkday?    @relation(fields: [correctionWorkdayId], references: [id], onDelete: SetNull)
  requestedStartAt    DateTime?
  requestedEndAt      DateTime?
  reason              String
  decisionNote        String?
  decidedByUserId     String?
  submittedAt         DateTime
  decidedAt           DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  workforceTimeCorrections WorkforceTimeCorrection[]

  @@unique([organizationId, agentId, clientRequestId])
  @@unique([organizationId, id])
  @@index([organizationId, agentId, startDate])
  @@index([organizationId, status, submittedAt])
  @@index([correctionWorkdayId])
  @@map("mtm_hrm_requests")
}

// A tenant-owned work location/context. It deliberately has no relation to
// Route customers or Route geofences. A site becomes operational only when a
// later effective-dated assignment and segment/policy select it.
model WorkforceSite {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String              @db.VarChar(64)
  name              String              @db.VarChar(160)
  type              WorkforceSiteType
  timezone          String              @db.VarChar(64)
  addressLabel      String?             @db.VarChar(500)
  responsibleTeamId String?
  responsibleTeam   MtmTeam?            @relation(fields: [organizationId, responsibleTeamId], references: [organizationId, id], onDelete: Restrict)
  status            WorkforceSiteStatus @default(ACTIVE)
  createdByUserId   String
  createdByUser     User                @relation("WorkforceSiteCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  archivedByUserId  String?
  archivedByUser    User?               @relation("WorkforceSiteArchivedBy", fields: [organizationId, archivedByUserId], references: [organizationId, id], onDelete: Restrict)
  archivedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  geofenceRevisions WorkforceSiteGeofenceRevision[]
  assignments        WorkforceSiteAssignment[]
  shiftSegments      WorkforceShiftSegment[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@index([organizationId, responsibleTeamId, status])
  @@index([organizationId, createdByUserId])
  @@index([organizationId, archivedByUserId])
  @@map("workforce_sites")
}

/// A geofence geometry is immutable once recorded. Its effective window may
/// be closed once by a future replacement; historical workday snapshots will
/// store the exact revision/hash rather than consulting the current site.
model WorkforceSiteGeofenceRevision {
  id                   String                     @id @default(cuid())
  organizationId       String
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId               String
  site                 WorkforceSite              @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  revision             Int
  kind                 WorkforceSiteGeofenceKind @default(CIRCLE)
  centerLatitude       Float
  centerLongitude      Float
  radiusMeters         Int
  calibrationReference String                     @db.VarChar(500)
  definitionHash       String                     @db.VarChar(64)
  effectiveFrom        DateTime                   @db.Date
  effectiveTo          DateTime?                  @db.Date
  createdByUserId      String
  createdByUser        User                       @relation("WorkforceSiteGeofenceRevisionCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  createdAt            DateTime                   @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, siteId, revision])
  @@index([organizationId, siteId, effectiveFrom, effectiveTo])
  @@index([organizationId, createdByUserId, createdAt])
  @@map("workforce_site_geofence_revisions")
}

/// Effective-dated employee eligibility for one Workforce site. A later
/// resolver/snapshot consumes this history; it never falls back to a current
/// team/site when processing delayed workday evidence.
model WorkforceSiteAssignment {
  id               String                     @id @default(cuid())
  organizationId   String
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId          String
  agent            MtmAgent                   @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict)
  siteId           String
  site             WorkforceSite              @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  kind             WorkforceSiteAssignmentKind
  effectiveFrom    DateTime                   @db.Date
  effectiveTo      DateTime?                  @db.Date
  assignedByUserId String
  assignedByUser   User                       @relation("WorkforceSiteAssignmentAssignedBy", fields: [organizationId, assignedByUserId], references: [organizationId, id], onDelete: Restrict)
  createdAt        DateTime                   @default(now())

  @@unique([organizationId, id])
  @@index([organizationId, agentId, kind, effectiveFrom, effectiveTo])
  @@index([organizationId, siteId, kind, effectiveFrom, effectiveTo])
  @@index([organizationId, assignedByUserId, createdAt])
  @@map("workforce_site_assignments")
}

// Versioned Workforce policy. The JSON definition is the tenant-authored
// contract; individual workdays use immutable snapshots below rather than a
// later live version of this row.
model WorkforcePolicy {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId            String?
  team              MtmTeam?                 @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  version           Int
  status            WorkforceDefinitionStatus @default(DRAFT)
  name              String
  effectiveFrom     DateTime                 @db.Date
  effectiveTo       DateTime?                @db.Date
  definition        Json
  definitionHash    String                   @db.VarChar(64)
  provenance        WorkforceDefinitionProvenance @default(TENANT_ADMIN)
  /// Non-null only for an explicit system-provisioned default profile.
  systemProfileVersion String?
  /// Null only when provenance is SYSTEM_PROVISIONING; the DB check prevents
  /// pretending that a tenant administrator authored a system default.
  createdByUserId   String?
  createdByUser     User?                    @relation("WorkforcePolicyCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  activatedByUserId String?
  activatedByUser   User?                    @relation("WorkforcePolicyActivatedBy", fields: [organizationId, activatedByUserId], references: [organizationId, id], onDelete: Restrict)
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  snapshots WorkforcePolicySnapshot[]
  attendanceVerifications WorkforceAttendanceVerification[]

  @@unique([organizationId, id])
  @@index([organizationId, teamId, status, effectiveFrom])
  @@index([organizationId, provenance])
  @@index([organizationId, createdByUserId])
  @@index([organizationId, activatedByUserId])
  @@map("workforce_policies")
}

// A reusable planned shift definition. Assignments select a version; the
// resolved UTC instants are frozen separately per workday.
model WorkforceShiftTemplate {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId            String?
  team              MtmTeam?                 @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  code              String
  isDefault         Boolean                  @default(false)
  version           Int
  status            WorkforceDefinitionStatus @default(DRAFT)
  name              String
  timezone          String
  definition        Json
  definitionHash    String                   @db.VarChar(64)
  provenance        WorkforceDefinitionProvenance @default(TENANT_ADMIN)
  /// Non-null only for an explicit system-provisioned default profile.
  systemProfileVersion String?
  /// Null only when provenance is SYSTEM_PROVISIONING; the DB check prevents
  /// pretending that a tenant administrator authored a system default.
  createdByUserId   String?
  createdByUser     User?                    @relation("WorkforceShiftTemplateCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  activatedByUserId String?
  activatedByUser   User?                    @relation("WorkforceShiftTemplateActivatedBy", fields: [organizationId, activatedByUserId], references: [organizationId, id], onDelete: Restrict)
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  assignments WorkforceShiftAssignment[]
  snapshots   WorkforceShiftSnapshot[]
  segments    WorkforceShiftSegment[]

  @@unique([organizationId, id])
  @@index([organizationId, teamId, code, status])
  @@index([organizationId, provenance])
  @@index([organizationId, createdByUserId])
  @@index([organizationId, activatedByUserId])
  @@map("workforce_shift_templates")
}

/// Ordered planned portions of a reusable shift. The parent draft controls
/// mutability; once the template is ACTIVE/RETIRED these rows are immutable
/// configuration history and later C3 snapshots copy their exact values.
model WorkforceShiftSegment {
  id                   String                    @id @default(cuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId           String
  template             WorkforceShiftTemplate    @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Cascade)
  sequence             Int
  mode                 WorkforceShiftSegmentMode
  siteId               String?
  site                 WorkforceSite?            @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  startTime            String                    @db.VarChar(5)
  endTime              String                    @db.VarChar(5)
  lateGraceSeconds     Int                       @default(0)
  proofPolicyReference String?                   @db.VarChar(64)
  createdAt            DateTime                  @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, templateId, sequence])
  @@index([organizationId, templateId, startTime, endTime])
  @@index([organizationId, siteId, createdAt])
  @@map("workforce_shift_segments")
}

// Effective-dated assignment only. It never rewrites a workday snapshot.
model WorkforceShiftAssignment {
  id              String                 @id @default(cuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId         String
  agent           MtmAgent               @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)
  templateId      String
  template        WorkforceShiftTemplate @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict)
  effectiveFrom   DateTime               @db.Date
  effectiveTo     DateTime?              @db.Date
  assignedByUserId String
  assignedByUser  User                   @relation("WorkforceShiftAssignmentAssignedBy", fields: [organizationId, assignedByUserId], references: [organizationId, id], onDelete: Restrict)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  snapshots WorkforceShiftSnapshot[]

  @@unique([organizationId, id])
  @@index([organizationId, agentId, effectiveFrom, effectiveTo])
  @@index([organizationId, templateId, effectiveFrom])
  @@index([organizationId, assignedByUserId])
  @@map("workforce_shift_assignments")
}

// Immutable policy inputs used for one workday's calculation. No live policy
// is consulted when a closed day is recomputed or exported.
model WorkforcePolicySnapshot {
  id                       String              @id @default(cuid())
  organizationId           String
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId                 String
  policy                   WorkforcePolicy     @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict)
  workdayId                String
  workday                  MtmAgentWorkday     @relation("WorkforcePolicySnapshotWorkday", fields: [organizationId, workdayId], references: [organizationId, id], onDelete: Restrict)
  agentId                  String
  agent                    MtmAgent            @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict)
  workDate                 DateTime            @db.Date
  policyVersion            Int
  definition               Json
  definitionHash           String              @db.VarChar(64)
  expectedWorkSeconds      Int
  lateGraceSeconds         Int
  undertimeToleranceSeconds Int
  overtimeThresholdSeconds Int
  longPauseThresholdSeconds Int?
  resolvedAt               DateTime            @default(now())
  createdAt                DateTime            @default(now())

  exceptions WorkforceAttendanceException[]

  @@unique([organizationId, id])
  @@unique([organizationId, workdayId])
  @@index([organizationId, agentId, workDate])
  @@index([organizationId, policyId, policyVersion])
  @@map("workforce_policy_snapshots")
}

// Immutable resolved shift for one workday. It holds UTC instants so DST or a
// future template edit cannot change the historical plan/fact result.
model WorkforceShiftSnapshot {
  id                String                 @id @default(cuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId        String
  template          WorkforceShiftTemplate @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict)
  assignmentId      String?
  assignment        WorkforceShiftAssignment? @relation(fields: [organizationId, assignmentId], references: [organizationId, id], onDelete: Restrict)
  workdayId         String
  workday           MtmAgentWorkday        @relation("WorkforceShiftSnapshotWorkday", fields: [organizationId, workdayId], references: [organizationId, id], onDelete: Restrict)
  agentId           String
  agent             MtmAgent               @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict)
  workDate          DateTime               @db.Date
  templateVersion   Int
  timezone          String
  definition        Json
  definitionHash    String                 @db.VarChar(64)
  plannedStartAt    DateTime
  plannedEndAt      DateTime
  resolvedAt        DateTime               @default(now())
  createdAt         DateTime               @default(now())

  exceptions WorkforceAttendanceException[]

  @@unique([organizationId, id])
  @@unique([organizationId, workdayId])
  @@index([organizationId, agentId, workDate])
  @@index([organizationId, templateId, templateVersion])
  @@map("workforce_shift_snapshots")
}

// Materialized calculation deviation. Resolution metadata is mutable, but its
// policy/shift snapshots and calculation version always identify the facts.
model WorkforceAttendanceException {
  id                 String                             @id @default(cuid())
  organizationId     String
  organization       Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workdayId          String
  workday            MtmAgentWorkday                   @relation(fields: [organizationId, workdayId], references: [organizationId, id], onDelete: Cascade)
  agentId            String
  agent              MtmAgent                           @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)
  policySnapshotId   String
  policySnapshot     WorkforcePolicySnapshot            @relation(fields: [organizationId, policySnapshotId], references: [organizationId, id], onDelete: Restrict)
  shiftSnapshotId    String
  shiftSnapshot      WorkforceShiftSnapshot             @relation(fields: [organizationId, shiftSnapshotId], references: [organizationId, id], onDelete: Restrict)
  type               WorkforceAttendanceExceptionType
  calculationVersion Int
  valueSeconds       Int
  thresholdSeconds   Int
  excessSeconds      Int
  provisional        Boolean                            @default(false)
  status             WorkforceAttendanceExceptionStatus @default(OPEN)
  resolutionNote     String?
  resolvedByUserId   String?
  resolvedByUser     User?                               @relation("WorkforceAttendanceExceptionResolvedBy", fields: [organizationId, resolvedByUserId], references: [organizationId, id], onDelete: Restrict)
  resolvedAt         DateTime?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt

  @@unique([organizationId, workdayId, type, calculationVersion])
  @@index([organizationId, agentId, status, createdAt])
  @@index([organizationId, policySnapshotId])
  @@index([organizationId, shiftSnapshotId])
  @@index([organizationId, resolvedByUserId])
  @@map("workforce_attendance_exceptions")
}

// Append-only audit fact for a manager or approved employee-request correction.
// The migration prevents UPDATE/DELETE; the old and new workday facts remain
// independently reviewable until a separately approved retention mechanism exists.
model WorkforceTimeCorrection {
  id              String                       @id @default(cuid())
  organizationId  String
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workdayId       String
  workday         MtmAgentWorkday              @relation(fields: [organizationId, workdayId], references: [organizationId, id], onDelete: Restrict)
  agentId         String
  agent           MtmAgent                     @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict)
  requestId       String?
  request         MtmHrmRequest?               @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict)
  source          WorkforceTimeCorrectionSource
  operationId     String
  // Required for manager-originated corrections so a repeated operation id can
  // prove it carries the exact same immutable request, rather than silently
  // accepting a changed start/end/reason payload.
  requestHash     String?                      @db.VarChar(64)
  actorUserId     String
  actorUser       User                         @relation("WorkforceTimeCorrectionActor", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict)
  reason          String
  beforeFacts     Json
  afterFacts      Json
  occurredAt      DateTime
  createdAt       DateTime                     @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, operationId])
  @@unique([organizationId, requestId])
  @@index([organizationId, workdayId, occurredAt])
  @@index([organizationId, agentId, occurredAt])
  @@index([organizationId, requestId])
  @@index([organizationId, actorUserId, occurredAt])
  @@map("workforce_time_corrections")
}

// An approved period is immutable. A subsequent correction appends another
// record that points to it; exports choose their approved revision explicitly.
model WorkforceTimesheetApproval {
  id                  String                       @id @default(cuid())
  organizationId      String
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId             String
  agent               MtmAgent                     @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict)
  periodStart         DateTime                     @db.Date
  periodEnd           DateTime                     @db.Date
  recordKind          WorkforceTimesheetRecordKind @default(APPROVAL)
  revision            Int
  supersedesId        String?
  supersedes          WorkforceTimesheetApproval?  @relation("WorkforceTimesheetApprovalRevisions", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict)
  corrections         WorkforceTimesheetApproval[] @relation("WorkforceTimesheetApprovalRevisions")
  calculationVersion  Int
  factsHash           String                       @db.VarChar(64)
  rowsHash            String                       @db.VarChar(64)
  rows                Json
  approvedByUserId    String
  approvedByUser      User                         @relation("WorkforceTimesheetApprovalApprovedBy", fields: [organizationId, approvedByUserId], references: [organizationId, id], onDelete: Restrict)
  approvedAt          DateTime
  correctionReason    String?
  correctionActorUserId String?
  correctionActorUser User?                        @relation("WorkforceTimesheetApprovalCorrectionActor", fields: [organizationId, correctionActorUserId], references: [organizationId, id], onDelete: Restrict)
  createdAt           DateTime                     @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, agentId, periodStart, periodEnd, revision])
  @@unique([organizationId, supersedesId])
  @@index([organizationId, agentId, periodStart, periodEnd])
  @@index([organizationId, approvedByUserId, approvedAt])
  @@index([organizationId, correctionActorUserId, approvedAt])
  @@map("workforce_timesheet_approvals")
}

// A QR station represents a physical display or location. The rotating QR
// itself is never persisted: its signed nonce is consumed only when an
// immutable verification fact is appended for a canonical workday event.
model WorkforceAttendanceQrStation {
  id               String                             @id @default(cuid())
  organizationId   String
  organization     Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
