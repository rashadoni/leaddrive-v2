  model                    String   @default("claude-haiku-4-5-20251001")
  maxTokens                Int      @default(1024)
  temperature              Float    @default(0.7) // matches the engine fallback + persona editor default; a direct API create without temperature no longer gets the hotter 1.0
  systemPrompt             String?
  /// Language the assistant replies in: "az" | "ru" | "en". Null means follow
  /// whatever language the customer wrote in, which is what every agent did
  /// before this field existed.
  replyLanguage            String?
  /// Approved product facts, kept apart from the rules in systemPrompt exactly
  /// as the voice agent keeps them apart. Facts change when a price list does;
  /// rules should not have to be touched to edit one.
  knowledgeBase            String?
  toolsEnabled             String[] @default([])
  escalationEnabled        Boolean  @default(true)
  escalationRules          String[] @default([])
  kbEnabled                Boolean  @default(true)
  kbMaxArticles            Int      @default(3)
  isActive                 Boolean  @default(false)
  version                  Int      @default(1)
  notes                    String?
  // Autonomous Inbox operator. Defaults are fail-closed for existing tenants:
  // an administrator explicitly enables lead creation/backlog after choosing a board.
  autoLeadEnabled          Boolean  @default(false)
  autoAssignSales          Boolean  @default(true)
  autonomousBacklogEnabled Boolean  @default(false)
  autonomousLookbackDays   Int      @default(7)
  autonomousBatchSize      Int      @default(20)
  // Multi-agent orchestration (Phase 4)
  agentType         String   @default("general") // "sales", "support", "marketing", "analyst", "general"
  department        String?
  priority          Int      @default(0) // Higher = preferred
  handoffTargets    String[] @default([]) // Agent config IDs this can handoff to
