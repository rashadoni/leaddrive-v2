  @@unique([organizationId, policyNumber], map: "policies_org_number_uniq")
  @@index([policyHolderId], map: "policies_holder_idx")
  @@index([organizationId, status], map: "policies_org_status_idx")
  @@index([organizationId, lineOfBusiness], map: "policies_org_line_idx")
  @@index([organizationId, effectiveDate], map: "policies_org_effective_idx")
  @@map("policies")
}

model Beneficiary {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId           String
  policy             Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  /// tier allow-list (DB CHECK): primary | contingent
  tier               String       @default("primary")
  /// beneficiaryType allow-list (DB CHECK):
  /// person | trust | charity | estate
  beneficiaryType    String       @default("person")
  fullName           String
  /// Slice-3 blind-index column. Stores HMAC-SHA256(per-tenant key, normalized fullName)
  /// as base64url (no padding). Enables equality search on the encrypted
  /// `fullName` column without surfacing plaintext. Nullable while the
  /// backfill rolls in column-by-column; once backfilled and dual-write
  /// stable, slice-4 may flip to NOT NULL + drop the legacy plaintext
  /// scan path. Indexed via `beneficiaries_org_full_name_blind_idx`.
  fullNameBlindIndex String?
  relationship       String?
  allocationPct      Decimal      @db.Decimal(5, 2)
  taxId              String?
  /// Slice-3 blind-index for `?taxId=` lookup on beneficiaries.
  /// Useful when reconciling a beneficiary record against a payee
  /// SSN supplied by the claims-adjuster workflow. Same HMAC pattern.
  taxIdBlindIndex    String?
  dateOfBirth        DateTime?
  designatedAt       DateTime     @default(now())
  revokedAt          DateTime?
  revocationReason   String?
  metadata           Json         @default("{}")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([policyId, tier], map: "beneficiaries_policy_tier_idx")
  @@index([organizationId], map: "beneficiaries_org_idx")
  @@index([organizationId, fullNameBlindIndex], map: "beneficiaries_org_full_name_blind_idx")
  @@index([organizationId, taxIdBlindIndex], map: "beneficiaries_org_tax_id_blind_idx")
  @@map("beneficiaries")
}

model Claim {
  id                   String                      @id @default(cuid())
  organizationId       String
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyId             String
  policy               Policy                      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  /// Claim number — institutional, UNIQUE per tenant.
  claimNumber          String
  /// lossType allow-list (DB CHECK):
  /// collision | theft | fire | weather | liability | medical
  /// | property_damage | death | disability | other
  lossType             String
  /// Lifecycle (DB CHECK):
  /// reported | under_review | approved | settled
  /// | denied | closed_no_action
  status               String                      @default("reported")
  /// severity allow-list (DB CHECK):
  /// minor | moderate | major | catastrophic
  severity             String                      @default("minor")
  lossDate             DateTime
  reportedAt           DateTime                    @default(now())
  initialReserveAmount Decimal                     @default(0) @db.Decimal(18, 2)
  currentReserveAmount Decimal                     @default(0) @db.Decimal(18, 2)
  paidAmount           Decimal                     @default(0) @db.Decimal(18, 2)
  description          String?
  adjusterId           String?
  adjuster             InsuranceServiceTeamMember? @relation("ClaimAdjuster", fields: [adjusterId], references: [id])
  fraudFlag            Boolean                     @default(false)
  reviewStartedAt      DateTime?
  approvedAt           DateTime?
  settledAt            DateTime?
  deniedAt             DateTime?
  closedNoActionAt     DateTime?
  decisionRationale    String?
  metadata             Json                        @default("{}")
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([organizationId, claimNumber], map: "claims_org_number_uniq")
  @@index([policyId], map: "claims_policy_idx")
  @@index([organizationId, status], map: "claims_org_status_idx")
  @@index([organizationId, severity], map: "claims_org_severity_idx")
  @@index([adjusterId], map: "claims_adjuster_idx")
  @@map("claims")
}

// --- Phase 7 R8: Public Sector Cloud (slice 1) ---
//
// Salesforce Public Sector Cloud analogue. Citizen case management,
// licensing, grants. FedRAMP scope = declarative only — slice-2 wraps
// PII columns with pgcrypto + audit log; certification audit is a
// separate business workstream.

model PublicSectorOfficial {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  fullName       String
  email          String
  phone          String?
  /// role allow-list (DB CHECK):
  /// caseworker | senior_caseworker | inspector | grant_officer
  /// | supervisor | director | clerk
  role           String       @default("caseworker")
  agencySlug     String
  departmentSlug String?
  /// authorityLevel allow-list (DB CHECK): line | supervisor | director
  authorityLevel String       @default("line")
  specialties    String[]     @default([])
  isActive       Boolean      @default(true)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  casesAssigned  PublicSectorCase[]    @relation("PublicSectorCaseAssigned")
  licensesIssued PublicSectorLicense[] @relation("PublicSectorLicenseIssuingOfficial")
  grantsAssigned PublicSectorGrant[]   @relation("PublicSectorGrantAssignedOfficial")

  @@unique([organizationId, email], map: "public_sector_officials_org_email_uniq")
  @@index([organizationId, role], map: "public_sector_officials_org_role_idx")
  @@index([organizationId, agencySlug], map: "public_sector_officials_org_agency_idx")
  @@index([organizationId, isActive], map: "public_sector_officials_org_active_idx")
  @@map("public_sector_officials")
}

model Citizen {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Soft FK to CRM Contact for outreach correspondence.
  contactId          String?
  /// Citizen record number — UNIQUE per tenant.
  citizenNumber      String
  /// Legal name (PII — slice-2 pgcrypto wrap).
  fullName           String
  /// Slice-3 blind-index for exact-match search on the encrypted
  /// fullName column. HMAC-SHA256(per-tenant key, normalize(fullName))
  /// → base64url 43 chars. Computed by `blindIndexForTenant()` in
  /// `src/lib/crypto/tenant-pii-encryption.ts`. Routes write this
  /// alongside the encrypted ciphertext; GET list filters query by
  /// blind index instead of decrypting + scanning. Nullable for
  /// backfill rollout — once 100% of rows are populated, the soft-
  /// decrypt fallback can also drop on this column.
  fullNameBlindIndex String?
  email              String?
  phone              String?
  /// Date of birth (PII).
  dateOfBirth        DateTime?
  /// SSN / Tax ID (PII — slice-2 pgcrypto wrap).
  taxId              String?
  /// Slice-3 blind-index for exact-match search on the encrypted
  /// taxId column. Same HMAC-SHA256 + per-tenant key as
  /// fullNameBlindIndex. Useful for "look up by SSN" workflows in
  /// FOIA records-request fulfillment (state agencies query by
  /// taxpayer ID). Nullable for backfill rollout.
  taxIdBlindIndex    String?
  /// Residence address (PII).
  addressLine1       String?
  addressLine2       String?
  city               String?
  stateProvince      String?
  postalCode         String?
  country            String?
  /// Jurisdiction slug — county / district code.
  jurisdictionSlug   String?
  /// Lifecycle (DB CHECK): active | inactive | deceased
  status             String       @default("active")
  deactivatedAt      DateTime?
  deceasedAt         DateTime?
  metadata           Json         @default("{}")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  cases    PublicSectorCase[]
  licenses PublicSectorLicense[]
  grants   PublicSectorGrant[]

  @@unique([organizationId, citizenNumber], map: "citizens_org_number_uniq")
  @@index([organizationId, status], map: "citizens_org_status_idx")
  @@index([organizationId, jurisdictionSlug], map: "citizens_org_jurisdiction_idx")
  @@index([contactId], map: "citizens_contact_idx")
  // Blind-index lookup for the GET list `?fullName=` filter — tenant-
  // scoped so the query plan can use it without scanning across orgs.
  @@index([organizationId, fullNameBlindIndex], map: "citizens_org_full_name_blind_idx")
  // Blind-index lookup for the GET list `?taxId=` filter — same shape.
  @@index([organizationId, taxIdBlindIndex], map: "citizens_org_tax_id_blind_idx")
  @@map("citizens")
}

model PublicSectorCase {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  citizenId          String
  /// FOIA audit boundary: RESTRICT not Cascade — case history must
  /// survive citizen deletion. Slice-2 archive job handles cleanup.
  citizen            Citizen               @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  caseNumber         String
  /// caseType allow-list (DB CHECK):
  /// benefits_application | benefits_recertification | complaint
  /// | inquiry | inspection_request | hearing_request
  /// | records_request | appeal | grievance
  caseType           String
  /// Lifecycle (DB CHECK):
  /// submitted | intake | assigned | in_progress | escalated
  /// | resolved | denied | withdrawn
  status             String                @default("submitted")
  /// priority allow-list (DB CHECK):
  /// routine | elevated | urgent | emergency
  priority           String                @default("routine")
  agencySlug         String
  departmentSlug     String?
  assignedOfficialId String?
  assignedOfficial   PublicSectorOfficial? @relation("PublicSectorCaseAssigned", fields: [assignedOfficialId], references: [id])
  subject            String
  description        String?
  /// Statutory deadline — when the agency MUST respond by law.
  statutoryDueAt     DateTime?
  submittedAt        DateTime              @default(now())
  intakeStartedAt    DateTime?
  assignedAt         DateTime?
  workStartedAt      DateTime?
  escalatedAt        DateTime?
  resolvedAt         DateTime?
  deniedAt           DateTime?
  withdrawnAt        DateTime?
  decisionRationale  String?
  withdrawalReason   String?
  metadata           Json                  @default("{}")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  licenses PublicSectorLicense[]
  grants   PublicSectorGrant[]

  @@unique([organizationId, caseNumber], map: "public_sector_cases_org_number_uniq")
  @@index([citizenId], map: "public_sector_cases_citizen_idx")
  @@index([organizationId, status], map: "public_sector_cases_org_status_idx")
  @@index([organizationId, agencySlug], map: "public_sector_cases_org_agency_idx")
  @@index([organizationId, assignedOfficialId, status], map: "public_sector_cases_assigned_idx")
  @@map("public_sector_cases")
}

model PublicSectorLicense {
  id                String                @id @default(cuid())
