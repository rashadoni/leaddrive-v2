/// Tenant-owned contact master-data vocabulary. A draft is immutable; signing
/// activates exactly one version per kind and preserves prior versions for
/// historical interpretation and offline synchronization.
model MtmContactDictionary {
  id                String                     @id @default(cuid())
  organizationId    String
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind              MtmContactDictionaryKind
  version           Int
  nameRu            String
  nameAz            String
  nameEn            String
  schemaVersion     Int                        @default(1)
  entries           Json
  entriesHash       String                     @db.VarChar(64)
  approvalReference String?
  sourceSystem      String
  sourceReference   String?
  sourceObservedAt  DateTime
  effectiveFrom     DateTime                   @db.Date
  status            MtmContactDictionaryStatus @default(DRAFT)
  createdByUserId   String
  signedByUserId    String?
  signedAt          DateTime?
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  groupedTasks MtmTask[] @relation("MtmTaskGroupDictionary")
  contactAssignments MtmContactDictionaryAssignment[]

  @@unique([organizationId, id], map: "mtm_contact_dict_org_id_key")
  @@unique([organizationId, kind, version], map: "mtm_contact_dict_org_kind_version_key")
  @@index([organizationId, kind, status, effectiveFrom], map: "mtm_contact_dict_org_kind_status_idx")
  @@map("mtm_contact_dictionaries")
}

/// Version-bound contact master-data assignment. The selected entry always
/// points to the exact signed dictionary version used for the decision;
/// ending an assignment preserves its historical interpretation.
model MtmContactDictionaryAssignment {
  id                 String                   @id @default(cuid())
  organizationId     String
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId          String
  contact            MtmContact               @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Cascade)
  dictionaryId       String
  dictionary         MtmContactDictionary     @relation(fields: [organizationId, dictionaryId], references: [organizationId, id], onDelete: Restrict)
  kind               MtmContactDictionaryKind
  entryCode          String
  effectiveFrom      DateTime                 @default(now())
  effectiveTo        DateTime?
  source             String                   @default("ADMIN")
  createdByUserId    String?
  requestedByAgentId String?
  approvedByUserId   String?
  sourceRequestId    String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([organizationId, id], map: "mtm_contact_dict_assignment_org_id_key")
  @@unique([organizationId, contactId, dictionaryId, entryCode, effectiveFrom], map: "mtm_contact_dict_assignment_history_key")
  @@index([organizationId, contactId, effectiveTo, effectiveFrom], map: "mtm_contact_dict_assignment_contact_idx")
  @@index([organizationId, dictionaryId, entryCode], map: "mtm_contact_dict_assignment_dictionary_idx")
  @@index([organizationId, updatedAt], map: "mtm_contact_dict_assignment_updated_idx")
  @@map("mtm_contact_dictionary_assignments")
}

/// Append-only doctor scoring fact. Content is never overwritten; only the
/// review envelope may transition from PENDING to VERIFIED or REJECTED.
model MtmDoctorAssessment {
  id                 String                    @id @default(cuid())
  organizationId     String
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId          String
  contact            MtmContact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  formulaId          String
  formula            MtmDoctorScoringFormula   @relation(fields: [formulaId], references: [id], onDelete: Restrict)
  enteredByAgentId   String?
  enteredByAgent     MtmAgent?                 @relation("MtmDoctorAssessmentEnteredBy", fields: [enteredByAgentId], references: [id], onDelete: SetNull)
  reviewedByAgentId  String?
  reviewedByAgent    MtmAgent?                 @relation("MtmDoctorAssessmentReviewedBy", fields: [reviewedByAgentId], references: [id], onDelete: SetNull)
  clientAssessmentId String
  requestHash        String
  office             String?
  patientsPerMonth   Int?
  bedCount           Int?
  isKol              Boolean                   @default(false)
  kolLevel           String?
  profile            String?
  psychotype         String?
  granularCategory   String?
  actualScore        Decimal?                  @db.Decimal(14, 4)
  targetScore        Decimal?                  @db.Decimal(14, 4)
  periodStart        DateTime                  @db.Date
  periodEnd          DateTime?                 @db.Date
  source             String
  provenance         Json
  formulaVersion     String
  status             MtmDoctorAssessmentStatus @default(PENDING)
  reviewComment      String?
  reviewedAt         DateTime?
  createdBy          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([organizationId, clientAssessmentId])
  @@index([organizationId, contactId, periodStart, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, formulaId])
  @@map("mtm_doctor_assessments")
}

/// Agent-proposed master-data change. Managers/admins apply the reviewed
/// payload transactionally; the request preserves the immutable decision
/// envelope and makes mobile retries idempotent without mutating the contact.
model MtmContactChangeRequest {
  id                       String               @id @default(cuid())
  organizationId           String
  organization             Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId                String
  contact                  MtmContact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  requestedByAgentId       String
  requestedByAgent         MtmAgent             @relation(fields: [requestedByAgentId], references: [id], onDelete: Cascade)
  kind                     MtmContactChangeKind
  status                   MtmApprovalStatus    @default(SUBMITTED)
  idempotencyKey           String
  requestHash              String
  reason                   String
  expectedContactUpdatedAt DateTime
  payload                  Json
  result                   Json?
  reviewedBy               String?
  decisionComment          String?
  submittedAt              DateTime             @default(now())
  reviewedAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, submittedAt])
  @@index([organizationId, contactId, submittedAt])
  @@index([requestedByAgentId, status])
  @@map("mtm_contact_change_requests")
}

model MtmContactWorkplace {
