  source         String                  @default("ADMIN")
  assignedBy     String?
  reason         String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, agentId, effectiveFrom, effectiveTo])
  @@index([organizationId, customerId, effectiveFrom, effectiveTo])
  @@map("mtm_customer_agent_assignments")
}

