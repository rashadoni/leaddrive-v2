  @@unique([organizationId, id], map: "outbound_social_reply_approvals_org_id_key")
  @@unique([organizationId, outboundReplyId], map: "outbound_social_reply_approvals_org_reply_key")
  @@index([organizationId, createdAt], map: "outbound_social_reply_approvals_org_created_idx")
  @@map("outbound_social_reply_approvals")
}

model OutboundSocialReplyEvent {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outboundReplyId String
