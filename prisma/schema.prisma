  @@index([organizationId, customerId, verifiedAt])
  @@map("mtm_customer_coordinate_verifications")
}

/// Signed tenant package for SwissMed organization attributes that are not
/// safe to infer from the CRM record itself. Draft rows are immutable and do
/// not affect the explorer until an administrator activates the exact hash.
model MtmOrganizationAttributePackage {
  id                String                                @id @default(cuid())
  organizationId    String
  organization      Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version           Int
  schemaVersion     Int                                   @default(1)
  rowsHash          String                                @db.VarChar(64)
  rowCount          Int
  sourceSystem      String
  sourceReference   String?
  sourceObservedAt  DateTime
  effectiveFrom     DateTime                              @db.Date
  status            MtmOrganizationAttributePackageStatus @default(DRAFT)
  approvalReference String?
  createdByUserId   String
  signedByUserId    String?
  signedAt          DateTime?
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt

  facts MtmOrganizationAttributeFact[]

  @@unique([organizationId, id], map: "mtm_org_attribute_packages_org_id_key")
  @@unique([organizationId, version], map: "mtm_org_attribute_packages_org_version_key")
  @@index([organizationId, status, effectiveFrom], map: "mtm_org_attribute_packages_status_idx")
  @@map("mtm_organization_attribute_packages")
}

/// Materialized row of an immutable organization attribute package. Nullable
/// fields mean the signed source did not assert a value; they never imply a
/// default classification or license state.
model MtmOrganizationAttributeFact {
  id                    String                          @id @default(cuid())
  organizationId        String
  organization          Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageId             String
  package               MtmOrganizationAttributePackage @relation(fields: [organizationId, packageId], references: [organizationId, id], onDelete: Cascade)
  customerId            String
  customer              MtmCustomer                     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)
  organizationCode      String
  medicalCategoryCode   String?
  medicalCategoryLabels Json?
  licenseStatus         String?
  licenseLabels         Json?
  polygonCode           String?
  polygonLabels         Json?
  createdAt             DateTime                        @default(now())

  @@unique([packageId, customerId], map: "mtm_org_attribute_facts_package_customer_key")
  @@index([organizationId, customerId, packageId], map: "mtm_org_attribute_facts_customer_idx")
  @@index([organizationId, medicalCategoryCode, packageId], map: "mtm_org_attribute_facts_category_idx")
  @@index([organizationId, licenseStatus, packageId], map: "mtm_org_attribute_facts_license_idx")
  @@index([organizationId, polygonCode, packageId], map: "mtm_org_attribute_facts_polygon_idx")
  @@map("mtm_organization_attribute_facts")
}

// Doctors, pharmacists, and other people are separate from the organization
// where they currently work. Workplace history keeps moves auditable without
// rewriting the contact identity.
model MtmContact {
  id                    String              @id @default(cuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalCode          String?
  firstName             String
  lastName              String
  middleName            String?
  displayName           String
  type                  MtmContactType      @default(DOCTOR)
  specialtyCode         String?
  specialtyName         String?
  qualificationCategory String?
  profile               String?
  category              MtmCustomerCategory @default(B)
  status                MtmContactStatus    @default(ACTIVE)
  birthDate             DateTime?           @db.Date
  gender                String?
  email                 String?
  phone                 String?
  messengerPhone        String?
  workPhone             String?
  homePhone             String?
  mobilePhone           String?
  viberPhone            String?
  whatsappPhone         String?
  telegramPhone         String?
  postalCode            String?
  addressRegion         String?
  addressLocality       String?
  addressDistrict       String?
  addressStreet         String?
  productCategory       String?
  verificationStatus    String              @default("UNVERIFIED")
  consentStatus         String              @default("UNKNOWN")
  contactPreference     String?
  source                String              @default("ADMIN")
  verifiedAt            DateTime?
  verifiedBy            String?
  duplicateOfContactId  String?
  duplicateOfContact    MtmContact?         @relation("MtmContactDuplicates", fields: [duplicateOfContactId], references: [id], onDelete: SetNull)
  duplicates            MtmContact[]        @relation("MtmContactDuplicates")
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  workplaces        MtmContactWorkplace[]
  agentAssignments  MtmContactAgentAssignment[]
  fieldPotentials   MtmFieldPotential[]
  routePoints       MtmRoutePoint[]
  visits            MtmVisit[]
  commitments       MtmCommitment[]
  changeRequests    MtmContactChangeRequest[]
  doctorAssessments MtmDoctorAssessment[]
  dictionaryAssignments MtmContactDictionaryAssignment[]
  pharmacyPromotionTargets MtmPharmacyPromotionTarget[]
  pharmacyPointsLedger     MtmPharmacyPointsLedgerEntry[]
  pharmacyRewardClaims     MtmPharmacyRewardClaim[]

  @@unique([organizationId, externalCode])
  @@unique([organizationId, id])
  @@index([organizationId, displayName])
  @@index([organizationId, status, type])
  @@index([organizationId, specialtyCode])
  @@index([organizationId, category])
  @@index([organizationId, verificationStatus])
  @@index([organizationId, duplicateOfContactId])
  @@map("mtm_contacts")
}

/// Tenant-owned, immutable scoring definition. Activation signs one version;
/// clients receive the resulting score but never execute this JSON formula.
model MtmDoctorScoringFormula {
  id                    String                        @id @default(cuid())
  organizationId        String
  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version               String
  name                  String
  definition            Json
  definitionHash        String?                       @db.VarChar(64)
  glossarySchemaVersion Int?
  approvalReference     String?
  sourceSystem          String?
  sourceReference       String?
  sourceObservedAt      DateTime?
  status                MtmDoctorScoringFormulaStatus @default(DRAFT)
  createdBy             String?
  signedBy              String?
  signedAt              DateTime?
  retiredAt             DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  assessments MtmDoctorAssessment[]

  @@unique([organizationId, version])
  @@index([organizationId, status, createdAt])
  @@map("mtm_doctor_scoring_formulas")
