// ═══════════════════════════════════════════════════════════════════════════
// C7 — DISTRIBUTED MARKETING (Phase 6 / Marketing Cloud)
// Salesforce Marketing Cloud Distributed Marketing analogue. Corporate
// authors brand-locked templates with rep-fillable unlocked variables.
// Slice-1 = schema + pure helpers. See migration for trigger-level
// invariants (lifecycle FSMs, append-only on distributions/sends,
// coherence with split-brain prevention).
// ═══════════════════════════════════════════════════════════════════════════

model MarketingTemplate {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  /**
   * Channel (DB CHECK):
   * email | sms | push | telegram | whatsapp
   */
  channel           String
  /**
   * Email/push only; NULL for sms/whatsapp/telegram (DB coherence check).
   */
  subjectTemplate   String?
  bodyTemplate      String
  /**
   * Corporate-locked variable values — reps cannot override.
   * Validator enforces every key maps to a {{placeholder}}.
   */
  lockedVariables   Json         @default("{}")
  /**
   * Variable slot definitions reps fill at send time. Array of
   * { name, label, type, required } objects. Validator enforces no
   * overlap with lockedVariables.
   */
  unlockedVariables Json         @default("[]")
  /**
   * Lifecycle (DB CHECK + transition trigger):
   * draft | active | archived. draft ↔ active permitted (pull-back).
   */
  status            String       @default("draft")
  archivedAt        DateTime?
  createdBy         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  distributions    TemplateDistribution[]
  personalizations TemplatePersonalization[]
  sendRecords      TemplateSendRecord[]

  @@unique([organizationId, name])
  @@index([organizationId, channel, status])
  @@map("marketing_templates")
}

model TemplateDistribution {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId       String
  template         MarketingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /**
   * Distribution scope (DB CHECK):
   * all | user | role | team
   */
  distributionType String
  targetUserId     String?
  targetUser       User?             @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  targetRole       String?
  /**
   * Opaque team identifier — slice-2 FKs to teams table.
   */
  targetTeamRef    String?
  createdBy        String?
  createdAt        DateTime          @default(now())

  // (template, type, target) unique handled by COALESCE-based partial
  // index in SQL migration (Prisma can't express COALESCE in @@unique).
  @@index([organizationId, templateId])
  // Partial WHERE-index on targetUserId handled in SQL migration.
  @@map("template_distributions")
}

model TemplatePersonalization {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       MarketingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /**
   * Variable values for the template's unlockedVariables slots.
   * Validator (template-variable-validator.ts) rejects keys that
   * exist in template.lockedVariables.
   */
  variableValues Json              @default("{}")
  /**
   * Lifecycle (DB CHECK + transition trigger):
   * draft | active | archived. draft ↔ active permitted.
   */
  status         String            @default("draft")
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  sendRecords TemplateSendRecord[]

  // (templateId, userId, name) unique only among non-archived rows.
  // Enforced via partial unique index in the SQL migration; Prisma's
  // @@unique can't express WHERE, so no @@unique here. The SQL partial
  // index also serves query lookups by (templateId, userId, name), so
  // no additional @@index needed.
  @@index([organizationId, userId])
  @@index([templateId, status])
  @@map("template_personalizations")
}

model TemplateSendRecord {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId        String
  template          MarketingTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  personalizationId String?
  personalization   TemplatePersonalization? @relation(fields: [personalizationId], references: [id], onDelete: SetNull)
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId         String
  contact           Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel           String
  /**
   * Send outcome (DB CHECK):
   * sent | failed | bounced
   */
  outcome           String                   @default("sent")
  errorMessage      String?
  renderedSubject   String?
  renderedBody      String
  sentAt            DateTime                 @default(now())
  createdAt         DateTime                 @default(now())

  @@index([organizationId, templateId, sentAt])
  @@index([organizationId, userId, sentAt])
  @@index([organizationId, contactId, sentAt])
  @@map("template_send_records")
}

// ═══════════════════════════════════════════════════════════════════════════
// A12 — REVENUE INTELLIGENCE (Phase 1 / Sales Cloud)
// Salesforce Revenue Intelligence analogue. Three measurement loops:
// forecast snapshots, pipeline waterfall (stage transitions), deal
// velocity (per-stage duration percentiles). Slice-1 = schema + pure
// helpers; slice-2 wires snapshot cron, stage-change hook, velocity
// recompute, forecast-accuracy recompute, admin UI dashboards.
// See prisma/migrations/20260520100000_revenue_intelligence/migration.sql
// for trigger-level invariants (append-only on snapshots / transitions /
// reports, immutability on metric identifiers, cross-table coherence).
// ═══════════════════════════════════════════════════════════════════════════

model ForecastSnapshot {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotDate    DateTime     @default(now())
  /**
   * Scope discriminator (DB CHECK):
   * org | pipeline | user
   * scopeRef is the target id when scope \!= 'org'; NULL otherwise.
   */
  scope           String
  scopeRef        String?
  periodStart     DateTime
  periodEnd       DateTime
  committedAmount Decimal      @default(0) @db.Decimal(18, 4)
  bestCaseAmount  Decimal      @default(0) @db.Decimal(18, 4)
  forecastAmount  Decimal      @default(0) @db.Decimal(18, 4)
  dealsCommitted  Int          @default(0)
  dealsBestCase   Int          @default(0)
  dealsTotal      Int          @default(0)
  currency        String       @default("USD")
  /**
   * Who triggered (NULL = cron). FK to users with same-org coherence trigger.
   */
  capturedBy      String?
  capturedByUser  User?        @relation("CapturedSnapshots", fields: [capturedBy], references: [id], onDelete: SetNull)
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())

  accuracyReport ForecastAccuracyReport?

  @@index([organizationId, snapshotDate])
  @@index([organizationId, scope, scopeRef])
  @@index([organizationId, periodStart, periodEnd])
  @@map("forecast_snapshots")
}

/// CDP Calculated Insights — daily KPI snapshot for trend / sparkline.
/// One row per org per day (written by /api/cron/customer-insights-snapshot,
/// capturedBy NULL). The 4 headline KPIs mirror /api/v1/calculated-insights
/// aggregates exactly (shared computeOrgInsights), so each KPI card's trend is
/// consistent with its live value. No historical backfill — sparklines fill in
/// as daily snapshots accumulate.
model CustomerInsightsSnapshot {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotDate     DateTime     @default(now())
  totalProfiles    Int          @default(0)
  highRiskCount    Int          @default(0)
  avgEngagement    Float        @default(0) // 0..100, cohort mean
  dominantLtv      Decimal      @default(0) @db.Decimal(18, 4)
  // Base currency; matches FALLBACK_CURRENCY in compute-org-insights so a
  // default-inserted row can't freeze a currency that contradicts the cohort.
  dominantCurrency String       @default("AZN")
  /// userId of a manual capture; NULL = cron-written.
  capturedBy       String?
  metadata         Json         @default("{}")
  createdAt        DateTime     @default(now())

  @@index([organizationId, snapshotDate])
  @@map("customer_insights_snapshots")
}

model PipelineStageTransition {
  id                         String       @id @default(cuid())
  organizationId             String
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId                     String
  deal                       Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  pipelineId                 String?
  pipeline                   Pipeline?    @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  /**
   * Null when transitionType = 'created'.
   */
  fromStage                  String?
  toStage                    String
  /**
   * Denormalized — deals get re-priced.
   */
  fromAmount                 Decimal?     @db.Decimal(18, 4)
  toAmount                   Decimal      @db.Decimal(18, 4)
  currency                   String       @default("USD")
  transitionedAt             DateTime     @default(now())
  /**
   * Transition type (DB CHECK):
   * created | advanced | regressed | won | lost | reopened | reassigned
   */
  transitionType             String
  reason                     String?
  actorUserId                String?
  actor                      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /**
   * How long the deal sat in fromStage before this transition.
   */
  durationInPrevStageSeconds Int?
  metadata                   Json         @default("{}")
  createdAt                  DateTime     @default(now())

  @@index([organizationId, dealId, transitionedAt])
  // Partial WHERE-index on pipelineId handled in SQL migration.
  @@index([organizationId, transitionType, transitionedAt])
  @@map("pipeline_stage_transitions")
}

model DealVelocityMetric {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineId         String
  pipeline           Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage              String
  /**
   * Period bucket (DB CHECK):
   * last_30d | last_90d | last_180d | last_365d
   */
  periodKey          String
  periodStart        DateTime
  periodEnd          DateTime
  dealsEntered       Int          @default(0)
  dealsExited        Int          @default(0)
  dealsAdvanced      Int          @default(0)
  dealsRegressed     Int          @default(0)
  dealsLost          Int          @default(0)
  dealsWon           Int          @default(0)
  /**
   * Stage-duration percentiles (seconds). NULL if insufficient data.
   */
  avgDurationSeconds Int?
  p50DurationSeconds Int?
  p90DurationSeconds Int?
  /**
   * % of entered deals that advanced. NULL if insufficient data.
   */
  conversionRate     Float?
  computedAt         DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([pipelineId, stage, periodKey])
  @@index([organizationId, pipelineId, periodKey])
  @@index([organizationId, computedAt])
  @@map("deal_velocity_metrics")
}

model ForecastAccuracyReport {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotId           String           @unique
  snapshot             ForecastSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  actualAmount         Decimal          @db.Decimal(18, 4)
  forecastedAmount     Decimal          @db.Decimal(18, 4)
  committedAmount      Decimal          @db.Decimal(18, 4)
  bestCaseAmount       Decimal          @db.Decimal(18, 4)
  varianceAbsForecast  Decimal          @db.Decimal(18, 4)
  varianceAbsCommitted Decimal          @db.Decimal(18, 4)
  varianceAbsBestCase  Decimal          @db.Decimal(18, 4)
  variancePctForecast  Float?
  variancePctCommitted Float?
  variancePctBestCase  Float?
  /**
   * Accuracy class (DB CHECK):
   * accurate | over_delivered | under_delivered | unknown
   */
  accuracyClass        String           @default("unknown")
  computedAt           DateTime         @default(now())
  metadata             Json             @default("{}")
  createdAt            DateTime         @default(now())

  @@index([organizationId, accuracyClass, computedAt])
  @@index([organizationId, computedAt])
  @@map("forecast_accuracy_reports")
}

// ═══════════════════════════════════════════════════════════════════════════
// B10 — ENTITLEMENT PROCESS (Phase 1 / Service Cloud)
// Salesforce Entitlement Process analogue. Granular milestone layer on
// top of existing SlaPolicy (which only tracks coarse firstResponse +
// resolution hours). Per-entitlement milestone definitions + per-ticket
// per-milestone tracking + append-only audit. Slice-1 = schema + pure
// helpers; slice-2 wires hooks into existing /api/cron/sla-escalation
// and Ticket lifecycle + admin UI for entitlement authoring.
// See prisma/migrations/20260520120000_entitlement_process/migration.sql
// for trigger-level invariants (lifecycle FSMs, immutability on
// identifier columns, cross-table coherence + split-brain prevention
// on milestone.type === definition.type, append-only audit).
// ═══════════════════════════════════════════════════════════════════════════

model Entitlement {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slaPolicyId        String
  slaPolicy          SlaPolicy    @relation(fields: [slaPolicyId], references: [id], onDelete: Restrict)
  /**
   * Support tier (DB CHECK):
   * basic | standard | premium | enterprise
   */
  supportLevel       String       @default("standard")
  /**
   * Inclusive lower bound.
   */
  validFrom          DateTime
  /**
   * Exclusive upper bound. NULL = open-ended.
   */
  validTo            DateTime?
  /**
   * Lifecycle (DB CHECK + transition trigger):
   * draft | active | suspended | expired | cancelled
   * draft → active|cancelled; active → suspended|expired|cancelled;
   * suspended → active|expired|cancelled; expired+cancelled terminal.
   * companyId + slaPolicyId immutable post-create.
   * At most one ACTIVE entitlement per company (partial unique index).
   */
  status             String       @default("draft")
  expiredAt          DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  notes              String?
  createdBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  milestoneDefinitions EntitlementMilestoneDefinition[]
  auditEvents          EntitlementAuditEvent[]

  @@index([organizationId, companyId])
  @@index([organizationId, status])
  @@index([organizationId, validFrom, validTo])
  // Partial unique on (companyId WHERE status='active') handled in SQL migration.
  @@map("entitlements")
}

model EntitlementMilestoneDefinition {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entitlementId    String
  entitlement      Entitlement  @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  /**
   * Milestone type (DB CHECK):
   * first_response | problem_identified | workaround_delivered | resolution | escalation
   */
  type             String
  name             String
  /**
   * Severity-tier scoping (DB CHECK):
   * critical | high | normal | low | NULL (all severities)
   */
  severityTier     String?
  /**
   * Due window in seconds (1..31_536_000 = max 365 days).
   */
  dueWithinSeconds Int
  isRequired       Boolean      @default(true)
  metadata         Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ticketMilestones EntitlementTicketMilestone[]

  // (entitlementId, type, COALESCE(severityTier, '')) unique handled in SQL.
  @@index([organizationId, entitlementId])
  @@map("entitlement_milestone_definitions")
}

model EntitlementMilestoneTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Support level (DB CHECK):
   * basic | standard | premium | enterprise
   */
  supportLevel   String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rules EntitlementMilestoneTemplateRule[]

  @@unique([organizationId, supportLevel])
  @@index([organizationId, isActive])
  @@map("entitlement_milestone_templates")
}

model EntitlementMilestoneTemplateRule {
  id               String                       @id @default(cuid())
  organizationId   String
  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId       String
  template         EntitlementMilestoneTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /**
   * Milestone type (DB CHECK):
   * first_response | problem_identified | workaround_delivered | resolution | escalation
   */
  type             String
  name             String
  /**
   * Severity-tier scoping (DB CHECK):
   * critical | high | normal | low | NULL (all severities)
   */
  severityTier     String?
  dueWithinSeconds Int
  isRequired       Boolean                      @default(true)
  sortOrder        Int                          @default(0)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([organizationId, templateId])
  @@map("entitlement_milestone_template_rules")
}

model EntitlementTicketMilestone {
  id              String                         @id @default(cuid())
  organizationId  String
  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId        String
  ticket          Ticket                         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  definitionId    String
  definition      EntitlementMilestoneDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  /**
   * Denormalized from definition for fast cron walks. Coherence trigger enforces match.
   */
  type            String
  /**
   * Lifecycle (DB CHECK + transition trigger):
   * pending | in_progress | met | missed | waived
   * "missed" is NOT terminal — operator can flip to met/waived after-the-fact.
   * "met" + "waived" are terminal.
   */
  status          String                         @default("in_progress")
  dueAt           DateTime
  completedAt     DateTime?
  missedAt        DateTime?
  waivedAt        DateTime?
  waivedReason    String?
  escalationLevel Int                            @default(0)
  lastEscalatedAt DateTime?
  metadata        Json                           @default("{}")
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  auditEvents EntitlementAuditEvent[]

  @@unique([ticketId, definitionId])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, ticketId])
  @@map("entitlement_ticket_milestones")
}

model EntitlementAuditEvent {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Either entitlementId or milestoneId required (DB CHECK).
   */
  entitlementId  String?
  entitlement    Entitlement?                @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  milestoneId    String?
  milestone      EntitlementTicketMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  /**
   * Event type (DB CHECK):
   * entitlement_created | entitlement_updated | entitlement_activated |
   * entitlement_suspended | entitlement_resumed | entitlement_expired |
   * entitlement_cancelled |
   * milestone_started | milestone_met | milestone_missed | milestone_waived |
   * milestone_escalated | milestone_re_anchored
   */
  eventType      String
  payload        Json                        @default("{}")
  actorUserId    String?
  actor          User?                       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  occurredAt     DateTime                    @default(now())
  createdAt      DateTime                    @default(now())

  // Partial WHERE-indexes on entitlementId/milestoneId handled in SQL.
  @@index([organizationId, eventType, occurredAt])
  @@map("entitlement_audit_events")
}

// ─── S3: Sales Sequences / Cadences ───────────────────────────────────────────

model SalesSequence {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  isActive          Boolean              @default(true)
  /// Cadence auto-exit rules: stop this sequence's active enrollments when the
  /// person replies / a meeting is logged / the related deal closes.
  /// Consumed by src/lib/sequence-auto-exit.ts.
  exitOnReply       Boolean              @default(true)
  /// E2 — what a recipient's reply does to the enrollment: "stop" | "pause" |
  /// "continue". Null = legacy behavior derived from exitOnReply
  /// (true→stop, false→continue). Owned by src/lib/sequence-auto-exit.ts.
  replyReaction     String?
  exitOnMeeting     Boolean              @default(true)
  exitOnDealClosed  Boolean              @default(true)
  /// Auto-enroll: a new lead whose `source` is in this list is enrolled into the
  /// sequence on creation (web-to-lead / form-submit). Empty = off.
  /// Consumed by src/lib/sequences-auto-enroll.ts.
  autoEnrollSources String[]             @default([])
  /// If true, a touch that would fall on Sat/Sun is scheduled for the next Monday
  /// (computeNextStepAt). Off = touches land on any day.
  workdaysOnly      Boolean              @default(false)
  createdBy         String?
  creator           User?                @relation("SequenceCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  steps             SequenceStep[]
  enrollments       SequenceEnrollment[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("sales_sequences")
}

model SequenceStep {
  id             String        @id @default(cuid())
  sequenceId     String
  sequence       SalesSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  organizationId String
  stepOrder      Int // 1, 2, 3… (execution order within the sequence)
  /// "email" | "call" | "task"
  type           String
  delayDays      Int           @default(0) // days after previous step (or enrollment for step 1)
  /// E1 email threading: "continue" = follow-up rides the enrollment's thread
  /// (In-Reply-To/References + «Re: root subject»), "new" = start a fresh
  /// thread. Only meaningful for type="email".
  threadMode     String        @default("continue")
  subject        String? // email subject / task title
  body           String? // email body or task description template
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([sequenceId])
  @@index([organizationId])
  @@map("sequence_steps")
}

model SequenceEnrollment {
  id              String        @id @default(cuid())
  sequenceId      String
  sequence        SalesSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "lead" | "contact"
  entityType      String
  entityId        String // references leads.id or contacts.id
  enrolledBy      String?
  enrolledByUser  User?         @relation("SequenceEnroller", fields: [enrolledBy], references: [id], onDelete: SetNull)
  /// Whose touch-queue this enrollment lands in. Set at enroll time from the
  /// enrolled lead's assignedTo (contacts carry no owner column — falls back to
  /// enrolledBy). Bare scalar like Lead.assignedTo / Deal.assignedTo — no User
  /// FK on purpose: assignedTo ids can be stale (no FK on leads either).
  ownerId         String?
  currentStep     Int           @default(0) // 0 = not started, N = step N completed
  /// "active" | "paused" | "completed" | "stopped"
  status          String        @default("active")
  nextStepAt      DateTime? // when to execute the next step
  completedAt     DateTime?
  stoppedAt       DateTime?
  /// Cadence outcome tracking (auto-exit + analytics)
  repliedAt       DateTime? // inbound reply from the enrolled person detected
  meetingBookedAt DateTime? // meeting activity logged with the enrolled person
  lastOutcome     String? // outcome of the most recent completed step: "done" | "no_answer" | "skipped"
  exitReason      String? // "replied" | "meeting_booked" | "deal_closed" | "manual"
  /// E1 email threading state: { rootSubject, messageIds: string[] } — the
  /// RFC Message-IDs WE minted for this enrollment's sent emails (cap 20).
  /// Shape owned by src/lib/sequence-threading.ts.
  threading       Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([sequenceId, entityType, entityId]) // one active enrollment per entity per sequence
  @@index([organizationId])
  @@index([sequenceId])
  @@index([organizationId, entityType, entityId])
  @@index([status, nextStepAt]) // cron query: active enrollments ready to advance
  @@index([organizationId, ownerId, status]) // touch-queue query: my active touches due
  @@map("sequence_enrollments")
}

// ═══════════════════════════════════════════════════
// S4: SALES TERRITORIES
// ═══════════════════════════════════════════════════

// Territory — a named sales region with optional auto-assignment rules.
//
// rules JSON shape:
// {
//   countries:  string[],   // ISO-3166-1 alpha-2 codes, e.g. ["AZ","GE","TR"]
//   industries: string[],   // freeform industry tags matching Company.industry
//   companySizeMin: number, // minimum employee count
//   companySizeMax: number, // maximum employee count (0 = no limit)
// }
// Empty array / missing key = "any" (no filter on that dimension).
// Auto-assignment fires on Company create if ANY territory rules match.

model Territory {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean               @default(true)
  rules          Json                  @default("{}") // TerritoryRules
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  members        TerritoryMembership[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("territories")
}

// TerritoryMembership — pivot: which users belong to a territory.
model TerritoryMembership {
  id          String    @id @default(cuid())
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([territoryId, userId])
  @@index([territoryId])
  @@index([userId])
  @@map("territory_memberships")
}

// ============================================================================
// S6 CPQ — Configure-Price-Quote (slice-1: schema + pure helper, no routes)
// ============================================================================
//
// Roadmap: docs/roadmap-to-salesforce-level.md Phase 5 S6.
// Audit: memory/project_salesforce_phase5_audit.md (2026-05-29) confirmed
//   no pre-existing Quote model — collision-safe.
// Architecture:
//   - Quote is the top-level proposal sent to a customer. Optional 1:N
//     with Deal (a deal can have multiple revisions, or a quote can
//     stand alone without a deal yet).
//   - QuoteLineItem is the per-product breakdown — qty + unitPrice +
//     per-line discount + computed lineTotal. References Product via
//     optional FK (ad-hoc line items without a Product row are allowed
//     for one-off services). productName snapshot preserves audit
//     integrity if the Product row is later renamed.
//   - All money columns are Decimal(18, 4) per the D5 Payments + D8
//     Loyalty Float→Decimal sweep pattern — IEEE-754 drift kills CPQ.
//   - Status state machine: draft → sent → viewed → accepted | rejected | expired.
//     Side-exit fields (sentAt / viewedAt / acceptedAt / rejectedAt) are
//     stamped by the route layer when the corresponding transition fires.
//   - rejectedReason carries customer-supplied free-text that may contain
//     PII (competitor names, contract objections) — encrypted via the
//     Phase 7 slice-3 column-bound AAD helpers (encryptForTenantBound
//     with table="quotes", column="rejectedReason"). Slice-2 route layer
//     wires the encrypt/decrypt; slice-1 only declares the column shape.

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Institutional quote identifier — UNIQUE per (org, version) tuple.
  /// 50-char cap accommodates "Q-2026-Q4-EnterpriseRenewal-v1" style
  /// composite IDs without surfacing a fee-counter debate later.
  quoteNumber String @db.VarChar(50)

  /// Revision counter — increments when the same quoteNumber is re-issued.
  /// (e.g. customer rejected v1, sales rep revises pricing, sends v2)
  version Int @default(1)

  /// Optional link to a Deal — a quote may also stand alone (cold
  /// prospect, not yet a tracked deal). ON DELETE SET NULL preserves
  /// the quote audit trail if the parent deal is removed.
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  /// State machine: draft → sent → viewed → accepted | rejected | expired.
  /// Validation enforced at the route layer in slice-2; DB stores the
  /// string verbatim with a CHECK constraint added in the migration.
  status String @default("draft")

  validUntil DateTime?
  currency   String    @default("AZN")

  /// Sum of all QuoteLineItem.lineTotal values BEFORE any quote-level
  /// discount. Computed by `src/lib/cpq/totals.ts`. Persisted (not
  /// computed-at-read) because the route layer may need to render
  /// historical totals even if line items were later edited.
  subtotal Decimal @default(0) @db.Decimal(18, 4)

  /// Quote-level absolute discount applied AFTER all per-line discounts.
  /// Either discountAmount OR discountPct — never both. Route-layer
  /// validation enforces the XOR in slice-2.
  discountAmount Decimal  @default(0) @db.Decimal(18, 4)
  discountPct    Decimal? @db.Decimal(5, 2)

  /// Final quote total = subtotal − discountAmount (or subtotal × (1 − discountPct/100)).
  /// Persisted for the same reason as subtotal.
  ///
  /// ⚠️ MUST be recomputed by the route layer whenever line items
  /// change — there is NO DB trigger keeping this in sync. The slice-2
  /// POST/PATCH handlers call `rollUpQuote()` from `src/lib/cpq/totals.ts`
  /// before persisting any change to lineItems / discountAmount /
  /// discountPct. Default 0 covers the empty-quote case (a draft with
  /// no line items yet); any other stale value would be a route bug.
  totalAmount Decimal @default(0) @db.Decimal(18, 4)

  notes String?

  /// Free-text buyer name for the quote PDF "FOR" line.
  /// When set, takes precedence over the linked deal's company name.
  /// Lets reps issue ad-hoc quotes to prospects not yet in the CRM.
  customerName String?

  /// Lifecycle timestamps — stamped by the route layer on the
  /// corresponding state-machine transition. NULL until the transition fires.
  sentAt     DateTime?
  viewedAt   DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  /// PII — bound-AAD encrypted in slice-2 routes via
  /// `encryptForTenantBound(orgId, "quotes", "rejectedReason", value)`.
  /// May carry competitor names, contract objections, or internal-mood
  /// commentary. Slice-1 only declares the column.
  rejectedReason String?

  /// Slice-3 piece-3: opaque tracking token embedded in the customer
  /// email's 1×1 pixel URL. When the pixel fires, the
  /// `/api/v1/tracking/open?quoteToken=…` endpoint looks up the quote
  /// by token (no auth — the token IS the capability) and atomically
  /// transitions `sent → viewed`. NULL on quotes created before
  /// piece-3 landed; required on new quotes (route layer sets it via
  /// `crypto.randomUUID()` at POST time).
  ///
  /// Token is per-quote, ~122 bits of entropy — unguessable without
  /// the email. If a customer forwards the email, the forwarded
  /// recipient could trigger `viewed` once — accepted risk (the
  /// transition is informational, not auth-critical, and idempotent
  /// so a second hit is a no-op).
  trackingToken String? @unique(map: "quotes_tracking_token_uniq")

  createdBy String?
  creator   User?    @relation("QuoteCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems QuoteLineItem[]

  @@unique([organizationId, quoteNumber, version], map: "quotes_org_number_version_uniq")
  @@index([organizationId, status], map: "quotes_org_status_idx")
  @@index([organizationId, dealId], map: "quotes_org_dealId_idx")
  @@map("quotes")
}

model QuoteLineItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Optional FK to Product. Null = ad-hoc line item (one-off service,
  /// custom bundle). ON DELETE SET NULL so the quote row stays whole
  /// even if a referenced Product is later removed — the productName
  /// snapshot below preserves the human-readable record.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Snapshot of Product.name at line-item write time. Stored even
  /// when productId is set so quote rendering is stable after a
  /// Product rename. Required because audit integrity > navigation
  /// efficiency on quote rows.
  productName String

  description String?

  /// Snapshot of Product.sku (or ad-hoc part number). Null when none.
  sku String?

  /// Snapshot of Product.productType (or ad-hoc choice). Drives whether
  /// `quantity` is integer (hardware/license/subscription/other) or
  /// decimal (service). Default "other" = integer.
  productType String @default("other")

  /// Decimal so partial-quantity line items work (2.5 consulting hours,
  /// 0.75 month prorated service). Default 1 covers the discrete case.
  quantity Decimal @default(1) @db.Decimal(18, 4)

  unitPrice Decimal @db.Decimal(18, 4)

  /// Per-line absolute discount applied BEFORE the quote-level discount
  /// at the Quote layer. Either lineDiscountAmount OR lineDiscountPct —
  /// route-layer validation enforces the XOR in slice-2.
  lineDiscountAmount Decimal  @default(0) @db.Decimal(18, 4)
  lineDiscountPct    Decimal? @db.Decimal(5, 2)

  /// Computed as: quantity * unitPrice - lineDiscountAmount (or
  /// quantity * unitPrice * (1 - lineDiscountPct/100)). Persisted
  /// for the same audit-integrity reason as Quote.subtotal/totalAmount —
  /// historical line totals must not silently shift if pricing data
  /// changes elsewhere. `src/lib/cpq/totals.ts` is the canonical
  /// computer; the route layer recomputes on write and persists.
  lineTotal Decimal @db.Decimal(18, 4)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_line_items")
}

// ============================================================================
// T9 Proactive Service — slice-1 (2026-05-29)
// ============================================================================
//
// Persisted customer health snapshot + triggered alert queue. Existing
// churnRisk computation (`/api/v1/calculated-insights/route.ts:216`) and
// engagementScore columns (Contact:740, MarketingAccount:10304) feed
// into these tables via a slice-2 cron; slice-1 only declares the data
// layer + pure compute helper.

/// Numerical health snapshot per (entityType, entityId). Polymorphic
/// across Contact / Company / Deal so the same model captures every
/// customer-facing relationship. Score is 0-100 (higher = healthier);
/// `factors` Json carries the explanatory breakdown for the UI.
model HealthScore {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Polymorphic target — "contact" | "company" | "deal". DB CHECK
  /// constraint added in the migration to fail-fast on a typo.
  entityType String
  entityId   String

  /// 0-100. CHECK constraint enforces the range at DB layer.
  /// Higher = healthier (consistent with conventional NPS / CSAT
  /// direction). Recomputed by the slice-2 refresh cron.
  score Int

  /// Breakdown of contributing factors so the UI can show "why":
  /// `{ "churnRisk": 0.7, "engagementScore": 12, "daysSinceLastActivity": 90, ... }`.
  /// Pure-helper computed (see `src/lib/proactive/score-compute.ts`).
  factors Json @default("{}")

  /// Last cron refresh timestamp. UI shows "stale" badge when older
  /// than the configured TTL (default 24h).
  lastComputedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // One score per (org, entityType, entityId) — the cron upserts.
  @@unique([organizationId, entityType, entityId], map: "health_scores_unique")
  @@index([organizationId, entityType, score], map: "health_scores_org_type_score_idx")
  @@map("health_scores")
}

/// Triggered alert queue — emitted by the slice-2 alerts cron when a
/// signal crosses a configured threshold (e.g. `score < 30`,
/// `daysSinceLastActivity > 90`). Surfaces in the customer detail page's
/// "Active Alerts" section; sales / CS reps acknowledge or dismiss.
model ProactiveAlert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// DB CHECK taxonomy: "churn_risk" | "health_drop" | "engagement_low"
  /// | "payment_overdue" | "contract_expiring" | "no_activity" | "custom".
  /// Slice-2 cron emits a fixed set; "custom" reserved for manual /
  /// API-triggered alerts.
  triggerType String

  /// "info" | "warning" | "critical" (CHECK). Drives UI badge color and
  /// notification routing (critical pages an on-call rep; info batches
  /// into the daily digest).
  severity String @default("warning")

  /// Polymorphic — same taxonomy as `HealthScore.entityType`.
  entityType String
  entityId   String

  /// Human-grade summary, "Customer hasn't logged in for 90 days" etc.
  message String

  /// Snapshot of the signals that triggered this alert at emit time —
  /// future UI may show "was 12, now 4" deltas.
  context Json @default("{}")

  /// Lifecycle:
  ///   - new alert → `acknowledgedAt` + `dismissedAt` both null
  ///   - rep saw it → `acknowledgedAt` stamped, still visible
  ///   - rep resolved it → `dismissedAt` + `dismissedBy` stamped,
  ///     hidden from active list (audit-retained)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  dismissedAt    DateTime?
  dismissedBy    String?

  createdAt DateTime @default(now())

  // Hot path: list "active" (un-dismissed) alerts per org/entity.
  // Migration creates this as a PARTIAL index with WHERE
  // "dismissedAt" IS NULL — Prisma can't express partial indices in
  // the schema annotations (yet), so the map name is the contract.
  @@index([organizationId, entityType, entityId], map: "proactive_alerts_active_idx")
  // Hot path: severity sort for digest emails.
  @@index([organizationId, severity, createdAt], map: "proactive_alerts_severity_idx")
  @@map("proactive_alerts")
}

// ============================================================================
// M10 Content Performance AI — slice-1 (2026-05-29)
// ============================================================================
//
// Persistent content quality score per (entityType, entityId). Reuses
// existing aggregation columns on Campaign / CampaignVariant + EmailLog
// templateId roll-up to compute a 0-100 score. Slice-1 ships data layer
// + pure helper; slice-2 wires the refresh cron; slice-3 wires UI badges
// on the email-templates list / campaigns list.

/// Polymorphic content scoring snapshot. Higher = better-performing.
/// `factors` Json carries the per-factor breakdown for the UI's
/// "why this score" panel (same pattern as `HealthScore.factors`).
model ContentScore {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Polymorphic target — "email_template" | "campaign" | "campaign_variant".
  /// DB CHECK enforced in the migration.
  entityType String
  entityId   String

  /// 0-100. CHECK constraint enforces range at DB layer.
  /// Higher = better-performing content (consistent with the T9
  /// HealthScore direction convention).
  score Int

  /// Breakdown of contributing factors:
  /// `{ "openRate": 0.27, "openBonus": 13.5, "clickBonus": 5,
  ///    "bouncePenalty": 1.2, "unsubscribePenalty": 0.5, "recencyPenalty": 0,
  ///    "baseline": 50, "sampleSize": 1240 }`.
  factors Json @default("{}")

  /// Last cron refresh timestamp. UI shows "stale" badge older than 24h.
  lastComputedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // One score per (org, entityType, entityId) — cron upserts.
  @@unique([organizationId, entityType, entityId], map: "content_scores_unique")
  @@index([organizationId, entityType, score], map: "content_scores_org_type_score_idx")
  @@map("content_scores")
}

// ============================================================================
// A9 Adaptive AI Models — slice-1 (2026-05-29)
// ============================================================================
//
// User-supplied feedback on AI predictions (deal win probability,
// churn risk, lead scoring, chat responses, AI recommendations).
// Slice-1 ships the data layer + pure aggregation helper. Slice-2
// wires API routes + UI feedback widgets on prediction surfaces.
// Slice-3 closes the adaptive loop — accumulated feedback adjusts
// prediction confidence + flags low-quality predictions for review.

/// Single user rating on a single AI prediction / output. Polymorphic
/// across all prediction surfaces. Rating taxonomy: -1 = bad, 0 =
/// neutral, +1 = good — three-state semantics matching the thumbs
/// up/down/skip UX widget on the prediction surface.
model AiFeedback {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Prediction surface taxonomy (CHECK):
  /// prediction_deal_win | prediction_churn | prediction_lead_score
  /// | prediction_revenue_forecast | recommendation_next_action
  /// | chat_response | content_insight | custom
  /// Slice-2 routes emit a fixed set; "custom" reserved for one-off
  /// adapters (e.g. third-party AI service responses).
  predictionType String

  /// ID of the entity the prediction was about — depends on
  /// predictionType:
  ///   prediction_deal_win        → Deal.id
  ///   prediction_churn           → Contact.id or Company.id
  ///   prediction_lead_score      → Lead.id
  ///   prediction_revenue_forecast→ ForecastSnapshot.id (each snapshot
  ///                                is a row, so org-wide forecasts
  ///                                always have a concrete target id)
  ///   recommendation_next_action → Activity.id or Task.id (the proposed action)
  ///   chat_response              → AiInteractionLog.id
  ///   content_insight            → EmailTemplate.id | EmailCampaign.id
  ///                                | CampaignVariant.id (matches M10
  ///                                ContentScore taxonomy in
  ///                                `src/lib/content-perf/types.ts`)
  /// Slice-2 routes own the type→table mapping; this column is
  /// intentionally just the string id so adding new prediction types
  /// doesn't require a schema migration.
  predictionTargetId String

  /// Snapshot of the prediction's value at feedback time (e.g. "0.73"
  /// for a 73% win probability). Lets accuracy aggregation compare
  /// "predicted 0.73, user said bad" without re-running the prediction.
  /// Optional — chat feedback doesn't have a numeric prediction.
  predictionValue String?

  /// User-supplied rating (CHECK: -1, 0, +1).
  rating Int

  /// Optional free-text feedback (anti-pattern: PII risk if user types
  /// names; slice-2 docs warn users to keep it abstract).
  comment String?

  /// The user who gave the feedback. Nullable for system-generated
  /// outcome feedback (slice-3 closes-the-loop cron may insert
  /// "actual outcome" rows with userId=null).
  userId String?

  createdAt DateTime @default(now())

  // Hot path: aggregate feedback for a specific prediction surface.
  @@index([organizationId, predictionType, createdAt], map: "ai_feedback_org_type_created_idx")
  // Hot path: lookup feedback for a specific prediction target (the
  // feedback widget on a Deal detail page queries this).
  @@index([organizationId, predictionType, predictionTargetId], map: "ai_feedback_target_idx")
  @@map("ai_feedback")
}

/// A9 Adaptive AI Models — slice-3 adjustment store.
///
/// Per-(org, predictionType) row holding the current `adjustmentFactor`
/// derived from accumulated user feedback (via slice-1
/// `aggregateFeedback`). Read by prediction engines at request time to
/// bias their output; written by the slice-3 refresh cron after each
/// aggregation tick.
///
/// Why a separate table instead of recomputing inline:
///   1) Aggregation cost grows with feedback volume — the cron pays
///      it once per N minutes instead of every prediction request
///   2) The cron's "since" cursor (`lastComputedAt`) lets us
///      incrementally aggregate just the new rows without rescanning
///   3) Snapshot of inputs (sampleSize, avgRating, approvalRate)
///      simplifies debugging — "why did the cron think the model is
///      bad?" is answered by a single SELECT
///
/// Decimals chosen over Float per project policy (no Float for any
/// stored-and-compared value).
model AiPredictionAdjustment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Mirrors AiFeedback.predictionType — same enum, same CHECK.
  predictionType String

  /// Current adjustment factor [-1, 1] computed by aggregateFeedback.
  /// Slice-3 engines multiply this by a per-engine `maxAdjustment`
  /// step (e.g. 0.10 for deal-win means up to ±10% nudge to the
  /// probability) — see `applyAdjustment` in
  /// `src/lib/adaptive-ai/adjustments.ts`.
  adjustmentFactor Decimal @db.Decimal(6, 4)

  /// Snapshot of inputs for observability.
  sampleSize   Int
  avgRating    Decimal @db.Decimal(6, 4)
  approvalRate Decimal @db.Decimal(6, 4)

  lastComputedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  // Composite uniqueness: one current adjustment row per
  // (org, predictionType). Upsert from the cron.
  @@unique([organizationId, predictionType], map: "ai_prediction_adjustment_org_type_unique")
  @@map("ai_prediction_adjustments")
}

/// P8 No-Code Form Builder — slice-1.
///
/// Standalone form (embeddable or shareable via a public slug-based
/// URL). Distinct from `LandingPage.formConfig` which embeds a form
/// inside a page. P8 forms are reusable across many pages and have
/// their own submissions endpoint + analytics.
///
/// `fields` JSON shape (validated by
/// `src/lib/form-builder/types.ts` → FormFieldSchema):
///   [{
///     key: string,                    // submission-data key
///     type: FormFieldType,            // see FORM_FIELD_TYPES enum
///     label: string,
///     required?: boolean,
///     placeholder?: string,
///     helpText?: string,
///     options?: [{ label, value }],   // for select/radio/checkbox
///     validation?: {
///       maxLength?: number,
///       minLength?: number,
///       pattern?: string,             // regex source
///       min?: number,                 // for number
///       max?: number,                 // for number
///     },
///   }]
///
/// Slice-1 stores the definition + ships the pure
/// `validateSubmission` helper. Slice-2 will add API CRUD + a public
/// submit endpoint + a renderer + builder UI.
model FormDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String // URL slug — `/f/{slug}` for the public render
  description String?

  /// Array of FormFieldSchema objects — validated at the route
  /// layer via `validateFormDefinition` in
  /// `src/lib/form-builder/validate-definition.ts`.
  fields Json

  /// CHECK enum: draft | published | archived.
  /// Published forms accept submissions on the public endpoint;
  /// draft is owner-preview-only; archived rejects new submissions.
  status String @default("draft")

  /// Optional behavior after submission.
  successMessage String?
  redirectUrl    String?

  /// Notify these emails on submission (CSV).
  notifyEmails String?

  /// Auto-create a Lead from the submission. Slice-2 routes a Lead.
  leadAutoCreate Boolean @default(false)

  /// C9 #15 — optional campaign this form belongs to. A published submission
  /// whose email resolves to a known contact records a `form_submitted`
  /// attribution touchpoint for this campaign. SetNull keeps forms if the
  /// campaign is deleted.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Observability counters refreshed on submission.
  totalViews       Int @default(0)
  totalSubmissions Int @default(0)

  publishedAt DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions FormSubmission[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, campaignId])
  @@map("form_definitions")
}

/// T8 Cobrowse — slice-1 session record.
///
/// Captures a single agent⇄customer cobrowse session. Slice-1 ships
/// only the data layer + state machine helpers; slice-2 wires the
/// signaling routes (WebSocket / SSE) that the WebRTC peer
/// connection uses; slice-3 builds the agent + customer UIs.
///
/// Lifecycle:
///   pending    — session created, customer hasn't joined yet
///   awaiting_consent — customer joined, consent banner shown
///   active     — consent granted, peer connection live
///   paused     — agent or customer paused (privacy mask)
///   ended      — terminal; endedAt stamped, reason captured
///
/// Consent gate: a session NEVER transitions to `active` without
/// `consentGivenAt` being set. Slice-2 signaling route enforces.
model CobrowseSession {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Internal user (support agent) initiating the session. Cascade
  /// on user deletion mirrors the convention used elsewhere; an
  /// orphan session referencing a deleted agent is a stale audit
  /// row, not a recoverable resource.
  agentUserId String
  agent       User   @relation("CobrowseAgent", fields: [agentUserId], references: [id], onDelete: Cascade)

  /// Contact being supported. Optional — anonymous public-portal
  /// cobrowse won't always have a known Contact row. SetNull
  /// preserves the audit row when the contact is later deleted.
  contactId String?
  contact   Contact? @relation("CobrowseContact", fields: [contactId], references: [id], onDelete: SetNull)

  /// Lifecycle status — CHECK enum mirrors COBROWSE_STATUSES.
  status String @default("pending")

  /// Short-lived signed token customer uses to join. Slice-2
  /// signaling route validates this. Single-use; rotated on
  /// pause/resume.
  joinToken String @unique

  /// Stamped when customer ticks the consent checkbox.
  consentGivenAt DateTime?

  /// Reason recorded on `ended` transition — CHECK enum mirrors
  /// COBROWSE_END_REASONS.
  endReason String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /// Row-level last-touched timestamp. Bumps on state transitions
  /// + any other row mutation; does NOT bump while an SSE connection
  /// is open without state changes. For that, see `lastSeenAt`.
  updatedAt DateTime @updatedAt

  /// SSE heartbeat poke. Bumped every ~25s while either side has an
  /// active SSE subscriber (slice-3c, `src/lib/cobrowse/sse.ts`).
  /// The reaper cron uses this as a liveness signal: a session with
  /// a fresh `lastSeenAt` is genuinely active even if no state
  /// transitions have fired. Falls back to `updatedAt` when null
  /// (e.g. sessions that never had an SSE subscriber).
  lastSeenAt DateTime?

  @@index([organizationId, status, startedAt])
  @@index([agentUserId, startedAt])
  // Reaper hot path — slice-3c.
  @@index([status, lastSeenAt])
  @@map("cobrowse_sessions")
}

// ═══════════════════════════════════════════════════════════════════
// CLM Slice 1a — Document core (contract versioning + clause library)
// ═══════════════════════════════════════════════════════════════════

// Immutable version history for a contract. Every draft edit, amendment,
// and the single canonical signed execution are recorded here.
//
// `versionNo` is 1-based, monotonically increasing per contract, enforced
// by the UNIQUE constraint (contractId, versionNo).
// `contentHash` is the SHA-256 of `renderedBody` — callers MUST set this
// before insert; the application enforces immutability (no UPDATE allowed
// on existing rows beyond the `isCanonicalSigned` pointer flip).
// `isCanonicalSigned` — exactly ONE row per contract may carry this flag;
// set when the executed/signed PDF version is archived (Slice 2 e-sign).
// Enforced at the DB layer by partial unique index
// "contract_versions_one_canonical_per_contract" ON (contractId) WHERE
// isCanonicalSigned (migration 20260607130000_contract_version_canonical_unique).
// Prisma DSL cannot express partial unique indexes — the index is
// migration-only, following the repo idiom (see 20260521150000_mtm_soft_delete).
// `source` values: draft | amendment | signed | import
model ContractVersion {
  id                String   @id @default(cuid())
  organizationId    String
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNo         Int
  /// Snapshot of the document text at this version. Nullable only for
  /// import stubs where the body is provided externally as a file.
  renderedBody      String?
  /// SHA-256 hex digest of renderedBody — immutability/integrity proof.
  contentHash       String
  /// Rich HTML snapshot of this version's body (Slice 1 editor). A non-hashed
  /// convenience mirror alongside `renderedBody`; null for pre-editor rows
  /// (display falls back to `renderedBody`). NEVER part of `contentHash`.
  bodyHtml          String?
  /// draft | amendment | signed | import
  source            String   @default("draft")
  /// The single executed version. At most ONE row per contract may be true.
  isCanonicalSigned Boolean  @default(false)
  note              String?
  createdBy         String?
  createdAt         DateTime @default(now())

  /// Envelopes that were bound to this version at send time (back-relation).
  boundEnvelopes EsignEnvelope[]

  /// CLM Slice 6d: AI redlines where this version is the "from" source.
  redlinesAsFrom ContractRedline[] @relation("RedlineFromVersion")
  /// CLM Slice 6d: AI redlines where this version is the "to" target.
  redlinesAsTo   ContractRedline[] @relation("RedlineToVersion")

  @@unique([contractId, versionNo])
  @@index([organizationId, contractId])
  @@map("contract_versions")
}

// Org-wide governed reusable clause library. Distinct from
// ContractTemplate.clauses (an embedded JSON array per template) — this is
// a first-class entity with ownership, approval workflow, risk classification,
// and fallback variant support.
//
// `fallbackOfClauseId` is a plain String reference (convention, not a Prisma
// relation) pointing at another ContractClause.id that this row is a
// fallback/alternative variant of. Kept as a bare String to avoid Prisma
// self-relation migration complexity while still allowing application-layer
// traversal (SELECT * FROM contract_clauses WHERE id = fallbackOfClauseId).
// `body` may contain {{variable}} markers — same substitution format as
// ContractTemplate.clauses bodies.
// `status` values: draft | approved | retired
// `riskLevel` values: standard | fallback | high_risk
model ContractClause {
  id                 String   @id @default(cuid())
  organizationId     String
  title              String
  /// Clause body text; may contain {{variable}} substitution markers.
  body               String
  /// Broad category for filtering: liability | confidentiality | termination | …
  category           String?
  /// standard | fallback | high_risk
  riskLevel          String   @default("standard")
  governingLaw       String?
  /// Plain-string self-reference: this clause is a fallback variant of
  /// the clause with this id. NOT a Prisma relation (avoids self-ref
  /// migration complexity). Application layer resolves the chain.
  fallbackOfClauseId String?
  /// User who owns/maintains this clause in the governance workflow.
  ownerUserId        String?
  /// draft | approved | retired
  status             String   @default("draft")
  version            Int      @default(1)
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, category])
  @@index([organizationId, status])
  @@map("contract_clauses")
}

// CLM Slice 4c — Clause Governance: Deviation Detection
//
// Produced at contract-generate time (and on demand via re-scan) when a
// template clause is matched against the org's ContractClause library and
// found to be high_risk / retired / a fallback variant, or is not present
// in the library at all (non_standard). One flag per clause per contract.
// Flags may be acknowledged or waived (with a reason) through the deviations
// API; waived flags are preserved across re-scans.
//
// deviationType: "high_risk" | "fallback" | "retired" | "non_standard"
// severity:      "critical"  | "warning"  | "info"
// status:        "flagged"   | "acknowledged" | "waived"  (default "flagged")
model ContractDeviationFlag {
  id             String   @id @default(cuid())
  organizationId String
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  /// Matched library clause (null when non_standard — no library match).
  clauseId    String?
  /// Clause title as observed in the template at detection time.
  clauseTitle String

  /// "high_risk" | "fallback" | "retired" | "non_standard"
  deviationType String
  /// "critical" | "warning" | "info"
  severity      String

  /// "flagged" | "acknowledged" | "waived"
  status       String    @default("flagged")
  waivedBy     String?
  waivedAt     DateTime?
  waivedReason String?

  detectedAt DateTime @default(now())
  detectedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, contractId])
  @@index([organizationId, status])
  @@map("contract_deviation_flags")
}

/// CLM Slice 5a — general contract milestones / deliverable obligations.
///
/// Distinct from ASC-606 PerformanceObligation (financial revenue recognition).
/// Tracks operational deliverables: who owns them, when they are due,
/// whether they are done, and drives a reminder cron for overdue items.
model ContractMilestone {
  id             String   @id @default(cuid())
  organizationId String
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  /// Short identifier for the deliverable (required). e.g. "Deliver phase-1 report"
  label       String
  /// Optional longer description of the obligation.
  description String?

  /// When the milestone is due.
  dueAt       DateTime
  /// Set by API when status transitions to "completed".
  completedAt DateTime?

  /// pending | in_progress | completed | cancelled
  status String @default("pending")

  /// Org user responsible for this milestone (optional; validated same-org on write).
  ownerUserId String?

  /// Tracks the last time the reminder cron notified for this milestone.
  /// Used for conditional (no-double) logic: only re-notify after REMINDER_INTERVAL_HOURS.
  lastRemindedAt DateTime?

  /// Arbitrary extra data (e.g. acceptance criteria, deliverable URL, reviewer notes).
  metadata Json @default("{}")

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, contractId])
  @@index([organizationId, status, dueAt])
  @@map("contract_milestones")
}

/// CLM Slice 6a: AI clause + obligation extraction result for a contract.
///
/// Stores structured output from the Anthropic haiku model (tool_use).
/// One row per extraction run; latest row = current extraction.
/// extractedClauses: [{title, text, category, inferredRiskLevel}]
/// extractedObligations: [{label, party, dueDateText, condition}]
model ContractAiExtraction {
  id                   String   @id @default(cuid())
  organizationId       String
  contractId           String
  contract             Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Which version was extracted (null = Contract.renderedBody directly).
  contractVersionId    String?
  /// Extracted clauses as JSON array.
  extractedClauses     Json     @default("[]")
  /// Extracted obligations as JSON array.
  extractedObligations Json     @default("[]")
  /// Model identifier used for the extraction.
  model                String
  promptTokens         Int?
  completionTokens     Int?
  costUsd              Decimal? @db.Decimal(10, 6)
  /// completed | failed
  status               String   @default("completed")
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizationId, contractId])
  @@map("contract_ai_extractions")
}

/// CLM Slice 6b: AI risk-scoring result — scores extracted clauses against the
/// org's approved ContractClause library playbook (Anthropic haiku, tool_use).
///
/// One row per scoring run; latest row = current risk score.
/// overallRisk: low | medium | high
/// status: completed | failed
/// clauseScores: [{
///   clauseTitle, matchedLibraryClauseId?, riskLevel,
///   deviationType?, severity?, rationale, suggestedFallbackClauseId?
/// }]
model ContractRiskScore {
  id             String   @id @default(cuid())
  organizationId String
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  /// The extraction that was scored (null if scored without a linked extraction).
  extractionId String?

  /// Overall risk level derived from clause scores: low | medium | high
  overallRisk String

  /// Per-clause scoring detail — see JSDoc above for shape.
  clauseScores Json @default("[]")

  /// Model identifier used for the scoring.
  model String

  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal? @db.Decimal(10, 6)

  /// completed | failed
  status    String   @default("completed")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, contractId])
  @@map("contract_risk_scores")
}

/// CLM Slice 6c — pgvector embedding for semantic contract search.
/// One embedding per contract (@@unique contractId). Generated from the
/// canonical signed ContractVersion.renderedBody (or Contract.renderedBody).
/// Voyage voyage-3-lite 512-dim, mirroring KbEmbedding shape exactly.
model ContractEmbedding {
  id                String                     @id @default(cuid())
  organizationId    String
  contractId        String                     @unique
  contract          Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Which version's body was embedded (null if embedded from Contract.renderedBody).
  contractVersionId String?
  /// Truncated text that was embedded (up to 32k chars).
  content           String
  /// 512-dim Voyage voyage-3-lite vector.
  embedding         Unsupported("vector(512)")
  /// Model used for embedding (e.g. "voyage-3-lite").
  model             String                     @default("voyage-3-lite")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([organizationId])
  @@map("contract_embeddings")
}

/// CLM Slice 6d — AI semantic redline between two ContractVersions.
///
/// Records a structured diff produced by the Anthropic haiku model (tool_use).
/// One row per redline run; latest row per (contractId, fromVersionId, toVersionId) =
/// current redline. Mirrors the 6a/6b hardened AI-safety pattern exactly.
///
/// deltas: [{changeType, clauseTitle, summary, severity}]
///   changeType: "added" | "removed" | "modified"
///   severity:   "low"   | "medium"  | "high"
/// status: "completed" | "failed"
model ContractRedline {
  id             String   @id @default(cuid())
  organizationId String
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  /// The "from" version in the semantic diff (older version).
  fromVersionId String
  fromVersion   ContractVersion @relation("RedlineFromVersion", fields: [fromVersionId], references: [id], onDelete: Cascade)

  /// The "to" version in the semantic diff (newer version).
  toVersionId String
  toVersion   ContractVersion @relation("RedlineToVersion", fields: [toVersionId], references: [id], onDelete: Cascade)

  /// Structured clause-level delta list — see JSDoc above for shape.
  deltas Json @default("[]")

  /// Model's narrative summary of overall changes between the two versions.
  overallAssessment String @default("")

  /// Model identifier used for the redline.
  model String

  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal? @db.Decimal(10, 6)

  /// completed | failed
  status    String   @default("completed")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, contractId])
  @@map("contract_redlines")
}

/// Slice-3a Approval Delegation (out-of-office).
///
/// A user (fromUser) delegates their contract-approval authority to
/// another user (toUser) for a date window. submit-for-approval resolves
/// the active delegate at submission time and routes the stage there,
/// recording the original in ContractApprovalStage.originalAssigneeUserId.
/// One hop only — no recursive delegation to avoid loops.
model UserApprovalDelegate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// User who is delegating (the absent user).
  fromUserId String
  fromUser   User   @relation("DelegatingUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  /// User who receives the delegated approval authority.
  toUserId String
  toUser   User   @relation("DelegateRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  /// Inclusive start of the delegation window (UTC).
  startDate DateTime
  /// Inclusive end of the delegation window (UTC).
  endDate   DateTime

  /// Human-readable reason: "out_of_office" | "handoff" | "vacation" | etc.
  reason String?

  /// Soft-deactivation: DELETE sets isActive=false (no hard deletes).
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, fromUserId, isActive])
  @@index([organizationId, toUserId])
  @@map("user_approval_delegates")
}

// CLM Slice 3b — Conditional approval routing.
// An org can define rules that, at submit-for-approval time, add or skip
// approval stages based on the contract's attributes (value, type, currency).
// Rules may be org-wide (templateId = null) or template-specific.
model ContractApprovalRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Optional: restrict rule to a specific template. NULL = org-wide.
  templateId String?
  template   ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name String

  /// JSONB array of condition objects:
  /// [{ field: "value"|"type"|"currency", operator: "gte"|"lte"|"gt"|"lt"|"eq"|"neq"|"in", value: number|string|string[] }]
  conditions Json @default("[]")

  /// "all" (AND) or "any" (OR) — how to combine conditions.
  matchLogic String @default("all")

  isActive Boolean @default(true)

  /// User who created this rule (nullable — survives user deletion).
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions ContractApprovalRuleAction[]

  @@index([organizationId, isActive])
  @@map("contract_approval_rules")
}

/// Individual action belonging to a ContractApprovalRule.
/// actionType = "add_stage"  → insert a stage (with label + optional assignee).
/// actionType = "skip_stage" → remove any stage whose label matches stageLabel.
model ContractApprovalRuleAction {
  id     String               @id @default(cuid())
  ruleId String
  rule   ContractApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// "add_stage" | "skip_stage"
  actionType String

  /// Label of the stage to add (for add_stage) OR to remove by label (for skip_stage).
  stageLabel String?

  /// For add_stage: specific user assignee.
  assigneeUserId String?

  /// For add_stage: role-based assignee (e.g. "manager", "director").
  assigneeRole String?

  /// For add_stage: 1-based insert position; NULL = append after existing stages.
  atPosition Int?

  /// Controls evaluation order when a rule has multiple actions.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([ruleId, sortOrder])
  @@map("contract_approval_rule_actions")
}

// CLM Slice 3d — Contract Intake / Request Forms.
//
// An admin configures a form per contract type (ContractIntakeForm).
// A user fills and submits it (ContractIntakeSubmission).
// On submission a draft Contract is created and optionally auto-routed for approval.

model ContractIntakeForm {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// Default Contract.type for contracts spawned from this form.
  contractType String?

  /// JSONB array of question objects:
  /// [{ id: string, label: string, type: "text"|"textarea"|"number"|"date"|"select",
  ///    required: boolean, options?: string[] }]
  questions Json @default("[]")

  /// JSONB map of questionId → contract field ("title"|"valueAmount"|"currency"|...).
  /// Used to auto-fill contract fields from submitted responses.
  mapping Json @default("{}")

  /// JSONB array of default approval stage specs — same shape as submit-for-approval stages:
  /// [{ label: string, assigneeUserId?: string, assigneeRole?: string, slaHours?: number }]
  /// Empty array = no auto-routing; the draft is left as "draft" for manual submit-for-approval.
  defaultStages Json @default("[]")

  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions ContractIntakeSubmission[]

  @@index([organizationId, isActive])
  @@map("contract_intake_forms")
}

model ContractIntakeSubmission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  formId String
  form   ContractIntakeForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  /// JSONB map of questionId → submitted value.
  responses Json

  /// The draft Contract created from this submission. Null until processing completes.
  /// @unique — a contract can only be spawned from one intake submission.
  contractId String?   @unique
  contract   Contract? @relation("IntakeSubmissionContract", fields: [contractId], references: [id], onDelete: SetNull)

  /// submitted | contract_created | rejected
  status String @default("submitted")

  submittedBy String?
  submittedAt DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@map("contract_intake_submissions")
}

// CLM Slice 4b-1: organisation-scoped tags for contracts.
// Prisma implicit m2m — the join table `_ContractToContractTag` is auto-managed.
model ContractTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String? // optional hex string e.g. "#4f46e5"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts Contract[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("contract_tags")
}

// CLM Slice 7d — E-sign provider config.
//
// Stores OAuth credentials for external e-sign providers (DocuSign, etc.).
// The `config` column is an ENCRYPTED JSON blob (AES-256-GCM via
// src/lib/crypto/tenant-pii-encryption.ts encryptForTenant). Credentials
// are NEVER stored plaintext or returned in GET responses.
//
// One row per (organization, provider) — the unique constraint prevents
// duplicate configs. isActive=false disables the provider without deletion
// (audit trail preserved).
//
// Current providers:
//   "docusign" — DocuSign OAuth credentials (clientId, clientSecret,
//                accountId, basePath). The provider is a stub pending
//                the user's DocuSign OAuth app — see [P2] in
//                memory/deferred_findings.md.
model EsignProviderConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Provider identifier string. Currently only "docusign" is defined.
   * String (not enum) so future providers can be added without migrations.
   */
  provider       String
  /**
   * ENCRYPTED JSON blob containing the provider OAuth/API credentials.
   * Encrypted at rest via encryptForTenant(orgId, JSON.stringify(creds)).
   * Shape for "docusign": { clientId, clientSecret, accountId, basePath? }
   * NEVER returned in GET; the API masks this column.
   */
  config         String
  isActive       Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  envelopes EsignEnvelope[]

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("esign_provider_configs")
}

// Cross-process lease for singleton scheduled jobs. This table is deliberately
// global (no organizationId): only CRON_SECRET-gated, RLS-bypass job entrypoints
// may use it. A short expiring lease prevents duplicate work during PM2 reloads
// and later when multiple application instances share the same PostgreSQL DB.
model SystemJobLease {
  name            String    @id
  ownerToken      String?
  leaseUntil      DateTime?
  status          String    @default("idle")
  lastStartedAt   DateTime?
  lastCompletedAt DateTime?
  lastSkippedAt   DateTime?
  lastFailedAt    DateTime?
  lastDurationMs  Int?
  lastError       String?
  claimedCount    BigInt    @default(0)
  completedCount  BigInt    @default(0)
  skippedCount    BigInt    @default(0)
  failedCount     BigInt    @default(0)
  updatedAt       DateTime  @updatedAt

  @@index([leaseUntil])
  @@map("system_job_leases")
}

model TikTokPublicationRevisit {
  id                     String         @id @default(cuid())
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingestEnvelopeId       String
  ingestEnvelope         IngestEnvelope @relation(fields: [organizationId, ingestEnvelopeId], references: [organizationId, id], onDelete: Cascade)
  postExternalId         String
  canonicalUrl           String
  approvedAt             DateTime
  lastActivityAt         DateTime
  lastCheckedAt          DateTime?
  nextDueAt              DateTime?
  status                 String         @default("ACTIVE") // ACTIVE | INACTIVE
  reactivationGeneration Int            @default(0)
  lastSeenCommentCount   Int            @default(0)
  coverageClass          String         @default("UNKNOWN")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([organizationId, id], map: "tiktok_publication_revisits_org_id_key")
  @@unique([organizationId, ingestEnvelopeId], map: "tiktok_publication_revisits_org_envelope_key")
  @@unique([organizationId, postExternalId], map: "tiktok_publication_revisits_org_post_key")
  @@index([organizationId, status, nextDueAt], map: "tiktok_publication_revisits_org_due_idx")
  @@map("tiktok_publication_revisits")
}

model SocialCommentCheckpoint {
  id                        String           @id @default(cuid())
  organizationId            String
  organization              Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceId                  String
  source                    MonitoringSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  platform                  String
  canonicalParentUrl        String
  parentExternalId          String?
  discoveredAt              DateTime
  lastActivityAt            DateTime
  lastAttemptAt             DateTime?
  lastSuccessfulAt          DateTime?
  nextDueAt                 DateTime?
  status                    String           @default("ACTIVE") // ACTIVE | INACTIVE
  consecutiveNoChange       Int              @default(0)
  lastSeenCommentCount      Int              @default(0)
  lastSeenCommentExternalId String?
  coverageClass             String           @default("UNKNOWN")
  lastProviderRunId         String?
  lastError                 String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@unique([organizationId, id], map: "social_comment_checkpoints_org_id_key")
  @@unique([organizationId, sourceId, canonicalParentUrl], map: "social_comment_checkpoints_org_source_url_key")
  @@index([organizationId, sourceId, status, nextDueAt], map: "social_comment_checkpoints_org_source_due_idx")
  @@index([organizationId, platform, status, nextDueAt], map: "social_comment_checkpoints_org_platform_due_idx")
  @@map("social_comment_checkpoints")
}

// ─────────────────────────────────────────────────────────────────────────────
// Voice control (Gemini Live). The conversation itself is held by Gemini;
// these tables exist so WE own the two things a third party must not decide:
// how many paid minutes a user may burn, and what was said.
//
// Minutes are reserved up-front and settled on a confirmed end (reserve-then-
// settle), because we cannot stop a conversation from our side — a session that
// dies silently must still be charged its reservation, or a phone left in a
// pocket bills nothing and runs forever.
// ─────────────────────────────────────────────────────────────────────────────

model VoiceSession {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                   String
  // Legacy column name retained without a migration. For Gemini Live it is the
  // durable one-shot marker: null | gemini:connecting:<nonce> | gemini:connected:<nonce>.
  elevenlabsConversationId String?
  status                   String       @default("active") // active | ended | abandoned | never_connected | superseded
  locale                   String       @default("ru")
  reservedSeconds          Int
  billedSeconds            Int          @default(0)
  toolCallCount            Int          @default(0)
  startedAt                DateTime     @default(now())
  lastHeartbeatAt          DateTime     @default(now())
  endedAt                  DateTime?
  expiresAt                DateTime
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  turns VoiceSessionTurn[]

  @@unique([organizationId, id], map: "voice_sessions_org_id_key")
  @@index([organizationId, status], map: "voice_sessions_org_status_idx")
  @@index([status, lastHeartbeatAt], map: "voice_sessions_reaper_idx")
  @@map("voice_sessions")
}

model VoiceSessionTurn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceSessionId String
  session        VoiceSession @relation(fields: [organizationId, voiceSessionId], references: [organizationId, id], onDelete: Cascade)
  role           String // user | agent | tool
  text           String
  toolName       String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, voiceSessionId], map: "voice_session_turns_org_session_idx")
  @@map("voice_session_turns")
}

// The real quota. checkRateLimit cannot serve here: it is per-process and every
// deploy zeroes it, so a paid budget kept there would reset itself.
model VoiceMonthlyUsage {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  yearMonth       String // "2026-08", tenant-local
  reservedSeconds Int          @default(0)
  settledSeconds  Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, userId, yearMonth], map: "voice_monthly_usage_org_user_month_key")
  @@map("voice_monthly_usage")
}
