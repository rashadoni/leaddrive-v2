// Legal-escalation dossier: operators flag mentions as legal cases
// (insult / defamation / false accusation / threat), then bundle open cases
// into a period report with an AI-drafted complaint letter. The letter is
// ALWAYS a draft for lawyer review — nothing is auto-submitted anywhere.
model SocialLegalCase {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentionId      String
  mention        SocialMention         @relation(fields: [organizationId, mentionId], references: [organizationId, id], onDelete: Cascade)
  subjectId      String?
  subject        MonitoringSubject?    @relation(fields: [organizationId, subjectId], references: [organizationId, id], onDelete: NoAction)
  candidateId    String?
  candidate      SocialLegalCandidate? @relation(fields: [organizationId, candidateId], references: [organizationId, id], onDelete: NoAction)
  reportId       String?
  report         SocialLegalReport?    @relation(fields: [organizationId, reportId], references: [organizationId, id], onDelete: NoAction)
  category       String // insult | defamation | false_accusation | threat | other
  status         String                @default("open") // open | included | dismissed
  aiSuggested    Boolean               @default(false)
  notes          String?
  flaggedBy      String? // userId
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  evidences      SocialLegalEvidence[]
  events         SocialLegalEvent[]
  actions        SocialLegalAction[]
  approvals      SocialLegalApproval[]

  @@unique([organizationId, id], map: "social_legal_cases_org_id_key")
  @@unique([organizationId, mentionId])
  @@unique([organizationId, candidateId], map: "social_legal_cases_org_candidate_key")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, reportId])
  @@index([organizationId, subjectId, status], map: "social_legal_cases_org_subject_status_idx")
  @@map("social_legal_cases")
}

model SocialLegalCandidate {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentionId          String
  mention            SocialMention         @relation(fields: [organizationId, mentionId], references: [organizationId, id], onDelete: Cascade)
  subjectId          String?
  subject            MonitoringSubject?    @relation(fields: [organizationId, subjectId], references: [organizationId, id], onDelete: NoAction)
  status             String                @default("NEW") // NEW | AI_REVIEWED | HUMAN_REVIEW | PROMOTED | DISMISSED
  category           String?
  confidence         Float                 @default(0)
  severity           Int                   @default(0)
  rationale          String?
  classifierVersion  String?
  classifierSnapshot Json                  @default("{}")
  policySnapshot     Json                  @default("{}")
  suggestedActions   Json                  @default("[]")
  createdBy          String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  promotedCase       SocialLegalCase?
  evidences          SocialLegalEvidence[]

  @@unique([organizationId, id], map: "social_legal_candidates_org_id_key")
  @@unique([organizationId, mentionId], map: "social_legal_candidates_org_mention_key")
  @@index([organizationId, status, confidence, createdAt], map: "social_legal_candidates_org_queue_idx")
  @@index([organizationId, subjectId, status], map: "social_legal_candidates_org_subject_status_idx")
  @@map("social_legal_candidates")
}

model SocialLegalEvidence {
