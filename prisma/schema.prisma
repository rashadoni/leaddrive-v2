  @@index([contentId], map: "media_ad_placements_content_idx")
  @@index([organizationId, status], map: "media_ad_placements_org_status_idx")
  @@index([organizationId, slotKind], map: "media_ad_placements_slot_idx")
  @@map("media_ad_placements")
}

model MediaConsumptionEvent {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriberId   String?
  subscriber     MediaSubscriber?      @relation(fields: [subscriberId], references: [id])
  contentId      String
  content        MediaContentInventory @relation(fields: [contentId], references: [id], onDelete: Cascade)
  placementId    String?
  placement      MediaAdPlacement?     @relation(fields: [placementId], references: [id])
  /// eventKind allow-list (DB CHECK):
  /// view_start | view_progress | view_complete | view_abandon
  /// | click | conversion | share | bookmark
  eventKind      String
  occurredAt     DateTime
  progressPct    Decimal?              @db.Decimal(5, 2)
  engagedSeconds Int?
  /// deviceKind allow-list (DB CHECK):
  /// web | mobile_web | ios_app | android_app | smart_tv | other
  deviceKind     String                @default("web")
  regionCode     String?
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())

  @@index([organizationId, occurredAt], map: "media_consumption_events_org_time_idx")
  @@index([contentId, occurredAt], map: "media_consumption_events_content_time_idx")
  @@index([subscriberId, occurredAt], map: "media_consumption_events_subscriber_time_idx")
  @@index([organizationId, eventKind], map: "media_consumption_events_kind_idx")
  @@index([placementId], map: "media_consumption_events_placement_idx")
  @@map("media_consumption_events")
}

// --- Phase 7+ C5: Pardot / Account Engagement (slice 1) ---
//
// Salesforce Marketing Cloud Account Engagement (Pardot) analogue.
// B2B marketing depth: account-level scoring + ICP fit grading + ABM
// journeys. Distinct from Phase 6 C2/C3/C4 (contact-level marketing).

model MarketingAccount {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Soft FK to CRM Company (NULL = marketing-only target account).
  companyId           String?
  accountName         String
  /// lifecycleStage allow-list (DB CHECK):
  /// target | engaged | mql | sql | opportunity | customer | churned
  lifecycleStage      String       @default("target")
  /// icpTier allow-list (DB CHECK):
  /// tier_1 | tier_2 | tier_3 | tier_4 | unscored
  icpTier             String       @default("unscored")
  engagementScore     Int          @default(0)
  /// grade allow-list (DB CHECK): A | B | C | D | F | unassigned
  grade               String       @default("unassigned")
  industrySlug        String?
  /// employeeBand allow-list (DB CHECK, nullable):
  /// micro | small | mid_market | enterprise | strategic
  employeeBand        String?
  annualRevenueUsd    BigInt?
  ownerUserId         String?
  becameEngagedAt     DateTime?
  becameMqlAt         DateTime?
  becameSqlAt         DateTime?
  becameOpportunityAt DateTime?
  becameCustomerAt    DateTime?
  churnedAt           DateTime?
  churnReason         String?
  lastSignalAt        DateTime?
  metadata            Json         @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  intentSignals  AccountIntentSignal[]
  abmEnrollments AbmJourneyEnrollment[]
  scoreSnapshots AccountScoreSnapshot[]

  @@index([organizationId, lifecycleStage], map: "marketing_accounts_org_stage_idx")
  @@index([organizationId, icpTier], map: "marketing_accounts_org_icp_idx")
  @@index([organizationId, grade], map: "marketing_accounts_org_grade_idx")
  @@index([organizationId, engagementScore], map: "marketing_accounts_org_score_idx")
  @@index([ownerUserId], map: "marketing_accounts_owner_idx")
  @@map("marketing_accounts")
}

model AccountIntentSignal {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketingAccountId String
  marketingAccount   MarketingAccount @relation(fields: [marketingAccountId], references: [id], onDelete: Cascade)
  /// signalKind allow-list (DB CHECK):
  /// page_view_high_intent | page_view_research | content_download
  /// | form_submission | email_engagement | chat_high_intent
  /// | third_party_intent | competitor_research | event_attendance
  /// | social_engagement
  signalKind         String
  /// Signal weight (DB CHECK 1..100; slice-2 reads per-tenant config).
  weight             Int              @default(5)
  contactId          String?
  resourceRef        String?
  occurredAt         DateTime
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now())

  @@index([marketingAccountId, occurredAt], map: "account_intent_signals_account_time_idx")
  @@index([organizationId, signalKind], map: "account_intent_signals_org_kind_idx")
  @@index([contactId], map: "account_intent_signals_contact_idx")
  @@map("account_intent_signals")
}

model AbmJourney {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journeyNumber  String
  name           String
  /// Lifecycle (DB CHECK): draft | active | paused | archived
  status         String       @default("draft")
  /// Eligible ICP tiers — empty array = any.
  targetIcpTiers String[]     @default([])
  /// Eligible lifecycle stages — empty array = any.
  targetStages   String[]     @default([])
  /// Journey definition JSON (graph; slice-2 editor).
  definition     Json         @default("{\"stages\":[]}")
  /// goalKind allow-list (DB CHECK):
  /// pipeline_creation | meeting_booked | trial_started | custom
  goalKind       String       @default("pipeline_creation")
  activatedAt    DateTime?
  archivedAt     DateTime?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrollments AbmJourneyEnrollment[]

  @@unique([organizationId, journeyNumber], map: "abm_journeys_org_number_uniq")
  @@index([organizationId, status], map: "abm_journeys_org_status_idx")
  @@map("abm_journeys")
}

model AbmJourneyEnrollment {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journeyId          String
  journey            AbmJourney       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  marketingAccountId String
  marketingAccount   MarketingAccount @relation(fields: [marketingAccountId], references: [id], onDelete: Cascade)
  /// Lifecycle (DB CHECK):
  /// enrolled | in_progress | goal_met | exited | failed
  status             String           @default("enrolled")
  currentStageIndex  Int              @default(0)
  /// Append-only log of stages traversed (slice-2 worker writes).
  stageHistory       Json             @default("[]")
  enrolledAt         DateTime         @default(now())
  lastAdvancedAt     DateTime?
  goalMetAt          DateTime?
  exitedAt           DateTime?
  exitReason         String?
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([journeyId, marketingAccountId], map: "abm_journey_enrollments_journey_account_uniq")
  @@index([marketingAccountId], map: "abm_journey_enrollments_account_idx")
  @@index([organizationId, status], map: "abm_journey_enrollments_org_status_idx")
  @@map("abm_journey_enrollments")
}

model AccountScoreSnapshot {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketingAccountId String
  marketingAccount   MarketingAccount @relation(fields: [marketingAccountId], references: [id], onDelete: Cascade)
  snapshotAt         DateTime
  engagementScore    Int
  /// grade allow-list mirrors marketing_accounts.grade
  grade              String
  /// icpTier allow-list mirrors marketing_accounts.icpTier
  icpTier            String
  /// lifecycleStage allow-list mirrors marketing_accounts.lifecycleStage
  lifecycleStage     String
  /// Signal-count breakdown JSON (e.g. {"page_view_high_intent": 12, ...}).
  signalCounts       Json             @default("{}")
  rationale          String?
  createdAt          DateTime         @default(now())

  @@index([marketingAccountId, snapshotAt], map: "account_score_snapshots_account_time_idx")
  @@index([organizationId, snapshotAt], map: "account_score_snapshots_org_time_idx")
  @@index([organizationId, grade], map: "account_score_snapshots_org_grade_idx")
  @@map("account_score_snapshots")
}

// --- Task 4: VoIP Integration ---

model CallLog {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  callSid         String? // Legacy/provider call id. Tenant/provider uniqueness is enforced by migration on providerCallId.
  channelConfigId String?
  direction       String // "outbound" | "inbound"
  fromNumber      String
  toNumber        String
  /// Canonical E.164 identity of the external party being called/calling.
  /// Outbound writers derive it from toNumber; inbound writers use fromNumber.
  /// Ambiguous national numbers remain null rather than guessing a country.
  targetPhoneE164 String?
  status          String              @default("initiated") // initiated, ringing, in-progress, completed, busy, no-answer, failed
  duration        Int? // seconds
  recordingUrl    String?
  transcription   String?             @db.Text
  /**
   * A7 Conversation Intelligence — structured analysis of the transcript:
   * sentiment, topics, competitor mentions, action items, coaching hints.
   * Shape governed by `ConversationInsight` in `src/lib/conversation-intel/types.ts`.
   */
  insights        Json?
  /**
   * When was the transcript last analysed — null if never.
   */
  insightsAt      DateTime?
  contactId       String?
  contact         Contact?            @relation(fields: [contactId], references: [id])
  conversationId  String?
  conversation    SocialConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  leadId          String? // set by writers when the call is tied to a lead (Slice 3 lead timeline)
  companyId       String?
  dealId          String?
  ticketId        String?
  ticket          Ticket?             @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  userId          String? // Agent who made/received the call
  // Copied from Lead.browserCallClaimToken for browser-originated lead calls.
  // It makes release a compare-and-set, even after a lease has expired.
  leadCallClaimToken  String?
  claimedByUserId String?
  claimedAt       DateTime?
  /// Incarnation and renewable lease for a browser answering an inbound call.
  /// The random token is signed into the relay ticket and used as a CAS guard;
  /// claimedAt alone cannot distinguish a same-user re-claim safely.
  browserAnswerClaimToken     String?
  browserAnswerClaimExpiresAt DateTime?
  queueId         String?
  activityId      String? // Linked Activity record
  provider        String              @default("twilio")
  providerCallId  String?
  callMode        String              @default("human") // human | ai
  wasAnswered     Boolean             @default(false)
  providerOutcome String? // connected | no_answer | busy | failed | cancelled
  // Technical PBX/provider finality and evidence, not the business outcome.
  // customer_spoke | no_customer_speech | no_answer | busy | failed |
  // cancelled | blocked, plus provider_* / operator_* internal fence states.
  conversationOutcome String?
  // Media-level evidence about HOW the call ended, reported by the PBX. Only
  // the PBX can observe these; whether the agent had actually finished the
  // conversation is a separate, semantic question answered from the transcript.
  // True when the agent still had audio in flight as the line dropped, i.e. the
  // customer hung up mid-sentence rather than at a natural end.
  agentMidUtterance Boolean?
  // Provider sessions rebuilt mid-call. Above zero means the caller lived
  // through at least one gap, whatever the transcript looks like.
  recoveryAttempts Int?
  // Raw dial evidence behind a non-connected providerOutcome, as the PBX saw
  // it: the Asterisk DIALSTATUS token and the Q.850 clearing cause (digits,
  // kept verbatim as text). providerOutcome stays the 5-value authority;
  // these exist so an operator can diagnose WHY a dial failed from the call
  // card instead of capturing trunk traffic.
  providerDialStatus  String?
  providerHangupCause String?
  /// The broken call this one was placed to continue. Unique on purpose: a
  /// broken call earns exactly one retry, and the database is what enforces
  /// it. A duplicated webhook, a retried handler or a crash mid-write must not
  /// be able to dial the same customer twice, and application-level guards do
  /// not survive concurrency.
  continuesCallId String?             @unique
  continues       CallLog?            @relation("CallContinuation", fields: [continuesCallId], references: [id], onDelete: SetNull)
  continuedBy     CallLog?            @relation("CallContinuation")
  /// When the PBX first collected this callback's continuation context. Serving
  /// is allowed to repeat for a short grace period afterwards so a retried
  /// request does not leave the agent starting the conversation from scratch,
  /// and is refused after it so a leaked runtime token cannot mine transcripts.
  continuationServedAt DateTime?
  consentAudit    Json?
  idempotencyKey  String?
  voiceCallSession VoiceCallSession?
  callEvents      CallEvent[]
  notes           String?             @db.Text
  disposition     String? // canonical per-call business result; values live in src/lib/calls/disposition.ts
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime            @default(now())

  @@index([organizationId, contactId])
  @@index([organizationId, conversationId])
  @@index([organizationId, channelConfigId])
  @@index([organizationId, provider, status])
  @@index([organizationId, provider, providerCallId])
  @@index([organizationId, targetPhoneE164], map: "call_logs_org_target_phone_e164_idx")
  @@index([organizationId, claimedByUserId])
  @@index([organizationId, leadId])
  @@index([organizationId, ticketId])
  @@index([organizationId, status])
  @@index([organizationId, callSid])
  @@unique([organizationId, idempotencyKey], map: "call_logs_org_idempotency_key")
  @@index([callSid])
  @@map("call_logs")
}

/// Phase 1 manual AI calling state. `activeLeadKey` and `activePhoneKey` stay
/// populated while the provider call may exist and become null only on a
/// proven terminal result. Their unique keys fence racing tabs and duplicate
/// lead records that point at the same phone.
model VoiceCallSession {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeOrganizationKey String?
  leadId              String
  requestedByUserId   String
  assignedToSnapshot  String?
  idempotencyKey      String
  activeLeadKey       String?
  activePhoneKey      String?
  targetPhoneE164     String
  channelConfigId     String
  provider            String        @default("asterisk")
  providerCallId      String
  callLogId           String?       @unique
  callLog             CallLog?      @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  queueItem           VoiceCallQueueItem?
  status              String        @default("prepared") // includes dispatch_uncertain; never auto-redial
  outcome             String?
  blockReason         String?
  policySnapshot      Json          @default("{}")
  leaseUntil          DateTime?
  startedAt           DateTime?
  answeredAt          DateTime?
  endedAt             DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([organizationId, idempotencyKey], map: "voice_call_sessions_org_idempotency_key")
  @@unique([organizationId, activeLeadKey], map: "voice_call_sessions_org_active_lead_key")
  @@unique([organizationId, activePhoneKey], map: "voice_call_sessions_org_active_phone_key")
  @@unique([organizationId, activeOrganizationKey], map: "voice_call_sessions_org_active_organization_key")
  @@unique([organizationId, provider, providerCallId], map: "voice_call_sessions_org_provider_call_key")
  @@index([organizationId, requestedByUserId, createdAt], map: "voice_call_sessions_org_user_created_idx")
  @@index([organizationId, leadId, createdAt], map: "voice_call_sessions_org_lead_created_idx")
  @@index([organizationId, status, leaseUntil], map: "voice_call_sessions_org_status_lease_idx")
  @@map("voice_call_sessions")
}

/// An immutable, explicitly selected batch of leads for one seller. Creating a
/// queue never dispatches a call: a separate start transition is required and
/// remains fail-closed until the dedicated automation flag is enabled.
model VoiceCallQueue {
  id                    String               @id @default(cuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUserId           String
  createdByUserId       String
  idempotencyKey        String
  selectionHash         String
  source                String               @default("selected")
  name                  String?
  status                String               @default("prepared")
  totalItems            Int
  consentAudit          Json                 @default("{}")
  activeOrganizationKey String?
  activeOwnerKey        String?
  startedAt             DateTime?
  pausedAt              DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  items                 VoiceCallQueueItem[]

  @@unique([organizationId, idempotencyKey], map: "voice_call_queues_org_idempotency_key")
  @@unique([organizationId, activeOrganizationKey], map: "voice_call_queues_org_active_org_key")
  @@unique([organizationId, activeOwnerKey], map: "voice_call_queues_org_active_owner_key")
  @@index([organizationId, ownerUserId, createdAt], map: "voice_call_queues_org_owner_created_idx")
  @@index([organizationId, status, updatedAt], map: "voice_call_queues_org_status_updated_idx")
  @@map("voice_call_queues")
}

/// One ordered lead snapshot inside a VoiceCallQueue. Nullable active keys are
/// populated only while the item owns the dispatch lane. PostgreSQL uniqueness
/// therefore provides the hard one-active-call-per-organisation and per-owner
/// fences while allowing any number of inactive rows.
model VoiceCallQueueItem {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueId               String
  queue                 VoiceCallQueue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  ownerUserId           String
  leadId                String
  assignedToSnapshot    String
  position              Int
  idempotencyKey        String
  status                String            @default("pending")
  outcome               String?
  blockReason           String?
  eligibilitySnapshot   Json              @default("{}")
  queuedLeadKey         String?
  queuedPhoneKey        String?
  activeOrganizationKey String?
  activeOwnerKey        String?
  leaseToken            String?
  leaseUntil            DateTime?
  voiceCallSessionId    String?           @unique
  voiceCallSession      VoiceCallSession? @relation(fields: [voiceCallSessionId], references: [id], onDelete: SetNull)
  availableAt           DateTime?
  claimedAt             DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([queueId, position], map: "voice_call_queue_items_queue_position_key")
  @@unique([organizationId, idempotencyKey], map: "voice_call_queue_items_org_idempotency_key")
  @@unique([organizationId, queuedLeadKey], map: "voice_call_queue_items_org_queued_lead_key")
  @@unique([organizationId, queuedPhoneKey], map: "voice_call_queue_items_org_queued_phone_key")
  @@unique([organizationId, activeOrganizationKey], map: "voice_call_queue_items_org_active_org_key")
  @@unique([organizationId, activeOwnerKey], map: "voice_call_queue_items_org_active_owner_key")
  @@index([organizationId, queueId, status, position], map: "voice_call_queue_items_org_queue_status_position_idx")
  @@index([organizationId, ownerUserId, status, updatedAt], map: "voice_call_queue_items_org_owner_status_idx")
  @@index([organizationId, voiceCallSessionId], map: "voice_call_queue_items_org_session_idx")
  @@map("voice_call_queue_items")
}

/// Durable phone-level permission. Missing/unknown consent is not promoted to
/// durable consent by a manual call; the per-call attestation stays on CallLog.
model VoiceConsent {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneE164        String
  scope            String        @default("sales") // sales | marketing | support | all
  status           String        @default("unknown") // allowed | blocked | unknown | expired
  source           String?
  reason           String?
  confirmedAt      DateTime?
  confirmedBy      String?
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([organizationId, phoneE164, scope], map: "voice_consents_org_phone_scope_key")
  @@index([organizationId, status, expiresAt], map: "voice_consents_org_status_expiry_idx")
  @@map("voice_consents")
}

/// Hard do-not-call ledger. It wins over stored consent and seller attestation.
model VoiceSuppression {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneE164        String
  scope            String        @default("all") // sales | marketing | support | all
  reason           String
  source           String?
  isActive         Boolean       @default(true)
  expiresAt        DateTime?
  createdBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([organizationId, phoneE164, scope], map: "voice_suppressions_org_phone_scope_key")
  @@index([organizationId, isActive, expiresAt], map: "voice_suppressions_org_active_expiry_idx")
  @@map("voice_suppressions")
}

model CallEvent {
  id             String   @id @default(cuid())
  organizationId String
  callLogId      String?
  provider       String
  providerCallId String
  eventType      String
  eventHash      String
  payload        Json     @default("{}")
  receivedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  callLog      CallLog?     @relation(fields: [callLogId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider, providerCallId, eventHash])
  @@index([organizationId, provider, providerCallId])
  @@index([organizationId, callLogId])
  @@index([organizationId, eventType])
  @@map("call_events")
}

model WhatsAppCallPermission {
  id                 String    @id @default(cuid())
  organizationId     String
  channelConfigId    String
  contactId          String?
  conversationId     String?
  recipientKey       String
  userWaId           String?
  recipient          String?
  status             String    @default("unknown") // unknown | no_permission | pending | temporary | permanent | rejected | expired
  canRequest         Boolean   @default(false)
  canStartCall       Boolean   @default(false)
  requestMessageId   String?
  contextId          String?
  responseSource     String?
  isPermanent        Boolean   @default(false)
  requestedByUserId  String?
  requestedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  expiresAt          DateTime?
  lastCheckedAt      DateTime?
  lastProviderStatus String?
  lastError          String?   @db.Text
  actions            Json      @default("[]")
  providerPayload    Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([organizationId, channelConfigId, recipientKey])
  @@index([organizationId, conversationId])
  @@index([organizationId, contactId])
  @@index([organizationId, channelConfigId, status])
  @@index([organizationId, userWaId])
  @@map("whatsapp_call_permissions")
}

/// SMS OTP codes — used for login 2FA, phone verification, sensitive action confirmation.
/// Codes are stored hashed (bcrypt). Each code is single-use and time-limited.
model OtpCode {
  id             String    @id @default(cuid())
  organizationId String? // nullable for public/pre-auth flows (e.g. phone verification during signup)
  userId         String? // nullable — bound to a specific user after login for 2FA/sensitive_action
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String // E.164 format recommended
  codeHash       String // bcrypt hash of the numeric code
  purpose        String // "login" | "2fa" | "verification" | "sensitive_action"
  attempts       Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([phone, purpose])
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

/// Deferred workflow actions — enqueued when an action has delayMinutes > 0.
/// A cron ticks every minute, finds rows where scheduledAt <= now and
/// executedAt is null, and runs them via the same executeAction() path.
///
/// Used primarily by the missed-call → SMS template (TT §9 requires a
/// 2-minute delay so the operator has a chance to call back first).
model ScheduledAction {
  id             String    @id @default(cuid())
  organizationId String
  ruleId         String // workflow rule that scheduled this
  entityType     String // "deal" | "lead" | "ticket" | "call" | ...
  entityId       String // stable id of the trigger entity
  entitySnapshot Json // snapshot of the entity at trigger time (for template substitution)
  actionType     String // "send_sms" | "send_email" | ...
  actionConfig   Json
  scheduledAt    DateTime
  executedAt     DateTime?
  error          String?   @db.Text
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([executedAt, scheduledAt])
  @@index([organizationId, ruleId])
  @@map("scheduled_actions")
}

/// Tracks which workflow templates have been applied to which org.
/// Enables duplicate prevention and usage analytics for the templates gallery.
model AppliedTemplate {
  id             String   @id @default(cuid())
  organizationId String
  templateId     String // slug from WORKFLOW_TEMPLATES (e.g. "welcome-new-lead")
  ruleId         String // the WorkflowRule that was created
  appliedBy      String? // userId who clicked "Use template"
  appliedAt      DateTime @default(now())

  @@index([organizationId, templateId])
  @@map("applied_templates")
}

// --- Task 5: Custom Report Builder ---

model SavedReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  entityType     String // "deals", "contacts", "companies", "leads", "tickets", "tasks", "activities"
  columns        Json // [{ field: "name", label: "Name" }, { field: "value", aggregate: "sum" }]
  filters        Json         @default("[]") // [{ field: "status", op: "eq", value: "won" }]
  groupBy        String?
  sortBy         String?
  sortOrder      String       @default("desc")
  chartType      String?      @default("table") // "table", "bar", "line", "pie", "area", "funnel"
  chartConfig    Json?
  isShared       Boolean      @default(false)
  createdBy      String
  scheduleFreq   String? // "daily", "weekly", "monthly", null = no schedule
  scheduleEmails String[]     @default([])
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("saved_reports")
}

// --- Task 6: Landing Page Builder ---

model LandingPage {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  description      String?
  gjsData          Json? // GrapesJS project data
  htmlContent      String?      @db.Text
  cssContent       String?      @db.Text
  formConfig       Json? // { fields: [...], successMessage, redirectUrl }
  status           String       @default("draft") // "draft" | "published" | "archived"
  publishedAt      DateTime?
  totalViews       Int          @default(0)
  totalSubmissions Int          @default(0)
  metaTitle        String?
  metaDescription  String?
  ogImage          String?
  createdBy        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  pageViews       PageView[]
  formSubmissions FormSubmission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("landing_pages")
}

model PageView {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  visitorIp     String?
  userAgent     String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  createdAt     DateTime    @default(now())

  @@index([landingPageId, createdAt])
  @@map("page_views")
}

model FormSubmission {
  id             String       @id @default(cuid())
  organizationId String
  landingPageId  String?
  landingPage    LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  // P8 No-Code Form Builder — optional pointer to a standalone Form
  // (LandingPage and FormDefinition are mutually exclusive at the
  // submission layer: either the submission came from a landing-page
  // embed (landingPageId set) or from a standalone form
  // (formDefinitionId set), never both. Route validation enforces.)
  formDefinitionId String?
  formDefinition   FormDefinition? @relation(fields: [formDefinitionId], references: [id], onDelete: SetNull)

  formData  Json
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  source    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([organizationId, landingPageId])
  @@index([organizationId, formDefinitionId])
  @@map("form_submissions")
}

model CustomDomain {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain         String       @unique
  status         String       @default("pending") // pending | dns_verified | ssl_active | error
  dnsVerifiedAt  DateTime?
  sslIssuedAt    DateTime?
  lastCheckedAt  DateTime?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([domain])
  @@map("custom_domains")
}

// ═══════════════════════════════════════════════════
// WEB CHAT WIDGET (§4) — embeddable live chat for tenant websites
// ═══════════════════════════════════════════════════

model WebChatWidget {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled          Boolean      @default(true)
  publicKey        String       @unique // short key used in embed snippet
  title            String       @default("Support")
  greeting         String       @default("Hi! How can we help?")
  primaryColor     String       @default("#0176D3")
  position         String       @default("bottom-right") // bottom-right | bottom-left
  showLauncher     Boolean      @default(true)
  aiEnabled        Boolean      @default(true) // use Da Vinci auto-reply
  // A2 (Creatio 10X roadmap) — web-chat AI reply policy, mirrors ChannelConfig.settings
  // draftMode/aiThreshold: draft mode parks every AI reply for operator review; the
  // threshold auto-sends only replies whose A1 judge total clears it (null = send all).
  aiDraftMode      Boolean      @default(false)
  aiThreshold      Float?
  // A3 — audience rollout: share of web-chat sessions the AI answers (0..100); NULL = everyone.
  aiRolloutPercent Int?
  escalateToTicket Boolean      @default(true) // create Ticket on escalation
  allowedOrigins   String[]     @default([]) // CORS whitelist, empty = any
  workingHours     Json? // { mon: ["09:00","18:00"], ... }
  offlineMessage   String?
  preChatForm      Json? // { name|email|phone: { enabled, required } }; NULL = legacy (all optional)
  // Whelp-style widget options: { onboardingEnabled, historyEnabled, customQuestions: string[] }.
  // NULL = all defaults (onboarding + history on, no extra questions). Field list stays in preChatForm.
  uiOptions        Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([publicKey])
  @@map("web_chat_widgets")
}

model WebChatSession {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitorName        String?
  visitorEmail       String?
  visitorPhone       String?
  contactId          String? // linked CRM contact (matched by email)
  pageUrl            String?
  userAgent          String?
  ipAddress          String?
  status             String       @default("open") // open | closed | escalated
  ticketId           String? // set on escalation
  assignedUserId     String?
  aiPaused           Boolean      @default(false)
  closedAt           DateTime? // stamped when the operator closes the session
  closeOutcome       String? // won | lost | none — operator disposition at close (analytics)
  closeOutcomeReason String? // optional internal note about the outcome (NOT the farewell)
  lastMessageAt      DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  messages WebChatMessage[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, closeOutcome])
  @@map("web_chat_sessions")
}

model WebChatMessage {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String
  session        WebChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromRole       String // visitor | bot | agent
  authorUserId   String?
  text           String
  attachmentUrl  String?
  attachmentName String?
  attachmentType String? // MIME type
  attachmentSize Int? // bytes
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([sessionId, createdAt])
  @@index([organizationId])
  @@map("web_chat_messages")
}

// ═══════════════════════════════════════════════════
// C1 (Creatio 10X roadmap) — ANONYMOUS WEB TRACKING
// Visitor behaviour on the tenant's own site: first-party visitorId cookie,
// batched pageviews/events via /api/v1/public/web-tracking. C2 stitches
// visitorId → contact on form submit / tracked email click and backfills.
// ═══════════════════════════════════════════════════

model WebTrackingConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(false)
  publicKey      String       @unique // short key baked into the snippet
  allowedOrigins String[]     @default([]) // origin whitelist, empty = any (same semantics as WebChatWidget)
  retentionDays  Int          @default(180) // TTL for raw WebAction rows (cron cleanup)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([publicKey])
  @@map("web_tracking_configs")
}

model WebSession {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitorId      String // anonymous first-party cookie id (_ldv)
  contactId      String? // set by C2 identity stitching, null while anonymous
  startedAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now()) // bumped per batch; 30-min inactivity closes the session
  pageViews      Int          @default(0)
  entryUrl       String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  userAgent      String?

  actions WebAction[]

  @@index([organizationId, visitorId, lastSeenAt])
  @@index([organizationId, contactId])
  @@index([organizationId, lastSeenAt])
  @@map("web_sessions")
}

model WebAction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String
  session        WebSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  visitorId      String // denormalised for C2 backfill scans without a session join
  type           String       @default("pageview") // pageview | event
  name           String? // custom event name (type=event)
  url            String?
  referrer       String?
  metadata       Json? // custom event props (bounded by the ingest route)
  createdAt      DateTime     @default(now())

  @@index([organizationId, visitorId, createdAt])
  @@index([sessionId])
  @@index([organizationId, createdAt]) // retention cleanup scan
  @@map("web_actions")
}

// ═══════════════════════════════════════════════════
// SOCIAL MEDIA MONITORING (§5)
// ═══════════════════════════════════════════════════

model SocialAccount {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform                 String // twitter | instagram | facebook | telegram | vkontakte | youtube | tiktok
  handle                   String // @brand or page name being monitored
  displayName              String?
  accessToken              String? // encrypted OAuth token when connected; null = keyword-only monitoring
  tokenExpiresAt           DateTime?
  isActive                 Boolean      @default(true)
  outboundLiveEnabled      Boolean      @default(false)
  outboundEmergencyStopped Boolean      @default(true)
  outboundCapability       String? // DIRECT | PROVIDER | null
  outboundVerifiedAt       DateTime?
  keywords                 String[]     @default([]) // additional keywords to track alongside handle
  lastPolledAt             DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  mentions             SocialMention[]
  replyChannelSettings SocialReplyChannelSetting[]
  sourceRoutePlans     SourceRoutePlan[]
  connectionCursors    SocialConnectionCursor[]
  replyIdentities      SocialReplyIdentity[]
  outboundReplies      OutboundSocialReply[]

  @@unique([organizationId, id], map: "social_accounts_org_id_key")
  @@unique([organizationId, platform, handle])
  @@index([organizationId, platform])
  @@map("social_accounts")
}

model SocialMention {
  id                       String          @id @default(cuid())
  organizationId           String
  organization             Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId                String?
  account                  SocialAccount?  @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: NoAction)
  clusterId                String?
  cluster                  MentionCluster? @relation(fields: [organizationId, clusterId], references: [organizationId, id], onDelete: NoAction)
  platform                 String
  externalId               String // unique per platform (post/comment id)
  sourceType               String          @default("unknown") // comment | dm | mention | post | manual | unknown
  contentKind              String          @default("MENTION") // POST | MENTION | COMMENT | REPLY | REVIEW | DM | UNKNOWN
  postExternalId           String?
  parentExternalId         String?
  threadExternalId         String?
  replyToExternalId        String?
  depth                    Int             @default(0)
  canonicalUrl             String?
  parentPostUrl            String?
  contentVersion           Int             @default(1)
  editedAt                 DateTime?
  deletedAtSource          DateTime?
  acquisitionMode          String?
  policySnapshot           Json            @default("{}")
  retentionClass           String          @default("OPERATIONAL_180D")
  purgeAt                  DateTime?
  purgedAt                 DateTime?
  sourceProvider           String          @default("manual") // native | chatwoot | manual | webhook | poller
  sourceMetadata           Json            @default("{}")
  authorName               String?
  authorHandle             String?
  authorAvatar             String?
  text                     String
  url                      String?
  sentiment                String? // positive | neutral | negative
  matchedTerm              String?
  reach                    Int             @default(0)
  engagement               Int             @default(0)
  status                   String          @default("new") // new | reviewed | replied | ignored | converted_to_ticket | converted_to_lead | converted_to_task
  ticketId                 String?
  leadId                   String?
  taskId                   String?
  whatsappGroupStatus      String          @default("not_required") // not_required | dry_run_sent | failed
  whatsappGroupDestination Json            @default("{}")
  whatsappGroupLastError   String?
  whatsappGroupDeliveredAt DateTime?
  handledBy                String? // userId
  handledAt                DateTime?
  publishedAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  aiDrafts                  SocialMentionAiDraft[]
  versions                  SocialMentionVersion[]
  evidences                 MentionEvidence[]
  primaryForMentionClusters MentionCluster[]            @relation("MentionClusterPrimary")
  legalCases                SocialLegalCase[]
  ingestEnvelopes           IngestEnvelope[]
  subjectMatches            SocialMentionSubjectMatch[]
  mediaObservations         MediaObservation[]
  legalCandidates           SocialLegalCandidate[]
  manualEngagementTasks     ManualEngagementTask[]
  outboundReplies           OutboundSocialReply[]
  relevanceFeedback         SocialRelevanceFeedback[]
  metricSnapshots           SocialMetricSnapshot[]

  @@unique([organizationId, id], map: "social_mentions_org_id_key")
  @@unique([organizationId, platform, externalId])
  @@index([organizationId, status])
  @@index([organizationId, platform, publishedAt])
  @@index([organizationId, sentiment])
  @@index([organizationId, platform, sourceType])
  @@index([organizationId, whatsappGroupStatus])
  @@index([organizationId, clusterId])
  @@index([organizationId, platform, postExternalId], map: "social_mentions_org_platform_post_external_idx")
  @@index([organizationId, platform, canonicalUrl], map: "social_mentions_org_platform_canonical_url_idx")
  @@index([organizationId, platform, threadExternalId, publishedAt], map: "social_mentions_org_platform_thread_published_idx")
  @@index([organizationId, purgeAt, purgedAt], map: "social_mentions_org_purge_idx")
  @@map("social_mentions")
}

model SocialMentionVersion {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentionId      String
  mention        SocialMention @relation(fields: [organizationId, mentionId], references: [organizationId, id], onDelete: Cascade)
  version        Int
  text           String
  sourceMetadata Json          @default("{}")
  publishedAt    DateTime?
  editedAt       DateTime?
  capturedAt     DateTime      @default(now())

  @@unique([organizationId, mentionId, version], map: "social_mention_versions_org_mention_version_key")
  @@index([organizationId, mentionId, capturedAt], map: "social_mention_versions_org_mention_captured_idx")
  @@map("social_mention_versions")
}

model SocialMentionAiDraft {
  id                    String             @id @default(cuid())
  organizationId        String
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentionId             String
  mention               SocialMention      @relation(fields: [organizationId, mentionId], references: [organizationId, id], onDelete: Cascade)
  subjectId             String?
  subject               MonitoringSubject? @relation(fields: [organizationId, subjectId], references: [organizationId, id], onDelete: NoAction)
  agentConfigId         String?
  mentionContentVersion Int                @default(1)
  engagementMode        String             @default("MANUAL_REVIEW") // OWNED_DIRECT | PROVIDER_REPLY | MANUAL_EXTERNAL | MANUAL_REVIEW | NO_REPLY
  routingRecommendation String?
  replyOptions          Json               @default("[]")
  agentSnapshot         Json               @default("{}")
  modelSnapshot         Json               @default("{}")
  promptSnapshot        Json               @default("{}")
  knowledgeSnapshot     Json               @default("{}")
  policySnapshot        Json               @default("{}")
  status                String             @default("needs_approval") // needs_approval | approved | rejected | sent | blocked | failed
  sentiment             String?
  language              String             @default("az")
  tone                  String             @default("official")
  replyText             String?
  reasoning             String?
  regenerateReason      String?
  sourceDraftId         String?
  forbiddenReason       String?
  approvedBy            String?
  approvedAt            DateTime?
  sentAt                DateTime?
  sendMode              String             @default("dry_run")
  sendResult            Json               @default("{}")
  reviewReason          String?
  failureReason         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  manualEngagementTasks ManualEngagementTask[]
  outboundReplies       OutboundSocialReply[]

  @@unique([organizationId, id], map: "social_mention_ai_drafts_org_id_key")
  @@index([organizationId, mentionId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, subjectId, createdAt], map: "social_mention_ai_drafts_org_subject_created_idx")
  @@map("social_mention_ai_drafts")
}

model SocialReplyChannelSetting {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform        String // instagram | facebook | twitter | tiktok | youtube | vkontakte
  senderAccountId String?
  senderAccount   SocialAccount? @relation(fields: [organizationId, senderAccountId], references: [organizationId, id], onDelete: NoAction)
  sendMode        String         @default("approval") // approval | auto | dry_run
  liveEnabled     Boolean        @default(false)
  updatedBy       String? // userId who last changed the setting
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([organizationId, platform])
  @@index([senderAccountId])
  @@map("social_reply_channel_settings")
}

model SocialOutboundPolicy {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  liveEnabled             Boolean      @default(false)
  emergencyStopped        Boolean      @default(true)
  allowedPlatforms        String[]     @default([])
  maxPerHour              Int          @default(10)
  quietHoursStart         Int?
  quietHoursEnd           Int?
  timeZone                String       @default("UTC")
  requireSeparateApprover Boolean      @default(true)
  policyVersion           Int          @default(1)
  releaseReviewedAt       DateTime?
  releaseReviewedBy       String?
  updatedBy               String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@map("social_outbound_policies")
}

model OutboundSocialReply {
  id                    String                       @id @default(cuid())
  organizationId        String
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentionId             String
  mention               SocialMention                @relation(fields: [organizationId, mentionId], references: [organizationId, id], onDelete: Cascade)
  draftId               String?
  draft                 SocialMentionAiDraft?        @relation(fields: [organizationId, draftId], references: [organizationId, id], onDelete: NoAction)
  subjectId             String
  subject               MonitoringSubject            @relation(fields: [organizationId, subjectId], references: [organizationId, id], onDelete: NoAction)
  replyIdentityId       String
  replyIdentity         SocialReplyIdentity          @relation(fields: [organizationId, replyIdentityId], references: [organizationId, id], onDelete: NoAction)
  senderAccountId       String
  senderAccount         SocialAccount                @relation(fields: [organizationId, senderAccountId], references: [organizationId, id], onDelete: NoAction)
  platform              String
  adapterType           String // DIRECT | PROVIDER
  targetExternalId      String
  targetContentVersion  Int
  replyText             String
  replyTextSha256       String
  idempotencyKey        String
  state                 String                       @default("PENDING") // PENDING | APPROVED | QUEUED | SENDING | SENT | FAILED | CANCELED | RECONCILIATION_REQUIRED
  requestedBy           String
  approvedBy            String?
  approvedAt            DateTime?
  approvalSnapshot      Json                         @default("{}")
  currentPolicySnapshot Json                         @default("{}")
  attemptCount          Int                          @default(0)
  maxAttempts           Int                          @default(3)
  nextAttemptAt         DateTime?
  leaseToken            String?
  leaseExpiresAt        DateTime?
  providerRequestId     String?
  externalReplyId       String?
  lastError             String?
  unknownOutcomeAt      DateTime?
  sentAt                DateTime?
  canceledAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  approval              OutboundSocialReplyApproval?
  events                OutboundSocialReplyEvent[]

  @@unique([organizationId, id], map: "outbound_social_replies_org_id_key")
  @@unique([organizationId, idempotencyKey], map: "outbound_social_replies_org_idempotency_key")
  @@index([state, nextAttemptAt, leaseExpiresAt], map: "outbound_social_replies_queue_idx")
  @@index([organizationId, platform, createdAt], map: "outbound_social_replies_org_platform_created_idx")
  @@index([organizationId, mentionId, createdAt], map: "outbound_social_replies_org_mention_created_idx")
  @@map("outbound_social_replies")
}

model OutboundSocialReplyApproval {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outboundReplyId String
  outboundReply   OutboundSocialReply @relation(fields: [organizationId, outboundReplyId], references: [organizationId, id], onDelete: Cascade)
