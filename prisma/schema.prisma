model MonitoringSubject {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                String // COMPANY | PERSON | BRAND | PRODUCT | ORGANIZATION | TOPIC | EVENT
  name                String
  description         String?
  status              String       @default("active") // active | paused | archived | deleted
  languages           String[]     @default([])
  geographies         String[]     @default([])
  requiredContext     String[]     @default([])
  exclusions          String[]     @default([])
  sensitiveCategories String[]     @default([])
  assignedAgentId     String?
  replyPolicy         Json         @default("{}")
  legalPolicy         Json         @default("{}")
  legacyScenarioId    String?
  aliasesVersion      Int          @default(1)
  createdBy           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  aliases                 MonitoringSubjectAlias[]
  outgoingRelations       MonitoringSubjectRelation[] @relation("MonitoringSubjectFrom")
  // Клиент CRM, которому принадлежит объект мониторинга. Жёсткое удаление
  // компании (DELETE /api/v1/companies/[id] делает deleteMany) обязано лишь
  // развязать связь: архив упоминаний переживает уход клиента из CRM.
  companyId               String?
  company                 Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  incomingRelations       MonitoringSubjectRelation[] @relation("MonitoringSubjectTo")
  sources                 MonitoringSubjectSource[]
  replyIdentities         SocialReplyIdentity[]
  mentionMatches          SocialMentionSubjectMatch[]
  visualReferences        VisualReference[]
  discoveryLeads          DiscoveryLead[]
  mediaObservations       MediaObservation[]
  mediaSignals            MediaSignal[]
  aiDrafts                SocialMentionAiDraft[]
  legalCandidates         SocialLegalCandidate[]
  legalCases              SocialLegalCase[]
  manualEngagementTasks   ManualEngagementTask[]
  outboundReplies         OutboundSocialReply[]
  relevanceFeedback       SocialRelevanceFeedback[]
  discoveryAutoReviewRuns DiscoveryAutoReviewRun[]

  @@unique([organizationId, id], map: "monitoring_subjects_org_id_key")
  @@unique([organizationId, legacyScenarioId], map: "monitoring_subjects_org_legacy_scenario_key")
  // Одна компания CRM может вести несколько объектов мониторинга (бренды,
  // персоны, продукты), поэтому связь НЕ уникальна.
  @@index([organizationId, companyId], map: "monitoring_subjects_org_company_idx")
  @@index([organizationId, status, type], map: "monitoring_subjects_org_status_type_idx")
  @@index([organizationId, name], map: "monitoring_subjects_org_name_idx")
  @@map("monitoring_subjects")
}

