  @@unique([organizationId, id], map: "outbound_social_reply_events_org_id_key")
  @@index([organizationId, outboundReplyId, createdAt], map: "outbound_social_reply_events_org_reply_created_idx")
  @@map("outbound_social_reply_events")
}

