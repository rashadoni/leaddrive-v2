  @@unique([organizationId, aggregateType, aggregateId], map: "event_aggregate_heads_stream_key")
  @@index([organizationId, updatedAt], map: "event_aggregate_heads_org_updated_idx")
  @@map("event_aggregate_heads")
}

model DomainEvent {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  aggregateType    String
  aggregateId      String
  aggregateVersion BigInt
  eventType        String
  eventVersion     Int          @default(1)
  source           String
  dataSchema       String
  classification   String
  subjectRef       String?
  correlationId    String
  causationId      String?
  traceparent      String?
  commandId        String?
