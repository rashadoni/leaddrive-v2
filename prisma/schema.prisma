  @@index([citizenId], map: "public_sector_grants_citizen_idx")
  @@index([organizationId, status], map: "public_sector_grants_org_status_idx")
  @@index([organizationId, programSlug], map: "public_sector_grants_org_program_idx")
  @@index([assignedOfficialId], map: "public_sector_grants_assigned_idx")
  @@index([caseId], map: "public_sector_grants_case_idx")
  @@map("public_sector_grants")
