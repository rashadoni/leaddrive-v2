// Durable, retryable tenant bootstrap. The organization is created first, then
// every additive initializer records its own status here. Re-running a failed
// step is safe because all resource writers use tenant-scoped upserts.
model TenantProvisioningRun {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        Int                      @default(2)
  idempotencyKey String
  status         String                   @default("pending") // pending | running | completed | partial | failed
  input          Json                     @default("{}")
  summary        Json                     @default("{}")
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  leaseToken     String?
  leaseUntil     DateTime?
  createdBy      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  steps          TenantProvisioningStep[]

  @@unique([organizationId, id], map: "tenant_provisioning_runs_org_id_key")
  @@unique([organizationId, idempotencyKey], map: "tenant_provisioning_runs_org_idempotency_key")
  @@index([organizationId, status, createdAt], map: "tenant_provisioning_runs_org_status_idx")
  @@index([leaseUntil], map: "tenant_provisioning_runs_lease_until_idx")
  @@map("tenant_provisioning_runs")
}

model TenantProvisioningStep {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          String
  run            TenantProvisioningRun @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Cascade)
  stepKey        String
  status         String                @default("pending") // pending | running | completed | blocked | failed
  attempts       Int                   @default(0)
  output         Json                  @default("{}")
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([organizationId, runId, stepKey], map: "tenant_provisioning_steps_org_run_step_key")
  @@index([organizationId, status, updatedAt], map: "tenant_provisioning_steps_org_status_idx")
  @@map("tenant_provisioning_steps")
}

// Provider access is a commercial entitlement, separate from credentials and
// from per-run authorization. No secret values are stored here.
model TenantProviderEntitlement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerKey    String
  enabled        Boolean      @default(false)
  billingMode    String       @default("disabled") // disabled | platform | byok
  credentialMode String       @default("none") // none | platform_secret | tenant_secret
  status         String       @default("needs_access") // ready | needs_access | disabled | suspended
  spendPolicy    Json         @default("{}")
  capabilities   Json         @default("{}")
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, providerKey], map: "tenant_provider_entitlements_org_provider_key")
  @@index([organizationId, status], map: "tenant_provider_entitlements_org_status_idx")
  @@map("tenant_provider_entitlements")
}

// Approved WhatsApp message templates synced from Meta Business Manager.
// Single source of truth for outbound template sends — no hardcoded names
// anywhere in src/. Synced via WhatsApp Graph API
// GET /v21.0/{businessAccountId}/message_templates
model WhatsAppTemplate {
  id              String        @id @default(cuid())
  organizationId  String
  channelConfigId String
  channelConfig   ChannelConfig @relation(fields: [channelConfigId], references: [id], onDelete: Cascade)
  metaTemplateId  String? // Meta's numeric id (optional; unique-ish per WABA)
  name            String
  category        String // MARKETING | UTILITY | AUTHENTICATION
  language        String // en_US, ru, az, ...
  status          String // APPROVED | PENDING | REJECTED | DISABLED | PAUSED
  bodyText        String?       @db.Text
  headerType      String? // TEXT | IMAGE | VIDEO | DOCUMENT | LOCATION
  headerText      String?       @db.Text
  footerText      String?       @db.Text
  buttons         Json? // [{type, text, url, phone_number, ...}]
  variables       String[]      @default([]) // extracted placeholders from body
  rawMeta         Json? // raw Graph API payload for debugging
  lastSyncAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, name, language])
  @@index([organizationId, status])
  @@index([channelConfigId])
  @@map("whatsapp_templates")
}

model ChannelMessage {
  id              String   @id @default(cuid())
  organizationId  String
  channelConfigId String?
  direction       String // inbound, outbound
  channelType     String? // email, telegram, sms, whatsapp, facebook, instagram, vkontakte
  contactId       String?
  leadId          String? // set by writers when the message is tied to a lead (Slice 3 lead timeline)
  from            String
  to              String
  subject         String?
  body            String
  status          String   @default("delivered") // pending, delivered, failed, read
  externalId      String?
  metadata        Json     @default("{}")
  conversationId  String?
  mediaUrl        String?
  messageType     String   @default("text")
  createdAt       DateTime @default(now())

  channelConfig ChannelConfig?      @relation(fields: [channelConfigId], references: [id])
  conversation  SocialConversation? @relation(fields: [conversationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, contactId])
  @@index([organizationId, leadId])
  @@index([conversationId])
  // NOTE: TWO PARTIAL unique indexes back inbound dedup (P2002 race guard); Prisma's @@unique
  // can't express a partial (WHERE) index, so neither is declared here. Do NOT "fix" the
  // resulting migrate-diff drift by dropping them:
  //   • `channel_messages_inbound_external_uniq` on (organizationId, externalId)
  //     WHERE direction='inbound' AND channelType IN ('sms','email') AND externalId IS NOT NULL
  //     — migration 20260609071733_channel_message_inbound_idempotency (A2).
  //   • `channel_messages_tiktok_inbound_external_uniq` on (organizationId, externalId)
  //     WHERE direction='inbound' AND channelType='tiktok' AND externalId IS NOT NULL
  //     — migration 20260620050000_inbound_tiktok_external_unique (G3, chatwoot bridge).
  @@map("channel_messages")
}

model EmailLog {
