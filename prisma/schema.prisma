  enrolledAt     DateTime              @default(now())
  completedAt    DateTime?
  droppedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([studentId, courseId, termId])
  @@index([organizationId, status])
  @@index([studentId])
  @@index([courseId])
  @@index([termId])
  @@map("education_enrollments")
}

// R1: Financial Services Cloud (Phase 6 Block E, closes Block E).
// Salesforce FSC analogue. Wealth management / retail-commercial
// banking / insurance — household-centric data model with multi-
// party ownership, goal tracking, life-event triggers.
//
// Slice 1 ships schema + 5 pure helpers. Slice 2 wires admin UI +
// client portal + KYC doc upload + lead-to-household conversion.
// Slice 3 wires portfolio AI + churn risk + OmniStudio FlexCard
// templates + external integrations (Plaid / Yodlee).

model FinancialHousehold {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  /**
   * Soft FK to Contact — slice-2 promotes to typed relation.
   */
  primaryContactId String?
  /**
   * Total Assets Under Management — sum of account balances.
   * Stored denormalised for cheap dashboard reads; aum-calculator
   * helper computes the canonical value. Slice-2 cron refreshes.
   */
  totalAum         Decimal      @default(0) @db.Decimal(18, 4)
  baseCurrency     String       @default("USD")
  /**
   * KYC status (DB CHECK):
   * not_started | in_review | approved | rejected | expired
   */
  kycStatus        String       @default("not_started")
  kycCompletedAt   DateTime?
  /**
   * Lifecycle (DB CHECK):
   * prospect | active | inactive | closed
   */
  status           String       @default("prospect")
  activatedAt      DateTime?
  closedAt         DateTime?
  closeReason      String?
  metadata         Json         @default("{}")
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  members    FinancialHouseholdMember[]
  accounts   FinancialAccount[]
  goals      FinancialGoal[]
  lifeEvents FinancialLifeEvent[]

  @@index([organizationId, status])
  @@index([organizationId, kycStatus])
  @@index([organizationId, totalAum])
  @@map("financial_households")
}

model FinancialHouseholdMember {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  householdId    String
  household      FinancialHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /**
   * Soft FK to Contact — slice-2 promotes.
   */
  contactId      String
  /**
   * primary | spouse | child | dependent | trustee | beneficiary — DB CHECK.
   */
  role           String
  /**
   * Ownership percentage 0-100. Slice-1 doesn't enforce sum-to-100
   * across members; slice-2 admin UI surfaces a warning.
   */
  ownershipPct   Decimal            @default(0) @db.Decimal(5, 2)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([householdId, contactId])
  @@index([organizationId, householdId])
  @@index([contactId])
  @@index([householdId, role])
  @@map("financial_household_members")
}

model FinancialAccount {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  householdId     String
  household       FinancialHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name            String
  accountNumber   String
  /**
   * 12-value allowlist (DB CHECK):
   * checking | savings | brokerage | ira_traditional | ira_roth
   * | 401k | 529 | credit_card | mortgage | personal_loan
   * | hsa | trust
   */
  accountType     String
  /**
   * pending | open | frozen | closed — DB CHECK.
   */
  status          String             @default("pending")
  /**
   * Current balance — sign matches account direction (loan = negative).
   */
  balance         Decimal            @default(0) @db.Decimal(18, 4)
  currency        String             @default("USD")
  institutionName String?
  openedAt        DateTime?
  closedAt        DateTime?
  frozenAt        DateTime?
  /**
   * Slice-3 Plaid/Yodlee sync timestamp.
   */
  lastSyncedAt    DateTime?
  metadata        Json               @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([householdId, accountNumber])
  @@index([organizationId, status])
  @@index([householdId, accountType])
  @@index([organizationId, lastSyncedAt])
  @@map("financial_accounts")
}

model FinancialGoal {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  householdId    String
  household      FinancialHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name           String
  /**
   * 7-value allowlist (DB CHECK):
   * retirement | college | home_purchase | emergency_fund
   * | major_purchase | debt_payoff | custom
   */
  goalType       String             @default("custom")
  targetAmount   Decimal            @db.Decimal(18, 4)
  /**
   * Current progress — manually slice-1; linked-account-sum slice-2.
   */
  currentAmount  Decimal            @default(0) @db.Decimal(18, 4)
  currency       String             @default("USD")
  targetDate     DateTime?
  /**
   * active | achieved | abandoned | paused — DB CHECK.
   */
  status         String             @default("active")
  achievedAt     DateTime?
  abandonedAt    DateTime?
  metadata       Json               @default("{}")
  createdBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([householdId])
  @@index([householdId, goalType])
  @@map("financial_goals")
}

model FinancialLifeEvent {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  householdId       String
  household         FinancialHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /**
   * 11-value allowlist (DB CHECK):
   * marriage | divorce | birth | death | retirement | job_change
   * | inheritance | home_purchase | major_illness
   * | child_education_start | other
   */
  eventType         String
  /**
   * Event date — may be past (logged after the fact) or future (planned).
   */
  eventDate         DateTime
  description       String?
  /**
   * Soft FK to involved Contact — slice-2 promotes.
   */
  involvedContactId String?
  /**
   * logged | acknowledged | actioned | dismissed — DB CHECK.
   */
  outreachStatus    String             @default("logged")
  actionedAt        DateTime?
  actionedBy        String?
  metadata          Json               @default("{}")
  createdBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId, householdId])
  @@index([householdId, eventDate])
  @@index([organizationId, outreachStatus])
  @@map("financial_life_events")
}

// C2: Mobile Studio (Phase 6 Block G first slice).
// Salesforce Marketing Cloud Mobile Studio analogue. Push / in-app /
// SMS campaigns + reusable templates. Builds on existing LeadDrive
// PushSubscription / sendSms / ContactEvent infrastructure (slice 2
// dispatchers + admin UI + cron).

model MobileMessageTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String?
  /**
   * push | in_app | sms — DB CHECK.
   */
  channel        String
  /**
   * Push/in_app title — null for SMS (body-only). DB CHECK enforces.
   */
  title          String?
  /**
   * Body content. Per-channel limits enforced by content-validator:
   * push   ≤ 240 chars (title + body)
   * sms    ≤ 1600 chars (multi-part)
   * in_app ≤ 5000 chars (HTML)
   */
  body           String
  /**
   * JSONB array — `[{ name, type, required, default? }]` (mirrors M5 shape).
   */
  variables      Json         @default("[]")
  deepLinkUrl    String?
  isActive       Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campaigns MobileCampaign[]

  @@unique([organizationId, channel, slug])
  @@index([organizationId, isActive])
  @@map("mobile_message_templates")
}

model MobileCampaign {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  /**
   * push | in_app | sms — DB CHECK.
   */
  channel        String
  templateId     String?
  template       MobileMessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /**
   * Inline content if no template — channel-specific coherence enforced.
   */
  title          String?
  body           String?
  deepLinkUrl    String?
  /**
   * JSONB audience filter — validated by audience-filter-validator at
   * INSERT/UPDATE. Slice-1 shape:
   * { contactTags?, segmentSlugs?, channelOptIn?, excludeContactIds? }
   */
  audienceFilter Json                   @default("{}")
  /**
   * Lifecycle (DB CHECK):
   * draft | scheduled | in_flight | completed | cancelled | failed
   */
  status         String                 @default("draft")
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelledBy    String?
  /**
   * JSONB delivery window — `{ quietHoursStart, quietHoursEnd, timezone }`.
   */
  deliveryWindow Json                   @default("{}")
  audienceSize   Int                    @default(0)
  createdBy      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  deliveries MobileCampaignDelivery[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, scheduledAt])
  @@index([templateId])
  @@map("mobile_campaigns")
}

model MobileCampaignDelivery {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          MobileCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /**
   * Soft FK to Contact — slice-2 promotes.
   */
  contactId         String
  /**
   * Address snapshot at queue time (phone, push token, etc.).
   */
  targetAddress     String
  /**
   * Lifecycle (DB CHECK):
   * pending | sent | delivered | failed | bounced | suppressed
   */
  status            String         @default("pending")
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  attemptCount      Int            @default(0)
  metadata          Json           @default("{}")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([campaignId, contactId])
  @@index([organizationId, status])
  @@index([campaignId])
  @@index([contactId])
  @@index([providerMessageId])
  @@map("mobile_campaign_deliveries")
}

// C3: Advertising Studio (Phase 6 Block G second slice).
// Salesforce Marketing Cloud Advertising Studio analogue. Manage
// FB / Google / LinkedIn ad accounts from CRM, sync segments →
// external custom audiences, track campaign metrics + ROI.
//
// Slice 1 ships schema + 5 pure helpers; slice 2 wires per-provider
// HTTP clients + OAuth + retry/DLQ + cron-driven sync.
//
// Unblocks G5 Activation: G4 DataCloudSegment can now sync to FB /
// Google audiences via the AdAudienceSync row + slice-2 dispatcher.

model AdProvider {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * facebook | google | linkedin | tiktok | twitter — DB CHECK.
   */
  providerType        String
  displayName         String
  /**
   * Provider's account ID (FB ad account, Google customer id).
   */
  externalAccountId   String
  /**
   * OAuth token / API key — slice-2 encrypts at ingest via pgcrypto.
   * Slice-1 keeps the column NULL because admin UI doesn't exist yet
   * (no plaintext write path).
   */
  credentialEncrypted String?
  /**
   * Connection status (DB CHECK):
   * draft | connected | disconnected | error | expired
   */
  status              String       @default("draft")
  connectedAt         DateTime?
  connectedBy         String?
  errorAt             DateTime?
  errorMessage        String?
  metadata            Json         @default("{}")
  createdBy           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  audienceSyncs    AdAudienceSync[]
  campaignTracking AdCampaignTracking[]

  @@unique([organizationId, providerType, externalAccountId])
  @@index([organizationId, status])
  @@index([organizationId, providerType])
  @@map("ad_providers")
}

model AdAudienceSync {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId         String
  provider           AdProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /**
   * Soft FK to Segment or DataCloudSegment — `segment_<id>` / `dataCloudSegment_<id>`.
   */
  segmentRef         String
  audienceName       String
  externalAudienceId String?
  /**
   * Sync status (DB CHECK):
   * pending | syncing | active | stale | error | deleted
   */
  status             String       @default("pending")
  memberCount        Int          @default(0)
  lastSyncAt         DateTime?
  lastErrorAt        DateTime?
  lastErrorMessage   String?
  deletedAt          DateTime?
  metadata           Json         @default("{}")
  createdBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([providerId, segmentRef])
  @@index([organizationId, status])
  @@index([organizationId, lastSyncAt])
  @@index([externalAudienceId])
  @@map("ad_audience_syncs")
}

model AdCampaignTracking {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId           String
  provider             AdProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  externalCampaignId   String
  campaignName         String
  /**
   * Soft FK to CRM Campaign — slice-2 promotes.
   */
  crmCampaignId        String?
  /**
   * active | paused | completed | archived — DB CHECK.
   */
  status               String       @default("active")
  /**
   * All money/count columns BigInt — defends against huge campaigns.
   */
  spendMinor           BigInt       @default(0)
  currency             String       @default("USD")
  impressions          BigInt       @default(0)
  clicks               BigInt       @default(0)
  conversions          BigInt       @default(0)
  conversionValueMinor BigInt       @default(0)
  campaignStartAt      DateTime?
  campaignEndAt        DateTime?
  lastSyncAt           DateTime?
  metadata             Json         @default("{}")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([providerId, externalCampaignId])
  @@index([organizationId, status])
  @@index([organizationId, lastSyncAt])
  @@index([crmCampaignId])
  @@map("ad_campaign_tracking")
}

// C4: Personalization / Interaction Studio (Phase 6 Block G slice 3,
// closes Block G).
//
// Salesforce Interaction Studio analogue. Real-time web personalization:
// show different content to different visitors based on profile +
// segment + behavior signals. Builds on G1 UnifiedProfile + G4
// DataCloudSegment.

model PersonalizationExperience {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * URL-safe slug, UNIQUE per tenant.
   */
  slug           String
  name           String
  description    String?
  /**
   * Placement key the JS snippet references (banner_top, product_card, etc.).
   */
  surface        String
  /**
   * JSONB targeting rules. Shape (see types.ts):
   * { allOf?: [...], anyOf?: [...], noneOf?: [...] }
   * targeting-evaluator helper walks it at decision time.
   */
  targetingRules Json         @default("{}")
  /**
   * Lifecycle (DB CHECK):
   * draft | active | paused | archived
   */
  status         String       @default("draft")
  /**
   * Tiebreaker when multiple experiences target same surface. 0..1000.
   */
  priority       Int          @default(0)
  /**
   * visitor (cookie) | contact (logged-in) | none (always reroll).
   */
  stickyMode     String       @default("visitor")
  activeFrom     DateTime?
  activeUntil    DateTime?
  activatedAt    DateTime?
  pausedAt       DateTime?
  archivedAt     DateTime?
  metadata       Json         @default("{}")
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  variants  PersonalizationVariant[]
  decisions PersonalizationDecision[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, surface, priority])
  @@map("personalization_experiences")
}

model PersonalizationVariant {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  experienceId   String
  experience     PersonalizationExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  /**
   * Variant content — surface-dependent JSONB; slice-2 caller interprets.
   */
  content        Json                      @default("{}")
  /**
   * Selection weight 0..1000. variant-selector picks weighted-random.
   */
  weight         Int                       @default(100)
  /**
   * Control / hold-out marker — variant-selector reports for lift math.
   */
  isControl      Boolean                   @default(false)
  isActive       Boolean                   @default(true)
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  decisions PersonalizationDecision[]

  @@unique([experienceId, slug])
  @@index([organizationId, experienceId])
  @@index([experienceId, isActive])
  @@map("personalization_variants")
}

model PersonalizationDecision {
  id               String                    @id @default(cuid())
  organizationId   String
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  experienceId     String
  experience       PersonalizationExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  variantId        String
  variant          PersonalizationVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /**
   * Pseudonymous visitor cookie / localStorage value. Soft FK.
   */
  visitorId        String
  /**
   * Optional logged-in Contact / UnifiedProfile soft FKs.
   */
  contactId        String?
  unifiedProfileId String?
  /**
   * When the decision was made (engine returned variant).
   */
  decidedAt        DateTime                  @default(now())
  /**
   * Event timestamps — set once each, immutable thereafter (DB trigger).
   */
  surfacedAt       DateTime?
  clickedAt        DateTime?
  convertedAt      DateTime?
  metadata         Json                      @default("{}")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([experienceId, visitorId])
  @@index([organizationId, experienceId])
  @@index([organizationId, decidedAt])
  @@index([variantId])
  @@index([contactId])
  @@index([unifiedProfileId])
  @@map("personalization_decisions")
}

// G5: Segment Activation (Phase 6 Block B deferred — final Phase 6 slice).
// Salesforce Data Cloud Activation analogue. Bridges G4 DataCloudSegment
// → external destinations (C3 AdAudienceSync FB/Google/LinkedIn, C2
