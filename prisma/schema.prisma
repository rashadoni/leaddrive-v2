  @@unique([organizationId, consumerName, consumerVersion, eventId], map: "consumer_inbox_event_key")
  @@unique([consumerName, consumerVersion, sourceTopic, sourcePartition, sourceOffset], map: "consumer_inbox_offset_key")
  @@index([organizationId, processedAt], map: "consumer_inbox_org_processed_idx")
  @@map("consumer_inbox")
}

model ProjectionBuild {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
