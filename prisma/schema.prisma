// Durable, tenant-scoped audit tombstone ledger for deterministic discovery
// auto-review. It intentionally has no time-based purge promise: the minimal
// ledger prevents the same resolver version from acting twice.
// Apply only suppresses eligible REVIEW rows. A separate zero-provider
// finalizer performs irreversible rejection after rollbackUntil.
model DiscoveryAutoReviewRun {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectId             String
  subject               MonitoringSubject @relation(fields: [organizationId, subjectId], references: [organizationId, id], onDelete: NoAction)
  idempotencyKey        String
  requestFingerprint    String
  resolverVersion       String
  mode                  String            @default("REJECT_ONLY") // REJECT_ONLY | SAFE_RESOLVE
  state                 String            @default("APPLIED") // APPLIED | ROLLED_BACK | FINALIZED | FAILED
  requestedBy           String
  plannedGroupCount     Int
  plannedRowCount       Int
  appliedGroupCount     Int               @default(0)
  appliedRowCount       Int               @default(0)
  skippedGroupCount     Int               @default(0)
  skippedRowCount       Int               @default(0)
  rolledBackGroupCount  Int               @default(0)
  rolledBackRowCount    Int               @default(0)
  rollbackUntil         DateTime
  completedAt           DateTime          @default(now())
  rolledBackAt          DateTime?
  finalizedAt           DateTime?
  error                 String?
  finalizeAttemptCount  Int               @default(0)
  finalizeLastAttemptAt DateTime?
  finalizeNextAttemptAt DateTime?
  finalizeLastError     String?
  retentionClass        String            @default("AUDIT_TOMBSTONE")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  decisions DiscoveryAutoReviewDecision[]
  events    DiscoveryAutoReviewEvent[]

  @@unique([organizationId, id], map: "discovery_auto_review_runs_org_id_key")
  @@unique([organizationId, idempotencyKey], map: "discovery_auto_review_runs_org_idempotency_key")
  // A partial unique index in the migration permits one APPLIED run per
  // tenant+subject. Prisma cannot represent that predicate.
  // A second partial migration index on finalizeAttemptCount+rollbackUntil+id
  // WHERE state = 'APPLIED' supports fair cross-tenant due-run work; Prisma
  // cannot model it either.
  @@index([organizationId, subjectId, state, createdAt], map: "discovery_auto_review_runs_subject_state_idx")
  @@index([organizationId, state, rollbackUntil], map: "discovery_auto_review_runs_rollback_idx")
  @@map("discovery_auto_review_runs")
}

// Tombstones are intentionally retained after rollback/finalization. The
// org+envelope+resolverVersion key prevents the same deterministic resolver
// version from applying twice to one observation.
model DiscoveryAutoReviewDecision {
  id                String                 @id @default(cuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId             String
  run               DiscoveryAutoReviewRun @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: NoAction)
  envelopeId        String
  envelope          IngestEnvelope         @relation(fields: [organizationId, envelopeId], references: [organizationId, id], onDelete: NoAction)
  resolverVersion   String
  action            String                 @default("REJECT") // REJECT | RELEASE_TO_NORMAL_PIPELINE
  state             String                 @default("SUPPRESSED") // SUPPRESSED | ROLLED_BACK | FINALIZED | SUPERSEDED
  reason            String
  groupKeyHmac      String
  beforeStatus      String
  beforeReason      String?
  beforeConfidence  Float?
  beforeDecidedAt   DateTime?
  beforePurgeAt     DateTime
  beforeContentHmac String
  beforeUpdatedAt   DateTime
  // Allowlisted evidence only: classifications, timestamps and hashes. Never
  // raw provider payload, content, authors, credentials or observed URLs.
  evidence          Json                   @default("{}")
  rollbackUntil     DateTime
  appliedAt         DateTime               @default(now())
  rolledBackAt      DateTime?
  finalizedAt       DateTime?
  supersededAt      DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([organizationId, id], map: "discovery_auto_review_decisions_org_id_key")
  @@unique([organizationId, envelopeId, resolverVersion], map: "discovery_auto_review_decisions_org_envelope_resolver_key")
  @@index([organizationId, runId, state], map: "discovery_auto_review_decisions_run_state_idx")
  @@index([organizationId, envelopeId, createdAt], map: "discovery_auto_review_decisions_envelope_idx")
  @@index([organizationId, state, rollbackUntil], map: "discovery_auto_review_decisions_rollback_idx")
  @@map("discovery_auto_review_decisions")
}

