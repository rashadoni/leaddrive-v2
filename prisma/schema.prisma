// Phase 7 slice-2 P0 #3 — compliance audit log for PHI / PII / FOIA reads.
// Distinct from `AuditLog` above (which logs CRUD mutations of business
// records); this one logs READ + EXPORT access to PHI (HIPAA),
// PII (insurance regulatory + general DPA), and FOIA-able records
// (public-sector citizen data). Append-only via DB trigger
// `compliance_audit_log_append_only_trigger` (UPDATE + DELETE both
// raise). Per-tenant scoped.
//
// Consumers: R2 Health / R7 Insurance / R8 Public Sector slice-2-mini
// API routes wrap their GET handlers with the helper module
// `src/lib/audit/compliance-audit.ts`. The helper is shipped first;
// route wrapping happens when those slice-2-mini routes ship.
model ComplianceAuditLog {
  id             String       @id @default(cuid())
  /// Deliberately NOT a relation. The compliance trail outlives the tenant it
  /// describes: a cascade would erase the record of who read what at exactly
  /// the moment the subject of an investigation is removed. Dropping the
  /// foreign key is what lets the row survive `hardDeleteTenant` — with the
  /// cascade in place the delete failed halfway instead (finding F-10).
  /// Retention is 3 years, enforced by schedule rather than by referential
  /// integrity — see docs/isms/ISMS-12-retention.md.
  organizationId String
  /// Operator who performed the read. NULL only for system-cron paths.
  userId         String?
  user           User?        @relation("ComplianceAuditUser", fields: [userId], references: [id], onDelete: SetNull)
  /// CHECK enum: 'read' | 'write' | 'export' | 'delete'.
  action         String
  /// CHECK enum: 'phi' | 'pii' | 'foia'.
  recordType     String
  /// Physical table the record lives in (e.g. "health_patients").
  recordTable    String
  /// ID of the audited row. NULL for "list" reads that don't identify
  /// a single record (e.g. roster page).
  recordId       String?
  /// Optional request metadata for forensics.
  ipAddress      String?
  userAgent      String?
  /// Free-form context (query filters, export format, etc.).
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now())

  @@index([organizationId, recordTable, recordId, occurredAt], map: "compliance_audit_log_org_record_idx")
  @@index([organizationId, userId, occurredAt], map: "compliance_audit_log_org_user_idx")
  @@index([organizationId, recordType, occurredAt], map: "compliance_audit_log_org_type_idx")
  @@map("compliance_audit_log")
}

// Phase 7 slice-2 P0 #1 — PII encryption key versioning.
// Slice-2: this table is reserved for slice-3 rotation history.
// DEKs are derived deterministically from the master KEK in the
// helper (`src/lib/crypto/tenant-pii-encryption.ts`), not stored.
// Slice-3 may switch to stored wrapped-DEK per-tenant when key
// rotation lands.
//
// Append-only via DB trigger (`tenant_master_keys_immutability_trigger`):
// DELETE rejected entirely; UPDATE only allowed on
// `supersededAt` + `supersededByVersion` (set-once). Other columns
// are immutable.
model TenantMasterKey {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Key version. Slice-3 rotation appends a new row with incrementing version.
  version             Int
  /// Wrapped DEK ciphertext (base64). Empty in slice-2 (derived DEKs
  /// don't need persistence). Reserved for slice-3 stored-DEK path.
  wrappedDek          String?
  activatedAt         DateTime     @default(now())
  /// Set when superseded by a newer version. NULL = currently active.
  supersededAt        DateTime?
  supersededByVersion Int?
  createdBy           String?
  createdAt           DateTime     @default(now())

  // SQL has a PARTIAL unique index on organizationId
  // WHERE supersededAt IS NULL — Prisma can't express partial
  // uniques, so we use @@index here (NOT @@unique). The DB-level
  // partial constraint is the real enforcement: exactly one active
  // (non-superseded) key per tenant at a time. Older versions
  // (supersededAt IS NOT NULL) accumulate as rotation history.
  // findUnique({where:{organizationId}}) at the Prisma layer would
  // mis-promise single-row-per-org — use findFirst with the
  // {organizationId, supersededAt: null} filter instead.
  @@index([organizationId], map: "tenant_master_keys_org_active_idx")
  @@index([organizationId, version], map: "tenant_master_keys_org_version_idx")
  @@map("tenant_master_keys")
}

// C5 Account Engagement slice-2 — per-tenant grade-component weights.
// Slice-1 helper `account-grade-calculator.ts` ships hardcoded
// defaults. Slice-2 loader merges this row's overrides on top.
// One row per tenant; absence of a row means "use defaults".
model AccountGradeConfig {
  id                     String       @id @default(cuid())
  organizationId         String       @unique(map: "account_grade_config_org_uniq")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Per-tier weight overrides. Shape: { "tier_1": 30, "tier_2": 22, ... }
  /// Missing keys fall back to helper defaults.
  icpComponentByTier     Json         @default("{}")
  /// Per-band weight overrides. Shape: { "strategic": 25, ... }
  bandComponent          Json         @default("{}")
  /// Target-industry positive list. Caller matches case-sensitively.
  targetIndustries       String[]     @default([])
  /// Disqualified-industry negative list.
  disqualifiedIndustries String[]     @default([])
  /// Letter-grade threshold overrides. Shape: { "A": 80, "B": 60, "C": 40, "D": 20 }
  gradeThresholds        Json         @default("{}")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@map("account_grade_config")
}

/// KPI Arena (leaderboard) per-org config. 1:1 per org; absence of a row → loader
/// defaults verbatim (= today's hardcoded constants). See lib/leaderboard/config-loader.ts.
model LeaderboardConfig {
  id               String       @id @default(cuid())
  organizationId   String       @unique(map: "leaderboard_config_org_uniq")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// MTM composite-attainment weights. Shape: { "task": 0.5, "photo": 0.3, "route": 0.2 }.
  /// Missing keys fall back to loader defaults; should sum to 1.0 (a weighted average).
  mtmWeights       Json         @default("{}")
  /// Status-band thresholds = min attainment % for each band. Shape:
  /// { "exceeding": 110, "on_track": 90, "behind": 70, "at_risk": 50 }. Missing keys → defaults.
  statusThresholds Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("leaderboard_config")
}

/// KPI Arena point-in-time standings (Phase D) — one row per org × group ×
/// hour-bucket, written by the hourly snapshot cron. `standings` is the ranked
/// array the agent-detail trend (1h/1d/1m/1y) samples. Append-mostly; no backfill.
model LeaderboardSnapshot {
  id             String       @id // deterministic: ${orgId}:${group}:${YYYY-MM-DDTHH}
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          String // sales | mtm | tickets | projects | tasks
  /// [{ id, attainmentPct, volume, rank }] per agent at capture time.
  standings      Json         @default("[]")
  capturedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, group, capturedAt])
  @@map("leaderboard_snapshots")
}

// C5 Account Engagement slice-2 — per-tenant intent-signal config.
// Slice-1 helper `intent-signal-classifier.ts` ships hardcoded
// signal weights + MQL-qualifying allow-list. Slice-2 loader
// merges this row's overrides on top.
model IntentSignalConfig {
  id                  String       @id @default(cuid())
  organizationId      String       @unique(map: "intent_signal_config_org_uniq")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Per-SignalKind weight overrides. Shape:
  /// { "chat_high_intent": 25, "form_submission": 20, ... }
  signalWeights       Json         @default("{}")
  /// Per-SignalKind MQL-qualifying flag overrides. Shape:
  /// { "chat_high_intent": true, "form_submission": false, ... }
  mqlQualifyingByKind Json         @default("{}")
  /// Lookback window for recency scoring (days). NULL = helper default.
  /// CHECK: 1 ≤ lookbackDays ≤ 365 when set.
  lookbackDays        Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("intent_signal_config")
}

// R11 Media slice-2 — per-tenant ad-campaign pacing thresholds.
// Slice-1 hardcodes OVER_PACE_THRESHOLD=1.1 / UNDER_PACE_THRESHOLD=0.9.
// Per-org overrides let marketing teams tighten/loosen by business
// rules (e.g. premium advertiser at ±5%).
// CHECKs: overPaceThreshold > 1.0; 0 < underPaceThreshold < 1.0.
model MediaPacingConfig {
  id                   String       @id @default(cuid())
  organizationId       String       @unique(map: "media_pacing_config_org_uniq")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Over-pace flag threshold (default 1.1). NULL = slice-1 default.
  overPaceThreshold    Float?
  /// Under-pace flag threshold (default 0.9). NULL = slice-1 default.
  underPaceThreshold   Float?
  /// Reserved JSONB for slice-3 per-campaign / per-slot pacing curves.
  perCampaignOverrides Json         @default("{}")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("media_pacing_config")
}

// R7 Insurance slice-2 — per-tenant premium rate-table overrides.
// Slice-1 hardcodes BASE_RATES + RISK_MULTIPLIERS + DEDUCTIBLE_CREDIT_RATES.
// Per-org overrides let regulated carriers honor state DOI tariff
// filings without code changes. Slice-3 may add per-state versioning.
//
// `rateTablesV2` is reserved for full actuarial rate tables
// (coverage-limit × age × territory). Slice-3 schema TBD.
model InsuranceRatingConfig {
  id                    String       @id @default(cuid())
  organizationId        String       @unique(map: "insurance_rating_config_org_uniq")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Per-LineOfBusiness base rate overrides. Shape:
  /// { "auto": 0.015, "home": 0.008, ... }
  baseRates             Json         @default("{}")
  /// Per-RiskTier multiplier overrides. Shape:
  /// { "preferred": 0.8, "standard": 1.0, "substandard": 1.4 }
  /// "declined" NOT overridable (NaN sentinel by code path).
  riskMultipliers       Json         @default("{}")
  /// Per-LineOfBusiness deductible credit rate overrides.
  deductibleCreditRates Json         @default("{}")
  /// Reserved: slice-3 full actuarial rate tables.
  rateTablesV2          Json         @default("{}")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("insurance_rating_config")
}

