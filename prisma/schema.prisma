  @@index([organizationId, status])
  @@index([organizationId, startedAt])
  @@map("segment_activation_runs")
}

// --- Phase 7 R2: Health Cloud (slice 1) ---
//
// HIPAA scope = declarative only: PHI columns flagged in field-level
// comments. Slice-2 wraps with pgcrypto / row-level encryption at rest
// + audit-log hooks. Certification (BAA, HIPAA audit) is OUT OF SCOPE
// per roadmap — code-side enforcement is what we build.

model HealthProvider {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Optional User link for providers who log into the CRM.
  userId         String?
  fullName       String
  email          String
  phone          String?
  /// National Provider Identifier (US NPI). DB CHECK enforces length 8..32.
  npiNumber      String?
  /// role allow-list (DB CHECK):
  /// physician | nurse_practitioner | physician_assistant
  /// | registered_nurse | specialist | therapist | technician | admin
  role           String       @default("physician")
  specialty      String?
  departmentSlug String?
  isActive       Boolean      @default(true)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patientsPrimary HealthPatient[]       @relation("HealthPatientPrimaryProvider")
  medicalRecords  HealthMedicalRecord[]
  encounters      HealthEncounter[]
  carePlans       HealthCarePlan[]

  @@unique([organizationId, email], map: "health_providers_org_email_uniq")
  @@index([organizationId, isActive], map: "health_providers_org_active_idx")
  @@index([organizationId, role], map: "health_providers_org_role_idx")
  @@index([organizationId, specialty], map: "health_providers_specialty_idx")
  @@map("health_providers")
}

model HealthPatient {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Optional Contact link for patients who came in via CRM.
  contactId             String?
  /// Optional User link for patient-portal self-service (slice-2).
  userId                String?
  /// Medical Record Number — institutional, UNIQUE per tenant.
  mrn                   String
  /// Legal name (PHI — slice-2 pgcrypto wrap).
  fullName              String
  /// Slice-3 blind-index for exact-match search on the encrypted
  /// fullName column. HMAC-SHA256(per-tenant key, normalize(fullName))
  /// → base64url 43 chars. Same pattern as citizens.fullNameBlindIndex
  /// (PR #160) — see helper at `src/lib/crypto/tenant-pii-encryption.ts`
  /// (`blindIndexForTenant`). Routes write this alongside the encrypted
  /// ciphertext; GET list `?fullName=` filter queries by hash instead
  /// of decrypting + scanning the table.
  fullNameBlindIndex    String?
  email                 String?
  phone                 String?
  /// Date of birth (PHI — quasi-identifier).
  dateOfBirth           DateTime?
  /// Biological sex at birth (free-form caller).
  sexAtBirth            String?
  /// Government tax / SSN (PHI — slice-2 pgcrypto wrap).
  taxId                 String?
  /// Slice-3 blind-index for exact-match search on the encrypted
  /// taxId column. Same HMAC + per-tenant key as the fullName
  /// blind index. Enables `?taxId=` lookup workflows (e.g. HIPAA-
  /// authorized cross-referencing a payer record) without scanning.
  taxIdBlindIndex       String?
  /// Address (PHI).
  addressLine1          String?
  city                  String?
  postalCode            String?
  country               String?
  /// Insurance carrier + policy id (PHI).
  insuranceCarrier      String?
  insurancePolicyId     String?
  /// Emergency contact (PHI).
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Lifecycle (DB CHECK): active | inactive | discharged | deceased
  status                String          @default("active")
  /// Primary care provider — soft FK to health_providers.
  primaryProviderId     String?
  primaryProvider       HealthProvider? @relation("HealthPatientPrimaryProvider", fields: [primaryProviderId], references: [id])
  registeredAt          DateTime        @default(now())
  dischargedAt          DateTime?
  deceasedAt            DateTime?
  metadata              Json            @default("{}")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  medicalRecords HealthMedicalRecord[]
  encounters     HealthEncounter[]
  carePlans      HealthCarePlan[]

  @@unique([organizationId, mrn], map: "health_patients_org_mrn_uniq")
  @@index([organizationId, status], map: "health_patients_org_status_idx")
  @@index([primaryProviderId], map: "health_patients_primary_provider_idx")
  @@index([contactId], map: "health_patients_contact_idx")
  // Blind-index lookup for the GET list `?fullName=` filter.
  @@index([organizationId, fullNameBlindIndex], map: "health_patients_org_full_name_blind_idx")
  // Blind-index lookup for the GET list `?taxId=` filter.
  @@index([organizationId, taxIdBlindIndex], map: "health_patients_org_tax_id_blind_idx")
  @@map("health_patients")
}

model HealthMedicalRecord {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId            String
  patient              HealthPatient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// Optional encounter link (if record was created during a visit).
  encounterId          String?
  encounter            HealthEncounter? @relation(fields: [encounterId], references: [id])
  /// Provider who created the record.
  recordedByProviderId String?
  recordedByProvider   HealthProvider?  @relation(fields: [recordedByProviderId], references: [id])
  /// recordType allow-list (DB CHECK):
  /// visit_summary | diagnosis | lab_result | procedure | medication
  /// | allergy | immunization | vital_signs | imaging | discharge_summary
  recordType           String
  /// Clinical event timestamp (NOT row-create time).
  recordedAt           DateTime
  /// Type-specific structured payload — validator enforces per-type shape.
  details              Json             @default("{}")
  /// Free-text clinician notes (PHI).
  clinicianNotes       String?
  /// severity allow-list: informational | low | moderate | high | critical
  severity             String           @default("informational")
  /// sensitivity allow-list: normal | sensitive | restricted
  sensitivity          String           @default("normal")
  metadata             Json             @default("{}")
  createdAt            DateTime         @default(now())

  @@index([patientId, recordedAt], map: "health_medical_records_patient_recorded_idx")
  @@index([organizationId, recordType], map: "health_medical_records_org_type_idx")
  @@index([encounterId], map: "health_medical_records_encounter_idx")
  @@index([recordedByProviderId], map: "health_medical_records_provider_idx")
  @@map("health_medical_records")
}

model HealthEncounter {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId          String
  patient            HealthPatient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId         String
  provider           HealthProvider @relation(fields: [providerId], references: [id])
  /// encounterType allow-list:
  /// in_person | telehealth | phone | home_visit | inpatient
  encounterType      String         @default("in_person")
  reason             String?
  /// Lifecycle (DB CHECK):
  /// scheduled | checked_in | in_progress | completed | no_show | cancelled
  status             String         @default("scheduled")
  scheduledStartAt   DateTime
  scheduledEndAt     DateTime
  checkedInAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  /// Set when status transitions to `no_show`. Slice-2 coherence
  /// CHECK enforces `status='no_show' ⇒ noShowAt IS NOT NULL`.
  noShowAt           DateTime?
  /// Location — clinic room / telehealth URL / phone-call ref.
  location           String?
  metadata           Json           @default("{}")
  createdBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  medicalRecords HealthMedicalRecord[]

  @@index([patientId, scheduledStartAt], map: "health_encounters_patient_scheduled_idx")
  @@index([providerId, scheduledStartAt], map: "health_encounters_provider_scheduled_idx")
  @@index([organizationId, status], map: "health_encounters_org_status_idx")
  @@index([organizationId, encounterType], map: "health_encounters_org_type_idx")
  @@map("health_encounters")
}

model HealthCarePlan {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId          String
  patient            HealthPatient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  /// Lead provider managing the plan.
  providerId         String?
  provider           HealthProvider? @relation(fields: [providerId], references: [id])
  /// goals shape:
  /// [{ id, label, metric, targetValue, comparator: 'gte'|'lte'|'eq',
  ///    kpiSource: 'medical_record_count'|'medication_adherence' }]
  goals              Json            @default("[]")
  /// Start of the plan's active window.
  startDate          DateTime
  /// End of the active window. NULL = open-ended.
  endDate            DateTime?
  /// Lifecycle (DB CHECK): draft | active | paused | completed | cancelled
  status             String          @default("draft")
  activatedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  metadata           Json            @default("{}")
  createdBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([patientId, status], map: "health_care_plans_patient_status_idx")
  @@index([organizationId, status], map: "health_care_plans_org_status_idx")
  @@index([providerId], map: "health_care_plans_provider_idx")
  @@map("health_care_plans")
}

// --- Phase 7 R6: Energy & Utilities Cloud (slice 1) ---
//
// Salesforce E&U Cloud analogue. Customer-service surface for utilities
// (electricity / gas / water / district heating / sewer), with smart-
// metering ingestion + outage management + service-call dispatch.
//
// Slice-1 = schema + pure helpers. Slice-2 wires AMI/AMR ingestion,
// SCADA grid hooks, mobile tech dispatch, tariff engine.

model UtilityCustomer {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Soft FK to CRM Contact for billing-side correspondence.
  contactId           String?
  /// Billing-system account number — UNIQUE per tenant.
  accountNumber       String
  /// Legal-name of the account holder (PII).
  accountHolderName   String
  /// Service-address (where meters are physically located).
  serviceAddressLine1 String
  serviceAddressLine2 String?
  serviceCity         String
  servicePostalCode   String?
  serviceCountry      String?
  /// Customer class (DB CHECK):
  /// residential | small_commercial | large_commercial
  /// | industrial | agricultural | municipal
  customerClass       String       @default("residential")
  /// Lifecycle (DB CHECK): prospect | active | suspended | terminated
  status              String       @default("active")
  activatedAt         DateTime?
  suspendedAt         DateTime?
  terminatedAt        DateTime?
  metadata            Json         @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  meteringPoints MeteringPoint[]
  serviceCalls   ServiceCall[]

  @@unique([organizationId, accountNumber], map: "utility_customers_org_account_uniq")
  @@index([organizationId, status], map: "utility_customers_org_status_idx")
  @@index([organizationId, customerClass], map: "utility_customers_org_class_idx")
  @@index([contactId], map: "utility_customers_contact_idx")
  @@map("utility_customers")
}

model MeteringPoint {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  utilityCustomerId String
  utilityCustomer   UtilityCustomer @relation(fields: [utilityCustomerId], references: [id], onDelete: Cascade)
  /// Meter serial / device number — UNIQUE per tenant.
  meterNumber       String
  /// Commodity type (DB CHECK):
  /// electricity | gas | water | district_heating | sewer
  commodityType     String
  latitude          Float?
  longitude         Float?
  manufacturer      String?
  modelNumber       String?
  installedAt       DateTime?
  /// Lifecycle (DB CHECK):
  /// pending_install | active | disconnected | retired
  status            String          @default("pending_install")
  disconnectedAt    DateTime?
  retiredAt         DateTime?
  tariffPlanSlug    String?
  metadata          Json            @default("{}")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  readings     MeterReading[]
  serviceCalls ServiceCall[]

  @@unique([organizationId, meterNumber], map: "metering_points_org_meter_uniq")
  @@index([utilityCustomerId], map: "metering_points_customer_idx")
  @@index([organizationId, status], map: "metering_points_org_status_idx")
  @@index([organizationId, commodityType], map: "metering_points_org_commodity_idx")
  @@map("metering_points")
}

model MeterReading {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meteringPointId     String
  meteringPoint       MeteringPoint  @relation(fields: [meteringPointId], references: [id], onDelete: Cascade)
  /// Reading source (DB CHECK):
  /// manual | amr | ami | estimated | corrected
  source              String
  readingAt           DateTime
  cumulativeValue     Decimal        @db.Decimal(18, 4)
  intervalValue       Decimal?       @db.Decimal(18, 4)
  unit                String
  tariffCode          String?
  /// Quality flag (DB CHECK): raw | validated | flagged
  quality             String         @default("raw")
  /// Self-referential FK — corrected source ⇒ supersedesReadingId set.
  supersedesReadingId String?
  supersedes          MeterReading?  @relation("MeterReadingCorrection", fields: [supersedesReadingId], references: [id])
  correctedBy         MeterReading[] @relation("MeterReadingCorrection")
  metadata            Json           @default("{}")
  createdAt           DateTime       @default(now())

  @@index([meteringPointId, readingAt], map: "meter_readings_meter_time_idx")
  @@index([organizationId, quality], map: "meter_readings_org_quality_idx")
  @@index([organizationId, source], map: "meter_readings_org_source_idx")
  @@index([supersedesReadingId], map: "meter_readings_supersedes_idx")
  @@map("meter_readings")
}

model Outage {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Reference label (e.g. "OUT-2026-05-1234") — UNIQUE per tenant.
  outageNumber       String
  /// cause allow-list (DB CHECK):
  /// planned_maintenance | equipment_failure | weather
  /// | third_party_damage | overload | unknown
  cause              String       @default("unknown")
  /// severity allow-list (DB CHECK): minor | moderate | major | critical
  severity           String       @default("minor")
  /// Lifecycle (DB CHECK): pending | active | resolved | cancelled
  status             String       @default("pending")
  scheduledStartAt   DateTime?
  scheduledEndAt     DateTime?
  actualStartAt      DateTime?
  actualEndAt        DateTime?
  /// Snapshot at outage start — count of affected meters.
  affectedMeterCount Int          @default(0)
  publicSummary      String?
  internalNotes      String?
  metadata           Json         @default("{}")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  serviceCalls ServiceCall[]

  @@unique([organizationId, outageNumber], map: "outages_org_number_uniq")
  @@index([organizationId, status], map: "outages_org_status_idx")
  @@index([organizationId, severity], map: "outages_org_severity_idx")
  @@index([organizationId, actualStartAt], map: "outages_org_started_idx")
  @@map("outages")
}

model ServiceCall {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Reference label (e.g. "SC-2026-05-9876") — UNIQUE per tenant.
  callNumber         String
  utilityCustomerId  String?
  utilityCustomer    UtilityCustomer? @relation(fields: [utilityCustomerId], references: [id])
  meteringPointId    String?
  meteringPoint      MeteringPoint?   @relation(fields: [meteringPointId], references: [id])
  outageId           String?
  outage             Outage?          @relation(fields: [outageId], references: [id])
  /// callType allow-list (DB CHECK):
  /// outage_report | new_connection | disconnection | reconnection
  /// | meter_inspection | meter_replacement | billing_dispute
  /// | usage_question | service_upgrade
  callType           String
  /// priority allow-list (DB CHECK):
  /// routine | elevated | urgent | emergency
  priority           String           @default("routine")
  /// Lifecycle (DB CHECK):
  /// received | dispatched | in_progress | resolved | cancelled
  status             String           @default("received")
  subject            String
  description        String?
  queueSlug          String?
  assignedToUserId   String?
  scheduledAt        DateTime?
  dispatchedAt       DateTime?
  startedAt          DateTime?
  resolvedAt         DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  resolutionNotes    String?
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([organizationId, callNumber], map: "service_calls_org_number_uniq")
  @@index([organizationId, status], map: "service_calls_org_status_idx")
  @@index([organizationId, priority], map: "service_calls_org_priority_idx")
  @@index([utilityCustomerId], map: "service_calls_customer_idx")
  @@index([outageId], map: "service_calls_outage_idx")
  @@index([organizationId, queueSlug, status], map: "service_calls_queue_status_idx")
  @@index([organizationId, assignedToUserId, status], map: "service_calls_assigned_status_idx")
  @@map("service_calls")
}

// --- Phase 7 R7: Insurance Cloud (slice 1) ---
//
// Salesforce Insurance Cloud analogue. P&C + life insurance policy
// administration, claims, beneficiaries, underwriter + adjuster team.
// PII columns flagged for slice-2 pgcrypto wrap.

model PolicyHolder {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Soft FK to CRM Contact for sales-funnel correspondence.
  contactId           String?
  /// Insured number — institutional, UNIQUE per tenant.
  holderNumber        String
  /// Legal name (PII — slice-2 pgcrypto wrap).
  fullName            String
  /// Slice-3 blind-index for exact-match search on the encrypted
  /// fullName column. Same pattern as citizens (PR #160) and
  /// health-patients (PR #161) — see `blindIndexForTenant()`.
  fullNameBlindIndex  String?
  email               String?
  phone               String?
  /// Date of birth (PII — quasi-identifier; required for life policies).
  dateOfBirth         DateTime?
  /// Tax / SSN (PII — slice-2 pgcrypto wrap).
  taxId               String?
  /// Slice-3 blind-index for `?taxId=` exact-match lookup. State DOI
  /// / NAIC records-request workflows often query a policyholder
  /// by SSN — same HMAC + per-tenant key as the fullName index.
  taxIdBlindIndex     String?
  /// Mailing address (PII).
  mailingAddressLine1 String?
  mailingCity         String?
  mailingPostalCode   String?
  mailingCountry      String?
  /// Occupation rating slug (slice-2 wires to rating engine).
  occupationSlug      String?
  /// Lifecycle (DB CHECK): prospect | active | inactive | deceased
  status              String       @default("active")
  activatedAt         DateTime?
  deactivatedAt       DateTime?
  deceasedAt          DateTime?
  metadata            Json         @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  policies Policy[]

  @@unique([organizationId, holderNumber], map: "policy_holders_org_number_uniq")
  @@index([organizationId, status], map: "policy_holders_org_status_idx")
  @@index([contactId], map: "policy_holders_contact_idx")
  @@index([organizationId, fullNameBlindIndex], map: "policy_holders_org_full_name_blind_idx")
  @@index([organizationId, taxIdBlindIndex], map: "policy_holders_org_tax_id_blind_idx")
  @@map("policy_holders")
}

model InsuranceServiceTeamMember {
