  collectorRuns        CollectorRun[]
  evidences            MentionEvidence[]
  routePlans           SourceRoutePlan[]
  providerRuns         SocialProviderRun[]
  ingestEnvelopes      IngestEnvelope[]
  rejectedFingerprints RejectedObservationFingerprint[]
  commentCheckpoints   SocialCommentCheckpoint[]
