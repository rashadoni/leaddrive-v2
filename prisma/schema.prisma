// Brand/product identifiers are external catalog references. MTM owns the
// scoped potential/coverage facts and display-name snapshots; no LeadShelf
// service or runtime dependency is required for field work.
model MtmFieldPotential {
  id                    String                      @id @default(cuid())
  organizationId        String
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId            String?
  customer              MtmCustomer?                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId             String?
  contact               MtmContact?                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agentId               String?
  agent                 MtmAgent?                   @relation("MtmFieldPotentialAgent", fields: [agentId], references: [id], onDelete: SetNull)
  enteredByAgentId      String?
  enteredByAgent        MtmAgent?                   @relation("MtmFieldPotentialEnteredBy", fields: [enteredByAgentId], references: [id], onDelete: SetNull)
  reviewedByAgentId     String?
  reviewedByAgent       MtmAgent?                   @relation("MtmFieldPotentialReviewedBy", fields: [reviewedByAgentId], references: [id], onDelete: SetNull)
  clientPotentialId     String?
  requestHash           String?
  brandExternalId       String?
  brandName             String?
  productExternalId     String?
  productName           String?
  category              MtmCustomerCategory?
  categoryLabel         String?
  potentialValue        Decimal                     @default(0) @db.Decimal(14, 2)
  coverageValue         Decimal                     @default(0) @db.Decimal(14, 2)
  periodStart           DateTime?                   @db.Date
  periodEnd             DateTime?                   @db.Date
  source                String                      @default("ADMIN")
  formulaVersion        String?
  provenance            Json?
  status                MtmFieldPotentialStatus     @default(PENDING)
  reviewComment         String?
  reviewedAt            DateTime?
  closedAt              DateTime?
  supersedesPotentialId String?
  supersedesPotential   MtmFieldPotential?          @relation("MtmFieldPotentialRevisions", fields: [supersedesPotentialId], references: [id], onDelete: SetNull)
  supersededBy          MtmFieldPotential[]         @relation("MtmFieldPotentialRevisions")
  evidenceVisits        MtmFieldPotentialEvidence[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  deletedAt             DateTime?

  @@unique([organizationId, clientPotentialId])
  @@index([organizationId, customerId, periodStart, periodEnd])
  @@index([organizationId, contactId, periodStart, periodEnd])
  @@index([organizationId, agentId, periodStart, periodEnd])
  @@index([organizationId, status, createdAt])
  @@index([supersedesPotentialId])
  @@index([organizationId, brandExternalId, productExternalId])
  @@map("mtm_field_potentials")
}

/// Evidence is an explicit tenant-scoped link rather than an embedded JSON id.
/// This keeps every potential/coverage value drillable to the visits that
/// support it while preserving the append-only assessment history.
model MtmFieldPotentialEvidence {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldPotentialId String
  fieldPotential   MtmFieldPotential @relation(fields: [fieldPotentialId], references: [id], onDelete: Cascade)
  visitId          String
  visit            MtmVisit          @relation(fields: [visitId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())

  @@unique([fieldPotentialId, visitId])
  @@index([organizationId, visitId])
  @@map("mtm_field_potential_evidence")
}

