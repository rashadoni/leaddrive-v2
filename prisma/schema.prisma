  startedAt         DateTime?
  completedAt       DateTime?
  promotedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  checkpoints ProjectionCheckpoint[]
  activeFor   ProjectionActivation[]     @relation("ProjectionActiveBuild")
  promotedBy  ProjectionPromotionEvent[] @relation("ProjectionPromotionTarget")
  replacedBy  ProjectionPromotionEvent[] @relation("ProjectionPromotionPrevious")

  @@unique([organizationId, id], map: "projection_builds_org_id_key")
  @@unique([organizationId, projectionName, buildKey], map: "projection_builds_build_key")
  @@index([organizationId, projectionName, status], map: "projection_builds_org_status_idx")
  @@map("projection_builds")
}

/// Mutable, tenant-scoped read pointer. It is changed only in the same
/// transaction that appends a ProjectionPromotionEvent.
model ProjectionActivation {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectionName    String
  activeBuildId     String          @db.Uuid
  activeBuild       ProjectionBuild @relation("ProjectionActiveBuild", fields: [organizationId, activeBuildId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  activationVersion BigInt          @default(1)
  activatedAt       DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, id], map: "projection_activations_org_id_key")
  @@unique([organizationId, projectionName], map: "projection_activations_pointer_key")
  @@index([organizationId, activeBuildId], map: "projection_activations_build_idx")
  @@map("projection_activations")
}

/// Append-only evidence for promotion and rollback. Requester and approver
/// must be different identities; the database enforces this again.
model ProjectionPromotionEvent {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectionName          String
  targetBuildId           String           @db.Uuid
  targetBuild             ProjectionBuild  @relation("ProjectionPromotionTarget", fields: [organizationId, targetBuildId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  previousBuildId         String?          @db.Uuid
  previousBuild           ProjectionBuild? @relation("ProjectionPromotionPrevious", fields: [organizationId, previousBuildId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade)
  action                  String
  requestKey              String
  requestedBy             String
