  /// Optional Subscription link (D4 billing). NULL for free-tier.
  subscriptionId       String?
  /// Subscriber number — UNIQUE per tenant.
  subscriberNumber     String
  /// Display name (PII — slice-2 pgcrypto wrap).
  displayName          String
  email                String?
  /// Tier slug (free | premium | premium-plus | family — tenant-defined).
  tierSlug             String       @default("free")
  /// Billing region ISO 3166-1 alpha-2 (US, GB, FR, ...).
