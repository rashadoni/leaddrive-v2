// ═══════════════════════════════════════════════════════════════════════════
// DIGEST SUBSCRIPTIONS — per-user delivery preferences for AI-generated
// briefings, anomaly alerts and renewal reminders. Replaces the hardcoded
// "send to all admin/manager users" logic in the cron jobs.
// ═══════════════════════════════════════════════════════════════════════════

model DigestSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Digest type — one row per (user, type)
  type String // daily_briefing | anomaly_alert | renewal

  // Cadence — cron job decides whether to actually fire for this user
  // based on lastSentAt + frequency. "off" short-circuits immediately.
  frequency String @default("daily") // off | daily | every_2_days | weekly | monthly

  // Which channels to deliver through. Empty array = in_app only.
  channels String[] @default(["email", "in_app"]) // email | telegram | slack | in_app

  // Optional override — time of day to send (HH:mm, org timezone).
  // Null = use job's default cron schedule.
  timeOfDay String?

  // For weekly/monthly: 0-6 (Sun-Sat) or 1-31. Null = not applicable.
  dayOfWeek  Int?
  dayOfMonth Int?

  lastSentAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([organizationId, userId, type])
  @@index([organizationId, type, isActive])
  @@index([organizationId, userId])
  @@map("digest_subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════════
// C9 — MARKETING ATTRIBUTION (Phase 6 Block A)
// Salesforce Campaign Influence analogue. Multi-touch attribution across
// 5 canonical models (first_touch / last_touch / linear / time_decay /
// u_shaped) + custom curves slice-3. Slice-1 = schema + pure helpers.
// See prisma/migrations/20260519130000_marketing_attribution/migration.sql
// for trigger-level invariants (append-only touchpoints, status machine,
// coherence, immutable identifiers on influences).
// ═══════════════════════════════════════════════════════════════════════════

model AttributionModel {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  /**
   * Model type (DB CHECK + immutable post-create):
   * first_touch | last_touch | linear | time_decay | u_shaped | custom
   */
  modelType            String
  /**
   * Per-model knobs. See migration header for shape per modelType.
   * Validated by model-config-validator.ts before slice-2 worker uses.
   */
  config               Json         @default("{}")
  /**
   * Lifecycle (DB CHECK + transition trigger):
   * draft | active | archived. archived terminal.
   */
  status               String       @default("draft")
  /**
   * Org-default model — at most one per org (partial unique index).
   */
  isDefault            Boolean      @default(false)
  archivedAt           DateTime?
  /**
   * C9 #17 — dirty marker for incremental recompute. Set to now() when a deal
   * enters/leaves a won stage; the attribution-drain cron recomputes models
   * with this set and compare-and-clears it. NULL = nothing pending.
   */
  recomputeRequestedAt DateTime?
  createdBy            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  influences      CampaignInfluence[]
  calculationRuns AttributionCalculationRun[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([recomputeRequestedAt])
  @@map("attribution_models")
}

model CampaignTouchpoint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /**
   * Optional explicit deal link. NULL = aggregator decides relevance via
   * contact + timeline overlap.
   */
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  /**
   * Channel (DB CHECK):
   * email | ad | web | social | event | sms | call | other
   */
  channel        String
  /**
   * Type within channel (e.g. "email_opened", "ad_clicked").
   */
  touchpointType String
  occurredAt     DateTime
  metadata       Json         @default("{}")
  /**
   * Deterministic idempotency key for derived touchpoints (e.g.
   * "email:<emailLogId>:opened", "event:<participantId>:registered",
   * "deal:<dealId>:campaign_link"). NULL for ad-hoc/manual touchpoints.
   * Backed by a partial UNIQUE index (organizationId, sourceKey) WHERE
   * sourceKey IS NOT NULL — lets recorder/backfill use
   * createMany({skipDuplicates}) (INSERT … ON CONFLICT DO NOTHING),
   * which never fires the append-only UPDATE trigger.
   */
  sourceKey      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, contactId, occurredAt])
  @@index([campaignId, occurredAt])
  // Partial WHERE-index on dealId (NULL filtered) + the (organizationId,
  // sourceKey) partial UNIQUE index are handled in SQL migration.
  @@map("campaign_touchpoints")
}

model CampaignInfluence {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId            String
  deal              Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  modelId           String
  model             AttributionModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  /**
   * Credit weight in [0,1]. Sum per (deal, model) = 1.0 when any tp exists.
   */
  weight            Float            @default(0)
  /**
   * Pre-computed weight * deal.amount for reporting.
   * Decimal(18,4) — IEEE-754 drift at high touchpoint count was unacceptable
   * for MRR/attribution reports (see Float→Decimal sweep 2026-05-25).
   */
  attributedRevenue Decimal          @default(0) @db.Decimal(18, 4)
  /**
   * C9 #18 — "won" = realized attribution on a closed-won deal (attributedRevenue
   * is the full allocated share). "pipeline" = projected attribution on an OPEN
   * deal (attributedRevenue is the probability-weighted expected share). CHECK
   * enforces the two values. Reports default to kind="won" (realized); pipeline
   * is surfaced separately.
   */
  kind              String           @default("won")
  touchpointCount   Int              @default(0)
  computedAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([dealId, campaignId, modelId])
  @@index([organizationId, campaignId])
  @@index([organizationId, dealId])
  @@index([modelId, computedAt])
  @@map("campaign_influences")
}

model AttributionCalculationRun {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId           String
  model             AttributionModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  /**
   * Run lifecycle (DB CHECK + transition trigger):
   * pending | running | succeeded | failed
   */
  status            String           @default("pending")
  /**
   * cron | manual | api — DB CHECK.
   */
  triggerSource     String           @default("cron")
  dealsTotal        Int              @default(0)
  dealsProcessed    Int              @default(0)
  influencesWritten Int              @default(0)
  startedAt         DateTime?
  endedAt           DateTime?
  errorMessage      String?
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([modelId, startedAt])
  @@map("attribution_calculation_runs")
}

// ═══════════════════════════════════════════════════════════════════════════
// CANONICAL EVENT PLATFORM
// Transactional domain-event store + Debezium outbox, idempotent consumer
// inboxes, versioned projection builds and externally-visible effect fencing.
// These tables are infrastructure shared by every product module. Domain
// adoption remains explicit in src/lib/event-platform/catalog.ts.
// ═══════════════════════════════════════════════════════════════════════════

/// Global, migration-role-only release evidence. Pilot migrations insert
/// migration_applied atomically with their schema/data transaction; the deploy
/// program advances a row exactly once after rollback-client and replay gates.
model EventPlatformCutoverGate {
  gateKey             String   @id
