// MTM Region — top-level geographic unit in the Region → Team → Agent hierarchy
// (M4-5). A Region maps to a sales territory (e.g. "North Baku", "Ganja District").
// MANAGER-role agents can be associated with a region's team to scope their
// analytics and agent-list views to their own territory.
model MtmRegion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  teams MtmTeam[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("mtm_regions")
}

// MTM Team — mid-level unit under a Region. Each team has a SUPERVISOR (stored as
// managerId on the team) and zero-or-more AGENT members. The team belongs to a
// Region; a Manager sees all agents in their region (across teams).
model MtmTeam {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regionId       String?
  region         MtmRegion?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  name           String
  code           String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agents           MtmAgent[]
  visitPolicies    MtmVisitPolicy[]
  workCalendarDays MtmWorkCalendarDay[]
  workforcePolicies WorkforcePolicy[]
  workforceShiftTemplates WorkforceShiftTemplate[]
  workforceSitesResponsible WorkforceSite[]
  pharmacyPromotionTargets MtmPharmacyPromotionTarget[] @relation("MtmPharmacyTargetTeam")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, regionId])
  @@index([regionId])
  @@map("mtm_teams")
}

// MTM Agent — field agents linked to CRM users
model MtmAgent {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String? // link to CRM User if exists
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  email          String?
  phone          String?
  externalCode   String?
  passwordHash   String? // for mobile app login
  role           MtmAgentRole   @default(AGENT)
  status         MtmAgentStatus @default(ACTIVE)
  /// Whether this field agent may create and edit their own route drafts.
  /// Managers and administrators always plan within their normal scope.
  canPlanOwnRoutes Boolean       @default(true)
  /// Whether this field agent may publish their own route drafts.
  /// This individual grant never bypasses the organization-wide routeSelfPublish kill switch.
  canSelfPublishRoutes Boolean   @default(false)
  avatar         String?
  teamId         String?
  team           MtmTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  managerId      String?
  manager        MtmAgent?      @relation("AgentManager", fields: [managerId], references: [id])
  subordinates   MtmAgent[]     @relation("AgentManager")
  isOnline       Boolean        @default(false)
  lastSeenAt     DateTime?
  /// Expo push token — registered via POST /api/v1/mtm/agents/push-token on app startup.
  /// Used by sendShelfAnalysisPush to send analysis-complete notifications to mobile agents.
  expoPushToken  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  routes                    MtmRoute[]
  visits                    MtmVisit[]
  tasks                     MtmTask[]
  taskEvents                MtmTaskEvent[]
  photos                    MtmPhoto[]
  alerts                    MtmAlert[]
  locations                 MtmAgentLocation[]
  latestLocation            MtmAgentLatestLocation?
  workdays                  MtmAgentWorkday[]
  workdayEvents             MtmAgentWorkdayEvent[]
  notifications             MtmNotification[]
  routeNotificationOutbox   MtmRouteNotificationOutbox[]
  auditLogs                 MtmAuditLog[]
  routeAssignments          MtmRouteAssignment[]
  visitParticipants         MtmVisitParticipant[]
  visitActionResults        MtmVisitActionResult[]
  routeChangeRequests       MtmRouteChangeRequest[]
  customerCreateRequests    MtmCustomerCreateRequest[]
  externalSalesDocuments    MtmExternalSalesDocument[]
  salesPlanLines            MtmSalesPlanLine[]
  workCalendarDays          MtmWorkCalendarDay[]
  customerAssignments       MtmCustomerAgentAssignment[]
  managedCustomers          MtmCustomer[]                @relation("MtmCustomerManagingManager")
  contactAssignments        MtmContactAgentAssignment[]
  contactChangeRequests     MtmContactChangeRequest[]
  enteredDoctorAssessments  MtmDoctorAssessment[]        @relation("MtmDoctorAssessmentEnteredBy")
  reviewedDoctorAssessments MtmDoctorAssessment[]        @relation("MtmDoctorAssessmentReviewedBy")
  fieldPotentials           MtmFieldPotential[]          @relation("MtmFieldPotentialAgent")
  enteredFieldPotentials    MtmFieldPotential[]          @relation("MtmFieldPotentialEnteredBy")
  reviewedFieldPotentials   MtmFieldPotential[]          @relation("MtmFieldPotentialReviewedBy")
  commitments               MtmCommitment[]
  commitmentFacts           MtmCommitmentFulfillment[]
  createdMessageThreads     MtmMessageThread[]           @relation("MtmMessageThreadCreator")
  messageParticipants       MtmMessageParticipant[]
  sentMessages              MtmMessage[]                 @relation("MtmMessageSender")
  messageReceipts           MtmMessageReceipt[]
  uploadedDocuments         MtmDocument[]                @relation("MtmDocumentUploader")
  uploadedMediaObjects      MtmMediaObject[]             @relation("MtmMediaObjectUploader")
  documentAssignments       MtmDocumentAssignment[]
  hrmRequests               MtmHrmRequest[]
  workforceShiftAssignments WorkforceShiftAssignment[]
  workforceSiteAssignments  WorkforceSiteAssignment[]
  workforcePolicySnapshots  WorkforcePolicySnapshot[]
  workforceShiftSnapshots   WorkforceShiftSnapshot[]
  workforceExceptions       WorkforceAttendanceException[]
  workforceAttendanceReviewCases WorkforceAttendanceReviewCase[]
  workforceTimeCorrections  WorkforceTimeCorrection[]
  workforceTimesheetApprovals WorkforceTimesheetApproval[]
  workforceAttendanceDeviceEnrollments WorkforceAttendanceDeviceEnrollment[]
  workforceAttendanceVerifications     WorkforceAttendanceVerification[]
  pharmacyPromotionTargets  MtmPharmacyPromotionTarget[]    @relation("MtmPharmacyTargetAgent")
  managedPharmacyTargets    MtmPharmacyPromotionTarget[]    @relation("MtmPharmacyTargetManager")
  pharmacyExecutions        MtmPharmacyPromotionExecution[] @relation("MtmPharmacyExecutionAgent")
  pharmacyExecutionsSubmitted MtmPharmacyPromotionExecution[] @relation("MtmPharmacyExecutionSubmittedByAgent")
  pharmacyEvidence          MtmPharmacyPromotionEvidence[]  @relation("MtmPharmacyEvidenceAgent")
  pharmacyReviews           MtmPharmacyPromotionReview[]    @relation("MtmPharmacyReviewAgent")
  pharmacyLedgerBenefits    MtmPharmacyPointsLedgerEntry[]  @relation("MtmPharmacyLedgerBeneficiary")
  pharmacyLedgerActions     MtmPharmacyPointsLedgerEntry[]  @relation("MtmPharmacyLedgerAgent")
  pharmacyRewardBenefits    MtmPharmacyRewardClaim[]        @relation("MtmPharmacyRewardClaimBeneficiary")
  pharmacyRewardRequests    MtmPharmacyRewardClaim[]        @relation("MtmPharmacyRewardClaimAgent")
  pharmacyPromotionEvents   MtmPharmacyPromotionEvent[]     @relation("MtmPharmacyEventAgent")
  pharmacyPromotionOperations MtmPharmacyPromotionOperation[] @relation("MtmPharmacyOperationAgent")

  onboarding MtmOnboarding?

  @@unique([organizationId, email])
  @@unique([organizationId, externalCode])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([managerId])
  @@index([teamId])
  @@map("mtm_agents")
}

// Explicit organization/team/agent calendar overrides. Weekday/weekend
// defaults are derived in application code; this table stores only deliberate
// exceptions and named days. Scope precedence is agent > team > organization.
model MtmWorkCalendarDay {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date                 DateTime               @db.Date
  kind                 MtmWorkCalendarDayKind
  name                 String?
  teamId               String?
  team                 MtmTeam?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agentId              String?
  agent                MtmAgent?              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  movedToDate          DateTime?              @db.Date
  routePlanningAllowed Boolean?
  source               String                 @default("ADMIN")
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?

  @@index([organizationId, date, deletedAt])
  @@index([organizationId, teamId, date])
  @@index([organizationId, agentId, date])
  @@map("mtm_work_calendar_days")
}

// MTM Onboarding (M4-4) — tracks per-agent first-time onboarding progress.
// Created on first PUT; read by the mobile welcome wizard and web admin view.
model MtmOnboarding {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String       @unique
  agent          MtmAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // JSON array of completed step IDs (subset of ONBOARDING_STEPS enum)
  completedSteps String       @default("[]")
  // Set when all 5 steps are complete
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("mtm_onboarding")
}

// MTM Customer — field customers (stores, pharmacies, outlets)
model MtmCustomer {
  id                     String                @id @default(cuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                   String?
  name                   String
  objectType             MtmCustomerObjectType @default(STORE)
  category               MtmCustomerCategory   @default(B)
  status                 MtmCustomerStatus     @default(ACTIVE)
  address                String?
  region                 String?
  administrativeDistrict String?
  locality               String?
  cityDistrict           String?
  city                   String?
  district               String?
  specialization         String?
  organizationKind       String?
  territoryCode          String?
  polygon                Json?
  managingManagerId      String?
  managingManager        MtmAgent?             @relation("MtmCustomerManagingManager", fields: [managingManagerId], references: [id], onDelete: SetNull)
  /// Unknown = NULL on both axes, never 0. `mtm_customers_coordinates_check`
  /// rejects (0, 0) and half pairs; writers go through src/lib/mtm/geo-coordinates.ts.
  latitude               Float?
  longitude              Float?
  phone                  String?
  contactPerson          String?
  notes                  String?
  geofenceRadius         Int? // F-22: per-customer override; null = use org-level setting
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  routePoints            MtmRoutePoint[]
  visits                 MtmVisit[]
  tasks                  MtmTask[]
  approvedRequests       MtmCustomerCreateRequest[]
  externalSalesDocuments MtmExternalSalesDocument[]
  salesPlanLines         MtmSalesPlanLine[]
  contactWorkplaces      MtmContactWorkplace[]
  agentAssignments       MtmCustomerAgentAssignment[]
  fieldPotentials        MtmFieldPotential[]
  commitments            MtmCommitment[]
  pharmacyPromotionTargets MtmPharmacyPromotionTarget[]
  pharmacyPointsLedger     MtmPharmacyPointsLedgerEntry[]
  pharmacyRewardClaims     MtmPharmacyRewardClaim[]
  attributeFacts           MtmOrganizationAttributeFact[]
  departments              MtmCustomerDepartment[]
  coordinateVerifications  MtmCustomerCoordinateVerification[]
  documents                MtmDocument[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, region, administrativeDistrict, locality])
  @@index([organizationId, managingManagerId])
  @@index([organizationId, status, objectType])
  @@index([organizationId, territoryCode])
  @@map("mtm_customers")
}

/// Source-attributed organization department. Rows are never inferred from
/// free-text workplace data because that would create false SwissMed parity.
model MtmCustomerDepartment {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId        String
  customer          MtmCustomer  @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)
  code              String?
  name              String
  kind              String?
  phone             String?
  email             String?
  address           String?
  contactPerson     String?
  sourceSystem      String
  sourceReference   String?
  sourceObservedAt  DateTime
  createdByUserId   String?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, customerId, code])
  @@index([organizationId, customerId, archivedAt, name])
  @@map("mtm_customer_departments")
}

/// Immutable evidence that a named operator checked the exact coordinate
/// pair shown on the organization card against an external source.
model MtmCustomerCoordinateVerification {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId        String
