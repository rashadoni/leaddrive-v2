model Company {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  industry        String?
  website         String?
  phone           String?
  email           String?
  address         String?
  city            String?
  country         String?
  employeeCount   Int?
  annualRevenue   Float?
  description     String?
  status          String       @default("active") // active, inactive, prospect
  category        String       @default("client") // client, partner, prospect, inactive
  leadStatus      String       @default("converted") // new, contacted, qualified, converted, rejected, cancelled
  leadScore       Int          @default(0)
  leadTemperature String? // cold, warm, hot
  userCount       Int          @default(0)
  costCode        String?
  voen            String?
  creditLimit     Float? // AR credit limit; null = no limit enforced
  creditCurrency  String? // ISO currency code for creditLimit (else fall back to org default)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  slaPolicyId String?
  slaPolicy   SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)

  contacts        Contact[]
  deals           Deal[]
  activities      Activity[]
  contracts       Contract[]
  invoices        Invoice[]
  pricingProfiles PricingProfile[]
  projects        Project[]
  tickets         Ticket[]
  vendorBills     Bill[]           @relation("VendorBills")

  // B10 Entitlement Process
  entitlements Entitlement[]
  monitoringSubjects MonitoringSubject[]

  @@index([organizationId])
  @@map("companies")
}

model Contact {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  fullName          String
  email             String?
  phone             String?
  phones            String[]     @default([])
  position          String?
  department        String?
  avatar            String?
  dateOfBirth       DateTime? // D8 Loyalty — birthday auto-earn trigger (month+day matched by the loyalty-birthday cron)
  source            String? // website, referral, cold_call, sms, email, social, event, other
  brand             String? // product brand the contact is associated with (TT §3.3)
  category          String? // contact category: vip, regular, partner, prospect, inactive (TT §3.3)
  lifecycleStage    String       @default("lead") // lead | engaged | mql | sql | opportunity | customer | churned
  // SMS attribution (TT §3.3 "SMS kampaniyaları" as segmentation source).
  // Populated by POST /campaigns/[id]/send when an SMS delivers successfully.
  lastSmsCampaignId String?
  lastSmsAt         DateTime?
  tags              String[]     @default([])
  isActive          Boolean      @default(true)
  lastContactAt     DateTime?
  engagementScore   Int          @default(0)
  lastActivityAt    DateTime?
  preferredLanguage String? // "ru" | "en" | "az" — null = use org default
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Portal access
  portalPasswordHash        String?
  portalAccessEnabled       Boolean   @default(false)
  portalLastLoginAt         DateTime?
  portalVerificationToken   String?
  portalVerificationExpires DateTime?
  /// Expo push tokens for the native loyalty app (one per device the member signed in on).
  expoPushTokens            String[]  @default([])

  activities Activity[]
  invoices   Invoice[]
  tickets    Ticket[]
  contracts  Contract[]
  events     ContactEvent[]
  callLogs   CallLog[]

  // C9 Marketing Attribution
  campaignTouchpoints CampaignTouchpoint[]

  // C12 Multi-channel Orchestrator
  channelPreferences     ChannelPreference[]
  orchestratedDeliveries OrchestratedDelivery[]

  // C7 Distributed Marketing
  templateSendRecords TemplateSendRecord[]

  // T8 Cobrowse — sessions where this contact was the customer side.
  cobrowseSessions CobrowseSession[] @relation("CobrowseContact")

  @@index([organizationId])
  @@index([organizationId, companyId])
  @@index([organizationId, lifecycleStage])
  // Speeds the C9 email-resolve hooks (form-submit touchpoint + event/deal hooks) that do
  // contact.findFirst({ where: { organizationId, email } }) — previously fell back to the
  // organizationId-only index and filtered email in-memory per org.
  @@index([organizationId, email])
  @@map("contacts")
}

model ContactEvent {
  id             String   @id @default(cuid())
  organizationId String
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  eventType      String
  eventData      Json?
  source         String?
  score          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, contactId])
  @@index([organizationId, eventType, createdAt])
  @@index([contactId, eventType])
  @@map("contact_events")
}

model Deal {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contactId       String?
  pipelineId      String?
  pipeline        Pipeline?    @relation(fields: [pipelineId], references: [id])
  name            String
  customerNeed    String?
  salesChannel    String?
  stage           String       @default("LEAD")
  valueAmount     Decimal      @default(0) @db.Decimal(18, 4)
  currency        String       @default("AZN")
  probability     Int          @default(0)
  expectedClose   DateTime?
  assignedTo      String?
  lostReason      String?
  notes           String?
  tags            String[]     @default([])
  stageChangedAt  DateTime?
  confidenceLevel Int          @default(50)
  metadata        Json?
  /// D1 (Creatio 10X roadmap) — MEDDPICC qualification: 8 blocks, each
  /// { score: 1-5, note, next }. Shape owned by src/lib/meddpicc.ts.
  meddpicc        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  teamMembers  DealTeamMember[]
  contactRoles DealContactRole[]
  competitors  DealCompetitor[]
  offers       Offer[]
  invoices     Invoice[]
  contracts    Contract[]
  projects     Project[]         @relation("ProjectDeal")

  // C9 Marketing Attribution
  campaignTouchpoints CampaignTouchpoint[]
  campaignInfluences  CampaignInfluence[]

  // A12 Revenue Intelligence
  stageTransitions PipelineStageTransition[]

  // S6 CPQ — formal quotes built off this deal. Optional 1:N; deals
  // may exist without quotes, quotes may exist standalone (no deal).
  quotes Quote[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([campaignId])
  @@index([pipelineId])
  @@map("deals")
}

model DealContactRole {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId      String
  role           String   @default("contact_person")
  influence      String   @default("Medium")
  decisionFactor String   @default("Ease of Use")
  loyalty        String   @default("Neutral")
  isPrimary      Boolean  @default(false)
  cashbackType   String? // "percent" or "fixed"
  cashbackValue  Float? // percentage (e.g. 5.0) or fixed amount
  createdAt      DateTime @default(now())

  @@unique([dealId, contactId])
  @@index([dealId])
  @@map("deal_contact_roles")
}

model DealCompetitor {
  id         String   @id @default(cuid())
  // Denormalised from the parent deal — see OfferItem (finding F-56).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name       String
  product    String?
  strengths  String?
  weaknesses String?
  price      String?
  threat     String   @default("Medium") // High, Medium, Low
  notes      String?
