// ═══════════════════════════════════════════════════════════════════════════
// G6 — REAL-TIME EVENT STREAM (Phase 6 platform infrastructure)
// Pub/sub backbone for typed cross-module events. Slice-1 = schema +
// pure helpers; slice-2 wires publisher API + dispatcher worker + UI.
// See prisma/migrations/20260519110000_event_stream/migration.sql for
// trigger-level invariants (status machines, append-only, coherence).
// ═══════════════════════════════════════════════════════════════════════════

model EventStream {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * Stable identifier within the org (lowercase + dots + underscores).
   * Used as publish-route segment. Immutable once created.
   */
  streamKey        String
  name             String
  description      String?
  /**
   * JSON-Schema-shaped payload contract. Slice-1 validator does shape
   * checks (required fields, type tags); full draft-07 = slice-2.
   */
  payloadSchema    Json         @default("{}")
  /**
   * Lifecycle (DB CHECK + transition trigger):
   * draft | active | paused | archived
   */
  status           String       @default("draft")
  /**
   * Event retention in seconds. NULL = retain indefinitely.
   * retention-pruner cron DELETEs events older than this.
   */
  retentionSeconds Int?         @default(2592000)
  /**
   * Monotonic per-stream sequence counter. Publisher (slice-2) takes
   * row lock + bumps inside publish transaction.
   */
  lastSequence     BigInt       @default(0)
  activatedAt      DateTime?
  archivedAt       DateTime?
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  events        EventStreamEvent[]
  subscriptions EventStreamSubscription[]

  @@unique([organizationId, streamKey])
  @@index([organizationId, status])
  @@map("event_streams")
}

model EventStreamEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  streamId       String
  stream         EventStream  @relation(fields: [streamId], references: [id], onDelete: Cascade)
  /**
   * Monotonic per-stream sequence number (bumped from EventStream.lastSequence).
   * Subscribers track cursors against this for ordered + at-least-once
   * delivery.
   */
  sequence       BigInt
  /**
   * Logical event type within the stream (e.g. `deal.stage_changed`).
   */
  eventType      String
  /**
   * Stable idempotency key — UPSERT collapses duplicate publishes (slice-2).
   */
  idempotencyKey String?
  /**
   * Validated against parent stream.payloadSchema by slice-1 validator.
   */
  payload        Json         @default("{}")
  /**
   * Traceability metadata: { sourceType, sourceId, actorId, ... }.
   */
  source         Json         @default("{}")
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  deliveryAttempts EventStreamDeliveryAttempt[]
  deadLetters      EventStreamDeadLetter[]

  @@unique([streamId, sequence])
  // Per-stream idempotency uniqueness handled by partial index in SQL
  // migration (Prisma can't express WHERE clauses on unique constraints).
  @@index([organizationId, streamId])
  @@index([streamId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("event_stream_events")
}

model EventStreamSubscription {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  streamId              String
  stream                EventStream  @relation(fields: [streamId], references: [id], onDelete: Cascade)
  name                  String
  /**
   * Delivery target type (DB CHECK):
   * webhook | internal_queue | workflow | activation
   */
  targetType            String
  /**
   * Target-table-specific id (soft FK — target tables diverse).
   */
  targetRef             String
  /**
   * Optional eventType equality filter.
   */
  eventTypeFilter       String?
  /**
   * Optional payload-path predicates. Shape:
   * { "payload.dealStage": { "eq": "won" }, "payload.amount": { "gt": 1000 } }
   * subscription-filter-matcher.ts implements eq/neq/in/gt/lt/contains.
   */
  payloadFilter         Json         @default("{}")
  /**
   * Lifecycle (DB CHECK + transition trigger):
   * active | paused | archived
   */
  status                String       @default("active")
  /**
   * Max delivery attempts before escalation to dead-letter.
   */
  maxAttempts           Int          @default(5)
  /**
   * Last sequence successfully delivered. Slice-2 dispatcher resumes from here.
   */
  lastDeliveredSequence BigInt       @default(0)
  archivedAt            DateTime?
  createdBy             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  deliveryAttempts EventStreamDeliveryAttempt[]
  deadLetters      EventStreamDeadLetter[]

  @@unique([streamId, targetType, targetRef])
  @@index([organizationId, status])
  @@index([streamId, status])
  @@map("event_stream_subscriptions")
}

model EventStreamDeliveryAttempt {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   EventStreamSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventId        String
  event          EventStreamEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /**
   * 1-based attempt counter; retry-policy computes next-delay from this.
   */
  attemptNumber  Int
  /**
   * Delivery outcome (DB CHECK):
   * pending | succeeded | failed | exhausted
   * Once outcome leaves pending, the row is immutable (audit semantics).
   */
  outcome        String                  @default("pending")
  attemptedAt    DateTime?
  completedAt    DateTime?
  /**
   * HTTP-style status for webhook target; null for internal targets.
   */
  responseCode   Int?
  errorMessage   String?
  metadata       Json                    @default("{}")
  createdAt      DateTime                @default(now())

  @@unique([subscriptionId, eventId, attemptNumber])
  @@index([organizationId, outcome])
  @@index([subscriptionId, outcome])
  @@index([eventId])
  @@map("event_stream_delivery_attempts")
}

model EventStreamDeadLetter {
  id                String                  @id @default(cuid())
  organizationId    String
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId    String
  subscription      EventStreamSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventId           String
  event             EventStreamEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  finalAttemptCount Int
  lastError         String?
  /**
   * Triage state (DB CHECK + transition trigger):
   * open | replaying | resolved | discarded
   * resolved + discarded are terminal.
   */
  triageStatus      String                  @default("open")
  replayedAt        DateTime?
  resolvedAt        DateTime?
  discardedAt       DateTime?
  resolvedBy        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([subscriptionId, eventId])
  @@index([organizationId, triageStatus])
  @@index([subscriptionId, triageStatus])
  @@map("event_stream_dead_letters")
}

