# Database
DATABASE_URL="postgresql://leaddrive:leaddrive@localhost:5432/leaddrive"

# Redis — required in production by public lead/portal-registration abuse guards.
# Those endpoints intentionally return 503 instead of silently losing protection.
REDIS_URL="redis://localhost:6379"

# NextAuth — generate a distinct value per environment with:
#   openssl rand -base64 32
# Store the result in deployment secrets; never commit or reuse it.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Domain URLs (production: app.leaddrivecrm.org / leaddrivecrm.org)
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_MARKETING_URL=""

# Cookie domain (e.g. ".leaddrivecrm.org" — must start with dot for subdomain sharing)
COOKIE_DOMAIN=""

# Contact email shown on marketing pages and used for notifications
NEXT_PUBLIC_CONTACT_EMAIL=""

# CNAME target for custom domains feature
CNAME_TARGET=""

# Base domain for tenant subdomains (e.g. "leaddrivecrm.org" → {slug}.leaddrivecrm.org)
NEXT_PUBLIC_BASE_DOMAIN="leaddrivecrm.org"

# Cloudflare API (for tenant DNS automation)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Shared server IP for tenant DNS records (default: 13.140.132.245)
SHARED_SERVER_IP="13.140.132.245"

# Production environment lives at /etc/leaddrive/app.env (root:root, 0600).
# /opt/leaddrive-v2/.env is only a deployment compatibility symlink; never
# create a second source of truth in the checkout.
# Mutable production state stays outside Git. These defaults are written by the
# approved deploy if absent and must not point at /tmp, /run, or the checkout.
LEADDRIVE_RUNTIME_DIR="/var/lib/leaddrive-v2"
# /var/log is group-writable on the supported host. Keep PM2's authoritative
# logs under a dedicated root-owned sibling instead of letting a log-reader
# replace the directory through the parent.
LEADDRIVE_LOG_DIR="/var/lib/leaddrive-v2-logs"
# Persistent tutorial video assets. Must end in /player and remain outside
# runtime uploads/state.
HELP_VIDEO_ASSET_DIR=""
# Private MTM document bytes and voice recovery state remain under the runtime
# roots; use the defaults unless an approved, equivalent external layout exists.
MTM_DOCUMENT_STORAGE_DIR=""
VOICE_OPERATOR_STATE_DIR=""

# Cron job secret (for /api/cron/* endpoints)
CRON_SECRET=""

# Field media object storage (M3) — OFF unless a dedicated private media
# bucket, least-privilege credential, encryption key and approved retention
# policy are supplied together. Never reuse BACKUP_S3_* or AWS_* backup keys.
MTM_MEDIA_OBJECT_STORAGE_MODE="disabled"
MTM_MEDIA_S3_ENDPOINT=""
MTM_MEDIA_S3_REGION=""
MTM_MEDIA_S3_BUCKET=""
MTM_MEDIA_S3_ACCESS_KEY_ID=""
MTM_MEDIA_S3_SECRET_ACCESS_KEY=""
MTM_MEDIA_ENCRYPTION_KEY_ID=""
# Exactly 32 random bytes, base64 encoded. Keep the raw value in the secret
# manager; optional historic keys use MTM_MEDIA_ENCRYPTION_KEYRING_JSON.
MTM_MEDIA_ENCRYPTION_KEY_BASE64=""
MTM_MEDIA_ENCRYPTION_KEYRING_JSON=""
# Required before mode=s3; no default retention/legal-hold decision is made in code.
MTM_MEDIA_OBJECT_RETENTION_DAYS=""
MTM_MEDIA_OBJECT_LOCK_MODE=""
MTM_MEDIA_OBJECT_LEGAL_HOLD=""
# Chatwoot polling sends each tenant's api_access_token only to the official
# Chatwoot Cloud host by default. Add exact comma-separated host[:port] values
# here only for trusted self-hosted Chatwoot installations.
CHATWOOT_POLL_ALLOWED_HOSTS=""

# Dedicated, single-tenant Facebook native-search worker. Keep disabled unless
# the internal T5/manual-only browser-capture workflow has been approved.
# TOKEN_SHA256 is the lowercase SHA-256 hex digest of the raw worker bearer;
# never place the raw bearer in this file.
SOCIAL_FACEBOOK_NATIVE_WORKER_ENABLED=""
SOCIAL_FACEBOOK_NATIVE_WORKER_TOKEN_SHA256=""
SOCIAL_FACEBOOK_NATIVE_WORKER_ORG_SLUG=""

# Tenant-slug enforcement (F-35 / F-36 rollout knobs)
#
# When `=1`, the corresponding auth endpoint REJECTS legacy clients that
# don't pass `organizationSlug` in the credentials payload — protecting
# against the cross-tenant first-match-wins lookup. Default unset / `=0`
# keeps the legacy path active (backward compat).
#
# Rollout sequence:
#   1. Deploy auth-credentials helpers (already in `src/lib/auth.ts` and
#      `src/app/api/v1/mtm/mobile/auth/route.ts`).
#   2. Watch server logs for `[Auth] legacy email-only lookup (F-36
#      deprecated path)` and `[MTM/mobile/auth] legacy email-only lookup
#      (F-35 deprecated path)`.
#   3. Once the rate drops to zero, set the corresponding flag to `1` on
#      one tenant at a time and confirm no breakage.
#   4. Make a final pass: bump prod env and remove the legacy fallback
#      code paths in a follow-up PR.
#
# Mobile flag (cadence: weeks — mobile builds linger on user devices):
MTM_REQUIRE_TENANT_SLUG=""
# Web flag (cadence: single redeploy):
REQUIRE_TENANT_SLUG=""

# Google OAuth (optional — for SSO login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft / Azure AD OAuth (optional — for SSO login)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Microsoft Azure AI Speech (approved external provider for help-video voiceover)
# Do not commit real values. These are not the same as Microsoft OAuth keys above.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
AZURE_SPEECH_ENDPOINT=""
AZURE_SPEECH_VOICE_RU=""
AZURE_SPEECH_VOICE_EN=""
AZURE_SPEECH_VOICE_AZ=""

# Compute Service (FastAPI)
COMPUTE_SERVICE_URL="http://localhost:8000"

# Optional operator-managed 1C ERP endpoint. Configure this pair atomically:
# setting only one value intentionally disables ERP delivery. When both are
# absent, an approved tenant-local URL/key pair may be used instead.
ERP_API_URL=""
ERP_API_KEY=""

# AI
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ── Browser voice control (Gemini Live only) ──────────────────────────────
# Fail-closed selector: any other or empty value disables browser voice.
# GEMINI_API_KEY stays server-side; the browser receives a one-use constrained
# ephemeral token for gemini-3.1-flash-live-preview with the Kore voice.
VOICE_REALTIME_PROVIDER="gemini_live"
# Pilot allowlist. Kept in env, not in the DB: the in-app feature-flag route
# and UserPreference rows are both writable by their own owner, so a DB flag
# would be a grant the grantee could issue to themselves. Unset = voice OFF.
VOICE_PILOT_ORG_ID=""
VOICE_PILOT_USER_IDS=""
# Optional — defaults live in src/lib/ai/voice/config.ts
VOICE_MONTHLY_MINUTES="120"
VOICE_MAX_SESSION_SECONDS="300"
VOICE_MAX_TOOL_CALLS="40"

# Lead AI-call queue. Keep false until the sequential worker, consent/DNC
# operations, calling-hours policy, provider callback and cost controls have
# all been proven for the pilot tenant. The tenant VoIP switch is a second,
# independent gate; neither side can enable dispatch by itself.
VOICE_CALL_QUEUE_EXECUTION_ENABLED="false"

# Single-tenant AI-call runtime binding. Unset means manual and queued AI calls
# remain unavailable even if a database setting is changed.
VOICE_AGENT_ORGANIZATION_ID=""

# PBX control-plane runtime secret. Store the same raw UTF-8 value in the CRM
# and PBX secret stores; never add a real value to this file. It authenticates
# callbacks and HMAC-signs the durable attempt-registry protocol.
FANUM_VOICE_RUNTIME_TOKEN=""

# Exact private/on-prem PBX origins allowed for server-side VoIP control or
# connectivity probes. Comma/newline separated `scheme://host:port` values;
# paths and wildcards are rejected. Public endpoints must use HTTPS and public
# DNS. Leave empty unless every origin has been inventoried and approved.
VOIP_PRIVATE_ENDPOINT_ALLOWLIST=""

# Durable Asterisk attempt registry. Default OFF. A call uses it only when this
# global gate and the pilot Asterisk ChannelConfig capability are both true.
VOICE_PROVIDER_ATTEMPT_REGISTRY_ENABLED="false"
VOICE_OUTBOUND_CALL_DISPATCH_PAUSED="false"

# Fail-closed reconciliation of dispatch_uncertain sessions. Default OFF and
# independently gated; it never redials and trusts only signed durable states.
VOICE_PROVIDER_FINALITY_RECONCILIATION_ENABLED="false"

# WhatsApp Cloud API — DEPRECATED ENV VARS
#
# All WhatsApp credentials are per-tenant and stored in ChannelConfig.
# Tenants configure their own WABA via /settings/channels +
# /settings/channels/whatsapp.
#
# These env vars are read only by the LeadDrive tenant's backfill script
# (scripts/migrate-leaddrive-whatsapp.mjs) during the transition, and by
# the webhook's legacy fallback when ?t= is not present in the callback URL.
# Remove them after every tenant's ChannelConfig is populated and every Meta
# app points to /api/v1/webhooks/whatsapp?t={slug}.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""     # per-tenant; store in ChannelConfig.appSecret

# Instagram-Login (Instagram Direct DMs — "Path B"). A SEPARATE Meta app from the Facebook one;
# Meta retired Instagram messaging on the Facebook-Login page-token path (returns "(#3)"). Powers
# /api/v1/social/oauth/instagram/{start,callback} + /api/v1/webhooks/instagram. The IG app must be
# PUBLISHED and pass App Review (instagram_business_manage_messages) for live (non-tester) delivery.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="https://app.leaddrivecrm.org/api/v1/social/oauth/instagram/callback"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""

# Stripe (Phase 6)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Google Maps Routes — MTM route feasibility (all four server gates stay OFF
# by default). Use a server-only API key restricted to the Routes API. A route
# calculation is possible only for allowlisted pilot tenants with a positive
# daily request ceiling; tenant settings alone cannot create paid traffic.
GOOGLE_MAPS_ROUTES_API_KEY=""
GOOGLE_MAPS_ROUTES_EXECUTION_ENABLED="false"
GOOGLE_MAPS_ROUTES_ALLOWED_ORG_IDS=""
GOOGLE_MAPS_ROUTES_DAILY_LIMIT="0"
GOOGLE_MAPS_ROUTES_TIMEOUT_MS="5000"

# Google Maps Embed API — optional separate map surface for a manually ordered
# route. This browser-visible key must be referrer-restricted and API-restricted
# to Maps Embed API; it is never used for the paid server-side Routes API.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=""

# CARTO Raster Basemaps (required by CARTO for the Leaflet MTM maps).
# This value is intentionally public in browser tile URLs; restrict the key to
# this application's domains in CARTO. For production it is injected only at
# build time from the CARTO_BASEMAPS_API_KEY GitHub Actions secret.
NEXT_PUBLIC_CARTO_BASEMAPS_API_KEY=""
