{
  "manifest_version": 3,
  "name": "LeadDrive e-Qaimə",
  "version": "1.0.0",
  "description": "e-Taxes-dəki elektron qaimələri LeadDrive-a gətirir: Maliyyə → E-qaimə.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://new.e-taxes.gov.az/*",
    "https://*.leaddrivecrm.org/*",
    "http://localhost:3000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://new.e-taxes.gov.az/*"],
      "js": ["core.js", "etaxes.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.leaddrivecrm.org/*", "http://localhost:3000/*"],
      "js": ["leaddrive.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "LeadDrive e-Qaimə", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
