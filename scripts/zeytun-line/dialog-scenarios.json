{
  "about": "Scenarios of the line's dialog stand (scripts/zeytun-line/dialog-stand.ts). The caller speaks Azerbaijani, as pharmacies do. A turn is the caller's words, or {say, when: [{match, say}]}: the first rule whose match (regex, case-insensitive) fits the assistant's last reply decides, else say. Regexes of checks run on the assistant's replies or on a tool call's JSON args. expectedFail: the line does not have it yet; such a scenario is reported but not fixed here. Products are chosen on the 2026-11-03 snapshot: Adefa №30 has buy 5 get 1 until 2026-11-30, Ketonal cream 50 g and gel buy 10 get 2 until 2026-11-30, Fluimucil is not in the catalog while A.C.C. long 600 effervescent is.",
  "scenarios": [
    {
      "id": "1",
      "title": "Обычный заказ из трёх товаров",
      "turns": [
        "Zəfər aptek. Adefa 5 qutu, Bisakodil 10 qutu.",
        { "say": "Mezim forte 10000, 3 qutu.", "when": [{ "match": "(Adefa|Bisakodil)[^.!]*\\?", "say": "Bəli, düzdür. Bir də Mezim forte 10000, 3 qutu." }] },
        { "say": "Bu qədər, təsdiq edirəm.", "when": [{ "match": "Mezim[^.!]*\\?", "say": "Bəli, 10000. Bu qədər, təsdiq edirəm." }] },
        "Sağ olun."
      ],
      "checks": {
        "tools": [
          { "name": "search_pharmacy_catalog", "args": "adefa", "label": "искал Adefa" },
          { "name": "search_pharmacy_catalog", "args": "bisakodil", "label": "искал Bisakodil" },
          { "name": "search_pharmacy_catalog", "args": "mezim", "label": "искал Mezim forte" }
        ],
        "reply": [{ "match": "aksiya|pulsuz|hədiyyə|bonus", "label": "назвал акцию на Adefa (5+1)" }],
        "finalSave": true,
        "savedLines": 3
      }
    },
    {
      "id": "2",
      "title": "Товара нет — сам предлагает аналог (substitute:)",
      "turns": [
        "Gənclik aptek. Fluimucil 600 şipuçi tablet, 10 qutu.",
        { "say": "Fluimucil. F-L-U-İ-M-U-C-İ-L, altı yüz.", "when": [
          { "match": "(A\\.?\\s?[CS]\\.?\\s?[CS]|АЦЦ|asetilsistein|ацетилцистеин)[^.!]*\\?", "say": "Bəli, onu yazın, 10 qutu." },
          { "match": "Fluifort|Флуифорт", "say": "Yox, Fluifort yox. Fluimucil." }] },
        { "say": "Bu qədər, təsdiq edirəm.", "when": [
          { "match": "(A\\.?\\s?[CS]\\.?\\s?[CS]|АЦЦ|asetilsistein|ацетилцистеин)[^.!]*\\?", "say": "Bəli, onu yazın, 10 qutu." }] },
        { "say": "Bu qədər, təsdiq edirəm.", "when": [{ "match": "Sağ olun, xoş günlər", "say": "Sağ olun." }] }
      ],
      "checks": {
        "tools": [{ "name": "search_pharmacy_catalog", "args": "substitute:\\s*ACETYLCYSTEINE", "label": "сам искал аналог: substitute: ACETYLCYSTEINE" }],
        "reply": [{ "match": "A\\.?\\s?[CS]\\.?\\s?[CS]|АЦЦ|asetilsistein|ацетилцистеин", "label": "предложил ACC (ацетилцистеин)" }],
        "finalSave": true,
        "savedLines": 1
      }
    },
    {
      "id": "3",
      "title": "«Paracetamol hansı formaları var?»",
      "turns": [
        "Nərgiz aptek. Paracetamol hansı formaları var?",
        { "say": "Yaxşı, sirop 5 qutu.", "when": [{ "match": "(sirop|hansı)[^.!]*\\?", "say": "Sirop, 5 qutu." }] },
        "Bu qədər, təsdiq edirəm.",
        "Sağ olun."
      ],
      "checks": {
        "tools": [{ "name": "search_pharmacy_catalog", "args": "paras?setamol|parac", "label": "искал Paracetamol" }],
        "reply": [
          { "match": "tablet|həb", "label": "назвал таблетки" },
          { "match": "sirop|şərbət", "label": "назвал сироп" }
        ],
        "noReply": [{ "match": "manat", "label": "без вопроса о цене цену не называет" }],
        "finalSave": true,
        "savedLines": 1
      }
    },
    {
      "id": "4",
      "title": "«Aksiyalar nələrdədir?» и «Ketonal-da aksiya var?»",
      "expectedFail": "нет запроса promotions: (сессия line-promotions)",
      "turns": [
        "Nərgiz aptek. Aksiyalar nələrdədir?",
        "Ketonal-da aksiya var?",
        "Yaxşı, sağ olun, hələlik sifariş yoxdur."
      ],
      "checks": {
        "tools": [
          { "name": "search_pharmacy_catalog", "args": "promotions:", "label": "запросил список акций (promotions:)" },
          { "name": "search_pharmacy_catalog", "args": "ketonal", "label": "искал Ketonal" }
        ],
        "reply": [
          { "match": "Ketonal.*(aksiya|pulsuz|hədiyyə|10.*2)|(aksiya|pulsuz|hədiyyə|10.*2).*Ketonal", "label": "назвал акцию Ketonal (10+2)" }
        ],
        "noReply": [{ "match": "aksiya (yoxdur|olmur)|məlumat(ım)? yoxdur|deyə bilmərəm", "label": "не отвечает «акций нет / не знаю» на вопрос об акциях" }]
      }
    },
    {
      "id": "5",
      "title": "«Əvvəlki kimi» / «как обычно»",
      "expectedFail": "нет запроса history: (сессия line-history)",
      "turns": [
        "Zəfər aptek. Əvvəlki kimi yazın.",
        "Как обычно, keçən dəfəki sifariş kimi.",
        "Bu qədər, təsdiq edirəm.",
        "Sağ olun."
      ],
      "checks": {
        "tools": [{ "name": "search_pharmacy_catalog", "args": "history:", "label": "запросил историю аптеки (history:)" }],
        "noTools": [{ "name": "save_order_list", "args": "\"externalId\"", "label": "не записал товары, которых аптека не называла" }]
      }
    },
    {
      "id": "6",
      "title": "Берут меньше, чем нужно для акции",
      "turns": [
        "Zəfər aptek. Adefa 3 qutu.",
        { "say": "Bəli, 3 qutu.", "when": [{ "match": "\\b5\\b|beş", "say": "Yaxşı, 5 qutu edin." }] },
        { "say": "Bu qədər, təsdiq edirəm.", "when": [{ "match": "(\\b5\\b|beş)[^.!]*\\?", "say": "Bəli, 5 qutu. Bu qədər, təsdiq edirəm." }] },
        "Sağ olun."
      ],
      "checks": {
        "tools": [{ "name": "search_pharmacy_catalog", "args": "adefa", "label": "искал Adefa" }],
        "reply": [{ "match": "(\\b5\\b|beş).*(aksiya|pulsuz|hədiyyə|bonus)|(aksiya|pulsuz|hədiyyə|bonus).*(\\b5\\b|beş)", "label": "предложил добрать до 5 по акции" }],
        "finalSave": true,
        "savedQuantity": { "spoken": "adefa", "quantity": 5, "label": "в заказе Adefa 5 qutu (после согласия)" }
      }
    }
  ]
}
