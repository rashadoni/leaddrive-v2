+    def mark_terminal_conflict(self, event: OutboxEvent, delivered_at: str | None = None) -> bool:
+        """Tombstone an undelivered event the CRM permanently refused with a
+        terminal-conflict verdict.  The row stays for audit: delivered_at
+        stops the retry loop while last_error_type/last_http_status retain the
+        409 evidence that mark_delivered would clear.  Returns True only when
+        this call settled the row; a concurrent settle or a changed payload
+        leaves the row to its owner."""
+        with self.connect() as connection:
+            connection.execute("BEGIN IMMEDIATE")
+            row = connection.execute(
+                "SELECT payload_hash FROM callback_outbox WHERE event_id = ?", (event.event_id,)
+            ).fetchone()
+            expected_hash = hashlib.sha256(event.payload_json.encode("utf-8")).hexdigest()
+            if row is None or not hmac.compare_digest(row["payload_hash"], expected_hash):
+                connection.rollback()
+                return False
+            cursor = connection.execute(
+                """
+                UPDATE callback_outbox
+                   SET delivered_at = ?, attempts = attempts + 1,
+                       last_error_type = 'terminal_conflict', last_http_status = 409
+                 WHERE event_id = ? AND delivered_at IS NULL
+                """,
+                (delivered_at or utc_now(), event.event_id),
+            )
+            changed = cursor.rowcount == 1
+            connection.commit()
+            return changed
