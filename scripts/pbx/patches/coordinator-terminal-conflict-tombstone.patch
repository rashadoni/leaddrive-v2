+def is_terminal_evidence_conflict(route: str, status_code: object, body: object) -> bool:
+    """True only for the CRM's own permanent 409 verdict on an evidence route.
+
+    The CRM claims a terminal outcome exactly once and answers matching
+    evidence replays with 200, so this exact conflict body can never succeed
+    on a retry.  Anything else — other routes, other statuses, unreadable or
+    non-exact bodies — stays retryable (fail closed)."""
+    if route not in ("provider_connected", "provider_unknown"):
+        return False
+    if status_code != 409 or not isinstance(body, bytes) or len(body) > 65_536:
+        return False
+    try:
+        payload = json.loads(body.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return False
+    return payload == {"success": False, "analysisStatus": "conflict"}
+
